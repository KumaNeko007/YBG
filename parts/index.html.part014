const STORY=[
 {s:['cat','にゃあ！ 朝の草原から、優しい星の歌が消えちゃったみたい。まずはあの羊耳のお兄さんに聞いてみよう！'],e:['cat','やったね、やっちゃん！ ひとつめの星のかけらだよ。お兄さんが言ってた『お城の扉』って何だろう？']},
 {s:['cat','木漏れ日の森だね。なんだか賑やかな虎耳のお兄さんが待ってるよ……気をつけて進もうね、やっちゃん！'],e:['cat','すごい滑走だったよ！ みんな意地悪じゃなく、何か大切なものを守るために星を集めているみたいだね。']},
 {s:['cat','キラキラの海辺だね！ あそこにいる馬耳の指揮官さん、何か大きな約束を知っていそうだよ。'],e:['cat','星のかけらが3つ集まったよ！ 4つそろうと、お城の特別な封印が解けるんだって！']},
 {s:['cat','月あかりの花園、とっても綺麗だね！ 発明家のお兄さんを超えて、次のお城へ進もうね！'],e:['cat','これで4つの星がそろったよ！ さあ、次はいよいよ『四つの星のお城』へ出発だにゃ！']},
 {s:['cat','4人全員がそろってるよ！ どんな時もボクがついてるから、いつものように楽しく滑ろうね！'],e:['goddess','……ああ、優しい黒猫があなたをかばい、古い呪いを受けてしまいました。これからは私が導きましょう。']},
 {s:['goddess','黒猫の姿が見えませんね……。呪いに操られ、お城の奥へ連れ去られたようです。あっきーさんに話を聞きましょう。'],e:['goddess','あっきーさんが道を示してくれました。水晶の鏡に残る小さな足跡を追って、先へ進みましょう。']},
 {s:['goddess','ここは時が止まった時計塔。たくぽんさんも、いなくなった黒猫を心配して力を試すようです。'],e:['goddess','呪いの正体は、お城に閉じ込められた古い魔法……。黒猫の心が完全に眠る前に、急ぎましょう。']},
 {s:['goddess','虹の雲の上で、ひかるんさんが待っています。あなたの『女神の光』こそが、黒猫を救う唯一の鍵なのです。'],e:['goddess','ひかるんさんも納得したようです。あなたの美しい舞と光が、黒猫の閉ざされた心に届き始めていますよ。']},
 {s:['goddess','ともさんが最後の扉の前で待っています。この先に、呪いに操られた黒猫が待っていますよ。'],e:['goddess','最後の扉が開きました！ 手強い相手になっていますが、恐れないで。あなたの愛で呪いを払うのです。']},
 {s:['goddess','4人の騎士と、呪いに操られた黒猫が立ちはだかります！ 光の力で、黒猫を優しく目覚めさせてあげましょう！'],e:['goddess','おめでとうございます！ 呪いは解け、黒猫も星の歌も戻りました。さあ、ふたりで最高の舞を踊りましょう！']},
];
const SYNOPSIS=[
 '朝の草原から「星の歌」が消えてしまいました。やっちゃんと黒猫は、羊耳のあっきーと出会い、ひとつめの星のかけらを手に入れます。',
 '歯車の音がひびく森で、虎耳のたくぽんが待っていました。ライバルたちは意地悪ではなく、何か大切なものを守るために星を集めているようです。',
 'キラキラの海辺で、馬耳の指揮官ひかるんと勝負。星のかけらは3つになり、お城の封印のうわさを聞きました。',
 '月あかりの花園で、発明家のともを超えて、ついに4つの星がそろいました。いよいよ「四つの星のお城」へ向かいます。',
 '4人のライバルとの大勝負に勝ったそのとき、お城の古い呪いの霧がやっちゃんをおそいます。黒猫はやっちゃんをかばって呪いを受け、姿を消してしまいました。',
 '女神さまの声に導かれ、やっちゃんは連れ去られた黒猫を追いかけます。水晶の回廊で、あっきーが道を示してくれました。',
 '時が止まった時計塔で、たくぽんがやっちゃんの力を試します。呪いの正体は、お城に閉じ込められた古い魔法でした。',
 '虹色の雲の上で、ひかるんに「女神の光」を認めてもらいました。やっちゃんの舞と光が、黒猫の心に届きはじめます。',
 '星降りの祭壇で、ともが最後の扉を開いてくれました。その先には、呪いに操られた黒猫が待っています。',
 '4人の騎士と、呪われた黒猫との最後の舞台。やっちゃんの優しい光は黒猫の呪いを解き、星の歌がよみがえりました。ふたりはまた、いっしょに滑りはじめます。',
];
