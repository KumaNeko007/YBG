 stump:{h:64,r:24},log:{h:48,r:30},shroom_r:{h:50,r:15},shroom_b:{h:48,r:15,glow:['#d8ecff',0.6,1.3]},crate:{h:54,r:22,nf:1},barrel:{h:58,r:20,nf:1},hay:{h:48,r:24},crates:{h:70,r:26,nf:1},
