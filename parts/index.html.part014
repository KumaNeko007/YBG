const BOSS_LINES=[
 {akira:['やあ、やっちゃん。星の歌を さがしているんだね。ぼくに 勝てたら、お城の扉の話を しよう。','…まいったね。星のかけらは きみに あずけるよ。お城の扉は 4つの星で ひらくんだ。']},
 {takumi:['よう、星を集めてるのは おまえか！ この森の かけらは オレが守ってるんだぜ！','くーっ、やるじゃねえか！ …オレたちも 大事な約束のために 星を守ってたんだ。']},
 {hikaru:['英国紳士ひかるん、参上！ 古い約束を 知りたければ、正々堂々 勝負だ！','見事だ…！ 約束とは、お城に眠る 星の歌を 守ること。きみになら 託せそうだ。']},
 {tomo:['最後の星は ぼくの発明で 守ってるよ。きみの すべり、計算させてもらおうか。','計算外だ…！ これで 4つの星が そろったね。お城で みんなが 待ってるよ。']},
 {akira:['ようこそ、四つの星のお城へ。ここからは 4人で きみを ためさせてもらうよ。','きれいな すべりだ。さあ、つぎの騎士が 待ってるよ。'],
  takumi:['ここまで来たか！ お城の封印の前で、手加減は なしだぜ！','ちくしょう、つええ！ あとは 二人に まかせた！'],
  hikaru:['封印を とく資格が あるか、騎士として 見届けさせてもらう！','見事…！ 最後は ともだ。'],
  tomo:['封印の前の 最後のしかけだよ。ぼくの計算を こえられるかな？','計算外…！ 封印が ゆるんで…あれ？ なにか 霧が…。']},
 {akira:['黒猫くんのことは 聞いたよ。きみの心が 折れていないか、すべりで 見せておくれ。','うん、だいじょうぶだね。水晶の鏡に 小さな足跡が のこっていたよ。']},
 {takumi:['黒猫が さらわれたって！？ …オレも 心配してんだ。おまえの力、ためさせてもらうぜ！','へへっ、それだけ すべれりゃ だいじょうぶだ。黒猫を 助けてやってくれよな！']},
 {hikaru:['虹の上まで よく来た。黒猫を 救う光が きみにあるか、騎士として 見極めよう！','見事だ…！ その光なら、黒猫の心にも きっと届く。']},
 {tomo:['この扉の むこうに 黒猫くんが いるよ。準備が できているか、最後の計算だ。','計算どおり…いや、それ以上だ。扉を ひらくよ。黒猫くんを たのんだよ。']},
 {akira:['いよいよだね。黒猫くんを 起こすための 光、ぼくたちに 見せておくれ。','その光だよ。さあ、先へ。'],
  takumi:['最後の勝負だ！ 全力で こいよ、やっちゃん！','行けっ！ 黒猫が 待ってるぜ！'],
  hikaru:['騎士として 最後の試練を あたえよう。いざ！','見事…！ その光で 黒猫を 照らしてくれ。'],
  tomo:['ぼくらの 最後の試練だよ。もう 計算なんて いらないね。','行って！ 黒猫くんの 呪いを といてあげて！']},
];
const BOSS_LINES_AFTER={akira:['星の歌が もどって よかったね。今日は ただ、いっしょに すべろうか。','…まいったね。きみは どんどん うまくなる。'],
 takumi:['もう一度 勝負だ！ 今度こそ オレが勝つぜ！','くーっ、また負けた！ 次こそは！'],
 hikaru:['再戦を 申しこむ！ 紳士として、手加減は しないよ。','見事だ…！ また 紅茶でも 飲みながら 話そう。'],
 tomo:['新しい発明が できたんだ。黒猫くんも いっしょに 見ていってよ。','計算外だ…！ また 研究しなおさなきゃ。']};
const BOSS_LINES_REPLAY10={akira:['呪いが とけて ほんとうに よかった。今日は 黒猫くんも いっしょだね。','ふふ、ふたりの 息が ぴったりだ。'],
 takumi:['おっ、黒猫も 元気そうだな！ 二人まとめて かかってこい！','くーっ、二人には かなわねえや！'],
 hikaru:['また 会えたね。今度は 黒猫くんと ふたりの 舞を 見せてくれ。','見事だ…！ 最高の ふたりだ。'],
 tomo:['黒猫くんの 呪いが とけた記念に、新しい発明を 試させてよ。','計算外…！ ふたりの力は 計算できないね。']};
function bossLine(id,kind){const k=kind==='lose'?1:0;
  if(id!=='cat'&&mode==='play'){if(stageIdx>=5&&stageIdx<=9&&save.cleared[9]&&BOSS_LINES_REPLAY10[id])return BOSS_LINES_REPLAY10[id][k];
    const L=BOSS_LINES[stageIdx];if(L&&L[id])return L[id][k];if(stageIdx>=10&&BOSS_LINES_AFTER[id])return BOSS_LINES_AFTER[id][k];}
  return BOSSES[id][kind];}
function bossName(id){return id==='cat'&&!save.cleared[9]?'？？？':BOSSES[id].name;}
const BOSS_ORDER=[['akira'],['takumi'],['hikaru'],['tomo'],['akira','takumi','hikaru','tomo']];
const JUMPS=['ループ','サルコウ','フリップ','ルッツ','トゥループ'];
const MAX_STAGE=120;
function makeStage(i){const n=i+1,rng=mulberry(9001+n*131);let bosses;
  if(n<=10)bosses=BOSS_ORDER[i%5].slice();
  else{const all=['akira','takumi','hikaru','tomo'];for(let k=all.length-1;k>0;k--){const j=Math.floor(rng()*(k+1));[all[k],all[j]]=[all[j],all[k]];}bosses=all.slice(0,1+Math.floor(rng()*4));}
  if(n===10)bosses.push('cat');
  const bg=n<=10?STAGE_BG[i]:BG_ORDER[i%10],lap=Math.floor(i/10);
  const tiers=n===1?[0,0,0,1]:n<=4?[0,0,1]:n<=10?[0,1,1,2]:n<=20?[0,1,2,2]:[1,2,2];
  const kinds=[];bosses.forEach(b=>{if(BOSSES[b].minion)kinds.push(BOSSES[b].minion);if(b==='hikaru')kinds.push('cpony');});
  const enemies=[];kinds.forEach(k=>tiers.forEach(t=>enemies.push([k,t])));
  if(n<=10){const others=['pony','tiger','sheep','mouse'].filter(k=>!kinds.includes(k));if(others.length)enemies.push([others[Math.floor(rng()*others.length)],0]);}
  const kills=n<=5?[12,14,16,16,20][i]:n<=10?15+(n-5):Math.min(26,16+Math.floor((n-11)/5)+bosses.length);
  return{no:n,name:n<=10?STAGE_NAMES[i]:ATLAS.bgs[bg].name+` その${lap+1}`,set:n<=10?STAGE_SET[i]:THEME_SET[bg],theme:bg,vid:BG_ORDER[i%10],enemies,bosses,kills,chests:(n<=2?2:3)+(n<=4?1:0),star:n<=4?i:-1,alive:Math.min(8,5+Math.floor(n/3)),
    jump:JUMPS[i%5],encore:n%5===0,encoreVid:n%10===0?'sky':'crystal',seed:n*37+11};}
const STAGES=Array.from({length:MAX_STAGE},(_,i)=>makeStage(i));
const EKIND={pony:{sp:1.2,hp:1,size:0.58,name:'ポニー'},tiger:{sp:1.0,hp:1.1,lunge:1,size:0.48,name:'子虎'},sheep:{sp:0.72,hp:1.5,size:0.52,name:'子羊'},mouse:{sp:1.3,hp:0.7,zig:1,size:0.5,name:'ネズミ'},cpony:{sp:1.25,hp:1,size:0.6,name:'白ポニー'}};
const TIER_SCALE=[1,1.12,1.26],TIER_H=[0.55,0.76,0.98],KIND_MUL={pony:1,cpony:1,tiger:0.95,sheep:0.95,mouse:0.92};

/* ============ assets ============ */
const images={};const failed=[];
function loadImg(file){if(images[file])return images[file].p;const img=new Image();img.decoding='async';
  const p=new Promise(res=>{img.onload=()=>res(img);img.onerror=()=>{failed.push(BASE+file);res(null);};});
  img.src=ASSETS[file]||(BASE+file);images[file]={img,p};return p;}
function imgOf(file){const e=images[file];if(!(e&&e.img.complete&&e.img.naturalWidth))return null;
  if(HIRES_YASUKO[file]){if(!e.preview){const cv=document.createElement('canvas');cv.width=1564;cv.height=830;
    const x=cv.getContext('2d');x.imageSmoothingQuality='high';x.drawImage(e.img,0,0,cv.width,cv.height);e.preview=cv;}
    return e.preview;}
  return e.img;}
function drawYasukoDetail(x,fr,dx,dy,dw,dh){const ratio=HIRES_YASUKO[fr.file]||1;
  const e=images[fr.file],im=ratio>1&&e&&e.img.complete&&e.img.naturalWidth?e.img:imgOf(fr.file);
  if(im)x.drawImage(im,fr.sx*ratio,fr.sy*ratio,fr.sw*ratio,fr.sh*ratio,dx,dy,dw,dh);
}
function gridFrame(info,i,foot){const c=i%info.cols,r=(i/info.cols)|0;return{file:info.file,sx:c*info.cw,sy:r*info.ch,sw:info.cw,sh:info.ch,fx:foot[0],fy:foot[1]};}
function yInfo(cid){return cid==='base'?(ATLAS.yasuko.bases[save.baseArt]||ATLAS.yasuko.bases.B):ATLAS.yasuko.costumes[cid];}
const yFrame=(cid,d)=>{const a=yInfo(cid);return gridFrame(a,d,a.foot||ATLAS.yasuko.foot);};
// Offline alpha-bound audit: one safe viewing box shared by all eight directions.
const Y_VIEW_BOX={"y_basic.webp":[22,28,348,386],"y_sailor.webp":[29,29,334,385],"y_lolita.webp":[23,29,346,385],"y_lace.webp":[33,29,326,385],"y_polka.webp":[24,29,344,385],"y_gothic.webp":[17,28,358,387],"y_princess.webp":[53,29,286,385],"y_chiffon.webp":[32,29,328,385],"y_crystal.webp":[23,28,346,386],"y_goddess.webp":[43,29,306,385],"y_maid.webp":[19,28,354,386],"y_hakama.webp":[34,28,324,387],"y_chinaw.webp":[36,28,320,387],"y_gsmile.webp":[32,27,328,387],"y_gtear.webp":[31,27,330,387],"yg_01.webp":[18,29,356,385],"yg_02.webp":[19,29,354,386],"yg_03.webp":[19,28,354,387],"yg_04.webp":[20,28,352,387],"yg_05.webp":[18,28,356,387],"yg_06.webp":[24,29,344,385],"yg_07.webp":[18,29,356,386],"yg_08.webp":[18,29,356,386],"yg_09.webp":[5,28,382,386],"yg_10.webp":[34,28,324,387],"yg_11.webp":[12,28,368,387],"yg_12.webp":[55,29,282,385],"yg_13.webp":[14,29,364,385],"yg_14.webp":[15,28,362,387],"yg_15.webp":[35,27,322,388],"yg_16.webp":[34,27,324,388],"yg_new10.webp":[51,28,290,386],"yg_new11.webp":[34,27,324,387],"yg_new12.webp":[35,27,322,387],"yg_new13.webp":[34,27,324,387],"yg_new14.webp":[28,27,336,387],"yg_new15.webp":[34,27,324,388],"yg_new16.webp":[34,27,324,388],"y_chinab.webp":[19,27,354,388],"ynew_veil.webp":[16,29,360,385],"ynew_blossom.webp":[23,28,346,386],"ynew_moon.webp":[59,29,274,385],"ynew_maid.webp":[47,27,298,388],"ynew_lace.webp":[48,29,296,385],"ynew_sheer.webp":[93,29,206,385],"ynew_tulle.webp":[79,28,234,387],"ynew_longveil.webp":[79,27,234,388],"ynew_tennis_white.webp":[51,27,290,387],"ynew_beige.webp":[67,27,258,388],"ynew2_gold.webp":[22,29,348,385],"ynew2_frill.webp":[21,29,350,385],"ynew2_ribbon.webp":[36,29,320,385],"ynew2_bob.webp":[98,29,196,385],"ynew2_marine.webp":[42,29,308,385],"ynew2_snow.webp":[94,29,204,385],"ynew2_tennis.webp":[42,29,308,385],"ynew2_rose.webp":[41,29,310,385],"ynew3_lacebow.webp":[98,29,196,385],"ynew3_sport.webp":[99,29,194,385],"ynew3_pearl.webp":[95,29,202,385],"ynew4_icelace.webp":[127,29,138,386],"ynew4_wrap.webp":[99,29,194,385],"ynew5_cross.webp":[99,29,194,385],"ynew5_cape.webp":[99,29,194,385],"ynew5_pearl.webp":[99,29,194,385],"ynew5_satin.webp":[100,29,192,385],"ynew5_braid.webp":[84,27,224,388],"ynew5_long.webp":[120,29,152,385],"y_base_B.webp":[56,28,280,386],"y_base_A.webp":[18,28,356,387],"y_base_W.webp":[77,29,238,385],"y_base_N.webp":[111,29,170,385],"y_base_P.webp":[112,29,168,385],"v8331_star_lace.webp":[0,0,391,415],"v8331_star_veil.webp":[0,0,391,415],"v8331_star_simple.webp":[0,0,391,415],"v8331_ice_lace.webp":[0,0,391,415],"v8331_jewel_ice.webp":[0,0,391,415],"v8331_flower_veil.webp":[0,0,391,415],"v8331_star_embroidery.webp":[0,0,391,415],"v8331_star_ribbon.webp":[0,0,391,415],"v8331_star_halter.webp":[0,0,391,415],"v8331_star_jewel_veil.webp":[0,0,391,415],"v8331_star_fine_lace.webp":[0,0,391,415],"v8331_star_satin.webp":[0,0,391,415],"v8331_star_open_sheer.webp":[0,0,391,415],"v8331_star_smooth_onepiece.webp":[0,0,391,415],"v8331_star_short_veil.webp":[0,0,391,415],"v8331_star_sheer_sleeveless.webp":[0,0,391,415],"v8331_star_snowflower_bob.webp":[0,0,391,415],"v8331_star_snowflower_braids.webp":[0,0,391,415]};
function commonYasukoFrame(fr){const b=Y_VIEW_BOX[fr.file];return b?{...fr,sx:fr.sx+b[0],sy:fr.sy+b[1],sw:b[2],sh:b[3]}:fr;}
const thumbFrame=id=>{const oi=ATLAS.thumbs.order.indexOf(id);if(oi<0)return yFrame(/^base_/.test(id)?'base':id,0);return{file:ATLAS.thumbs.file,sx:(oi%ATLAS.thumbs.cols)*ATLAS.thumbs.cw,sy:((oi/ATLAS.thumbs.cols)|0)*ATLAS.thumbs.ch,sw:ATLAS.thumbs.cw,sh:ATLAS.thumbs.ch,fx:ATLAS.thumbs.cw/2,fy:ATLAS.thumbs.ch-4};};
const bFrame=(bid,d)=>gridFrame(ATLAS.boss.list[bid],d,ATLAS.boss.foot);
const catFrame=d=>{const f=gridFrame(ATLAS.cat,d,ATLAS.cat.foot);f.file=ribbonKey(f.file);return f;};
const catPose=n=>{const f=gridFrame(ATLAS.catpose,ATLAS.catpose.names.indexOf(n),ATLAS.catpose.foot);f.file=ribbonKey(f.file);return f;};
const poseFrame=k=>{const r=ATLAS.poses.rects[k];return{file:ATLAS.poses.file,sx:r[0],sy:r[1],sw:r[2],sh:r[3],fx:r[4],fy:r[5]};};
const partnerFrame=(k,d)=>{const info=ATLAS.partner[k];return gridFrame(info,d,info.foot);};
const enemyFrame=(k,t)=>gridFrame(ATLAS.enemy,ATLAS.enemy.kinds.indexOf(k)*3+t,ATLAS.enemy.foot);

const spriteCache=new Map();
function scaledSprite(fr,s,flip,tint){
  const key=fr.file+'|'+fr.sx+'|'+fr.sy+'|'+s.toFixed(3)+'|'+(flip?1:0)+'|'+(tint||'');
  let c=spriteCache.get(key);if(c)return c;
  const ratio=HIRES_YASUKO[fr.file]||1;const img=ratio>1?(images[fr.file]&&images[fr.file].img):imgOf(fr.file);if(!img||!img.naturalWidth&&ratio>1)return null;
  const w=Math.max(1,Math.round(fr.sw*s)),h=Math.max(1,Math.round(fr.sh*s));
  let src=img,sx=fr.sx*ratio,sy=fr.sy*ratio,sw=fr.sw*ratio,sh=fr.sh*ratio;
  while(sw/2>=w&&sw>4){const nw=Math.round(sw/2),nh=Math.round(sh/2),t=document.createElement('canvas');t.width=nw;t.height=nh;
    const tc=t.getContext('2d');tc.imageSmoothingQuality='high';tc.drawImage(src,sx,sy,sw,sh,0,0,nw,nh);src=t;sx=0;sy=0;sw=nw;sh=nh;}
  c=document.createElement('canvas');c.width=w;c.height=h;const cx=c.getContext('2d');cx.imageSmoothingQuality='high';
  if(flip){cx.translate(w,0);cx.scale(-1,1);}
  cx.drawImage(src,sx,sy,sw,sh,0,0,w,h);
  if(tint){cx.setTransform(1,0,0,1,0,0);cx.globalCompositeOperation='source-atop';cx.fillStyle=tint;cx.fillRect(0,0,w,h);}
  if(spriteCache.size>260)spriteCache.clear();
  spriteCache.set(key,c);return c;
}

/* ============ canvas & sizing ============ */
const cv=$('cv'),ctx=cv.getContext('2d');
let VW=0,VH=0,DPR=1,charPx=130,K=0.3,vignette=null;
function fitViewport(){
  // Use the actual CSS 100dvh game rectangle: it excludes Safari's top/bottom bars
  // and adapts when they expand or collapse. Do not size the game from a transient
  // visualViewport.height value (may be tiny during Safari toolbar animations).
  const h=Math.max(320,Math.round($('game').getBoundingClientRect().height || document.documentElement.clientHeight || window.innerHeight));
  document.documentElement.style.setProperty('--app-h',h+'px');
  if(window.scrollY)window.scrollTo(0,0);return h;
}
function resize(){
  VW=window.innerWidth;VH=fitViewport();
  const nd=Math.min(window.devicePixelRatio||1,2.5);
  const nc=Math.round(clamp(Math.min(VH*0.19,VW*0.38),100,165));
  cv.width=Math.round(VW*nd);cv.height=Math.round(VH*nd);
  if(nd!==DPR||nc!==charPx){DPR=nd;charPx=nc;spriteCache.clear();fxCache.clear();themeCache.clear();}
  K=charPx/ATLAS.yasuko.charH;
  vignette=mk(VW,VH,(x,w,h)=>{const g=x.createRadialGradient(w/2,h/2,Math.min(w,h)*0.35,w/2,h/2,Math.max(w,h)*0.75);
    g.addColorStop(0,'rgba(90,60,40,0)');g.addColorStop(1,'rgba(90,60,40,0.28)');x.fillStyle=g;x.fillRect(0,0,w,h);},1);
}
function mk(w,h,draw,scale){const s=scale||DPR,c=document.createElement('canvas');c.width=Math.max(1,Math.ceil(w*s));c.height=Math.max(1,Math.ceil(h*s));
  const x=c.getContext('2d');x.scale(s,s);draw(x,w,h);c.cw=w;c.ch=h;return c;}

function drawSprite(fr,x,y,scale,o){o=o||{};
  const c=scaledSprite(fr,scale*DPR,!!o.flip,o.tint);if(!c)return;
  const w=c.width/DPR,h=c.height/DPR,fx=(o.flip?fr.sw-fr.fx:fr.fx)*scale,fy=fr.fy*scale;
  ctx.save();ctx.translate(x,y);if(o.rot)ctx.rotate(o.rot);if(o.sx||o.sy)ctx.scale(o.sx||1,o.sy||1);
  if(o.alpha!=null)ctx.globalAlpha=o.alpha;
  ctx.drawImage(c,-fx,-fy,w,h);
  if(o.flash){ctx.globalCompositeOperation='lighter';ctx.globalAlpha=o.flash;ctx.drawImage(c,-fx,-fy,w,h);}
  ctx.restore();
}

/* ============ small FX sprites ============ */
const fxCache=new Map();
function fx(key,size,draw){const k=key+'|'+size;let c=fxCache.get(k);if(c)return c;
  c=mk(size,size,(x,w)=>{x.translate(w/2,w/2);draw(x,w/2);});fxCache.set(k,c);return c;}
function glowCircle(x,r,col,a){const g=x.createRadialGradient(0,0,0,0,0,r);g.addColorStop(0,rgba(col,a));g.addColorStop(1,rgba(col,0));x.fillStyle=g;x.beginPath();x.arc(0,0,r,0,TAU);x.fill();}
function starPath(x,n,r1,r2){x.beginPath();for(let i=0;i<n*2;i++){const a=-Math.PI/2+i*Math.PI/n,r=i%2?r2:r1;x.lineTo(Math.cos(a)*r,Math.sin(a)*r);}x.closePath();}
function heartPath(x,r){x.beginPath();x.moveTo(0,r*0.75);x.bezierCurveTo(-r*1.3,-r*0.1,-r*0.55,-r*1.05,0,-r*0.35);x.bezierCurveTo(r*0.55,-r*1.05,r*1.3,-r*0.1,0,r*0.75);x.closePath();}
const FX={
 spark:(col)=>fx('spark'+col,28,(x,r)=>{glowCircle(x,r,col,0.55);x.fillStyle='#fff';starPath(x,4,r*0.8,r*0.16);x.fill();}),
 dot:(col)=>fx('dot'+col,16,(x,r)=>{glowCircle(x,r,col,0.9);}),
 heart:(col)=>fx('heart'+col,26,(x,r)=>{glowCircle(x,r,'#ffffff',0.5);x.fillStyle=col;heartPath(x,r*0.7);x.fill();x.strokeStyle='#fff';x.lineWidth=1.5;x.stroke();}),
 star:(col)=>fx('star'+col,28,(x,r)=>{glowCircle(x,r,'#fff7d0',0.7);x.fillStyle=col;starPath(x,5,r*0.78,r*0.36);x.fill();x.strokeStyle='#fff6c8';x.lineWidth=2;x.stroke();}),
 rose:(col)=>fx('rose'+col,30,(x,r)=>{glowCircle(x,r,'#ffd6de',0.6);x.fillStyle='#4f8a3a';x.beginPath();x.ellipse(-r*0.45,r*0.35,r*0.32,r*0.16,-0.5,0,TAU);x.fill();x.beginPath();x.ellipse(r*0.45,r*0.35,r*0.32,r*0.16,0.5,0,TAU);x.fill();
   x.fillStyle=col;x.beginPath();x.arc(0,0,r*0.52,0,TAU);x.fill();x.strokeStyle='rgba(255,230,235,.85)';x.lineWidth=1.6;for(let i=0;i<3;i++){x.beginPath();x.arc(0,0,r*(0.14+i*0.13),i,i+4.2);x.stroke();}}),
 pearl:(col)=>fx('pearl'+col,26,(x,r)=>{glowCircle(x,r,'#fff8e0',0.8);const g=x.createRadialGradient(-r*0.2,-r*0.2,1,0,0,r*0.5);g.addColorStop(0,'#fff');g.addColorStop(1,col);x.fillStyle=g;x.beginPath();x.arc(0,0,r*0.48,0,TAU);x.fill();}),
 dotshot:(col)=>fx('dots'+col,26,(x,r)=>{glowCircle(x,r,'#ffe0e0',0.6);x.fillStyle=col;x.beginPath();x.arc(0,0,r*0.55,0,TAU);x.fill();x.fillStyle='#fff';[[-.2,-.2],[.25,.05],[-.05,.3]].forEach(p=>{x.beginPath();x.arc(p[0]*r,p[1]*r,r*0.11,0,TAU);x.fill();});}),
 crystal:(col)=>fx('cry'+col,30,(x,r)=>{glowCircle(x,r,'#e8d6ff',0.7);const g=x.createLinearGradient(0,-r,0,r);g.addColorStop(0,'#f1e2ff');g.addColorStop(1,col);x.fillStyle=g;x.beginPath();x.moveTo(0,-r*0.75);x.lineTo(r*0.38,0);x.lineTo(0,r*0.75);x.lineTo(-r*0.38,0);x.closePath();x.fill();x.strokeStyle='#fff';x.lineWidth=1.2;x.stroke();}),
 petal:(col)=>fx('pet'+col,30,(x,r)=>{glowCircle(x,r,'#ffe6ee',0.6);x.fillStyle=col;x.beginPath();x.moveTo(0,-r*0.7);x.bezierCurveTo(r*0.6,-r*0.4,r*0.45,r*0.5,0,r*0.65);x.bezierCurveTo(-r*0.45,r*0.5,-r*0.6,-r*0.4,0,-r*0.7);x.fill();x.strokeStyle='rgba(255,255,255,.8)';x.lineWidth=1.2;x.beginPath();x.moveTo(0,-r*0.4);x.lineTo(0,r*0.4);x.stroke();}),
 snow:(col)=>fx('snow'+col,30,(x,r)=>{glowCircle(x,r,'#e6f6ff',0.8);x.strokeStyle=col;x.lineWidth=2.4;x.lineCap='round';for(let i=0;i<6;i++){x.save();x.rotate(i*TAU/6);x.beginPath();x.moveTo(0,0);x.lineTo(0,-r*0.62);x.moveTo(0,-r*0.35);x.lineTo(-r*0.16,-r*0.5);x.moveTo(0,-r*0.35);x.lineTo(r*0.16,-r*0.5);x.stroke();x.restore();}}),
 feather:(col)=>artFeather()||fx('fea'+col,34,(x,r)=>{glowCircle(x,r,'#fff3c2',0.8);x.fillStyle='#fffdf6';x.beginPath();x.moveTo(0,-r*0.8);x.bezierCurveTo(r*0.45,-r*0.4,r*0.3,r*0.4,0,r*0.75);x.bezierCurveTo(-r*0.3,r*0.4,-r*0.45,-r*0.4,0,-r*0.8);x.fill();x.strokeStyle=col;x.lineWidth=1.5;x.beginPath();x.moveTo(0,-r*0.7);x.lineTo(0,r*0.85);x.stroke();}),
 gear:(col)=>fx('gear'+col,32,(x,r)=>{glowCircle(x,r,'#ffe9a0',0.5);x.fillStyle=col;starPath(x,8,r*0.62,r*0.5);x.fill();x.fillStyle='#e8c35a';x.beginPath();x.arc(0,0,r*0.26,0,TAU);x.fill();}),
 ring:(col)=>fx('ring'+col,64,(x,r)=>{x.strokeStyle=rgba(col,0.9);x.lineWidth=3;x.beginPath();x.arc(0,0,r*0.8,0,TAU);x.stroke();}),
 glow:(col)=>fx('glow'+col,64,(x,r)=>glowCircle(x,r,col,0.6)),
 crown:()=>fx('crown',30,(x,r)=>{x.fillStyle='#f2c94c';x.strokeStyle='#a0761c';x.lineWidth=1.5;x.beginPath();x.moveTo(-r*0.7,r*0.35);x.lineTo(-r*0.7,-r*0.2);x.lineTo(-r*0.35,r*0.05);x.lineTo(0,-r*0.5);x.lineTo(r*0.35,r*0.05);x.lineTo(r*0.7,-r*0.2);x.lineTo(r*0.7,r*0.35);x.closePath();x.fill();x.stroke();x.fillStyle='#e0526e';x.beginPath();x.arc(0,r*0.12,r*0.12,0,TAU);x.fill();}),
 ebul:(col)=>fx('ebul'+col,30,(x,r)=>{glowCircle(x,r,col,0.55);x.fillStyle='#fff';x.beginPath();x.arc(0,0,r*0.42,0,TAU);x.fill();x.strokeStyle=col;x.lineWidth=4;x.stroke();}),
};
function drawFx(c,x,y,rot,alpha,s){s=s||1;ctx.save();ctx.translate(x,y);if(rot)ctx.rotate(rot);ctx.globalAlpha=alpha;ctx.drawImage(c,-c.cw/2*s,-c.ch/2*s,c.cw*s,c.ch*s);ctx.restore();}
function shotSprite(c){switch(c.shot){case'rose':return FX.rose(c.col);case'star':return FX.star(c.col);case'pearl':return FX.pearl(c.col);case'dot':return FX.dotshot(c.col);
  case'crystal':return FX.crystal(c.col);case'petal':return FX.petal(c.col);case'snow':return FX.snow(c.col);case'tear':return FX.tear(c.col);case'gfeather':return FX.feather(c.col);default:return FX.feather('#d4a531');}}

/* ============ themes & procedural scenery ============ */
const TH={
 meadow:{grass:'#b5cf86',stroke:'#6f9a52',deco:['flowerPink','flowerWhite','flowerYellow','grass','grass','clover'],obst:['tree','tree','bush','rock'],obstN:12,edge:'hedge'},
 gearwood:{grass:'#a9c47c',stroke:'#5e8a45',deco:['grass','grass','mushroom','fern','flowerWhite','flowerPink'],obst:['tree','tree','gear','bush'],obstN:16,edge:'hedge'},
 beach:{dots:'#c9b083',deco:['shell','starfish','pebble','pebble','sand','flowerPink'],obst:['rock','palm','rock'],obstN:10,edge:'hedge'},
 moon:{grass:'#8e98b4',stroke:'#5d6888',deco:['glow','grassN','firefly','flowerN','flowerN','flowerWhite'],obst:['treeN','lantern','bushN'],obstN:13,edge:'hedgeN',dark:1,stars:1},
 castle:{grass:'#b3cd84',stroke:'#6f9a52',deco:['petals','roseS','flowerWhite','grass'],obst:['roseBush','bush','tree','roseBush'],obstN:11,edge:'hedge',fountain:1},
 brook:{grass:'#b8cf8c',stroke:'#6f9a52',deco:['flowerPink','flowerWhite','flowerYellow','grass','pebble'],obst:['rock','bush','tree','roseBush'],obstN:12,edge:'hedge'},
 glowwood:{grass:'#a9bf7c',stroke:'#5e7f45',deco:['mushroom','firefly','fern','grass','flowerWhite'],obst:['tree','shroom','rock','shroom'],obstN:15,edge:'hedge'},
 lake:{tiles:1,deco:['petalsL','petals','roseS'],obst:['pillar','roseBush','urn','bush'],obstN:10,edge:'planter'},
 sky:{tiles:1,deco:['petalsL','petals','sparkle'],obst:['pillar','urn','roseBush'],obstN:9,edge:'planter'},
 crystal:{tiles:1,deco:['petals','sparkle','petalsL'],obst:['pillar','crystalO','pillar','urn'],obstN:9,edge:'planter'},
};
const THEMES={};for(const k in TH)THEMES[k]=Object.assign({ground:ATLAS.bgs[k].pal},TH[k]);
const THEME_ORDER=BG_ORDER;
const THEME_NAME={};for(const k in TH)THEME_NAME[k]=ATLAS.bgs[k].name;
const themeCache=new Map();
function tcache(key,fn){let c=themeCache.get(key);if(!c){c=fn();themeCache.set(key,c);}return c;}
function wcBlob(x,cx,cy,r,col,a){const g=x.createRadialGradient(cx,cy,0,cx,cy,r);g.addColorStop(0,rgba(col,a));g.addColorStop(0.65,rgba(col,a*0.55));g.addColorStop(1,rgba(col,0));x.fillStyle=g;x.beginPath();x.arc(cx,cy,r,0,TAU);x.fill();}
const TILE=384;
function groundTile(tid){const ga=ATLAS.ground&&ATLAS.ground[tid],art=ga&&imgOf(ga.tile);
  if(art)return tcache('groundA'+tid,()=>{const th=THEMES[tid],r=mulberry(tid.length*977+5);return mk(TILE,TILE,(x,T)=>{x.drawImage(art,0,0,T,T);
    if(th.tiles){x.strokeStyle='rgba(150,125,95,.10)';x.lineWidth=1.2;for(let k=0;k<=T;k+=96){x.beginPath();x.moveTo(0,k);x.lineTo(T,k);x.stroke();x.beginPath();x.moveTo(k,0);x.lineTo(k,T);x.stroke();}}
    if(th.stars){for(let i=0;i<40;i++){x.fillStyle=`rgba(255,250,210,${0.12+r()*0.3})`;x.beginPath();x.arc(r()*T,r()*T,0.8+r()*1.2,0,TAU);x.fill();}}});});
  return tcache('ground'+tid,()=>{const th=THEMES[tid],r=mulberry(tid.length*977+5);
  return mk(TILE,TILE,(x,T)=>{x.fillStyle=th.ground[0];x.fillRect(0,0,T,T);
    if(th.tiles){for(let row=0;row<8;row++){const off=row%2?32:0;for(let c=-1;c<7;c++){const sx=c*64+off,sy=row*48;
        x.globalAlpha=0.45;x.fillStyle=th.ground[1+((r()*3)|0)];x.beginPath();x.roundRect?x.roundRect(sx+2,sy+2,60,44,8):x.rect(sx+2,sy+2,60,44);x.fill();x.globalAlpha=1;
        wcBlob(x,sx+20+r()*24,sy+14+r()*16,22,'#ffffff',0.25);}}
      x.strokeStyle='rgba(150,125,95,.16)';x.lineWidth=1.5;for(let row=0;row<=8;row++){x.beginPath();x.moveTo(0,row*48);x.lineTo(T,row*48);x.stroke();}}
    if(th.grass){for(let i=0;i<26;i++){const cx=r()*T,cy=r()*T,rad=40+r()*120;for(const ox of[-T,0,T])for(const oy of[-T,0,T]){const X=cx+ox,Y=cy+oy;if(X+rad>0&&X-rad<T&&Y+rad>0&&Y-rad<T)wcBlob(x,X,Y,rad,th.grass,0.5);}}}
    for(let i=0;i<70;i++){const cx=r()*T,cy=r()*T,rad=30+r()*110,col=th.ground[1+((r()*3)|0)];
      for(const ox of[-T,0,T])for(const oy of[-T,0,T]){const X=cx+ox,Y=cy+oy;if(X+rad>0&&X-rad<T&&Y+rad>0&&Y-rad<T)wcBlob(x,X,Y,rad,col,th.tiles?0.18:0.33);}}
    if(th.stroke){x.strokeStyle=rgba(th.stroke,0.32);x.lineWidth=1.2;x.lineCap='round';for(let i=0;i<240;i++){const gx=8+r()*(T-16),gy=10+r()*(T-18),h=4+r()*7,l=(r()-.5)*5;x.beginPath();x.moveTo(gx,gy);x.quadraticCurveTo(gx+l*.4,gy-h*.6,gx+l,gy-h);x.stroke();}}
    if(th.dots){x.fillStyle=rgba(th.dots,0.5);for(let i=0;i<400;i++){x.beginPath();x.arc(r()*T,r()*T,0.6+r()*1.2,0,TAU);x.fill();}}
    if(th.stars){for(let i=0;i<60;i++){x.fillStyle=`rgba(255,250,210,${0.15+r()*0.35})`;x.beginPath();x.arc(r()*T,r()*T,0.8+r()*1.3,0,TAU);x.fill();}}
  });});}
function flower(x,n,pr,col,center,ox,oy,rot){x.save();x.translate(ox,oy);x.rotate(rot||0);x.fillStyle=col;x.strokeStyle='rgba(120,70,60,.35)';x.lineWidth=0.8;
  for(let i=0;i<n;i++){x.save();x.rotate(i*TAU/n);x.beginPath();x.ellipse(0,-pr*0.62,pr*0.42,pr*0.62,0,0,TAU);x.fill();x.stroke();x.restore();}
  x.fillStyle=center;x.beginPath();x.arc(0,0,pr*0.32,0,TAU);x.fill();x.restore();}
function decoSprite(k){return tcache('deco'+k,()=>{switch(k){
  case'flowerPink':return mk(34,34,x=>{flower(x,5,9,'#f4adc0','#f6d36b',12,14,0.3);flower(x,5,7,'#f7c2d0','#f6d36b',24,22,1);});
  case'flowerWhite':return mk(34,34,x=>{flower(x,8,8,'#fffdf6','#f2c14e',14,16,0);flower(x,8,6,'#fffaf0','#f2c14e',25,24,.4);});
  case'flowerYellow':return mk(30,30,x=>{flower(x,5,8,'#f6d870','#e39b35',15,15,0.2);});
  case'grass':return mk(30,24,x=>{x.strokeStyle='#5f8f45';x.lineWidth=2;x.lineCap='round';[[-6,-2],[-2,-1],[3,1],[7,3]].forEach(([d,l])=>{x.beginPath();x.moveTo(15+d,22);x.quadraticCurveTo(15+d+l,12,15+d+l*2.5,4+Math.abs(d));x.stroke();});});
  case'clover':return mk(30,26,x=>{x.fillStyle='#78a85c';for(let i=0;i<3;i++){x.save();x.translate(15,14);x.rotate(i*TAU/3);x.beginPath();x.arc(0,-6,5.5,0,TAU);x.fill();x.restore();}x.strokeStyle='#5e8a45';x.beginPath();x.moveTo(15,14);x.lineTo(18,24);x.stroke();});
  case'mushroom':return mk(30,30,x=>{x.fillStyle='#f3ead6';x.fillRect(12,14,6,12);x.fillStyle='#d9534f';x.beginPath();x.ellipse(15,14,11,8,0,Math.PI,TAU);x.fill();x.fillStyle='#fff';[[10,10],[17,8],[21,12]].forEach(p=>{x.beginPath();x.arc(p[0],p[1],1.8,0,TAU);x.fill();});});
  case'fern':return mk(34,30,x=>{x.strokeStyle='#4f7f3a';x.lineWidth=1.6;x.beginPath();x.moveTo(6,26);x.quadraticCurveTo(16,8,30,6);x.stroke();for(let i=1;i<7;i++){const t=i/7,px=6+24*t,py=26-20*t;x.beginPath();x.moveTo(px,py);x.lineTo(px-3,py-6);x.moveTo(px,py);x.lineTo(px+4,py+3);x.stroke();}});
  case'shell':return mk(28,26,x=>{x.fillStyle='#f6c9b0';x.beginPath();x.moveTo(14,22);x.arc(14,14,10,Math.PI*1.1,Math.PI*1.9);x.closePath();x.fill();x.strokeStyle='#d99a80';x.lineWidth=1;for(let i=-2;i<=2;i++){x.beginPath();x.moveTo(14,22);x.lineTo(14+i*4.5,6);x.stroke();}});
  case'starfish':return mk(28,28,x=>{x.translate(14,14);x.fillStyle='#ee9a6a';starPath(x,5,11,5);x.fill();x.fillStyle='rgba(255,240,220,.7)';for(let i=0;i<5;i++){const a=-Math.PI/2+i*TAU/5;x.beginPath();x.arc(Math.cos(a)*5,Math.sin(a)*5,1.2,0,TAU);x.fill();}});
  case'pebble':return mk(26,18,x=>{x.fillStyle='#c8bba3';x.beginPath();x.ellipse(10,10,7,5,0.3,0,TAU);x.fill();x.fillStyle='#d8cdb8';x.beginPath();x.ellipse(19,11,5,3.5,-0.2,0,TAU);x.fill();});
  case'sand':return mk(40,18,x=>{x.strokeStyle='rgba(190,160,110,.5)';x.lineWidth=1.4;x.beginPath();x.arc(20,22,16,Math.PI*1.2,Math.PI*1.8);x.stroke();x.beginPath();x.arc(20,28,16,Math.PI*1.25,Math.PI*1.75);x.stroke();});
  case'glow':return mk(36,36,x=>{wcBlob(x,18,18,17,'#cdb8ff',0.45);flower(x,5,7,'#e9dcff','#fff6b0',18,18,0);});
  case'grassN':return mk(30,24,x=>{x.strokeStyle='#33405c';x.lineWidth=2;x.lineCap='round';[[-6,-2],[-2,-1],[3,1],[7,3]].forEach(([d,l])=>{x.beginPath();x.moveTo(15+d,22);x.quadraticCurveTo(15+d+l,12,15+d+l*2.5,4+Math.abs(d));x.stroke();});});
  case'firefly':return mk(24,24,x=>{wcBlob(x,12,12,11,'#fff2a0',0.7);x.fillStyle='#fffbe0';x.beginPath();x.arc(12,12,2,0,TAU);x.fill();});
  case'flowerN':return mk(32,32,x=>{flower(x,6,8,'#bcd3f7','#fff3b0',16,16,0.2);});
  case'petals':return mk(36,30,x=>{x.fillStyle='rgba(240,150,170,.75)';[[8,10,.4],[20,8,1.4],[27,20,2.2],[13,22,.9]].forEach(([a,b,c])=>{x.save();x.translate(a,b);x.rotate(c);x.beginPath();x.ellipse(0,0,4,2.4,0,0,TAU);x.fill();x.restore();});});
  case'petalsL':return mk(36,30,x=>{x.fillStyle='rgba(176,150,220,.75)';[[8,10,.4],[20,8,1.4],[27,20,2.2],[13,22,.9]].forEach(([a,b,c])=>{x.save();x.translate(a,b);x.rotate(c);x.beginPath();x.ellipse(0,0,4,2.4,0,0,TAU);x.fill();x.restore();});});
  case'sparkle':return mk(26,26,x=>{x.translate(13,13);wcBlob(x,0,0,12,'#fff6d0',0.6);x.fillStyle='#f2d27a';starPath(x,4,9,2);x.fill();});
  case'roseS':return mk(30,28,x=>{x.fillStyle='#5f8f45';x.beginPath();x.ellipse(9,18,6,3,-.5,0,TAU);x.fill();x.beginPath();x.ellipse(21,18,6,3,.5,0,TAU);x.fill();x.fillStyle='#c94a63';x.beginPath();x.arc(15,13,6.5,0,TAU);x.fill();x.strokeStyle='rgba(255,220,230,.8)';x.lineWidth=1.2;x.beginPath();x.arc(15,13,3,0,4.5);x.stroke();});
  default:return mk(8,8,()=>{});}});}
// obstacles: canvas anchored bottom-centre; r=collision radius; cy=collision centre offset
function softBlob(x,cx,cy,rad,col,a){const g=x.createRadialGradient(cx,cy,0,cx,cy,rad);g.addColorStop(0,rgba(col,a));g.addColorStop(0.72,rgba(col,a*0.92));g.addColorStop(1,rgba(col,0));x.fillStyle=g;x.beginPath();x.arc(cx,cy,rad,0,TAU);x.fill();}
function wcFoliage(x,cx,cy,rx,ry,pal,r,n,bl){
  for(let i=0;i<n;i++){const a=r()*TAU,d=Math.sqrt(r()),br=(rx+ry)/2*(0.34+r()*0.2);softBlob(x,cx+Math.cos(a)*rx*d*0.72+br*0.18,cy+Math.sin(a)*ry*d*0.72+br*0.22,br,pal[0],0.9);}
  for(let i=0;i<n;i++){const a=r()*TAU,d=Math.sqrt(r()),br=(rx+ry)/2*(0.3+r()*0.18);softBlob(x,cx+Math.cos(a)*rx*d*0.66-br*0.08,cy+Math.sin(a)*ry*d*0.62-br*0.12,br,pal[1],0.82);}
  for(let i=0;i<Math.round(n*0.7);i++){const a=Math.PI*1.05+r()*Math.PI*0.9,d=Math.sqrt(r())*0.8,br=(rx+ry)/2*(0.18+r()*0.14);softBlob(x,cx+Math.cos(a)*rx*d*0.6,cy+Math.sin(a)*ry*d*0.6,br,pal[2],0.6);}
  for(let i=0;i<Math.round(n*0.5);i++){const a=Math.PI*1.1+r()*Math.PI*0.7,d=r()*0.75,br=(rx+ry)/2*(0.07+r()*0.07);softBlob(x,cx+Math.cos(a)*rx*d*0.6,cy+Math.sin(a)*ry*d*0.6,br,pal[3],0.5);}
  x.strokeStyle=rgba(pal[0],0.28);x.lineWidth=1.3;for(let i=0;i<Math.round(n*0.6);i++){const a=r()*TAU,d=0.55+r()*0.4,br=(rx+ry)/2*(0.16+r()*0.14);x.beginPath();x.arc(cx+Math.cos(a)*rx*d*0.75,cy+Math.sin(a)*ry*d*0.75,br,a-1.2,a+1.2);x.stroke();}
  if(bl){for(let i=0;i<bl.n;i++){const a=r()*TAU,d=Math.sqrt(r())*0.85;flower(x,5,3+r()*2.2,bl.c[(r()*bl.c.length)|0],'#f6d36b',cx+Math.cos(a)*rx*d*0.8,cy+Math.sin(a)*ry*d*0.8,r()*3);}}}
function wcTrunk(x,w,h,top,c1,c2){const g=x.createLinearGradient(w/2-12,0,w/2+12,0);g.addColorStop(0,c1);g.addColorStop(1,c2);x.fillStyle=g;x.beginPath();
  x.moveTo(w/2-15,h);x.quadraticCurveTo(w/2-8,h-6,w/2-8,h-24);x.quadraticCurveTo(w/2-10,top+20,w/2-6,top);x.lineTo(w/2+7,top);x.quadraticCurveTo(w/2+10,top+20,w/2+9,h-24);x.quadraticCurveTo(w/2+9,h-6,w/2+16,h);x.closePath();x.fill();
  x.strokeStyle='rgba(60,40,25,.35)';x.lineWidth=1.2;x.stroke();x.strokeStyle='rgba(60,40,25,.25)';for(let i=0;i<4;i++){x.beginPath();x.moveTo(w/2-4+i*3,h-6-i*9);x.quadraticCurveTo(w/2-2+i*2,h-30-i*9,w/2+i*2-3,h-46-i*8);x.stroke();}}
const OBST={
 tree:{w:140,h:176,r:22,tall:1,draw:(x,w,h,r)=>{softBlob(x,w/2,h-4,34,'#5a4a30',0.18);wcTrunk(x,w,h,h-80,'#b08a62','#6e4d33');
   wcFoliage(x,w/2,70,58,50,['#4c7a3a','#6e9d50','#a2c873','#eef6c0'],r,16,r()<0.55?{n:14,c:['#fffdf6','#ffe6ee','#fff6d8']}:null);}},

 treeN:{w:140,h:176,r:22,tall:1,draw:(x,w,h,r)=>{softBlob(x,w/2,h-4,34,'#1e2438',0.25);wcTrunk(x,w,h,h-80,'#6d5a63','#3e3240');
   wcFoliage(x,w/2,70,58,50,['#22344d','#33506a','#55759a','#c9d8f5'],r,16,{n:12,c:['#f6c9da','#fffaf0','#e9dcff']});
   for(let i=0;i<8;i++)softBlob(x,w/2-45+r()*90,40+r()*60,4,'#fff3a0',0.9);}},

 bush:{w:80,h:60,r:20,draw:(x,w,h,r)=>{softBlob(x,w/2,h-6,30,'#5a4a30',0.15);wcFoliage(x,w/2,h-28,32,22,['#4c7a3a','#6e9d50','#a2c873','#eef6c0'],r,10,{n:6,c:['#f7c2d0','#fffaf0','#f6d870']});}},

 bushN:{w:80,h:60,r:20,draw:(x,w,h,r)=>{softBlob(x,w/2,h-6,30,'#1e2438',0.2);wcFoliage(x,w/2,h-28,32,22,['#22344d','#33506a','#55759a','#c9d8f5'],r,10,{n:6,c:['#e9dcff','#bcd3f7','#fffaf0']});}},

 gear:{w:78,h:76,r:24,draw:(x,w,h)=>{x.fillStyle='#8a6142';x.fillRect(w/2-24,h-40,48,38);x.fillStyle='#a77a55';x.beginPath();x.ellipse(w/2,h-40,24,9,0,0,TAU);x.fill();
   x.save();x.translate(w/2,h-48);x.fillStyle='#c9a24a';starPath(x,10,22,17);x.fill();x.fillStyle='#e9cf7a';x.beginPath();x.arc(0,0,11,0,TAU);x.fill();x.fillStyle='#8a6a2a';x.beginPath();x.arc(0,0,4,0,TAU);x.fill();x.restore();}},
 rock:{w:86,h:62,r:26,draw:(x,w,h,r)=>{softBlob(x,w/2,h-6,36,'#5a4a30',0.16);const g=x.createLinearGradient(0,10,0,h);g.addColorStop(0,'#dcd4c5');g.addColorStop(1,'#998e7f');x.fillStyle=g;
   const rp=()=>{x.beginPath();x.moveTo(8,h-6);x.quadraticCurveTo(2,30,24,16);x.quadraticCurveTo(44,4,64,14);x.quadraticCurveTo(84,26,78,h-6);x.quadraticCurveTo(44,h+2,8,h-6);x.closePath();};rp();x.fill();
   x.save();rp();x.clip();softBlob(x,30,22,26,'#ffffff',0.45);softBlob(x,62,h-10,30,'#6e6458',0.35);softBlob(x,36,14,20,'#8fb36a',0.75);softBlob(x,52,12,14,'#a9c97e',0.7);x.restore();
   rp();x.strokeStyle='rgba(80,70,60,.4)';x.lineWidth=1.4;x.stroke();x.strokeStyle='rgba(80,70,60,.25)';x.beginPath();x.moveTo(40,30);x.quadraticCurveTo(46,40,42,50);x.stroke();}},

 palm:{w:124,h:176,r:16,tall:1,draw:(x,w,h)=>{x.strokeStyle='#a07a52';x.lineWidth=12;x.lineCap='round';x.beginPath();x.moveTo(w/2,h-2);x.quadraticCurveTo(w/2+18,h-80,w/2+4,58);x.stroke();
   x.strokeStyle='#8a6440';x.lineWidth=2;for(let i=0;i<9;i++){const t=i/9,yy=h-2-(h-60)*t;x.beginPath();x.moveTo(w/2-6+18*Math.sin(t*2.6),yy);x.lineTo(w/2+6+18*Math.sin(t*2.6),yy-3);x.stroke();}
   const g=['#5f9447','#74a957'];for(let i=0;i<7;i++){const a=Math.PI+i*Math.PI/6;x.strokeStyle=g[i%2];x.lineWidth=9;x.beginPath();x.moveTo(w/2+4,58);x.quadraticCurveTo(w/2+4+Math.cos(a)*40,58+Math.sin(a)*40-14,w/2+4+Math.cos(a)*58,58+Math.sin(a)*30+16);x.stroke();}}},
 lantern:{w:40,h:96,r:10,glow:1,draw:(x,w,h)=>{x.fillStyle='#3d3a46';x.fillRect(w/2-3,30,6,h-30);x.fillRect(w/2-10,h-6,20,6);x.fillStyle='#ffe7a0';x.fillRect(w/2-9,14,18,20);x.strokeStyle='#3d3a46';x.lineWidth=3;x.strokeRect(w/2-9,14,18,20);x.fillStyle='#3d3a46';x.beginPath();x.moveTo(w/2-13,14);x.lineTo(w/2,4);x.lineTo(w/2+13,14);x.fill();}},
 pillar:{w:52,h:124,r:20,tall:1,draw:(x,w,h)=>{const g=x.createLinearGradient(8,0,w-8,0);g.addColorStop(0,'#cfc3b0');g.addColorStop(0.4,'#f2ebe0');g.addColorStop(1,'#bfb29c');x.fillStyle=g;x.fillRect(10,22,w-20,h-34);x.fillStyle='#e2d8c8';x.fillRect(4,10,w-8,14);x.fillRect(4,h-14,w-8,14);
   x.strokeStyle='rgba(120,100,80,.3)';x.lineWidth=1.5;for(let i=1;i<4;i++){x.beginPath();x.moveTo(10+i*(w-20)/4,24);x.lineTo(10+i*(w-20)/4,h-14);x.stroke();}flower(x,5,5,'#e8879c','#f6d36b',w/2+8,14,0);}},
 roseBush:{w:84,h:66,r:22,draw:(x,w,h,r)=>{softBlob(x,w/2,h-6,32,'#5a4a30',0.15);wcFoliage(x,w/2,h-30,34,24,['#3f7032','#5b8f45','#8fbb66','#e4f0b8'],r,11,null);
   [[24,30,'#c94a63'],[44,22,'#e8879c'],[60,34,'#c94a63'],[36,40,'#f2b3c2'],[54,44,'#e8879c']].forEach(([a,b,c])=>{softBlob(x,a,b,9,c,0.95);x.strokeStyle='rgba(255,230,235,.85)';x.lineWidth=1.2;x.beginPath();x.arc(a,b,4,0,4.6);x.stroke();x.beginPath();x.arc(a,b,6.5,1,5.2);x.stroke();});}},

 shroom:{w:84,h:100,r:18,glow:1,draw:(x,w,h)=>{x.fillStyle='#f6ead6';x.beginPath();x.moveTo(w/2-10,h);x.quadraticCurveTo(w/2-14,h-30,w/2-8,h-50);x.lineTo(w/2+8,h-50);x.quadraticCurveTo(w/2+14,h-30,w/2+10,h);x.fill();
   wcBlob(x,w/2,h-62,40,'#fff2c0',0.6);const g=x.createLinearGradient(0,14,0,h-50);g.addColorStop(0,'#d9b8ef');g.addColorStop(1,'#f3e3fb');x.fillStyle=g;x.beginPath();x.ellipse(w/2,h-52,38,26,0,Math.PI,TAU);x.fill();
   x.fillStyle='rgba(255,255,255,.85)';[[-18,-62],[2,-70],[18,-60],[-4,-58]].forEach(p=>{x.beginPath();x.arc(w/2+p[0],h+p[1],3,0,TAU);x.fill();});x.strokeStyle='rgba(120,90,140,.35)';x.lineWidth=1.5;x.beginPath();x.ellipse(w/2,h-52,38,26,0,Math.PI,TAU);x.stroke();}},
 crystalO:{w:70,h:104,r:18,tall:1,glow:1,draw:(x,w,h)=>{wcBlob(x,w/2,h-40,34,'#d8ecff',0.7);[[-14,-8,13,46],[12,-4,11,38],[0,-2,15,64]].forEach(([dx,dy,cw,ch])=>{const cx=w/2+dx,by=h-6+dy,g=x.createLinearGradient(cx-cw,0,cx+cw,0);
   g.addColorStop(0,'#bcd9f7');g.addColorStop(0.5,'#f4faff');g.addColorStop(1,'#a9c4ef');x.fillStyle=g;x.beginPath();x.moveTo(cx,by-ch);x.lineTo(cx+cw,by-ch*0.72);x.lineTo(cx+cw*0.8,by);x.lineTo(cx-cw*0.8,by);x.lineTo(cx-cw,by-ch*0.72);x.closePath();x.fill();x.strokeStyle='rgba(255,255,255,.9)';x.lineWidth=1.2;x.stroke();});
   x.fillStyle='#e8dcc6';x.fillRect(w/2-24,h-8,48,8);}},
 urn:{w:70,h:92,r:20,draw:(x,w,h)=>{x.fillStyle='#ece3d4';x.fillRect(w/2-20,h-30,40,30);x.fillStyle='#d9a93e';x.fillRect(w/2-22,h-32,44,4);x.fillRect(w/2-22,h-4,44,4);
   x.fillStyle='#f3ece0';x.beginPath();x.moveTo(w/2-24,h-58);x.quadraticCurveTo(w/2-22,h-34,w/2-8,h-32);x.lineTo(w/2+8,h-32);x.quadraticCurveTo(w/2+22,h-34,w/2+24,h-58);x.closePath();x.fill();x.strokeStyle='#d9a93e';x.lineWidth=2;x.stroke();
   [[w/2-14,h-64,'#f2a7bd'],[w/2+2,h-70,'#fffaf0'],[w/2+14,h-62,'#c6a8ec'],[w/2-4,h-60,'#f6c1cc']].forEach(([a,b,c])=>{x.fillStyle='#6f9a52';x.beginPath();x.ellipse(a,b+6,8,4,0.3,0,TAU);x.fill();flower(x,6,7,c,'#f6d36b',a,b,0);});}},
 fountain:{w:200,h:150,r:78,cy:-44,draw:(x,w,h)=>{x.fillStyle='#d6cab6';x.beginPath();x.ellipse(w/2,h-44,96,42,0,0,TAU);x.fill();x.fillStyle='#e9e1d3';x.beginPath();x.ellipse(w/2,h-50,92,38,0,0,TAU);x.fill();
   const g=x.createRadialGradient(w/2-20,h-56,4,w/2,h-50,80);g.addColorStop(0,'#d8f0ff');g.addColorStop(1,'#8fc1e0');x.fillStyle=g;x.beginPath();x.ellipse(w/2,h-50,80,30,0,0,TAU);x.fill();
   x.fillStyle='#e9e1d3';x.fillRect(w/2-8,30,16,h-80);x.beginPath();x.ellipse(w/2,34,30,10,0,0,TAU);x.fill();wcBlob(x,w/2,22,22,'#cfeaff',0.8);x.fillStyle='#ffffff';x.fillRect(w/2-2,4,4,26);}},
};
function obstSprite(k,v){return tcache('ob'+k+v,()=>{const o=OBST[k],r=mulberry(v*131+k.length);return mk(o.w,o.h,(x,w,h)=>o.draw(x,w,h,r));});}
function planterSprite(){return tcache('planter',()=>mk(70,60,x=>{x.fillStyle='#eee6d8';x.fillRect(10,30,50,26);x.fillStyle='#d9a93e';x.fillRect(8,28,54,4);x.fillRect(8,54,54,3);
  const g=['#6f9a52','#7fab5e'];[[20,26,12],[35,22,14],[50,26,12]].forEach((c,i)=>{x.fillStyle=g[i%2];x.beginPath();x.arc(c[0],c[1],c[2],0,TAU);x.fill();});
  [[18,22,'#f2a7bd'],[34,16,'#fffaf0'],[50,22,'#c6a8ec'],[28,26,'#f6c1cc'],[42,26,'#fffaf0']].forEach(([a,b,c])=>flower(x,5,6,c,'#f6d36b',a,b,0));}));}
function hedgeSprite(dark){return tcache('hedgeW'+dark,()=>mk(70,60,x=>{const r=mulberry(7+dark);wcFoliage(x,35,32,30,22,dark?['#22344d','#33506a','#55759a','#c9d8f5']:['#4c7a3a','#6e9d50','#a2c873','#eef6c0'],r,9,{n:3,c:dark?['#e9dcff','#fffaf0']:['#f7c2d0','#fffaf0']});return;const g=dark?['#2f475e','#3a556e','#45607a']:['#5b8d43','#6b9d50','#7aab5d'];[[16,34,18],[35,26,22],[54,34,18],[35,44,20]].forEach((c,i)=>{x.fillStyle=g[i%3];x.beginPath();x.arc(c[0],c[1],c[2],0,TAU);x.fill();});
  if(!dark){flower(x,5,4,'#f7c2d0','#f6d36b',22,22,0);}else{wcBlob(x,46,26,8,'#e9dcff',0.8);}}));}

