const ASSETS=window.__ASSETS||{};
const BASE='assets/';
const DEBUG=/[?&]debug=1/.test(location.search);

/* ============ utilities ============ */
const clamp=(v,a,b)=>v<a?a:v>b?b:v, lerp=(a,b,t)=>a+(b-a)*t, hyp=Math.hypot, TAU=Math.PI*2;
function mulberry(seed){return function(){seed|=0;seed=seed+0x6D2B79F5|0;let t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
let R=Math.random;
const rr=(a,b)=>a+(b-a)*R(), pick=a=>a[(R()*a.length)|0];
const $=id=>document.getElementById(id);
function rgba(hex,a){const n=parseInt(hex.slice(1),16);return`rgba(${n>>16&255},${n>>8&255},${n&255},${a})`;}
const ease=t=>t<.5?2*t*t:1-Math.pow(-2*t+2,2)/2;

/* ============ save ============ */
const DEFAULT_SPEED={min:70,max:340,drag:110,curve:1.5,decel:0.45};
const SAVE_KEY='yasuko-adventure-save-v7';
const COSTUME_ALIASES={"v8331_star_beaded_sheer":"v8331_star_jewel_veil","v8331_star_lace_body":"v8331_star_halter"};
function canonicalCostumeId(id){return Object.prototype.hasOwnProperty.call(COSTUME_ALIASES,id)?COSTUME_ALIASES[id]:id;}
let save={costume:'basic',difficulty:'normal',speed:{...DEFAULT_SPEED},cleared:{},allStages:false,sleepOn:true,meter:false,hintSeen:false,guardMode:'auto',baseArt:'B',tutDone:false,storySeen:{},storyAlways:false,stars:{},posterSeen:false,best:{},bestUp:0,stamps:[],ribbon:'red',ribbons:['red'],giftBonus:0,bgmVol:1,seVol:2,owned:[],baseNUnlocked:false,titleZoom:1,titlePanX:0,titlePanY:0};
function loadSave(){try{const s=JSON.parse(localStorage.getItem(SAVE_KEY)||'null');if(s){save=Object.assign(save,s);save.speed=Object.assign({...DEFAULT_SPEED},s.speed||{});}}catch(e){}
  save.costume=canonicalCostumeId(save.costume);
  if(Array.isArray(save.owned))save.owned=[...new Set(save.owned.map(canonicalCostumeId))];
  if(!save.storySeen||typeof save.storySeen!=='object')save.storySeen={};
  if(!save.stars||typeof save.stars!=='object')save.stars={};
  if(!save.best||typeof save.best!=='object')save.best={};if(!Array.isArray(save.stamps))save.stamps=[];if(!Array.isArray(save.ribbons)||!save.ribbons.length)save.ribbons=['red'];if(!save.ribbons.includes(save.ribbon))save.ribbon='red';
  if(!save.v82){save.v82=1;if(save.cleared&&save.cleared[10])save.giftBonus=1;}
  if(save.baseArt==='N'||save.baseArt==='P')save.baseNUnlocked=true;/* 旧版で選択済みの隠し素体は維持 */
  if(MOVED_BASE_IDS.includes(save.costume)){save.pendingBaseArt=save.costume;save.costume=save.baseNUnlocked?'base':'basic';}
  if(save.baseNUnlocked&&MOVED_BASE_IDS.includes(save.pendingBaseArt)){save.baseArt=save.pendingBaseArt;delete save.pendingBaseArt;}
  if(!save.baseNUnlocked&&MOVED_BASE_IDS.includes(save.baseArt)){save.pendingBaseArt=save.baseArt;save.baseArt='B';}
  if(!ATLAS.yasuko.bases[save.baseArt])save.baseArt='B';if(!['auto','3','5'].includes(save.guardMode))save.guardMode='auto';
  if(!save.cleared||typeof save.cleared!=='object')save.cleared={};
  try{migrateV83();syncOwned();}catch(e){console.error(e);}
  if(save.costume!=='base'){if(!ATLAS.yasuko.costumes[save.costume])save.costume='basic';
  try{if(!cosOpen(CMAP[save.costume]))save.costume='basic';}catch(e){save.costume='basic';}}
  else if(!save.baseNUnlocked)save.costume='basic';/* v8.3.16: 素体は ふたつめの ひみつ の中 */
  save.titleZoom=1;save.titlePanX=0;save.titlePanY=0;/* v8.3.17: タイトルは いつも 100%（拡大なし）で はじまる */
  writeSave();}
function writeSave(){try{localStorage.setItem(SAVE_KEY,JSON.stringify(save));}catch(e){}}

