 fountain:{h:132,r:84,cy:-30,nf:1},fountain_cat:{h:132,r:84,cy:-30,nf:1},fountain_crys:{h:136,r:84,cy:-30,nf:1,glow:['#d8ecff',0.6,2.6]},fountain_shell:{h:128,r:84,cy:-30,nf:1},fountain_moon:{h:132,r:84,cy:-30,nf:1},
};
const FLOOR_W={floor_compass:150,floor_ice:170,floor_magic:175};
const SDECO_H={fl_daisy:32,fl_pink:30,fl_lily:34,grass:26,grass2:24,fl_a71:26,fl_a73:26,fl_a72:24,fl_a69:30,fl_a57:22,fl_a55:20,rock_s:28,shroom_r:32,shroom_b:30,lavender:40,shard:24,cloud_s:28};
const OBJSET={
 meadow:{obst:['tree_g','tree_g','tree_sakura','bush_rose','bush_white','bush_yellow','bush_green','rock','rock_moss','signpost','stump','lamp_round'],n:13,deco:['fl_daisy','fl_pink','fl_a71','fl_a73','grass','grass2','fl_lily','fl_a69'],edge:['hedge_flower','bush_green']},
 gearwood:{obst:['tree_g','tree_autumn','tree_g','gear','stump','log','shroom_r','crates','barrel','lamp_banner','signpost','bush_orange'],n:14,deco:['shroom_r','fl_a72','grass','grass2','fl_daisy','rock_s'],edge:['hedge_flower','bush_green']},
 beach:{obst:['palm','palm','palm','parasol','tea','rock','rock_moss','bush_hydr','barrel','lamp_blue'],n:11,center:'fountain_shell',deco:['fl_a71','fl_pink','grass2','rock_s'],edge:['hedge_flower','bush_green']},
 moon:{obst:['tree_wisteria','tree_wisteria','lamp_moon','lamp_wisteria','bush_hydr','bush_rose','bench_iron','urn','ban_moon','lavender'],n:12,center:'gazebo',deco:['fl_a72','fl_lily','lavender','fl_a57','shroom_b'],edge:null},
 castle:{obst:['ban_red','ban_blue','ban_crown','lamp_banner','lamp_blue','bush_rose','tree_sakura','statue_cat','bench_heart','urn','bush_white'],n:13,center:'fountain_cat',floor:['floor_compass'],deco:['fl_daisy','fl_pink','fl_a71','grass2'],edge:['hedge_flower','bush_rose']},
 crystalhall:{obst:['crys_tall','crys_cluster','crys_blue','crys_purple','lamp_crystal','mirror','urn','tree_ice','crys_lamp','bush_hydr'],n:13,center:'fountain_crys',deco:['shard','fl_lily','fl_a72','rock_s'],edge:['urn','crys_purple']},
 clocktower:{obst:['clock_tall','clock','hourglass','gear','books','lamp_banner','crates','barrel','bench_iron','mapboard','gear'],n:14,floor:['floor_compass'],deco:['grass','fl_daisy','rock_s'],edge:['hedge_stone','bush_green']},
 rainbow:{obst:['cloud_pink','cloud_pink','island','lamp_wing','crys_purple','tree_star','urn','rainbow','bush_white'],n:12,floor:['floor_ice'],deco:['cloud_s','fl_a57','shard','fl_a55'],edge:['urn','cloud_pink']},
 altar:{obst:['ball','lamp_crystal','crys_tall','portal','ban_moon','shroom_b','tree_star','crys_cluster','lamp_moon','crys_lamp'],n:13,floor:['floor_magic'],deco:['shroom_b','shard','fl_lily','fl_a72'],edge:['hedge_stone','crys_purple']},
 rink:{obst:['tree_ice','tree_snow','crys_blue','trophy','statue_wing','ban_snow','ban_skate','lamp_blue','crys_tall','tree_snow'],n:13,center:'fountain_crys',floor:['floor_ice','floor_ice'],deco:['shard','fl_a72','fl_a57'],edge:['crys_blue','bush_white']},
 brook:{obst:['tree_g','tree_sakura','bush_rose','rock','rock_moss','lamp_rose','bench_heart','bush_hydr','stump'],n:13,deco:['fl_daisy','fl_pink','fl_a71','grass'],edge:['hedge_flower','bush_green']},
 glowwood:{obst:['tree_star','tree_g','shroom_r','shroom_b','stump','crys_purple','log','lamp_rose'],n:15,deco:['shroom_r','shroom_b','grass','fl_lily'],edge:['hedge_flower','bush_green']},
 lake:{obst:['tree_wisteria','urn','bush_hydr','lamp_wisteria','bench_heart','bush_rose','tree_sakura','lamp_round'],n:12,deco:['fl_pink','fl_a72','fl_lily'],edge:['urn','bush_hydr']},
};
const objImg=()=>ATLAS.objects&&imgOf(ATLAS.objects.file);
function artRect(k){return ATLAS.objects&&ATLAS.objects.items[k]||null;}
function artW(k,h){const it=artRect(k);return it?it[2]*h/it[3]:h;}
function drawArt(k,x,y,h,o){const it=artRect(k),img=objImg();if(!it||!img)return false;const w=it[2]*h/it[3];o=o||{};
  ctx.save();if(o.alpha!=null)ctx.globalAlpha=o.alpha;ctx.translate(x,y);if(o.flip)ctx.scale(-1,1);if(o.sc)ctx.scale(o.sc,o.sc);ctx.drawImage(img,it[0],it[1],it[2],it[3],-w/2,-h,w,h);ctx.restore();return true;}
function artToCanvas(cv,k,pad){const it=artRect(k),img=objImg();if(!cv||!it||!img)return;const x=cv.getContext('2d'),p=pad||4,s=Math.min((cv.width-p*2)/it[2],(cv.height-p*2)/it[3]);
  x.clearRect(0,0,cv.width,cv.height);x.drawImage(img,it[0],it[1],it[2],it[3],(cv.width-it[2]*s)/2,(cv.height-it[3]*s)/2,it[2]*s,it[3]*s);}
function artObj(k,x,y,v){const d=OBJ[k];return{k,art:1,v,x,y,r:d.r,cy:d.cy||0,tall:d.tall,glow:d.glow,h:d.h,w:artW(k,d.h),f:!d.nf&&v%2===1};}

/* ============ world ============ */
let world=null;
function buildWorld(tid,seed,chestN,setName){
  R=mulberry(seed);if(!THEMES[tid])tid='meadow';const W=1300,H=2000,th=THEMES[tid];
  const os=OBJSET[setName||THEME_SET[tid]],art=!!(os&&objImg());
  world={W,H,tid,th,b:{l:60,r:W-60,t:300,b:H-130},deco:[],obst:[],chests:[],start:{x:W/2,y:450},set:art?os:null,floors:[],sdeco:[]};
  const n=Math.round(W*H/(ATLAS.ground&&ATLAS.ground[tid]?15000:6500)*(art?0.5:1));
  world.decals=[];const nd=th.tiles?16:28;for(let i=0;i<nd;i++)world.decals.push({x:rr(world.b.l-10,world.b.r+10),y:rr(world.b.t+30,world.b.b-10),i:(R()*6)|0,s:rr(0.8,1.25),f:R()<0.5});
  for(let i=0;i<n;i++){const y=rr(world.b.t-20,H);world.deco.push({x:rr(0,W),y,k:pick(th.deco),s:rr(0.8,1.3),ph:rr(0,TAU)});}
  world.deco.sort((a,b)=>a.y-b.y);
  let tries=0;
  if(art){
    if(os.center)world.obst.push(artObj(os.center,W/2,H*0.55,0));
    (os.floor||[]).forEach((k,i)=>{let x,y,t=0;do{x=rr(world.b.l+120,world.b.r-120);y=i===0&&!os.center?H*0.55:rr(world.b.t+200,world.b.b-120);}while(t++<40&&world.obst.some(q=>hyp(q.x-x,q.y+q.cy-y)<q.r+90));world.floors.push({k,x,y,w:FLOOR_W[k]||150});});
    const nObs=Math.round(os.n*1.45);
    while(world.obst.length<nObs+(os.center?1:0)&&tries++<4000){const k=pick(os.obst),d=OBJ[k],x=rr(world.b.l+40,world.b.r-40),y=rr(world.b.t+90,world.b.b-40);
      if(hyp(x-world.start.x,y-world.start.y)<230)continue;
      if(world.obst.some(q=>hyp(q.x-x,q.y-y)<(q.r+d.r+84)))continue;
      world.obst.push(artObj(k,x,y,(R()*4)|0));}
    for(let i=0;i<58;i++){const k=pick(os.deco);world.sdeco.push({k,x:rr(world.b.l,world.b.r),y:rr(world.b.t+20,world.b.b),h:(SDECO_H[k]||28)*rr(0.85,1.15),f:R()<0.5});}
    world.sdeco.sort((a,b)=>a.y-b.y);
  }else{
  if(th.fountain)world.obst.push({k:'fountain',v:0,x:W/2,y:H*0.55,...OBST.fountain});
  const oN=Math.round(th.obstN*0.75);
  while(world.obst.length<oN&&tries++<2000){const k=pick(th.obst),o=OBST[k],x=rr(world.b.l+40,world.b.r-40),y=rr(world.b.t+90,world.b.b-40);
    if(hyp(x-world.start.x,y-world.start.y)<230)continue;
    if(world.obst.some(q=>hyp(q.x-x,q.y-y)<(q.r+o.r+110)))continue;
    world.obst.push({k,v:(R()*3)|0,x,y,r:o.r,cy:o.cy||0,tall:o.tall,glow:o.glow,w:o.w,h:o.h});}
  }
  for(let i=0;i<chestN;i++){let x,y,ok=false;tries=0;
    while(!ok&&tries++<500){x=rr(world.b.l+60,world.b.r-60);y=rr(world.b.t+90,world.b.b-80);
      ok=hyp(x-world.start.x,y-world.start.y)>420&&!world.obst.some(q=>hyp(q.x-x,q.y+q.cy-y)<q.r+70)&&!world.chests.some(c=>hyp(c.x-x,c.y-y)<500);}
    world.chests.push({x,y,open:false,t:0,type:['match3','gates','battle'][(i+(seed%3))%3]});}
  R=Math.random;
}
function bgFiles(k){const g=ATLAS.ground&&ATLAS.ground[k];return[ATLAS.bgs[k].file,...(g?[g.tile,g.decals]:[])];}
const bgArtCache=new Map();
function bgArt(tid){let a=bgArtCache.get(tid);if(a)return a;const info=ATLAS.bgs[tid],img=info&&imgOf(info.file);if(!img)return null;
  const W=img.naturalWidth,H=img.naturalHeight,hzY=info.hz*H,end=Math.min(info.fg*H,hzY+H*0.10);
  const top=document.createElement('canvas');top.width=W;top.height=Math.ceil(end);let x=top.getContext('2d');x.drawImage(img,0,0);
  x.globalCompositeOperation='destination-in';let g=x.createLinearGradient(0,0,0,end);g.addColorStop(0,'rgba(0,0,0,1)');g.addColorStop(clamp((hzY+H*0.015)/end,0,1),'rgba(0,0,0,1)');g.addColorStop(1,'rgba(0,0,0,0)');
  x.fillStyle=g;x.fillRect(0,0,W,top.height);
  const sy0=Math.floor(info.fg*H-H*0.04),strip=document.createElement('canvas');strip.width=W;strip.height=H-sy0;x=strip.getContext('2d');x.drawImage(img,0,-sy0);
  x.globalCompositeOperation='destination-in';g=x.createLinearGradient(0,0,0,strip.height);g.addColorStop(0,'rgba(0,0,0,0)');g.addColorStop(0.42,'rgba(0,0,0,1)');g.addColorStop(1,'rgba(0,0,0,1)');x.fillStyle=g;x.fillRect(0,0,W,strip.height);
  a={top,strip,W,H,hzY};bgArtCache.set(tid,a);return a;}
function backdropGeom(){const a=world&&bgArt(world.tid);if(!a)return null;const bw=Math.min(world.W,Math.max(760,VW*2.1)),s=bw/a.W,topY=world.b.t-6-a.hzY*s;
  const sw=world.W/a.W,stripY=world.b.b-a.strip.height*sw*0.36;return{a,bw,s,topY,sw,stripY,stripBot:stripY+a.strip.height*sw};}
function collideObst(e,rad){for(const o of world.obst){const cy=o.y+o.cy,dx=e.x-o.x,dy=e.y-cy,d=hyp(dx,dy),m=o.r+rad;
  if(d<m&&d>0.001){e.x=o.x+dx/d*m;e.y=cy+dy/d*m;}}
  const b=world.b;e.x=clamp(e.x,b.l,b.r);e.y=clamp(e.y,b.t,b.b);}

/* ============ game state ============ */
let mode='title';     // title | play | walk | tutorial
let state='menu';     // menu | play | perform | down | result | paused
let stageIdx=0,stage=null,time=0,stTime=0,clearTime=0,newBest=false,giftNew=[];
let P=null,CAT=null,enemies=[],bosses=[],shots=[],ebul=[],traps=[],parts=[],texts=[],bubbles=[],orbs=[];
let thief=null,tut=null,catOn=true,story=null,scene=null,holdClear=0;
function catAway(){return !!save.cleared[4]&&!save.cleared[9];}
let kills=0,chestsOpen=0,bossesDown=0,bossQueue=[],bossTimer=0,spawnT=0,shake=0;
const cam={x:0,y:0};
let perform=null;

function guardCount(){const e=save.difficulty==='easy';return save.guardMode==='3'?3:save.guardMode==='5'?5:(e?5:3);}
function diff(){const g=guardCount();return save.difficulty==='easy'?{esp:0.75,ehp:0.8,bhp:0.68,bsp:0.82,bul:0.8,guard:g,bare:2,inv:1.6}:{esp:1,ehp:1,bhp:1,bsp:1,bul:1,guard:g,bare:1,inv:1.2};}
function costume(){return save.costume==='base'?BARE:CMAP[save.costume]||CMAP.basic;}
const hardMode=()=>save.costume==='base';
const permanentGoddess=()=>!!P&&!P.bare&&!!costume().permanentGoddess;
const goddessPower=()=>!!P&&(P.god>0||permanentGoddess());
const thumbId=id=>id==='base'?'base_'+save.baseArt:id;
function curMods(bare){return Object.assign({speed:1,dmg:1,rate:1,range:1,inv:1,heal:1,pierce:0,twin:0,tri:0,big:1,gaugeMul:1},bare?{}:costume().mods);}
function curLook(){return P&&P.bare?BARE:costume();}

function godMax(){return mode==='play'&&stage&&save.difficulty==='easy'?Math.max(1,stage.bosses.length):1;}
function newPlayer(){const d=diff();
  return{x:world.start.x,y:world.start.y,vx:0,vy:0,face:4,lean:0,leanV:0,guard:d.guard,maxGuard:d.guard,godLeft:godMax(),godMax:godMax(),bare:false,bareHp:d.bare,maxBare:d.bare,shield:0,restoreT:0,inv:0,fireT:0,
    st:'awake',idle:0,wakeT:0,god:0,gauge:mode==='walk'?1:0,expr:'smile',exprT:0,trail:[],trailT:0,lift:0,dead:false};}
function newCat(){return{x:world.start.x+50,y:world.start.y+20,vx:0,vy:0,face:0,pose:null,flip:false,hop:0,punchT:0,still:0};}

/* ============ input ============ */
const input={on:false,id:null,ox:0,oy:0,x:0,y:0};
cv.addEventListener('pointerdown',e=>{if(input.on)return;input.on=true;input.id=e.pointerId;input.ox=input.x=e.clientX;input.oy=input.y=e.clientY;
  try{cv.setPointerCapture(e.pointerId);}catch(_){}e.preventDefault();});
cv.addEventListener('pointermove',e=>{if(!input.on||e.pointerId!==input.id)return;input.x=e.clientX;input.y=e.clientY;
  const dx=input.x-input.ox,dy=input.y-input.oy,d=hyp(dx,dy),lim=save.speed.drag*1.2;if(d>lim){input.ox=input.x-dx/d*lim;input.oy=input.y-dy/d*lim;}e.preventDefault();});
function endPtr(e){if(e.pointerId!==input.id)return;input.on=false;input.id=null;}
cv.addEventListener('pointerup',endPtr);cv.addEventListener('pointercancel',endPtr);cv.addEventListener('lostpointercapture',endPtr);
document.addEventListener('touchmove',e=>{if(e.target===cv)e.preventDefault();},{passive:false});
document.addEventListener('gesturestart',e=>e.preventDefault());
function inputVec(){if(!input.on)return null;const dx=input.x-input.ox,dy=input.y-input.oy,d=hyp(dx,dy),S=save.speed,dead=8;
  if(d<dead)return{x:0,y:0,t:0,still:true};const t=clamp((d-dead)/(S.drag-dead),0,1),sp=S.min+(S.max-S.min)*Math.pow(t,S.curve);
  return{x:dx/d*sp,y:dy/d*sp,t};}

/* ============ facing ============ */
const SECT=[2,1,0,7,6,5,4,3],DANG=[90,45,0,315,270,225,180,135];
function dirOf(vx,vy){let a=Math.atan2(vy,vx);if(a<0)a+=TAU;return SECT[Math.round(a/(Math.PI/4))%8];}
// Player uses actual displacement after collision; NPC hysteresis remains unchanged.
function faceFromDisplacement(face,dx,dy,dt,moving){return moving&&dt>0&&hyp(dx,dy)/dt>=2?dirOf(dx,dy):face;}
function turn(e,vx,vy,min){if(hyp(vx,vy)<min)return;let a=Math.atan2(vy,vx)*180/Math.PI;if(a<0)a+=360;let d=Math.abs(a-DANG[e.face])%360;if(d>180)d=360-d;if(d>27)e.face=dirOf(vx,vy);}

/* ============ particles & text ============ */
function part(spr,x,y,vx,vy,life,o){o=o||{};if(parts.length>260)parts.shift();parts.push({spr,x,y,vx,vy,life,max:life,rot:o.rot||0,vr:o.vr||0,g:o.g||0,s:o.s||1,s2:o.s2!=null?o.s2:o.s||1,fade:o.fade!==false,a:o.a!=null?o.a:1});}
/* v8.3.2: goddess feathers flank Yasuko instead of covering her (smaller, fewer, a little transparent) */
function sideFeather(life,spread,o){const side=R()<0.5?-1:1,x=P.x+side*charPx*rr(0.30,spread),y=P.y-charPx*rr(0.25,1.15);
  part(gFeather(),x,y,side*rr(6,22),rr(12,32),life,Object.assign({rot:rr(-0.6,0.6),vr:rr(-1,1),a:0.85},o));}
function burst(x,y,col,n,sp,o){for(let i=0;i<n;i++){const a=R()*TAU,v=sp*(0.4+R()*0.8);part(FX.spark(col),x,y,Math.cos(a)*v,Math.sin(a)*v,0.5+R()*0.5,Object.assign({s:0.6+R()*0.6,s2:0.1},o));}}
function ftext(x,y,t,col){texts.push({x,y,t,col:col||'#fff',life:0.9});}
let bq=[],bShowing=false,bannerT=null;
function banner(html,dur,o){o=o||{};const it={html,dur:dur||2,after:o.after};
  if(o.now)clearBanners();
  if(o.front)bq.unshift(it);else bq.push(it);
  while(bq.length>3)bq.splice(o.front?bq.length-1:0,1);
  if(!bShowing)nextBanner();}
function nextBanner(){const b=$('banner'),it=bq.shift();if(!it){bShowing=false;b.classList.remove('show');return;}
  bShowing=true;b.innerHTML=it.html;if(it.after){try{it.after(b);}catch(e){}}
  b.classList.remove('show');void b.offsetWidth;b.classList.add('show');
  clearTimeout(bannerT);bannerT=setTimeout(()=>{b.classList.remove('show');bannerT=setTimeout(nextBanner,330);},it.dur*1000);}
function clearBanners(){bq=[];clearTimeout(bannerT);bShowing=false;const b=$('banner');b.classList.remove('show');b.innerHTML='';}
function drawBossFace(cv,id){if(!cv)return;if(id==='cat'){drawNarrator(cv,'cat');const x=cv.getContext('2d');x.globalCompositeOperation='source-atop';x.fillStyle='rgba(80,30,125,0.45)';x.fillRect(0,0,cv.width,cv.height);x.globalCompositeOperation='source-over';return;}const fr=bFrame(id,0),img=imgOf(fr.file),x=cv.getContext('2d');if(!img)return;const H=ATLAS.boss.charH,sz=H*0.40,top=fr.fy-H;
  x.fillStyle='#fff6ea';x.fillRect(0,0,cv.width,cv.height);x.drawImage(img,fr.sx+fr.fx-sz/2,fr.sy+Math.max(0,top-H*0.01),sz,sz,0,0,cv.width,cv.height);}
function bossBanner(id,title,line,dur){banner(`<div class="bcard"><canvas width="96" height="96"></canvas><div><div class="bt">${title}</div><div class="bl">「${line}」</div></div></div>`,dur||3,{after:el=>drawBossFace(el.querySelector('canvas'),id)});}

/* ============ stage setup ============ */
async function startStage(i){
  stageIdx=i;stage=STAGES[i];if(i===9&&save.cleared[9])stage={...stage,bosses:stage.bosses.filter(b=>b!=='cat')};mode='play';
  await ensureLoaded([...bgFiles(stage.theme),yInfo(save.costume).file,yInfo('goddess').file,yInfo('base').file,...stage.bosses.filter(b=>ATLAS.boss.list[b]).map(b=>ATLAS.boss.list[b].file)]);
  buildWorld(stage.theme,stage.seed,stage.chests-(stage.star>=0?1:0),stage.set);world.chests.forEach((c,k)=>c.type=['match3','gates','battle'][(k+i)%3]);if(stage.star>=0)placeStarChest(stage.star);beginRun();
  const st=STORY[i];
  if(st&&(!save.storySeen[i]||save.storyAlways)){save.storySeen[i]=1;writeSave();playStory([st.s],()=>{state='play';stageBanners(i);},`ステージ${i+1}「${stage.name}」 はじまり`);}
  else stageBanners(i);
}
function stageBanners(i){banner(`ステージ${i+1}<small>${stage.name}${hardMode()?'<br>素体（ハードモード）':''}</small>`,2.2);if(stage.bosses.length>1)banner(`ライバル ${stage.bosses.length}人<small>${stage.bosses.map(b=>bossName(b)).join('・')}</small>`,2.2);
}
function sceneryList(){if(save.allStages)return THEME_ORDER.filter(k=>THEMES[k]);const ok=new Set(['meadow']);for(const i in save.cleared)if(save.cleared[i]&&STAGES[i])ok.add(STAGES[i].theme);return THEME_ORDER.filter(k=>ok.has(k)&&THEMES[k]);}
async function startWalk(tid){mode='walk';stage=null;
  tid=THEMES[tid]&&sceneryList().includes(tid)?tid:'meadow';await ensureLoaded([...bgFiles(tid),yInfo(save.costume).file,yInfo('goddess').file]);
  buildWorld(tid,77+THEME_ORDER.indexOf(tid),2);beginRun();banner(`おさんぽ<small>${THEME_NAME[world.tid]}（けしき ${sceneryList().indexOf(world.tid)+1}/${sceneryList().length}）</small>`,2);}
function beginRun(){clearBanners();holdClear=0;pops=[];catReq=null;catReqT=rr(30,50);catSay=null;bgm('waltz');fm=null;$('fmPanel').classList.add('hidden');$('goals').classList.remove('hidden');P=newPlayer();CAT=newCat();catOn=!(mode==='play'&&stageIdx>=5&&stageIdx<=9&&!save.cleared[9]);enemies=[];bosses=[];shots=[];ebul=[];traps=[];parts=[];texts=[];bubbles=[];orbs=[];thief=null;if(mode!=='tutorial')tut=null;
  kills=0;chestsOpen=0;bossesDown=0;bossQueue=stage?[...stage.bosses]:[];bossTimer=0;spawnT=1.5;stTime=0;perform=null;
  cam.x=P.x-VW/2;cam.y=P.y-VH*0.55;state='play';showOnly(null);$('hud').classList.remove('hidden');
  $('caption').classList.add('hidden');$('btnSkip').classList.add('hidden');
  buildHearts();updateGoals(true);$('bossBar').classList.add('hidden');
  $('btnGoddess').classList.remove('hidden');lastGauge=-1;lastUsed=null;$('speedMeter').classList.toggle('hidden',!save.meter);
  $('hint').classList.toggle('hidden',!!save.hintSeen||mode==='tutorial');hintMoveT=0;$('tutCard').classList.toggle('hidden',mode!=='tutorial');lastFace='';}
let hintMoveT=0;

/* ============ spawning ============ */
function spawnEnemy(kind,tier,x,y){const d=diff(),k=EKIND[kind];
  if(x==null){let ok=false,t=0;while(!ok&&t++<60){const a=R()*TAU,m=rr(1.05,1.4);x=P.x+Math.cos(a)*(VW/2+40)*m;y=P.y-charPx*0.4+Math.sin(a)*(VH/2+40)*m;
      ok=x>world.b.l&&x<world.b.r&&y>world.b.t&&y<world.b.b&&!world.obst.some(o=>hyp(o.x-x,o.y+o.cy-y)<o.r+30);}if(!ok)return;}
  const hp=Math.round([3,6,10][tier]*k.hp*d.ehp);
  const h=charPx*TIER_H[tier]*(KIND_MUL[kind]||1);
  enemies.push({kind,tier,x,y,vx:0,vy:0,hp,maxHp:hp,sp:[58,70,82][tier]*k.sp*d.esp,h,r:h*0.3,flip:false,fly:kind==='cpony'&&tier===2,wt:0,wx:x,wy:y,hit:0,bob:R()*TAU,lunge:0,wind:0,age:0});
  burst(x,y-20,'#ffffff',6,80);}
function spawnBoss(id){const B=BOSSES[id],d=diff(),a=R()*TAU;let x=P.x+Math.cos(a)*320,y=P.y+Math.sin(a)*260;
  x=clamp(x,world.b.l+40,world.b.r-40);y=clamp(y,world.b.t+40,world.b.b-40);
  const hp=Math.round((30+Math.min(stageIdx,24)*4)*d.bhp*(id==='cat'?1.3:1));
  bosses.push({id,x,y,vx:0,vy:0,hp,maxHp:hp,face:0,st:'enter',t:1.8,cyc:0,hit:0,dash:null,sp:B.speed*d.bsp,pal:B.minion?{kind:B.minion,x:x+charPx*0.45,y:y+10,vx:0,vy:0,face:0,hop:0,still:0}:null});
  burst(x,y-60,id==='cat'?'#7a4aa8':'#fff3c2',24,200);bossBanner(id,`${B.name} が あらわれた！`,bossLine(id,'enter'),4.2);sfx('boss');bgm('boss');
  $('bossBar').classList.remove('hidden');$('bossName').textContent=B.name;}

/* ============ update ============ */
function update(dt){
  time+=dt;
  if(state==='play'||state==='perform'||state==='down'||state==='result')stTime+=dt;
  if(state==='play')updatePlay(dt);
  else if(state==='perform')updatePerform(dt);
  else if(state==='down'){P.lift=Math.max(0,P.lift-dt*40);updateCat(dt);downT-=dt;if(downT<=0){state='result';showDefeat();}}
  else if(state==='result'){updateCat(dt);}
  // shared
  for(const p of parts){p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=p.g*dt;p.rot+=p.vr*dt;p.life-=dt;}
  parts=parts.filter(p=>p.life>0);
  for(const t of texts){t.y-=28*dt;t.life-=dt;}texts=texts.filter(t=>t.life>0);
  for(const b of bubbles)b.life-=dt;bubbles=bubbles.filter(b=>b.life>0);
  if(shake>0)shake=Math.max(0,shake-dt*20);
  updateCamera(dt);
}
let downT=0;
function updatePlay(dt){
  if(fm){updatePlayer(dt);updateCat(dt);if(!fmFrozen()){fmStand=stageIdx<5;updateEnemies(dt);updateBosses(dt);updateEbul(dt);fmStand=false;}if(fm)updateField(dt);updateHUD();return;}
  updatePlayer(dt);updateCat(dt);updateCatReq(dt);
  if(mode==='play'){
    // spawn
    const goalLeft=kills<stage.kills;
    spawnT-=dt;const alive=enemies.length;
    if(goalLeft&&spawnT<=0&&alive<stage.alive+(bosses.length?-2:0)){const [k,t]=pick(stage.enemies);spawnEnemy(k,t);spawnT=rr(0.8,1.6);}
    // boss timing
    if(bossQueue.length&&!bosses.length){
      const need=Math.ceil(stage.kills*0.5);
      if(bossesDown===0&&kills>=need){spawnBoss(bossQueue.shift());}
      else if(bossesDown>0){bossTimer+=dt;if(bossTimer>3){bossTimer=0;spawnBoss(bossQueue.shift());}}
    }
  }
  if(mode!=='walk'){updateEnemies(dt);updateBosses(dt);updateEbul(dt);}
  if(mode==='tutorial')updateTutorial(dt);
  updateOrbs(dt);
  if(P.bare&&!P.dead){if(thief&&!isAlive(thief))restoreCostume(P.x,P.y-charPx*1.3);else if(!thief&&P.restoreT>0){P.restoreT-=dt;if(P.restoreT<=0)restoreCostume(P.x,P.y-charPx*1.3);}}
  updateShots(dt);updateChests(dt);
  updateHUD();
  if(holdClear>0)holdClear-=dt;
  else if(mode==='play'&&kills>=stage.kills&&chestsOpen>=stage.chests&&bossesDown>=stage.bosses.length)startPerform();
}
function updatePlayer(dt){
  {const cc=costume();if(cc.goddessAura&&!P.bare&&P.god<=0&&state==='play'){if(R()<dt*7)part(FX.spark(R()<0.5?cc.goddessAura:'#fff6d0'),P.x+rr(-40,40),P.y-charPx*rr(0.2,1.1),rr(-10,10),rr(-30,-8),0.8,{s:rr(0.4,0.8),s2:0.1});if(R()<dt*0.8)sideFeather(1.5,0.6,{s:rr(0.34,0.48),s2:0.22});}}
  const m=curMods(P.bare),iv=inputVec();
  if(iv&&!iv.still){if(P.st==='drowsy'||P.st==='asleep')wake();P.idle=0;
    if(!save.hintSeen){hintMoveT+=dt;if(hintMoveT>1.2){save.hintSeen=true;writeSave();$('hint').classList.add('hidden');}}}
  const spm=m.speed*(goddessPower()?1.1:1);
  if(iv&&!iv.still&&(P.st==='awake'||P.st==='waking')){const a=1-Math.exp(-dt/0.09);P.vx+=(iv.x*spm-P.vx)*a;P.vy+=(iv.y*spm-P.vy)*a;}
  else{const tau=Math.max(0.05,save.speed.decel)/3,a=Math.exp(-dt/tau);P.vx*=a;P.vy*=a;if(hyp(P.vx,P.vy)<3){P.vx=0;P.vy=0;}}
  const oldX=P.x,oldY=P.y;
  P.x+=P.vx*dt;P.y+=P.vy*dt;collideObst(P,16);
  const sp=hyp(P.vx,P.vy),maxs=save.speed.max*spm;
  const dx=P.x-oldX,dy=P.y-oldY;
  P.face=faceFromDisplacement(P.face,dx,dy,dt,sp>=2);
  const actualVX=dt>0&&sp>=2?dx/dt:0;
  const tl=clamp(actualVX/(save.speed.max*1.1),-1,1)*0.10;P.leanV+=((tl-P.lean)*95-P.leanV*10)*dt;P.lean+=P.leanV*dt;
  P.lift=lerp(P.lift,clamp(sp/maxs,0,1)*5,1-Math.exp(-dt*5));
  // trail / afterimage
  P.trailT-=dt;if(P.trailT<=0){P.trailT=0.045;P.trail.unshift({x:P.x,y:P.y,face:P.face,lean:P.lean});if(P.trail.length>4)P.trail.pop();}
  if(sp>maxs*0.45&&R()<sp/maxs*0.9){const c=goddessPower()?'#fff3c2':curLook().trail;part(FX.spark(c),P.x+rr(-14,14),P.y-rr(0,14),-P.vx*0.15+rr(-20,20),-P.vy*0.15-rr(10,40),0.55,{s:rr(0.4,0.8),s2:0.1});}
  if(P.inv>0)P.inv-=dt;if(P.exprT>0){P.exprT-=dt;if(P.exprT<=0)P.expr='smile';}
  // goddess
  if(P.god>0){P.god-=dt;if(R()<dt*9)sideFeather(1.6,0.68,{s:rr(0.45,0.62),s2:0.3});if(R()<dt*16)part(FX.spark(pick(['#fff3c2','#ffd6ec','#e6dcff'])),P.x+rr(-60,60),P.y-charPx*rr(0.2,1.2),rr(-15,15),rr(-30,10),0.8,{s:rr(0.4,0.75),s2:0.1});
    if(P.god<=0){P.god=0;banner('へんしん おしまい',1.2);burst(P.x,P.y-charPx*0.5,'#fff3c2',16,160);}}
  if(mode==='walk')P.gauge=Math.min(1,P.gauge+dt*0.08);
  // idle -> drowsy -> asleep
  const quiet=!enemies.some(e=>hyp(e.x-P.x,e.y-P.y)<300)&&!bosses.length;
  if(save.sleepOn&&mode!=='tutorial'&&!input.on&&sp<5&&quiet&&P.god<=0){P.idle+=dt;}else if(!(input.on&&inputVec()&&inputVec().still))P.idle=0;
  if(P.st==='awake'&&P.idle>5){P.st='drowsy';P.expr='drowsy';}
  if(P.st==='drowsy'&&P.idle>10){P.st='asleep';P.expr='sleep';}
  if(P.st==='drowsy'&&R()<dt*1.2)part(FX.dot('#cdb8ff'),P.x+charPx*0.25,P.y-charPx*0.95,rr(5,15),-20,1.5,{s:rr(0.6,1.2),s2:1.6});
  if(P.st==='waking'){P.wakeT-=dt;if(P.wakeT<=0){P.st='awake';P.expr='smile';}}
  // auto fire
  if(mode!=='walk'&&!fm&&!(tut&&tut.noFire)&&(P.st==='awake'||P.st==='waking')){P.fireT-=dt;if(P.fireT<=0)fire(m);}
}
function wake(){const was=P.st;P.st='waking';P.wakeT=0.7;P.idle=0;P.expr='surprised';P.exprT=0.8;if(was==='asleep')burst(P.x+charPx*0.3,P.y-charPx*1.0,'#f2c94c',6,90);}
/* ---- v8.3 attack patterns ----
   strength (for "strong" aiming) is one definition everywhere: boss > larger max HP > larger remaining HP */
function strength(t){return (t.boss?1e6:0)+(t.maxHp||0)*1000+(t.hp||0);}
function fireTargets(cx,cy,range){const T=[];
  for(const e of enemies){if(e.dead||e.hp<=0)continue;const y=e.y-e.h*0.45,d=hyp(e.x-cx,y-cy);if(d<range)T.push({o:e,x:e.x,y,d,boss:false,maxHp:e.maxHp,hp:e.hp});}
  for(const b of bosses){if(b.st==='enter'||b.st==='dead')continue;const y=b.y-charPx*0.45,d=hyp(b.x-cx,y-cy);if(d<range)T.push({o:b,x:b.x,y,d,boss:true,maxHp:b.maxHp,hp:b.hp});}
  T.sort((p,q)=>p.d-q.d);
  if(P.bare&&isAlive(thief)){const i=T.findIndex(t=>t.o===thief);if(i>0)T.unshift(T.splice(i,1)[0]);}
  return T;}
function shoot(cx,cy,a,sp,o){if(shots.length>150)shots.splice(0,shots.length-150);
  shots.push({x:cx,y:cy,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,life:o.range/sp+0.1,dmg:o.dmg,r:12*o.big,pierce:o.pr,spr:o.spr,rot:a,s:o.s,hitList:[]});}
const FACE_ANG=d=>DANG[d]*Math.PI/180;
function fire(m){
  const range=330*m.range*(goddessPower()?1.1:1),cx=P.x,cy=P.y-charPx*0.45;
  const T=fireTargets(cx,cy,range);
  if(!T.length){P.fireT=0.1;return;}
  if(P.god>0){ /* temporary goddess transformation: the classic 3-way feathers, scaled from the costume's power */
    const A=atkOf(P.bare?null:costume()),eff=Math.max(17.3,A.eff*3),dg=eff*0.24/(2.0*1.3),base=Math.atan2(T[0].y-cy,T[0].x-cx);
    const o={range,dmg:dg,big:1.2,pr:2,spr:shotSprite(permanentGoddess()?curLook():CMAP.goddess),s:1.15};
    for(const da of [-0.22,0,0.22])shoot(cx,cy,base+da,520,o);
    P.fireT=0.24;sfx('shot');return;}
  const look=curLook(),A=atkOf(P.bare?null:costume());
  const o={range,dmg:A.d,big:m.big,pr:A.pr,spr:shotSprite(look),s:m.big>1?1.35:1};
  const fan=(base,n,width)=>{for(let i=0;i<n;i++)shoot(cx,cy,base+(n>1?(i/(n-1)-0.5)*width:0),A.sp,o);};
  for(const [p,n] of A.parts){
    if(p==='near'){const t=T[0];fan(Math.atan2(t.y-cy,t.x-cx),n,n===2?0.24:0.44);}
    else if(p==='strong'){let t=T[0];for(const q of T)if(strength(q)>strength(t))t=q;fan(Math.atan2(t.y-cy,t.x-cx),n,n===2?0.16:0.3);}
    else if(p==='even'){for(let i=0;i<n;i++){const t=T[i%T.length],j=Math.floor(i/T.length);shoot(cx,cy,Math.atan2(t.y-cy,t.x-cx)+(j?(j%2?0.12:-0.12):0),A.sp,o);}}
    else if(p==='nway'){const t=T[0];fan(Math.atan2(t.y-cy,t.x-cx),n,Math.min(1.3,0.22*(n-1)+0.2));}
    else if(p==='front'){const a=FACE_ANG(P.face),px=-Math.sin(a),py=Math.cos(a);for(let i=0;i<n;i++){const off=(n>1?(i/(n-1)-0.5):0)*charPx*0.22;
        shoot(cx+px*off,cy+py*off,a,A.sp,o);}}
    else if(p==='scatter'){const t=T[0],b=Math.atan2(t.y-cy,t.x-cx);for(let i=0;i<n;i++)shoot(cx,cy,b+rr(-0.7,0.7),A.sp*rr(0.78,1.15),o);}
    else if(p==='spiral'){P.spin=(P.spin||0)+0.55;for(let i=0;i<n;i++)shoot(cx,cy,P.spin+i*TAU/n,A.sp,o);}
    else if(p==='ring'){P.ring=((P.ring||0)+1)%2;for(let i=0;i<n;i++)shoot(cx,cy,(i+P.ring*0.5)*TAU/n,A.sp,o);}
  }
  P.fireT=A.iv*(goddessPower()?0.9:1);sfx('shot');
}
function updateShots(dt){for(const s of shots){s.x+=s.vx*dt;s.y+=s.vy*dt;s.life-=dt;s.rot+=dt*6;
    for(const e of enemies){if(e.hp<=0||s.hitList.includes(e))continue;if(hyp(e.x-s.x,e.y-e.h*0.45-s.y)<e.h*0.32+s.r){hitEnemy(e,s.dmg,s.vx,s.vy);s.hitList.push(e);if(s.pierce>0)s.pierce--;else{s.life=0;break;}}}
    if(s.life>0)for(const b of bosses){if(b.st==='enter'||b.hp<=0||s.hitList.includes(b))continue;if(hyp(b.x-s.x,b.y-charPx*0.45-s.y)<charPx*0.24+s.r){hitBoss(b,s.dmg);s.hitList.push(b);if(s.pierce>0)s.pierce--;else{s.life=0;break;}}}
    if(s.life<=0)burst(s.x,s.y,curLook().trail,3,60);}
  shots=shots.filter(s=>s.life>0);}
function hitEnemy(e,dmg,vx,vy){if(e.stealT>0){if(R()<0.5)burst(e.x,e.y-e.h*0.5,'#fff3c2',3,80);return;}e.hp-=dmg;e.hit=0.15;const v=hyp(vx,vy)||1;e.x+=vx/v*8;e.y+=vy/v*8;
  if(e.hp<=0){e.dead=true;kills++;sfx('pop');P.gauge=Math.min(1,P.gauge+0.11*curMods(P.bare).gaugeMul);burst(e.x,e.y-e.h*0.45,'#ffffff',10,150);if(e.thief)restoreCostume(e.x,e.y-e.h*0.5);
    for(let i=0;i<3;i++)part(FX.heart('#f19bb5'),e.x,e.y-e.h*0.45,rr(-60,60),rr(-120,-60),0.9,{g:160,s:0.7,s2:0.4});
    if(stage&&kills===stage.kills)banner('敵を倒す クリア！',1.4);}}
function hitBoss(b,dmg){b.hp-=dmg;b.hit=0.12;if(b.hp<=0&&b.st!=='dead'){b.st='dead';b.t=1.4;bossesDown++;sfx('bossDown');if(b.thief)restoreCostume(b.x,b.y-charPx*0.5);P.gauge=Math.min(1,P.gauge+0.3*curMods(P.bare).gaugeMul);P.expr='happy';P.exprT=1.6;
    burst(b.x,b.y-charPx*0.5,'#fff3c2',30,260);shake=6;ebul=[];traps=[];
    if(b.id==='cat'){b.t=0.6;purifyCat(b);}else bossBanner(b.id,`${BOSSES[b.id].name} を たおした！`,bossLine(b.id,'lose'),3.6);}}
function purifyCat(b){sfx('star');catOn=true;holdClear=3.4;CAT=newCat();CAT.x=b.x;CAT.y=b.y;CAT.pose='happy';
  burst(b.x,b.y-charPx*0.4,'#fff7d0',40,300);burst(b.x,b.y-charPx*0.4,'#ffffff',24,200);shake=5;P.expr='happy';P.exprT=2.5;
  for(let i=0;i<18;i++)part(FX.heart('#f19bb5'),b.x,b.y-charPx*0.4,rr(-140,140),rr(-220,-60),1.4,{g:120,s:0.8,s2:0.4});
  banner(`<div class="bcard"><canvas width="96" height="96"></canvas><div><div class="bt">呪いが とけた！ 黒猫が もどった！</div><div class="bl">「${BOSSES.cat.lose}」</div></div></div>`,3.6,{front:true,after:el=>drawNarrator(el.querySelector('canvas'),'cat')});}
function isAlive(o){return !!o&&((enemies.includes(o)&&!o.dead)||(bosses.includes(o)&&o.st!=='dead'));}
function damagePlayer(src,owner){if(P.inv>0||goddessPower()||state!=='play'||P.dead)return;
  if(mode==='tutorial'&&!(tut&&tut.allowHit))return;
  if(catGuard(src))return;
  sfx('hurt');
  const d=diff();
  if(src){const dx=P.x-src.x,dy=P.y-src.y,dd=hyp(dx,dy)||1;P.vx+=dx/dd*260;P.vy+=dy/dd*260;}
  if(P.st==='drowsy'||P.st==='asleep')wake();
  if(P.shield>0){P.shield=0;P.inv=d.inv;burst(P.x,P.y-charPx*0.5,'#fff7d0',18,200);ftext(P.x,P.y-charPx*1.05,'まもった！','#fff3c2');banner('光のベールが まもってくれた！',1.6);buildHearts();return;}
  P.inv=d.inv*curMods(P.bare).inv;P.expr='surprised';P.exprT=0.9;shake=7;burst(P.x,P.y-charPx*0.5,'#ff9aa8',10,170);
  if(!P.bare){P.guard--;if(P.guard<=0){if(hardMode()){buildHearts();if(fm){fm=null;$('fmPanel').classList.add('hidden');$('goals').classList.remove('hidden');}state='down';downT=1.4;P.dead=true;banner('あぶない…！',1.2,{now:true});return;}breakCostume(owner);}}
  else{P.bareHp--;if(P.bareHp<=0){buildHearts();if(fm){fm=null;$('fmPanel').classList.add('hidden');$('goals').classList.remove('hidden');}state='down';downT=1.4;P.dead=true;banner('あぶない…！',1.2,{now:true});return;}}
  buildHearts();}
function breakCostume(owner){
  P.bare=true;P.guard=0;P.bareHp=P.maxBare;P.shield=0;P.inv=Math.max(P.inv,2.2);P.expr='surprised';P.exprT=1.4;
  let th=isAlive(owner)?owner:null;
  if(!th){let bd=1e9;for(const e of [...enemies,...bosses.filter(b=>b.st!=='dead')]){const dd=hyp(e.x-P.x,e.y-P.y);if(dd<bd){bd=dd;th=e;}}}
  thief=th;
  const look=costume();
  for(let i=0;i<16;i++)part(FX.petal(look.trail),P.x,P.y-charPx*0.5,rr(-160,160),rr(-200,-40),1.1,{g:220,vr:rr(-4,4),s:0.8,s2:0.4});
  burst(P.x,P.y-charPx*0.5,'#ffffff',22,230);
  if(th){th.thief=true;if(th.h){th.hp=th.maxHp;th.stealT=1.4;th.wind=0;th.lunge=0;}orb(P.x,P.y-charPx*0.5,()=>isAlive(th)?{x:th.x,y:th.h?th.y-th.h-14:th.y-charPx*1.05}:null);
    banner('衣装の力が うばわれた！<small>衣装マークの敵を たおすと もどります</small>',2.8,{front:true});}
  else{P.restoreT=4;banner('衣装の力が きえた…<small>すこし まつと もどります</small>',2.4);}
  buildHearts();updateGoals(true);}
function restoreCostume(x,y){if(!P||!P.bare)return;P.bare=false;P.guard=P.maxGuard;P.restoreT=0;
  if(thief)thief.thief=false;thief=null;
  if(x!=null)orb(x,y,()=>({x:P.x,y:P.y-charPx*0.5}));
  P.expr='happy';P.exprT=1.8;P.inv=Math.max(P.inv,1);
  const look=costume();burst(P.x,P.y-charPx*0.5,look.trail,30,260);
  for(let i=0;i<12;i++)part(FX.star('#f2c94c'),P.x,P.y-charPx*0.5,rr(-140,140),rr(-220,-60),1.2,{g:200,vr:rr(-4,4),s:0.7,s2:0.4});
  if(state==='play')banner('衣装が もどった！<small>衣装の力で また つよくなったよ</small>',2.2,{front:true});
  buildHearts();updateGoals(true);}
function orb(x,y,tgt){orbs.push({sx:x,sy:y,x,y,t:0,dur:0.75,tgt});}
function updateOrbs(dt){for(const o of orbs){o.t+=dt;const u=clamp(o.t/o.dur,0,1),T=o.tgt();if(!T){o.t=o.dur;continue;}
    o.x=lerp(o.sx,T.x,ease(u));o.y=lerp(o.sy,T.y,ease(u))-Math.sin(u*Math.PI)*90;
    if(R()<0.8)part(FX.spark('#fff3c2'),o.x+rr(-6,6),o.y+rr(-6,6),rr(-20,20),rr(-20,20),0.45,{s:rr(0.5,0.9),s2:0.1});}
  orbs=orbs.filter(o=>o.t<o.dur);}
function updateEnemies(dt){const d=diff();
  for(const e of enemies){e.age+=dt;e.bob+=dt*(6+e.tier);if(e.hit>0)e.hit-=dt;if(e.stealT>0)e.stealT-=dt;
    const dx=P.x-e.x,dy=P.y-e.y,dist=hyp(dx,dy),k=EKIND[e.kind];let tx=0,ty=0;
    if(e.wind>0){e.wind-=dt;if(e.wind<=0){e.lunge=0.45;}}
    else if(e.lunge>0){e.lunge-=dt;tx=e.lx*e.sp*2.6;ty=e.ly*e.sp*2.6;}
    else if(e.thief&&(dist<340||e.stealT>0)){const b=world.b,fl=e.stealT>0?1.8:1.05;tx=-dx/dist*e.sp*fl;ty=-dy/dist*e.sp*fl;
      if(e.x<b.l+50||e.x>b.r-50)ty+=(e.y<(b.t+b.b)/2?1:-1)*e.sp*0.8;if(e.y<b.t+50||e.y>b.b-50)tx+=(e.x<(b.l+b.r)/2?1:-1)*e.sp*0.8;
      if(R()<dt*8)part(FX.spark(costume().trail),e.x+rr(-12,12),e.y-e.h*rr(0.3,0.9),rr(-15,15),-25,0.6,{s:0.7,s2:0.1});}
    else if(!e.thief&&(dist<Math.max(420,VH*0.6)&&P.st!=='asleep'||dist<120)){tx=dx/dist*e.sp;ty=dy/dist*e.sp;
      if(k.zig){const z=Math.sin(e.age*7)*0.7;tx+=-dy/dist*e.sp*z;ty+=dx/dist*e.sp*z;}
      if(k.lunge&&dist<150&&dist>60&&R()<dt*0.9){e.wind=0.4;e.lx=dx/dist;e.ly=dy/dist;}}
    else{e.wt-=dt;if(e.wt<=0){e.wt=rr(1.2,2.6);e.wx=e.x+rr(-120,120);e.wy=e.y+rr(-120,120);}
      const wx=e.wx-e.x,wy=e.wy-e.y,wd=hyp(wx,wy);if(wd>8){tx=wx/wd*e.sp*0.5;ty=wy/wd*e.sp*0.5;}}
    if(e.wind>0){tx=0;ty=0;}
    if(fmStand){tx=0;ty=0;e.wind=0;e.lunge=0;if(!e.thief){e.shotT=(e.shotT==null?rr(1.0,2.6):e.shotT)-dt;if(e.shotT<=0&&dist<520){e.shotT=rr(2.6,4.0);const n=e.tier>=2?3:1,a0=Math.atan2(dy-(-charPx*0.4+e.h*0.5),dx);for(let q=0;q<n;q++)ebul.push(mkBul(e.x,e.y-e.h*0.5,a0+(q-(n-1)/2)*0.28,130*d.bul,'petal',e));burst(e.x,e.y-e.h*0.6,'#f6c2ff',5,60);}}}
    const a=1-Math.exp(-dt/0.18);e.vx+=(tx-e.vx)*a;e.vy+=(ty-e.vy)*a;e.x+=e.vx*dt;e.y+=e.vy*dt;if(e.fly){const b=world.b;e.x=clamp(e.x,b.l,b.r);e.y=clamp(e.y,b.t,b.b);if(R()<dt*6)part(FX.feather('#d4a531'),e.x+rr(-15,15),e.y-e.h*0.7,rr(-15,15),rr(10,30),0.9,{vr:rr(-2,2),s:0.45,s2:0.2});}else collideObst(e,e.r*0.7);
    if(Math.abs(e.vx)>6)e.flip=e.vx<0;
    if(hyp(P.x-e.x,(P.y-charPx*0.35)-(e.y-e.h*0.45))<e.h*0.26+charPx*0.14){if(goddessPower()){const qx=e.x-P.x,qy=e.y-P.y,qd=hyp(qx,qy)||1;e.x+=qx/qd*5;e.y+=qy/qd*5;}else damagePlayer(e,e);}}
  // separation
  for(let i=0;i<enemies.length;i++)for(let j=i+1;j<enemies.length;j++){const a=enemies[i],b=enemies[j],dx=b.x-a.x,dy=b.y-a.y,d=hyp(dx,dy),m=a.r+b.r;if(d<m&&d>0.01){const p=(m-d)/2;a.x-=dx/d*p;a.y-=dy/d*p;b.x+=dx/d*p;b.y+=dy/d*p;}}
  enemies=enemies.filter(e=>!e.dead);}
function updateBosses(dt){const d=diff();
  for(const b of bosses){if(b.hit>0)b.hit-=dt;b.t-=dt;followPal(b,dt);const dx=P.x-b.x,dy=P.y-b.y,dist=hyp(dx,dy)||1;let tx=0,ty=0;
    if(b.st==='dead'){if(b.t<=0)b.gone=true;continue;}
    if(b.st==='enter'){turn(b,dx,dy,0);if(b.t<=0){b.st='chase';b.t=2.2;}}
    else if(b.st==='chase'){tx=dx/dist*b.sp;ty=dy/dist*b.sp;if(dist<90){tx=-tx*0.3;ty=-ty*0.3;}if(b.t<=0){b.st='wind';b.t=b.id==='takumi'?0.6:b.id==='tomo'?0.5:0.75;b.aim=Math.atan2(dy,dx);}}
    else if(b.st==='wind'){turn(b,dx,dy,0);b.aim=Math.atan2(dy,dx);if(b.t<=0)bossAttack(b);}
    else if(b.st==='dash'){tx=Math.cos(b.aim)*430*d.bsp;ty=Math.sin(b.aim)*430*d.bsp;if(R()<0.6)part(FX.dot('#ffffff'),b.x+rr(-10,10),b.y-rr(0,20),rr(-20,20),-20,0.4,{s:1.2,s2:0.2});if(b.t<=0){b.st='rest';b.t=0.7;}}
    else if(b.st==='spiral'){b.sp2=(b.sp2||0)+dt;if(b.sp2>0.18){b.sp2=0;const n=3;for(let i=0;i<n;i++){const a=b.rot+i*TAU/n;ebul.push(mkBul(b.x,b.y-charPx*0.45,a,115*d.bul,'petal',b));}b.rot+=0.42;}if(b.t<=0){b.st='rest';b.t=0.8;}}
    else if(b.st==='rest'){if(b.t<=0){b.st='chase';b.t=rr(1.8,2.6);b.cyc++;}}
    if(fmStand){tx=0;ty=0;b.vx=0;b.vy=0;}
    const a=1-Math.exp(-dt/0.15);b.vx+=(tx-b.vx)*a;b.vy+=(ty-b.vy)*a;b.x+=b.vx*dt;b.y+=b.vy*dt;collideObst(b,22);
    if(b.st!=='wind'&&b.st!=='enter')turn(b,b.vx,b.vy,15);
    if(b.st!=='enter'&&hyp(dx,dy-0)<charPx*0.32){if(goddessPower()){b.x-=dx/dist*4;b.y-=dy/dist*4;}else damagePlayer(b,b);}}
  bosses=bosses.filter(b=>!b.gone);
  if(!bosses.length){$('bossBar').classList.add('hidden');if(state==='play'&&SND.song==='boss')bgm('waltz');}}
function followPal(b,dt){const p=b.pal;if(!p)return;const bs=hyp(b.vx,b.vy);let tx,ty;
  if(bs>30){tx=b.x-b.vx/bs*charPx*0.55;ty=b.y-b.vy/bs*charPx*0.35;}else{tx=b.x+charPx*0.45;ty=b.y+10;}
  const dx=tx-p.x,dy=ty-p.y,d=hyp(dx,dy),want=d<6?0:clamp(d*3.4,0,520),a=1-Math.exp(-dt/0.12);
  p.vx+=((d?dx/d:0)*want-p.vx)*a;p.vy+=((d?dy/d:0)*want-p.vy)*a;p.x+=p.vx*dt;p.y+=p.vy*dt;collideObst(p,10);
  const s=hyp(p.vx,p.vy);if(s>12){p.still=0;turn(p,p.vx,p.vy,12);p.hop+=dt*12;}else{p.still+=dt;if(p.still>0.8)p.face=0;}}
function mkBul(x,y,a,sp,kind,owner){return{x,y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,life:4,kind,r:11,rot:a,owner};}
function bossAttack(b){const d=diff(),cx=b.x,cy=b.y-charPx*0.45;
  if(b.id==='hikaru'){b.st='dash';b.t=0.7;if(b.cyc%3===2&&enemies.length<9){banner('ひかるん「ポニー隊、前へ！」',1.6);for(let i=0;i<2;i++)spawnEnemy('cpony',stageIdx>=10?2:stageIdx>=2?1:0,b.x+rr(-60,60),b.y+rr(-40,40));}}
  else if(b.id==='takumi'){const n=save.difficulty==='easy'?7:10;for(let i=0;i<n;i++)ebul.push(mkBul(cx,cy,b.aim+i*TAU/n,165*d.bul,'star',b));b.st='dash';b.t=0.35;}
  else if(b.id==='akira'){b.st='spiral';b.t=1.6;b.rot=b.aim;b.sp2=0;}
  else if(b.id==='cat'){if(b.cyc%2===0){b.st='dash';b.t=0.6;}else{const n=save.difficulty==='easy'?5:7;for(let i=0;i<n;i++)ebul.push(mkBul(cx,cy+charPx*0.1,b.aim+(i-(n-1)/2)*0.28,170*d.bul,'curse',b));b.st='rest';b.t=0.9;}}
  else if(b.id==='tomo'){const n=save.difficulty==='easy'?2:3;for(let i=0;i<n;i++){traps.push({x:P.x+rr(-90,90),y:P.y+rr(-70,70),t:1.5,r:46,owner:b});}
    for(const da of[-0.25,0,0.25])ebul.push(mkBul(cx,cy,b.aim+da,190*d.bul,'gear',b));b.st='rest';b.t=1.0;}}
function updateEbul(dt){const px=P.x,py=P.y-charPx*0.42,pr=charPx*0.13;
  for(const u of ebul){u.x+=u.vx*dt;u.y+=u.vy*dt;u.life-=dt;u.rot+=dt*4;if(hyp(u.x-px,u.y-py)<u.r+pr){damagePlayer(u,u.owner);u.life=0;}
    if(u.x<world.b.l-80||u.x>world.b.r+80||u.y<world.b.t-120||u.y>world.b.b+80)u.life=0;}
  ebul=ebul.filter(u=>u.life>0);
  for(const t of traps){t.t-=dt;if(t.t<=0&&!t.boom){t.boom=0.3;burst(t.x,t.y,'#e8c35a',14,200);if(hyp(P.x-t.x,P.y-t.y)<t.r+10)damagePlayer(t,t.owner);}if(t.boom)t.boom-=dt;}
  traps=traps.filter(t=>t.t>0||(t.boom&&t.boom>0));}
function updateChests(dt){for(const c of world.chests){if(c.open){c.t+=dt;continue;}
  const d=hyp(P.x-c.x,P.y-c.y);if(c.cool){if(d>90)c.cool=false;continue;}
  if(d<46&&state==='play'&&!P.dead&&!fm&&c.type==='star'){openStarChest(c);return;}
  if(d<46&&state==='play'&&!P.dead&&!fm){const type=mode==='tutorial'?'match3':c.type||['match3','gates','battle'][chestsOpen%3];if(type==='match3')startMini(c,type);else startField(c,type);return;}}}
function openChest(c,ok){sfx(ok?'chest':'pop');c.open=true;c.t=0;chestsOpen++;P.expr='happy';P.exprT=1.4;burst(c.x,c.y-30,'#f2c94c',ok?34:18,ok?280:200);
  for(let i=0;i<(ok?14:6);i++)part(FX.star('#f2c94c'),c.x,c.y-30,rr(-110,110),rr(-240,-120),1.3,{g:260,vr:rr(-4,4),s:0.7,s2:0.5});
  if(ok){if(P.bare){P.shield=1;buildHearts();popItem('star_rb',c.x,c.y-40);ftext(c.x,c.y-60,'大成功！','#fff3c2');banner('大成功！<small>「光のベール」が 出てきた！ 1回 まもってくれるよ</small>',2.2);}
    else if(P.guard<P.maxGuard){P.guard=Math.min(P.maxGuard,P.guard+curMods(false).heal);buildHearts();popItem('item_heart',c.x,c.y-40);ftext(c.x,c.y-60,'大成功！','#ffd6de');banner('大成功！<small>「回復のハート」が 出てきた！ ハートが かいふく</small>',2.2);}
    else{popItem('item_gem',c.x,c.y-40);ftext(c.x,c.y-60,'大成功！','#fff3c2');banner('大成功！<small>「キラキラの宝石」が 出てきた！ 女神ゲージが たまったよ</small>',2.2);}
    if(P.godLeft>0||mode==='walk')P.gauge=Math.min(1,P.gauge+0.35);}
  else{ftext(c.x,c.y-60,'おしい！','#fff3c2');banner('おしい！<small>でも 宝箱は あいたよ</small>',1.8);if(P.godLeft>0||mode==='walk')P.gauge=Math.min(1,P.gauge+0.12);}
  if(stage&&chestsOpen===stage.chests)banner('宝箱 クリア！',1.4);}
function updateCat(dt){if(!catOn||!CAT)return;const c=CAT,sleeping=P.st==='drowsy'||P.st==='asleep';
  let tx,ty;const ps=hyp(P.vx,P.vy);
  if(sleeping||state!=='play'){tx=P.x+charPx*0.42;ty=P.y+6;}
  else if(ps>40){tx=P.x-P.vx/ps*charPx*0.5+(-P.vy/ps)*charPx*0.16;ty=P.y-P.vy/ps*charPx*0.4+(P.vx/ps)*charPx*0.12;}
  else{tx=P.x+charPx*0.38;ty=P.y+8;}
  const dx=tx-c.x,dy=ty-c.y,d=hyp(dx,dy);const want=d<6?0:clamp(d*3.2,0,save.speed.max*1.35);
  const a=1-Math.exp(-dt/0.12);c.vx+=((d?dx/d:0)*want-c.vx)*a;c.vy+=((d?dy/d:0)*want-c.vy)*a;c.x+=c.vx*dt;c.y+=c.vy*dt;
  if(world)collideObst(c,10);const s=hyp(c.vx,c.vy);
  if(s>12){c.still=0;turn(c,c.vx,c.vy,12);}else{c.still+=dt;if(c.still>0.8)c.face=0;}
  c.hop+=dt*(s>30?12:0);
  if(state==='perform'||(state==='result'&&mode==='play'&&!P.dead))c.pose=perform&&perform.ph==='pose'||state==='result'?'happy':null;
  else if(P.st==='asleep')c.pose='sleep';else if(P.st==='drowsy')c.pose='sit_drowsy';
  else if(s>save.speed.max*0.55){c.pose='run';c.flip=c.vx<0;}else if(s>70&&Math.abs(c.vx)>Math.abs(c.vy)*1.3){c.pose='walk';c.flip=c.vx<0;}else c.pose=null;
  if(c.guardFx>0)c.guardFx-=dt;if(c.shT>0)c.shT-=dt;
  catAttack(dt);}
function catAttack(dt){const c=CAT;if(mode==='walk'||state!=='play'||(tut&&tut.noFire)||P.st==='asleep'||P.st==='drowsy'){c.dash=null;return;}
  // block enemy bullets that touch the cat
  for(const u of ebul){if(u.life>0&&hyp(u.x-c.x,u.y-(c.y-charPx*0.14))<u.r+17){u.life=0;burst(u.x,u.y,'#fff3c2',6,90);}}
  c.atkT=(c.atkT||0)-dt;
  if(c.dash){const t=c.dash.t;c.dash.time+=dt;
    if(!isAlive(t)||c.dash.time>1.1){c.dash=null;c.atkT=1.2;return;}
    const dx=t.x-c.x,dy=t.y-c.y,d=hyp(dx,dy)||1;c.x+=dx/d*Math.min(d,620*dt);c.y+=dy/d*Math.min(d,620*dt);c.vx=dx/d*500;c.vy=dy/d*500;c.pose='run';c.flip=dx<0;turn(c,dx,dy,0);
    if(R()<0.7)part(FX.spark('#fff3c2'),c.x+rr(-8,8),c.y-rr(4,20),-dx/d*40,-dy/d*40,0.35,{s:0.6,s2:0.1});
    if(d<(c.dash.boss?charPx*0.3:t.h*0.3+18)){const dmg=c.dash.boss?2:2.2;if(c.dash.boss)hitBoss(t,dmg);else hitEnemy(t,dmg,dx,dy);
      burst(t.x,t.y-(c.dash.boss?charPx*0.45:t.h*0.45),'#f6d36b',12,170);ftext(c.x,c.y-charPx*0.45,'ねこアタック！','#fff3c2');shake=Math.max(shake,2);
      c.vx=-dx/d*260;c.vy=-dy/d*260;c.dash=null;c.atkT=save.difficulty==='easy'?1.8:2.4;}
    return;}
  if(c.atkT>0)return;
  let best=null,bd=1e9,boss=false;
  for(const e of enemies){if(e.dead||e.hp<=0)continue;const dp=hyp(e.x-P.x,e.y-P.y),dc=hyp(e.x-c.x,e.y-c.y);if(dp<250&&dc<320&&dc<bd){bd=dc;best=e;boss=false;}}
  for(const b of bosses){if(b.st==='dead'||b.st==='enter')continue;const dp=hyp(b.x-P.x,b.y-P.y),dc=hyp(b.x-c.x,b.y-c.y);if(dp<230&&dc<300&&dc<bd){bd=dc;best=b;boss=true;}}
  if(best){c.dash={t:best,time:0,boss};}else c.atkT=0.3;}
function catGuard(src){const c=CAT;if(!catOn||!c||mode==='walk'||(c.shT||0)>0||P.st==='asleep')return false;if(hyp(c.x-P.x,c.y-P.y)>230)return false;
  c.shT=save.difficulty==='easy'?7:10;c.guardFx=0.9;c.dash=null;P.inv=Math.max(P.inv,1.0);
  if(src){const dx=src.x-P.x,dy=src.y-P.y,dd=hyp(dx,dy)||1;c.x=P.x+dx/dd*charPx*0.3;c.y=P.y+dy/dd*charPx*0.18+6;c.vx=0;c.vy=0;}
  burst(c.x,c.y-charPx*0.2,'#fff3c2',22,210);for(let i=0;i<6;i++)part(FX.heart('#f19bb5'),c.x,c.y-charPx*0.3,rr(-90,90),rr(-160,-60),1,{g:140,s:0.6,s2:0.3});
  ftext(c.x,c.y-charPx*0.55,'ねこガード！','#fff3c2');sfx('guard');banner('黒猫が まもってくれた！',1.4);return true;}
function updateCamera(dt){if(!P)return;const tx=P.x+P.vx*0.22-VW/2,ty=P.y-charPx*0.35+P.vy*0.22-VH/2-(fm&&fm.type==='gates'&&fm.res==null?VH*0.15:mode==='tutorial'?VH*0.1:0);const a=1-Math.exp(-dt*5);
  cam.x+=(tx-cam.x)*a;cam.y+=(ty-cam.y)*a;cam.x=clamp(cam.x,Math.min(0,world.W-VW),Math.max(0,world.W-VW));
  const g=backdropGeom(),y0=g?g.topY:-60,y1=g?g.stripBot-VH:world.H-VH;cam.y=clamp(cam.y,y0,Math.max(y0,y1));}

/* ============ goddess ============ */
$('btnGoddess').addEventListener('click',()=>{if(permanentGoddess()){banner('女神の光は<small>衣装を着ている間 ずっと つづくよ</small>',1.5);return;}if(state!=='play'||fm||P.god>0||P.gauge<1)return;
  if(P.godLeft<=0&&mode!=='walk'){banner(`女神へんしんは<small>このステージでは もう つかえません（${P.godMax}回まで）</small>`,1.8);return;}
  if(mode!=='walk')P.godLeft--;sfx('goddess');P.god=12;P.gauge=0;P.inv=0;if(P.st==='drowsy'||P.st==='asleep')wake();P.expr='happy';P.exprT=2;
  banner(`女神へんしん！<small>12秒間 敵の こうげきを うけません${P.godMax>1&&mode!=='walk'?`（あと ${P.godLeft}回）`:''}</small>`,1.8,{front:true});burst(P.x,P.y-charPx*0.5,'#fff3c2',40,300);shake=4;
  for(let i=0;i<16;i++){const a=rr(0,TAU),v=rr(150,240);part(gFeather(),P.x+Math.cos(a)*charPx*0.3,P.y-charPx*0.6+Math.sin(a)*charPx*0.3,Math.cos(a)*v,Math.sin(a)*v-60,1.6,{rot:rr(-1,1),vr:rr(-2,2),g:50,s:rr(0.42,0.62),s2:0.25,a:0.9});}for(let i=0;i<14;i++)part(FX.spark(pick(['#fff3c2','#ffd6ec','#e6dcff'])),P.x+rr(-60,60),P.y-charPx*rr(0.2,1.2),rr(-80,80),rr(-120,20),1,{s:rr(0.6,1.1),s2:0.1});});

/* ============ perform (clear show) ============ */
let lastUnlock=null,jumpUrl=null,jumpTimer=null,jumpSkipFn=null,jumpSkipAll=false;
function startPerform(){if(P.bare)restoreCostume(P.x,P.y-charPx*1.3);thief=null;state='perform';enemies.forEach(e=>burst(e.x,e.y-e.h*0.45,'#ffffff',8,120));enemies=[];ebul=[];traps=[];shots=[];P.god=0;P.st='awake';P.expr='happy';
  const giftBefore=GIFTS().filter(cosOpen).map(c=>c.id);bgm(null);sfx('clear');
  const first=!save.cleared[stageIdx];save.cleared[stageIdx]=true;
  clearTime=stTime;newBest=false;{const pb=save.best[stageIdx];if(pb==null||clearTime<pb-0.05){if(pb!=null){save.bestUp=(save.bestUp||0)+1;newBest=true;}save.best[stageIdx]=Math.round(clearTime*10)/10;}}
  syncOwned();writeSave();giftNew=GIFTS().filter(c=>cosOpen(c)&&!giftBefore.includes(c.id));
  lastUnlock=first?COSTUMES.find(c=>c.unlock===stageIdx+1)||null:null;
  const vid=ATLAS.jumps&&ATLAS.jumps[stage.vid||stage.theme];
  if(vid){perform={video:true,first};banner('ステージクリア！',1.3,{now:true});
    setTimeout(async()=>{if(!perform||!perform.video)return;jumpSkipAll=false;
      await playJump(vid,`${stage.jump} ジャンプ<small>※イメージ演出です（競技ジャンプの正確な再現ではありません）</small>`);
      if(stage.encore&&!jumpSkipAll&&perform)await playJump(ATLAS.jumps[stage.encoreVid],`特別アンコール！<br>アクセル ジャンプ<small>※イメージ演出です</small>`);
      endVideoPerform();},1300);
    return;}
  const jumps=[stage.jump];if(stage.encore)jumps.push('アクセル');
  perform={jumps,ji:0,ph:'banner',t:1.6,first};banner('ステージクリア！',1.6);$('btnSkip').classList.remove('hidden');}
function setupJump(){const name=perform.jumps[perform.ji],dir=(P.x<world.W/2)?1:-1;
  perform.name=name;perform.dir=dir;perform.axel=name==='アクセル';perform.ph='entry';perform.t=1.3;perform.sx=P.x;perform.sy=P.y;
  const cap=$('caption');cap.innerHTML=(perform.ji>0?'特別アンコール！<br>':'')+name+' ジャンプ<small>※イメージ演出です（競技のジャンプの正確な再現ではありません）</small>';cap.classList.remove('hidden');}
function updatePerform(dt){const pf=perform;if(pf.video){P.vx*=0.9;P.vy*=0.9;updateCat(dt);return;}pf.t-=dt;updateCat(dt);
  if(pf.ph==='banner'){P.vx*=0.9;P.vy*=0.9;if(pf.t<=0)setupJump();return;}
  const fwd=pf.axel,dir=pf.dir;
  if(pf.ph==='entry'){const u=1-pf.t/1.3;P.x=pf.sx+dir*190*ease(u);P.y=pf.sy-26*Math.sin(u*Math.PI);
    P.face=fwd?(dir>0?2:6):(dir>0?6:2);P.lean=-dir*0.05;if(R()<0.7)part(FX.spark('#e6f6ff'),P.x,P.y,rr(-30,30),rr(-30,0),0.5,{s:0.6,s2:0.1});
    if(pf.t<=0){pf.ph='air';pf.t=1.1;pf.ax=P.x;burst(P.x,P.y,'#ffffff',16,180);}}
  else if(pf.ph==='air'){const u=1-pf.t/1.1,rot=pf.axel?2.5:2,start=P.face;
    P.x=pf.ax+dir*130*u;P.lift=86*Math.sin(u*Math.PI);
    const idx=Math.floor(ease(u)*rot*8);const seq=[0,1,2,3,4,5,6,7];const base=fwd?(dir>0?2:6):(dir>0?6:2);
    P.face=seq[(base+(dir>0?idx:-idx)+800)%8];
    if(R()<0.9)part(FX.spark(pf.axel?'#fff3c2':'#ffd6e6'),P.x+rr(-20,20),P.y-P.lift-charPx*rr(0.1,0.8),rr(-40,40),rr(-40,40),0.6,{s:rr(0.5,1),s2:0.1});
    if(pf.t<=0){pf.ph='land';pf.t=0.6;P.lift=0;shake=3;for(let i=0;i<18;i++){const a=Math.PI+R()*Math.PI;part(FX.dot('#e6f6ff'),P.x,P.y,Math.cos(a)*rr(60,200),Math.sin(a)*rr(30,120),0.6,{s:rr(0.8,1.6),s2:0.2,g:200});}}}
  else if(pf.ph==='land'){P.x+=dir*60*dt;if(pf.t<0.3)P.face=0;if(pf.t<=0){pf.ph='pose';pf.t=1.8;P.face=0;
      for(let i=0;i<26;i++)part(FX.petal(pick(['#f19bb5','#ffd6e6','#f6c1cc'])),P.x+rr(-VW/2,VW/2),P.y-VH*0.6,rr(-30,30),rr(40,110),2.6,{vr:rr(-3,3),s:rr(0.6,1)});}}
  else if(pf.ph==='pose'){if(R()<0.15)if(catOn)part(FX.heart('#f19bb5'),CAT.x,CAT.y-charPx*0.35,rr(-30,30),-60,1,{s:0.7,s2:0.3});
    if(pf.t<=0){pf.ji++;if(pf.ji<pf.jumps.length){P.x=clamp(P.x,world.b.l+260,world.b.r-260);setupJump();}else finishPerform();}}}
function playJump(file,cap){return new Promise(async res=>{const ov=$('jumpOv'),img=$('jumpImg');let done=false;
  const fin=()=>{if(done)return;done=true;clearTimeout(jumpTimer);img.classList.remove('on');setTimeout(res,350);};
  jumpSkipFn=()=>{jumpSkipAll=true;fin();};
  $('jumpCap').innerHTML=cap;img.classList.remove('on');ov.classList.remove('hidden');
  try{const blob=await(await fetch(ASSETS[file]||BASE+file)).blob();if(jumpUrl)URL.revokeObjectURL(jumpUrl);jumpUrl=URL.createObjectURL(blob);
    img.onload=()=>{img.classList.add('on');jumpTimer=setTimeout(fin,3000+1400);};img.onerror=()=>fin();img.src=jumpUrl;
    jumpTimer=setTimeout(fin,9000);}catch(e){fin();}});}
function endVideoPerform(){$('jumpOv').classList.add('hidden');const img=$('jumpImg');img.classList.remove('on');img.removeAttribute('src');
  if(jumpUrl){URL.revokeObjectURL(jumpUrl);jumpUrl=null;}if(!perform)return;const f=perform.first;perform=null;afterPerform(f);}
$('btnJumpSkip').addEventListener('click',()=>{if(jumpSkipFn)jumpSkipFn();});
function finishPerform(){if(!perform)return;const f=perform.first;perform=null;P.lift=0;P.face=0;$('caption').classList.add('hidden');$('btnSkip').classList.add('hidden');afterPerform(f);}
$('btnSkip').addEventListener('click',finishPerform);

/* ============ render ============ */
function render(){
  ctx.setTransform(DPR,0,0,DPR,0,0);
  if(!world||!P){ctx.fillStyle='#f6efe2';ctx.fillRect(0,0,VW,VH);return;}
  const sx=shake?rr(-shake,shake):0,sy=shake?rr(-shake,shake):0;
  const ox=Math.round((cam.x+sx)*DPR)/DPR,oy=Math.round((cam.y+sy)*DPR)/DPR;
  ctx.setTransform(DPR,0,0,DPR,-ox*DPR,-oy*DPR);
  const x0=ox,y0=oy,x1=ox+VW,y1=oy+VH;
  // ground
  const gt=groundTile(world.tid);const tx0=Math.floor(x0/TILE)*TILE,ty0=Math.floor(y0/TILE)*TILE;
  for(let y=ty0;y<y1;y+=TILE)for(let x=tx0;x<x1;x+=TILE)ctx.drawImage(gt,x,y,TILE,TILE);
  {const gd=ATLAS.ground&&ATLAS.ground[world.tid],dimg=gd&&imgOf(gd.decals);
    if(dimg&&world.decals)for(const d of world.decals){const q=gd.rects[d.i];if(!q)continue;const w=q[2]*d.s,h=q[3]*d.s;if(d.x+w<x0||d.x-w>x1||d.y+h<y0||d.y-h>y1)continue;
      ctx.save();ctx.translate(d.x,d.y);if(d.f)ctx.scale(-1,1);ctx.drawImage(dimg,q[0],q[1],q[2],q[3],-w/2,-h/2,w,h);ctx.restore();}}
  // art floors + small art deco
  if(world.mounds)for(const m of world.mounds){if(m.x+m.rx<x0||m.x-m.rx>x1||m.y+m.ry<y0||m.y-m.ry>y1)continue;ctx.save();ctx.translate(m.x,m.y);ctx.scale(1,m.ry/m.rx);const g=ctx.createRadialGradient(0,0,m.rx*0.2,0,0,m.rx);g.addColorStop(0,m.col);g.addColorStop(1,'rgba(0,0,0,0)');ctx.fillStyle=g;ctx.beginPath();ctx.arc(0,0,m.rx,0,TAU);ctx.fill();ctx.restore();}
  if(world.set){const oi=objImg();if(oi){for(const f of world.floors){const it=artRect(f.k);if(!it)continue;const h=f.w*it[3]/it[2];if(f.x+f.w<x0||f.x-f.w>x1||f.y+h<y0||f.y-h>y1)continue;ctx.drawImage(oi,it[0],it[1],it[2],it[3],f.x-f.w/2,f.y-h/2,f.w,h);}
    for(const d of world.sdeco){if(d.x<x0-40||d.x>x1+40||d.y<y0-10||d.y>y1+50)continue;drawArt(d.k,d.x,d.y,d.h,{flip:d.f});}}}
  // deco
  for(const d of world.deco){if(d.x<x0-30||d.x>x1+30||d.y<y0-30||d.y>y1+30)continue;const s=decoSprite(d.k);
    let a=1;if(d.k==='firefly')a=0.35+0.65*Math.abs(Math.sin(time*1.6+d.ph));ctx.globalAlpha=a;ctx.drawImage(s,d.x-s.cw/2*d.s,d.y-s.ch/2*d.s,s.cw*d.s,s.ch*d.s);}
  ctx.globalAlpha=1;
  const BG=backdropGeom();
  if(BG){const px=world.W-VW>0?cam.x-(cam.x/(world.W-VW))*(BG.bw-VW):(world.W-BG.bw)/2;ctx.drawImage(BG.a.top,px,BG.topY,BG.bw,BG.a.top.height*BG.s);}
  drawEdges(x0,y0,x1,y1);
  // traps (ground)
  for(const t of traps){const u=1-clamp(t.t/1.5,0,1);ctx.save();ctx.globalAlpha=t.boom?t.boom/0.3:0.35+0.4*u;ctx.strokeStyle='#b8862a';ctx.fillStyle=rgba('#f2c94c',0.18+0.25*u);ctx.lineWidth=3;
    ctx.beginPath();ctx.ellipse(t.x,t.y,t.r,t.r*0.55,0,0,TAU);ctx.fill();ctx.stroke();ctx.restore();if(!t.boom)drawFx(FX.gear('#3b3f7a'),t.x,t.y-6,time*3,1,0.9);}
  // boss telegraph
  for(const b of bosses)if(b.st==='wind'&&(b.id==='hikaru'||b.id==='takumi'||(b.id==='cat'&&b.cyc%2===0))){ctx.save();ctx.globalAlpha=0.25+0.25*Math.sin(time*30);ctx.strokeStyle='#e0524f';ctx.lineWidth=charPx*0.3;ctx.lineCap='round';
      ctx.beginPath();ctx.moveTo(b.x,b.y);ctx.lineTo(b.x+Math.cos(b.aim)*(b.id==='hikaru'?300:60),b.y+Math.sin(b.aim)*(b.id==='hikaru'?300:60));ctx.stroke();ctx.restore();}
  // shadows
  const sh=(x,y,rx,a)=>{ctx.fillStyle=`rgba(60,40,30,${a})`;ctx.beginPath();ctx.ellipse(x,y,rx,rx*0.32,0,0,TAU);ctx.fill();};
  if(world.th.dark)ctx.globalCompositeOperation='source-over';
  sh(P.x,P.y+2,charPx*0.2*(1-P.lift/200),0.2);if(catOn)sh(CAT.x,CAT.y+2,charPx*0.12,0.18);
  for(const e of enemies)sh(e.x,e.y+2,e.r*1.2,0.18);for(const b of bosses){sh(b.x,b.y+2,charPx*0.2,0.2);if(b.pal)sh(b.pal.x,b.pal.y+2,charPx*0.14,0.16);}
  for(const o of world.obst)sh(o.x,o.y+o.cy*0.2,o.r*1.25,0.16);
  // sorted drawables
  const L=[];
  for(const o of world.obst){if(o.x+o.w<x0||o.x-o.w>x1||o.y<y0-10||o.y-o.h>y1)continue;L.push({y:o.y,f:()=>drawObst(o)});}
  for(const c of world.chests){if(c.x<x0-60||c.x>x1+60||c.y<y0-60||c.y>y1+60)continue;L.push({y:c.y,f:()=>drawChest(c)});}
  const gh=f=>fm&&fmFrozen()?()=>{ctx.save();ctx.globalAlpha=0.28;f();ctx.restore();}:f;
  for(const e of enemies)L.push({y:e.y,f:gh(()=>drawEnemy(e))});
  for(const b of bosses){L.push({y:b.y,f:gh(()=>drawBoss(b))});if(b.pal)L.push({y:b.pal.y,f:gh(()=>drawPal(b))});}
  if(fm&&fm.foes)for(const f of fm.foes)if(!f.gone||f.die>0)L.push({y:f.y,f:()=>drawFoe(f)});
  if(catOn)L.push({y:CAT.y,f:drawCat});L.push({y:P.y+0.5,f:drawPlayer});
  L.sort((a,b)=>a.y-b.y);for(const d of L)d.f();
  if(BG)ctx.drawImage(BG.a.strip,0,BG.stripY,world.W,BG.a.strip.height*BG.sw);
  // glows (lanterns, mushrooms, crystals)
  {ctx.save();ctx.globalCompositeOperation='lighter';for(const o of world.obst)if(o.glow){if(o.x<x0-120||o.x>x1+120||o.y<y0-40||o.y-o.h>y1+40)continue;const A=(world.th.dark?0.55:0.32)+0.08*Math.sin(time*2+o.x);
    if(Array.isArray(o.glow)){drawFx(FX.glow(o.glow[0]),o.x,o.y-o.h*o.glow[1],0,A,o.glow[2]);continue;}
    const c=o.k==='lantern'?'#ffd98a':o.k==='shroom'?'#f6dcff':'#d8ecff';drawFx(FX.glow(c),o.x,o.y-o.h*(o.k==='lantern'?0.8:0.55),0,A,o.k==='lantern'?2.2:1.8);}ctx.restore();}
  if(fm)drawFieldTop();
  drawPops();drawCatReq();
  // shots
  for(const s of shots)drawFx(s.spr,s.x,s.y,s.rot,1,s.s);
  for(const u of ebul){const spr=u.kind==='star'?FX.ebul('#d9822b'):u.kind==='petal'?FX.ebul('#9a6ad0'):u.kind==='curse'?FX.ebul('#5b2a86'):FX.ebul('#3b3f7a');drawFx(spr,u.x,u.y,u.rot,1,1);}
  for(const o of orbs){ctx.save();ctx.globalCompositeOperation='lighter';drawFx(FX.glow('#fff3c2'),o.x,o.y,0,0.9,1.1);ctx.restore();const ic=costumeIcon(save.costume);if(ic)ctx.drawImage(ic,o.x-16,o.y-16,32,32);}
  // particles
  for(const p of parts){const u=p.life/p.max;drawFx(p.spr,p.x,p.y,p.rot,(p.fade?Math.min(1,u*1.6):1)*p.a,lerp(p.s2,p.s,u));}
  // texts
  ctx.save();ctx.textAlign='center';ctx.font=`bold 15px ${getComputedStyle(document.body).fontFamily}`;ctx.lineJoin='round';
  for(const t of texts){ctx.globalAlpha=Math.min(1,t.life*2);ctx.lineWidth=4;ctx.strokeStyle='rgba(90,40,50,.85)';ctx.strokeText(t.t,t.x,t.y);ctx.fillStyle=t.col;ctx.fillText(t.t,t.x,t.y);}
  ctx.restore();ctx.globalAlpha=1;
  for(const bb of bubbles)drawBubble(bb);
  // screen space
  ctx.setTransform(DPR,0,0,DPR,0,0);
  if(world.th.dark){ctx.fillStyle='rgba(30,30,70,0.12)';ctx.fillRect(0,0,VW,VH);}
  if(goddessPower()){ctx.fillStyle=`rgba(255,240,190,${0.10+0.05*Math.sin(time*6)})`;ctx.fillRect(0,0,VW,VH);}
  ctx.drawImage(vignette,0,0,VW,VH);
  if(state==='play'){
    if(P.bare&&isAlive(thief)){const t=thief;drawPointer(t.x,t.h?t.y-t.h*0.5:t.y-charPx*0.5,ox,oy,costumeIcon(save.costume),'#c45a72');}
    if(tut&&tut.target&&!tut.target.open)drawPointer(tut.target.x,tut.target.y-24,ox,oy,chestIcon(),'#c9a24a');
    if(catReq&&!fm)drawPointer(catReq.x,catReq.y-20,ox,oy,reqIcon(catReq.art),'#e58aa8');
    for(const c of world.chests)if(c.type==='star'&&!c.open&&!fm)drawPointer(c.x,c.y-30,ox,oy,starIcon(c.star),'#c9a24a');
    if(fm&&fm.foes&&fm.res==null)for(const f of fm.foes)if(!f.gone)drawPointer(f.x,f.y-f.h*0.5,ox,oy,lvIcon(f.lv,f.boss),f.boss?'#c9a24a':'#8a64b8');}
  drawJoystick();
}
function drawEdges(x0,y0,x1,y1){const b=world.b;
  if(world.set&&world.set.edge&&objImg()){const E=world.set.edge;let i=0;
    for(let y=b.t-10;y<b.b+60;y+=34){for(const [x,dy] of[[b.l-46,0],[b.l-92,17],[b.r+46,0],[b.r+92,17]]){const yy=y+dy;i++;if(x<x0-80||x>x1+80||yy<y0-80||yy>y1+90)continue;const k=E[(i+((y/34)|0))%E.length];drawArt(k,x,yy+22,(SDECO_H[k]?52:OBJ[k]?Math.min(64,OBJ[k].h):58),{flip:i%2===0});}}
    return;}
  const e=world.th.edge,hs=e==='planter'?planterSprite():hedgeSprite(e==='hedgeN'?1:0);
  const put=(x,y)=>{if(x<x0-70||x>x1+70||y<y0-70||y>y1+70)return;ctx.drawImage(hs,x-35,y-40,70,60);};
  for(let y=b.t-10;y<b.b+60;y+=e==='planter'?52:36){put(b.l-48,y);put(b.l-90,y+18);put(b.r+48,y);put(b.r+90,y+18);}}
function drawObst(o){let a=1;
  if(o.tall&&P.y<o.y&&P.y>o.y-o.h*0.9&&Math.abs(P.x-o.x)<o.w*0.5)a=0.5;
  if(o.art){drawArt(o.k,o.x,o.y+2,o.h,{flip:o.f,alpha:a});return;}
  const s=obstSprite(o.k,o.v);
  ctx.globalAlpha=a;ctx.drawImage(s,o.x-o.w/2,o.y-o.h,o.w,o.h);ctx.globalAlpha=1;}
function chestSprite(open){return tcache('chest'+open,()=>mk(60,56,x=>{
  x.fillStyle='#8a5a36';x.beginPath();x.roundRect?x.roundRect(6,24,48,28,6):x.rect(6,24,48,28);x.fill();
  x.fillStyle='#c9a24a';x.fillRect(6,34,48,5);x.fillRect(16,24,5,28);x.fillRect(39,24,5,28);
  if(open){x.fillStyle='#fff3b0';x.fillRect(9,20,42,8);wcBlob(x,30,20,24,'#fff3b0',0.9);x.fillStyle='#7a4e2e';x.beginPath();x.ellipse(30,10,24,9,0,0,TAU);x.fill();}
  else{x.fillStyle='#9b6a42';x.beginPath();x.moveTo(6,26);x.quadraticCurveTo(30,4,54,26);x.closePath();x.fill();x.fillStyle='#c9a24a';x.fillRect(16,12,5,14);x.fillRect(39,12,5,14);
    x.fillStyle='#f2d27a';x.beginPath();x.arc(30,32,5,0,TAU);x.fill();}
  x.strokeStyle='rgba(60,30,20,.45)';x.lineWidth=1.5;x.strokeRect(6,24,48,28);}));}
const CHEST_ART={match3:'chest_r',gates:'chest_b',battle:'chest_p',star:'chest_w'};
function drawChest(c){const bob=c.open?0:Math.sin(time*3+c.x)*2,ak=(CHEST_ART[c.type]||'chest_r')+(c.open?'_o':'');
  if(artRect(ak)&&objImg()){if(c.type==='star'&&!c.open){const S=STARS[c.star];ctx.save();ctx.globalCompositeOperation='lighter';drawFx(FX.glow(S.col),c.x,c.y-30,0,0.55+0.25*Math.sin(time*3),2.8);ctx.restore();
      if(R()<0.12)part(FX.spark(pick(['#fff3c2',S.col])),c.x+rr(-40,40),c.y-rr(10,80),rr(-10,10),-30,0.9,{s:rr(0.5,0.9),s2:0.1});
      drawArt(ak,c.x,c.y+4+bob,62);drawArt(S.art,c.x,c.y-74+Math.sin(time*2.4)*5,34,{});return;}
    if(!c.open){ctx.save();ctx.globalCompositeOperation='lighter';drawFx(FX.glow(c.type==='gates'?'#cfe2ff':c.type==='battle'?'#ead6ff':'#ffe9a0'),c.x,c.y-26,0,0.35+0.2*Math.sin(time*4),1.7);ctx.restore();
      if(R()<0.04)part(FX.spark('#fff3c2'),c.x+rr(-24,24),c.y-rr(10,50),0,-20,0.7,{s:0.6,s2:0.1});}
    drawArt(ak,c.x,c.y+4+bob,c.type==='star'?(c.open?70:62):c.open?62:54,{alpha:c.open?Math.max(0.55,1-c.t*0.2):1});return;}
  const s=chestSprite(c.open);
  if(!c.open){ctx.save();ctx.globalCompositeOperation='lighter';drawFx(FX.glow('#ffe9a0'),c.x,c.y-24,0,0.35+0.2*Math.sin(time*4),1.6);ctx.restore();
    if(R()<0.04)part(FX.spark('#fff3c2'),c.x+rr(-24,24),c.y-rr(10,50),0,-20,0.7,{s:0.6,s2:0.1});}
  ctx.drawImage(s,c.x-30,c.y-52+bob,60,56);}
function drawEnemy(e){const sc=e.h/ATLAS.enemy.charH,mv=hyp(e.vx,e.vy)>10,hop=e.fly?12+Math.sin(e.bob*0.5)*6:Math.abs(Math.sin(e.bob))*(mv?6:2);
  const wind=e.wind>0?Math.sin(time*60)*2:0;
  if(e.tier===2){ctx.save();ctx.globalCompositeOperation='lighter';drawFx(FX.glow('#ffe08a'),e.x,e.y-e.h*0.45,0,0.25+0.12*Math.sin(time*5+e.bob),e.h*1.3/64);ctx.restore();}
  drawSprite(enemyFrame(e.kind,e.tier),e.x+wind,e.y-hop,sc,{flip:e.flip,sy:1+Math.sin(e.bob*2)*0.03,flash:e.hit>0?0.6:0});
  if(e.thief)drawThiefBadge(e.x,e.y-hop-e.h-16);
  if(e.tier>0||e.hp<e.maxHp){const w=e.h*0.55;ctx.fillStyle='rgba(255,255,255,.7)';ctx.fillRect(e.x-w/2,e.y+6,w,4);ctx.fillStyle='#d9534f';ctx.fillRect(e.x-w/2,e.y+6,w*clamp(e.hp/e.maxHp,0,1),4);}}
function drawPal(b){const p=b.pal;if(!p)return;const info=ATLAS.partner[p.kind],h=charPx*EKIND[p.kind].size,sc=h/info.charH,hop=Math.abs(Math.sin(p.hop))*4;
  const a=b.st==='dead'?clamp(b.t/1.4,0,1):1;
  ctx.save();ctx.globalAlpha=0.55*a;ctx.strokeStyle=BOSSES[b.id].col;ctx.lineWidth=3;ctx.beginPath();ctx.ellipse(p.x,p.y+2,h*0.34,h*0.11,0,0,TAU);ctx.stroke();ctx.restore();
  drawSprite(partnerFrame(p.kind,p.face),p.x,p.y-hop,sc,{alpha:a});}
function drawCursedCat(b,a,fl){const ck=charPx*0.72/ATLAS.cat.charH,bob=Math.sin(time*4+b.x)*3;
  ctx.save();ctx.globalCompositeOperation='multiply';drawFx(FX.glow('#5b2a86'),b.x,b.y-charPx*0.15,0,0.55*a,3.2);ctx.restore();
  if(R()<0.35)part(FX.glow('#6b3fa0'),b.x+rr(-40,40),b.y-rr(0,charPx*0.8),rr(-15,15),rr(-40,-15),1.0,{s:rr(0.3,0.6),s2:0.9});
  drawSprite(catFrame(b.face),b.x,b.y-bob-(b.st==='dash'?6:0),ck,{alpha:a,flash:fl,tint:'rgba(70,25,115,0.42)'});
  if(b.thief&&b.st!=='dead')drawThiefBadge(b.x,b.y-charPx*0.95);}
function drawBoss(b){if(b.id==='cat'){let a=b.st==='dead'?clamp(b.t/0.6,0,1):1,fl=b.hit>0?0.55:b.st==='wind'?0.25+0.25*Math.sin(time*40):0;drawCursedCat(b,a,fl);return;}
  const fr=bFrame(b.id,b.face),bob=Math.sin(time*5+b.x)*1.5;let a=1,fl=b.hit>0?0.55:0;
  if(b.st==='dead'){a=clamp(b.t/1.4,0,1);}if(b.st==='wind')fl=0.25+0.25*Math.sin(time*40);
  if(b.st==='enter'){ctx.save();ctx.globalCompositeOperation='lighter';drawFx(FX.glow('#fff3c2'),b.x,b.y-charPx*0.5,0,0.6,3);ctx.restore();}
  drawSprite(fr,b.x,b.y-bob-(b.st==='dash'?6:0),K,{alpha:a,flash:fl,rot:b.st==='dead'?(1-a)*0.5:0});
  if(b.thief&&b.st!=='dead')drawThiefBadge(b.x,b.y-charPx*1.08);}
const iconCache=new Map();
function costumeIcon(cid){cid=thumbId(cid);const k=cid+'|'+DPR;let c=iconCache.get(k);if(c)return c;const f=thumbFrame(cid);const img=imgOf(f.file);if(!img)return null;c=mk(40,40,(x,w)=>{x.save();x.beginPath();x.arc(20,20,18,0,TAU);x.fillStyle='#fffaf0';x.fill();x.clip();
    x.drawImage(img,f.sx+f.sw*0.18,f.sy+f.sh*0.02,f.sw*0.64,f.sw*0.64,2,2,36,36);x.restore();
    x.strokeStyle='#e6bf5a';x.lineWidth=2.5;x.beginPath();x.arc(20,20,18,0,TAU);x.stroke();});iconCache.set(k,c);return c;}
function drawThiefBadge(x,y){const bob=Math.sin(time*4)*4,ic=costumeIcon(save.costume);
  ctx.save();ctx.globalCompositeOperation='lighter';drawFx(FX.glow('#fff3c2'),x,y+bob,0,0.55+0.2*Math.sin(time*6),1.3);ctx.restore();
  if(ic)ctx.drawImage(ic,x-20,y-20+bob,40,40);
  drawFx(FX.star('#f2c94c'),x+17,y-15+bob,time*2,1,0.55);}
function drawPointer(wx,wy,ox,oy,icon,col){const sx=wx-ox,sy=wy-oy,m=34,top=150,bot=VH-110;
  if(sx>m&&sx<VW-m&&sy>top&&sy<bot)return;
  const cx=clamp(sx,m,VW-m),cy=clamp(sy,top,bot),a=Math.atan2(sy-cy,sx-cx),pul=1+0.08*Math.sin(time*8);
  ctx.save();ctx.translate(cx,cy);ctx.scale(pul,pul);
  ctx.save();ctx.rotate(a);ctx.fillStyle=col||'#c45a72';ctx.beginPath();ctx.moveTo(34,0);ctx.lineTo(18,-11);ctx.lineTo(18,11);ctx.closePath();ctx.fill();ctx.restore();
  ctx.fillStyle='rgba(255,250,240,.95)';ctx.strokeStyle=col||'#c45a72';ctx.lineWidth=3;ctx.beginPath();ctx.arc(0,0,22,0,TAU);ctx.fill();ctx.stroke();
  if(icon)ctx.drawImage(icon,-18,-18,36,36);ctx.restore();}
const chestIcon=()=>tcache('chestIcon',()=>mk(36,36,x=>{x.drawImage(chestSprite(false),2,4,32,30);}));
function drawCat(){if(!catOn||!CAT)return;const c=CAT,ck=charPx*0.42/ATLAS.cat.charH;let fr,flip=false,hop=0;
  if(c.pose==='sleep'||c.pose==='sit_drowsy'){fr=catPose(c.pose);}
  else if(c.pose==='run'||c.pose==='walk'){fr=catPose(c.pose);flip=c.flip;hop=Math.abs(Math.sin(c.hop))*(c.pose==='run'?7:3);}
  else if(c.pose==='happy'){fr=catPose(Math.sin(time*2)>0?'look':'stand');hop=Math.abs(Math.sin(time*7))*9;}
  else{fr=catFrame(c.face);hop=Math.abs(Math.sin(c.hop))*3;}
  const cu=scene?Math.round(scene.curse*10)/10:0;
  if(c.guardFx>0){ctx.save();ctx.globalCompositeOperation='lighter';drawFx(FX.glow('#fff3c2'),c.x,c.y-charPx*0.15,0,c.guardFx,2.2);ctx.restore();ctx.save();ctx.globalAlpha=Math.min(1,c.guardFx*1.4);ctx.strokeStyle='#f2c94c';ctx.lineWidth=3;ctx.beginPath();ctx.arc(c.x,c.y-charPx*0.16,charPx*0.24*(1.3-c.guardFx*0.3),0,TAU);ctx.stroke();ctx.restore();}
  if(scene&&scene.curse>0)drawFx(FX.glow('#a07ad0'),c.x,c.y-charPx*0.12,0,scene.curse*0.45*scene.fade,1.6);
  drawSprite(fr,c.x+(scene&&scene.curse>0.3?Math.sin(time*40)*2:0),c.y-hop,ck,{flip,alpha:scene?scene.fade:1,tint:cu>0?`rgba(80,30,125,${(0.6*cu).toFixed(2)})`:null});
  if(c.pose==='sleep'&&R()<0.02)texts.push({x:c.x+14,y:c.y-charPx*0.25,t:'z',col:'#e9dcff',life:1});}
function drawPlayer(){const god=P.god>0,cid=god?'goddess':P.bare?'base':save.costume;let fr,o={rot:P.lean},y=P.y-P.lift-(state==='play'?Math.sin(time*2.4)*2.2:0);
  const basic=cid==='basic';
  if(P.dead){fr=yFrame(cid,0);o.rot=Math.sin(time*10)*0.12;o.alpha=0.85;}
  else if(P.st==='asleep'&&basic){fr=poseFrame('sleep');o.rot=0;y=P.y;}
  else if(P.st==='drowsy'&&basic){fr=poseFrame('doze');o.rot=Math.sin(time*1.3)*0.03;y=P.y;}
  else if(P.st==='waking'&&basic&&hyp(P.vx,P.vy)<30){fr=poseFrame('wake');o.rot=0;}
  else{fr=yFrame(cid,P.face);if(P.st==='drowsy'||P.st==='asleep'){o.rot=Math.sin(time*1.3)*0.06;}}
  if(P.inv>0&&!god)o.alpha=(Math.floor(time*14)%2)?0.45:1;
  if(god){ctx.save();ctx.globalCompositeOperation='lighter';drawFx(FX.glow('#fff3c2'),P.x,P.y-charPx*0.5,0,0.4+0.12*Math.sin(time*5),charPx/28);ctx.restore();}
  else if(!P.bare&&costume().goddessAura){ctx.save();ctx.globalCompositeOperation='lighter';drawFx(FX.glow(costume().goddessAura),P.x,P.y-charPx*0.5,0,0.32+0.1*Math.sin(time*3),charPx/30);ctx.restore();}
  const sp=hyp(P.vx,P.vy);
  if(state==='play'&&sp>save.speed.max*0.6&&P.st==='awake'){for(let i=2;i<P.trail.length;i+=1){const t=P.trail[i];drawSprite(yFrame(cid,t.face),t.x,t.y-P.lift,K,{rot:t.lean,alpha:0.16-i*0.03});}}
  drawSprite(fr,P.x,y,K,o);
  if(P.shield>0&&!P.dead){ctx.save();ctx.globalCompositeOperation='lighter';drawFx(FX.glow('#fff3c2'),P.x,P.y-charPx*0.5,0,0.35+0.1*Math.sin(time*4),charPx/36);ctx.restore();drawFx(FX.ring('#f2c94c'),P.x,P.y-charPx*0.5,time,0.55,charPx/40);}
  if(P.st==='asleep'&&!basic&&R()<0.03)texts.push({x:P.x+charPx*0.3,y:P.y-charPx*0.9,t:'Z',col:'#cdb8ff',life:1.2});
  if(P.st==='asleep'&&R()<0.012)texts.push({x:P.x+charPx*0.35,y:P.y-charPx*0.55,t:'z',col:'#e9dcff',life:1.3});
  if(P.dead)for(let i=0;i<3;i++)drawFx(FX.star('#f2c94c'),P.x+Math.cos(time*4+i*2.1)*charPx*0.25,P.y-charPx*1.02+Math.sin(time*4+i*2.1)*8,time*3,1,0.6);}
function drawBubble(bb){let x,y;if(bb.who==='p'){x=P.x;y=P.y-charPx*1.1;}else{const b=bosses.find(q=>q.id===bb.who);if(!b)return;x=b.x;y=b.y-charPx*1.12;}
  ctx.save();ctx.globalAlpha=Math.min(1,bb.life*3);ctx.font=`bold 15px ${getComputedStyle(document.body).fontFamily}`;
  const maxW=Math.min(230,VW*0.7),words=[...bb.text],lines=[];let cur='';for(const ch of words){if(ctx.measureText(cur+ch).width>maxW-20){lines.push(cur);cur=ch;}else cur+=ch;}if(cur)lines.push(cur);
  const w=Math.min(maxW,Math.max(...lines.map(l=>ctx.measureText(l).width))+22),h=lines.length*20+14;x=clamp(x,cam.x+w/2+6,cam.x+VW-w/2-6);y=Math.max(y,cam.y+h+150);
  ctx.fillStyle='rgba(255,255,255,.96)';ctx.strokeStyle='#5a3a2e';ctx.lineWidth=2;ctx.beginPath();ctx.roundRect?ctx.roundRect(x-w/2,y-h,w,h,12):ctx.rect(x-w/2,y-h,w,h);ctx.fill();ctx.stroke();
  ctx.beginPath();ctx.moveTo(x-8,y-1);ctx.lineTo(x,y+10);ctx.lineTo(x+8,y-1);ctx.fill();ctx.beginPath();ctx.moveTo(x-8,y);ctx.lineTo(x,y+10);ctx.lineTo(x+8,y);ctx.stroke();
  ctx.fillStyle='#5a3a2e';ctx.textAlign='center';lines.forEach((l,i)=>ctx.fillText(l,x,y-h+24+i*20-4));ctx.restore();}
function drawJoystick(){if(!input.on||state!=='play')return;const S=save.speed,dx=input.x-input.ox,dy=input.y-input.oy,d=hyp(dx,dy),t=clamp((d-8)/(S.drag-8),0,1);
  ctx.save();ctx.globalAlpha=0.55;ctx.strokeStyle='#fff';ctx.lineWidth=3;ctx.beginPath();ctx.arc(input.ox,input.oy,S.drag,0,TAU);ctx.stroke();
  ctx.strokeStyle=t>0.85?'#f2c94c':'rgba(255,255,255,.8)';ctx.lineWidth=5;ctx.beginPath();ctx.arc(input.ox,input.oy,S.drag,-Math.PI/2,-Math.PI/2+TAU*t);ctx.stroke();
  const k=Math.min(d,S.drag);ctx.globalAlpha=0.8;ctx.fillStyle=t>0.85?'#f7dd8a':'#fff';ctx.beginPath();ctx.arc(input.ox+(d?dx/d*k:0),input.oy+(d?dy/d*k:0),16,0,TAU);ctx.fill();ctx.restore();}

/* ============ HUD ============ */
const HEART_SVG=(fill,stroke)=>`<svg viewBox="0 0 24 22"><path d="M12 21C5 15 1 11.5 1 7a5.5 5.5 0 0 1 11-1 5.5 5.5 0 0 1 11 1c0 4.5-4 8-11 14z" fill="${fill||'rgba(255,255,255,.55)'}" stroke="${stroke||'#fff'}" stroke-width="1.6"/></svg>`;
function buildHearts(){if(!P)return;let h='';
  if(!P.bare){if(hardMode())h+='<span class="hlabel" style="background:#7a5a8a">ハード</span>';for(let i=0;i<P.maxGuard;i++)h+=HEART_SVG(i<P.guard?'#e0526e':null);}
  else{h+='<span class="hlabel">素体</span>';for(let i=0;i<P.maxBare;i++)h+=HEART_SVG(i<P.bareHp?'#ffffff':null,'#e07a8e');}
  if(P.shield>0)h+='<span class="hshield">✦</span>';
  $('hearts').innerHTML=h;$('portrait').classList.toggle('bare',!!P.bare);}
let lastGoals='';
function updateGoals(force){const g=$('goals');if(mode!=='play'){if(lastGoals){g.innerHTML='';lastGoals='';}return;}
  const items=[['敵',kills,stage.kills],['宝箱',chestsOpen,stage.chests],['ボス',bossesDown,stage.bosses.length]];
  const s=(P&&P.bare?'<div class="goal bare">★ 衣装マークの敵を たおす</div>':'')+items.map(([n,a,b])=>`<div class="goal ${a>=b?'done':''}">${n}<b>${Math.min(a,b)}/${b}</b>${a>=b?' ✓':''}</div>`).join('');
  if(force||s!==lastGoals){g.innerHTML=s;lastGoals=s;fitGoals();}}
/* v8.3.22: 箱が 1行に おさまるまで 文字を 1px ずつ 小さくする（18px → 最小 10px） */
function fitGoals(){const row=$('goalRow'),g=$('goals');if(!row||!g)return;
  row.classList.remove('gfit');row.style.removeProperty('--gfs');
  const bb=$('bossBar'),boss=!bb.classList.contains('hidden');
  const avail=()=>row.clientWidth-(boss?(bb.getBoundingClientRect().width>0?Math.min(bb.getBoundingClientRect().width,84)+6:0):0);
  const bare=g.querySelector('.goal.bare');if(bare)bare.textContent='★ 衣装マークの敵を たおす';
  if(!g.children.length||g.scrollWidth<=avail()+1)return;
  row.classList.add('gfit');const base=boss?15:18,fits=()=>g.scrollWidth<=avail()+1;
  const shrink=min=>{for(let fs=base;fs>=min;fs--){row.style.setProperty('--gfs',fs+'px');if(fits())return true;}return false;};
  if(shrink(13))return;
  if(bare){bare.textContent='★衣装マーク';if(shrink(11))return;}   /* せまい画面では 短い言い方に */
  shrink(10);}
window.addEventListener('resize',()=>{try{fitGoals();}catch(e){}});
let lastFace='',lastGauge=-1,lastUsed=null,lastWB=null;
function updateHUD(){{const ci=$('catIco'),show=catOn&&!!CAT&&mode!=='walk'&&(state==='play');if(ci.classList.contains('hidden')===show){ci.classList.toggle('hidden',!show);if(show&&!ci.dataset.d){const img=imgOf(ribbonKey(ATLAS.catface.file));if(img){drawNarrator(ci,'cat');ci.dataset.d=1;}}}if(show)ci.classList.toggle('cool',(CAT.shT||0)>0);}
updateGoals();
  {const wb=!$('bossBar').classList.contains('hidden');if(wb!==lastWB){lastWB=wb;$('goalRow').classList.toggle('withBoss',wb);fitGoals();}}
  const b=bosses.find(q=>q.st!=='dead')||bosses[0];if(b&&$('bossName').textContent!==BOSSES[b.id].name)$('bossName').textContent=BOSSES[b.id].name;if(b)$('bossHp').style.width=clamp(b.hp/b.maxHp*100,0,100)+'%';
  const perm=permanentGoddess(),used=!perm&&P.godLeft<=0&&P.god<=0&&mode!=='walk',gp=perm?1:P.god>0?P.god/12:used?0:P.gauge,gk=used+'|'+P.godLeft+'|'+perm;
  if(Math.abs(gp-lastGauge)>0.005||gk!==lastUsed){lastGauge=gp;lastUsed=gk;$('btnGoddess').dataset.n=P.godMax>1&&!used&&mode!=='walk'&&P.godLeft>0?'あと'+P.godLeft:'';$('gauge').style.width=(gp*100)+'%';const bt=$('btnGoddess');bt.style.setProperty('--p',(gp*100)+'%');
    bt.classList.toggle('ready',!perm&&!used&&P.god<=0&&P.gauge>=1);bt.classList.toggle('active',goddessPower());bt.classList.toggle('used',used);
    bt.firstChild.innerHTML=perm?'女神の光<br>いつも':used?'女神は<br>かえった':'女神<br>へんしん';}
  const fk=P.expr+'|'+P.bare+'|'+save.baseArt+'|'+(P.god>0);if(fk!==lastFace){lastFace=fk;drawFace();}
  if(save.meter){const sp=hyp(P.vx,P.vy);$('speedMeter').firstChild.style.width=clamp(sp/(save.speed.max*1.15)*100,0,100)+'%';}}
function drawFace(){const fc=$('faceCv'),x=fc.getContext('2d');x.clearRect(0,0,128,128);x.fillStyle='#fff6ea';x.fillRect(0,0,128,128);
  if(P&&P.bare&&P.god<=0){const f=yFrame('base',0),img=imgOf(f.file);if(!img)return;const H=ATLAS.yasuko.charH,top=f.fy-H,sz=H*((save.baseArt==='W'||save.baseArt==='N')?0.27:0.40);
    x.drawImage(img,f.sx+f.fx-sz/2,f.sy+top+H*0.035,sz,sz,0,0,128,128);return;}
  const img=imgOf(ATLAS.faces.file);if(!img)return;const cw=ATLAS.faces.cw,k=cw/360;
  const i=Math.max(0,ATLAS.faces.names.indexOf(P?P.expr:'smile')),c=i%3,r=(i/3)|0;
  x.drawImage(img,c*cw+70*k,r*cw+18*k,220*k,220*k,0,0,128,128);}

/* ============ screens ============ */
const SCREENS=['scrLoad','scrError','scrTitle','scrStages','scrWard','scrSettings','scrHelp','scrPause','scrClear','scrDefeat','scrMini','scrJournal','scrConfirm','scrPoster','scrReady','scrRecord','scrStamp','scrPhoto'];
let overlayReturn=null;
function showOnly(id){SCREENS.forEach(s=>$(s).classList.toggle('hidden',s!==id));}
function show(id){$(id).classList.remove('hidden');}
function hide(id){$(id).classList.add('hidden');}
function toTitle(){bgm('title');setTimeout(()=>{if(mode==='title')stampCheck();},350);mode='title';state='menu';tut=null;clearBanners();story=null;scene=null;$('storyWin').classList.add('hidden');$('storyDim').classList.add('hidden');document.body.classList.remove('storying');
  $('btnJournal').classList.toggle('hidden',!(save.cleared[9]||save.allStages));$('hud').classList.add('hidden');showOnly('scrTitle');save.titleZoom=1;save.titlePanX=0;save.titlePanY=0;titleTouch.clear();titlePinch=null;titlePointer=null;applyTitleZoom();}
/* bounding box of the opaque figure inside a frame (1x cell units), cached; used to show Eva large */
const bboxCache=new Map();
function frameBBox(fr){const k=fr.file+'|'+fr.sx+'|'+fr.sy;if(bboxCache.has(k))return bboxCache.get(k);const im=images[fr.file];if(!im||!im.img.naturalWidth)return null;
  const ratio=HIRES_YASUKO[fr.file]||1,c=document.createElement('canvas');c.width=Math.ceil(fr.sw);c.height=Math.ceil(fr.sh);const x=c.getContext('2d',{willReadFrequently:true});
  x.drawImage(im.img,fr.sx*ratio,fr.sy*ratio,fr.sw*ratio,fr.sh*ratio,0,0,c.width,c.height);const d=x.getImageData(0,0,c.width,c.height).data;let x0=c.width,y0=c.height,x1=-1,y1=-1;
  for(let y=0;y<c.height;y++)for(let xx=0;xx<c.width;xx++){if(d[(y*c.width+xx)*4+3]>16){if(xx<x0)x0=xx;if(xx>x1)x1=xx;if(y<y0)y0=y;if(y>y1)y1=y;}}
  const r=x1<0?{x:0,y:0,w:fr.sw,h:fr.sh}:{x:Math.max(0,x0-3),y:Math.max(0,y0-3),w:Math.min(fr.sw,x1+4)-Math.max(0,x0-3),h:Math.min(fr.sh,y1+4)-Math.max(0,y0-3)};bboxCache.set(k,r);return r;}
function costumeBBox(cid){const k='cos|'+cid+'|'+(cid==='base'?save.baseArt:'');if(bboxCache.has(k))return bboxCache.get(k);let u=null;
  for(let d=0;d<8;d++){const b=frameBBox(yFrame(cid,d));if(!b)return null;u=u?{x0:Math.min(u.x0,b.x),y0:Math.min(u.y0,b.y),x1:Math.max(u.x1,b.x+b.w),y1:Math.max(u.y1,b.y+b.h)}:{x0:b.x,y0:b.y,x1:b.x+b.w,y1:b.y+b.h};}
  const r={x:u.x0,y:u.y0,w:u.x1-u.x0,h:u.y1-u.y0};bboxCache.set(k,r);return r;}
/* v8.3.9: Pan the actual zoomed title art by dragging the open canvas space.
   Save UI gestures only once at pointerup; preserve the game's old save key.
   Pan is in CSS pixels, independent of devicePixelRatio and Safari toolbar size. */
const TITLE_ZOOMS=[1,1.25,1.5,2,3,4,5,7.5,10];
let titlePanBounds={minX:0,maxX:0,minY:0,maxY:0};
let titlePointer=null;
function selectedTitleZoom(){return Math.round(clamp(Number(save.titleZoom)||1,1,10)*20)/20;}
function applyTitleZoom(){
  const z=selectedTitleZoom();$('scrTitle').style.setProperty('--title-zoom',String(z));
  if(z<=1){save.titlePanX=0;save.titlePanY=0;}
  drawTitleChar();
}
function setTitlePanBounds(minX,maxX,minY,maxY){
  titlePanBounds={minX,maxX,minY,maxY};
  save.titlePanX=clamp(Number(save.titlePanX)||0,minX,maxX);
  save.titlePanY=clamp(Number(save.titlePanY)||0,minY,maxY);
  const z=selectedTitleZoom(),sr=$('scrTitle').getBoundingClientRect();
  // The background must NEVER expose blank edges, even on Safari viewport resize.
  const bgLimitX=Math.max(0,(z-1)*sr.width*0.5);
  const bgYTop=Math.max(0,(z-1)*sr.height*0.44),bgYBottom=Math.max(0,(z-1)*sr.height*0.56);
  $('scrTitle').style.setProperty('--title-pan-x',clamp(save.titlePanX,-bgLimitX,bgLimitX)+'px');
  $('scrTitle').style.setProperty('--title-pan-y',clamp(save.titlePanY,-bgYBottom,bgYTop)+'px');
}
/* Title layout in CSS pixels for a given zoom (shared by drawing and the pinch gesture). */
function titleGeom(zoom){const c=$('titleChar');if(!c)return null;const r=c.getBoundingClientRect();if(r.width<10||r.height<10)return null;
  // Title-specific lossless portrait image: never enlarge the game thumbnail or
  // the atlas's 1x preview. Assets are generated by exact transparent crop;
  // the native original and complete eight-direction atlas remain untouched.
  const artId=save.costume==='base'?'base_'+save.baseArt:save.costume;
  const frontFile=TITLE_FRONT[artId],img=frontFile?imgOf(frontFile):null;
  if(!img)return{r,img:null,frontFile};
  const cat=!catAway()&&imgOf(catFrame(0).file),W=r.width,H=r.height;
  const maxW=W*(cat?0.74:0.96),baseK=Math.min(H*0.985/img.naturalHeight,maxW/img.naturalWidth);
  const w=img.naturalWidth*baseK*zoom,h=img.naturalHeight*baseK*zoom,cx=cat?W*0.39:W/2;
  const dx=cx-w/2,baseY=H*0.98-img.naturalHeight*baseK,dy=H*0.5+(baseY-H*0.5)*zoom;
  return{r,img,frontFile,cat,W,H,w,h,dx,dy};}
function drawTitleChar(){const c=$('titleChar');if(!c||$('scrTitle').classList.contains('hidden'))return;
  const zoom=selectedTitleZoom(),g=titleGeom(zoom);if(!g)return;
  const dpr=Math.min(window.devicePixelRatio||1,3),W=Math.round(g.r.width*dpr),H=Math.round(g.r.height*dpr);if(c.width!==W||c.height!==H){c.width=W;c.height=H;}
  const x=c.getContext('2d');x.clearRect(0,0,W,H);x.imageSmoothingQuality='high';
  if(!g.img){if(g.frontFile&&!images[g.frontFile])loadImg(g.frontFile).then(()=>drawTitleChar());return;}
  if(zoom<=1){setTitlePanBounds(0,0,0,0);}
  else{setTitlePanBounds(Math.min(0,g.W-g.dx-g.w),Math.max(0,-g.dx),Math.min(0,g.H-g.dy-g.h),Math.max(0,-g.dy));}
  const h=g.h*dpr;
  x.drawImage(g.img,(g.dx+save.titlePanX)*dpr,(g.dy+save.titlePanY)*dpr,g.w*dpr,h);
  if(g.cat){const cf=catFrame(0),ci=imgOf(cf.file),kk=(h/zoom)*0.42*0.95/ATLAS.cat.charH,cw=cf.sw*kk,chh=cf.sh*kk;
    x.drawImage(ci,cf.sx,cf.sy,cf.sw,cf.sh,W-cw*0.96,H-chh+(cf.sh-cf.fy)*kk*0.5,cw,chh);}
}
/* Pointer Events work with touch (iOS Safari), mouse and stylus. The listener is
   on the artwork ONLY so it cannot steal taps from the title secrets or buttons. */
$('titleChar').addEventListener('pointerdown',e=>{
  if(selectedTitleZoom()<=1||titlePointer||titlePinch||titleTouch.size>1||$('scrTitle').classList.contains('hidden'))return;
  if(e.pointerType==='mouse'&&e.button!==0)return;
  titlePointer={id:e.pointerId,x:e.clientX,y:e.clientY,panX:Number(save.titlePanX)||0,panY:Number(save.titlePanY)||0};
  try{e.currentTarget.setPointerCapture(e.pointerId);}catch(_){}
  e.currentTarget.classList.add('dragging');e.preventDefault();
});
$('titleChar').addEventListener('pointermove',e=>{
  if(!titlePointer||titlePointer.id!==e.pointerId||titlePinch)return;
  save.titlePanX=clamp(titlePointer.panX+e.clientX-titlePointer.x,titlePanBounds.minX,titlePanBounds.maxX);
  save.titlePanY=clamp(titlePointer.panY+e.clientY-titlePointer.y,titlePanBounds.minY,titlePanBounds.maxY);
  drawTitleChar();e.preventDefault();
});
function endTitleDrag(e){
  if(!titlePointer||titlePointer.id!==e.pointerId)return;
  titlePointer=null;$('titleChar').classList.remove('dragging');writeSave();
}
['pointerup','pointercancel','lostpointercapture'].forEach(ev=>$('titleChar').addEventListener(ev,endTitleDrag));
/* v8.3.16: 2本指のピンチイン・ピンチアウトで 拡大・縮小（1〜10倍）。指のあいだの点が 指についてくる。
   タイトル画面のどこで ピンチしても 効く（ブラウザ自体の拡大は止める）。2回タップで 100% に もどす。 */
const titleTouch=new Map();let titlePinch=null,titleLastTap=null;
function titleAnchor(z,cx,cy){const g=titleGeom(z);if(!g||!g.img)return null;const px=Number(save.titlePanX)||0,py=Number(save.titlePanY)||0;
  return{u:(cx-g.r.left-(g.dx+px))/g.w,v:(cy-g.r.top-(g.dy+py))/g.h};}
function zoomTitleAround(z,cx,cy,u,v){z=Math.round(clamp(z,1,10)*20)/20;const g=titleGeom(z);if(!g||!g.img)return;
  save.titleZoom=z;save.titlePanX=cx-g.r.left-g.dx-u*g.w;save.titlePanY=cy-g.r.top-g.dy-v*g.h;applyTitleZoom();}
function resetTitleZoom(){if(selectedTitleZoom()<=1)return;save.titleZoom=1;save.titlePanX=0;save.titlePanY=0;writeSave();applyTitleZoom();}
function pinchPair(){const v=[...titleTouch.values()];return [v[0],v[1]];}
$('scrTitle').addEventListener('pointerdown',e=>{
  if(e.pointerType==='mouse'||$('scrTitle').classList.contains('hidden'))return;
  if(e.isPrimary){titleTouch.clear();titlePinch=null;}
  titleTouch.set(e.pointerId,{x:e.clientX,y:e.clientY,sx:e.clientX,sy:e.clientY,t:performance.now(),art:e.target===$('titleChar')});
  if(titleTouch.size===2){const [a,b]=pinchPair(),z0=selectedTitleZoom(),an=titleAnchor(z0,(a.x+b.x)/2,(a.y+b.y)/2);if(!an)return;
    if(titlePointer){titlePointer=null;$('titleChar').classList.remove('dragging');}
    titlePinch={d0:Math.max(24,Math.hypot(a.x-b.x,a.y-b.y)),z0,u:an.u,v:an.v};titleLastTap=null;e.preventDefault();}
},true);
$('scrTitle').addEventListener('pointermove',e=>{
  const p=titleTouch.get(e.pointerId);if(!p)return;p.x=e.clientX;p.y=e.clientY;
  if(!titlePinch||titleTouch.size<2)return;
  const [a,b]=pinchPair();zoomTitleAround(titlePinch.z0*Math.hypot(a.x-b.x,a.y-b.y)/titlePinch.d0,(a.x+b.x)/2,(a.y+b.y)/2,titlePinch.u,titlePinch.v);e.preventDefault();
},true);
function endTitleTouch(e){const p=titleTouch.get(e.pointerId);if(!p)return;titleTouch.delete(e.pointerId);
  if(titlePinch){if(titleTouch.size<2){titlePinch=null;writeSave();}return;}
  if(e.type!=='pointerup'||!p.art||titleTouch.size)return;
  const now=performance.now(),tap=now-p.t<320&&Math.hypot(e.clientX-p.sx,e.clientY-p.sy)<12;
  if(!tap){titleLastTap=null;return;}
  if(titleLastTap&&now-titleLastTap.t<380&&Math.hypot(e.clientX-titleLastTap.x,e.clientY-titleLastTap.y)<40){titleLastTap=null;resetTitleZoom();}
  else titleLastTap={t:now,x:e.clientX,y:e.clientY};}
['pointerup','pointercancel'].forEach(ev=>$('scrTitle').addEventListener(ev,endTitleTouch,true));
$('titleChar').addEventListener('dblclick',e=>{e.preventDefault();resetTitleZoom();});
/* パソコンのトラックパッドのピンチ（ctrl+ホイールとして届く）にも対応 */
$('scrTitle').addEventListener('wheel',e=>{if(!e.ctrlKey||$('scrTitle').classList.contains('hidden'))return;e.preventDefault();
  const an=titleAnchor(selectedTitleZoom(),e.clientX,e.clientY);if(!an)return;
  zoomTitleAround(selectedTitleZoom()*Math.exp(-e.deltaY*0.01),e.clientX,e.clientY,an.u,an.v);clearTimeout(titleWheelT);titleWheelT=setTimeout(writeSave,400);},{passive:false});
let titleWheelT=0;
/* iPhone Safari は viewport の拡大禁止を無視するので、タイトル画面では ページ自体の ピンチ拡大を止める */
['gesturestart','gesturechange'].forEach(ev=>document.addEventListener(ev,e=>{if(!$('scrTitle').classList.contains('hidden'))e.preventDefault();},{passive:false}));

let chap=-1;
function stageOpen(i){return save.allStages||i===0||!!save.cleared[i-1];}
async function openStages(ch){showOnly('scrStages');starRow();document.querySelectorAll('#scrStages .seg button').forEach(b=>b.classList.toggle('on',b.dataset.d===save.difficulty));
  let maxOpen=0;for(let i=0;i<STAGES.length;i++)if(stageOpen(i))maxOpen=i;
  const nCh=Math.ceil(STAGES.length/10),maxCh=save.allStages?nCh-1:Math.floor(maxOpen/10);
  if(typeof ch==='number')chap=ch;else if(chap<0||chap>maxCh)chap=Math.floor(maxOpen/10);
  $('chapTabs').innerHTML=maxCh>0?Array.from({length:maxCh+1},(_,c)=>`<button data-c="${c}" class="${c===chap?'on':''}">${c*10+1}〜${c*10+10}</button>`).join(''):'';
  $('chapTabs').querySelectorAll('button').forEach(b=>b.onclick=()=>openStages(+b.dataset.c));
  let h='';for(let i=chap*10;i<Math.min(STAGES.length,chap*10+10);i++){const s=STAGES[i],open=stageOpen(i),cl=save.cleared[i];
    h+=`<button class="stage" data-i="${i}" ${open?'':'disabled'}><canvas width="168" height="94" ${open?`data-bg="${s.theme}"`:'class="lockbg"'}></canvas><span class="nm"><span style="color:var(--wine)">${i+1}.</span> ${s.name}<small>${save.best[i]!=null?`ベスト ${fmtT(save.best[i])}`:cl?'ベスト ー':open?'まだ クリアしていないよ':''}${open?'':'🔒 前のステージをクリアで あそべます'}</small></span><span class="st">${cl?'★':''}</span></button>`;}
  $('stageList').innerHTML=h;
  $('stageList').querySelectorAll('.stage').forEach(b=>b.onclick=()=>{if(b.disabled)return;openReady(+b.dataset.i);});
  const cvs=[...$('stageList').querySelectorAll('canvas[data-bg]')];
  await Promise.all([...new Set(cvs.map(c=>c.dataset.bg))].map(k=>loadImg(ATLAS.bgs[k].file)));
  cvs.forEach(c=>{const img=imgOf(ATLAS.bgs[c.dataset.bg].file);if(img)c.getContext('2d').drawImage(img,0,0,c.width,c.height);});}
document.querySelectorAll('#scrStages .seg button').forEach(b=>b.onclick=()=>{save.difficulty=b.dataset.d;writeSave();openStages(chap);});

// wardrobe
let wardSel=null,wardDir=0,wardFrom=null,wardSequence=0,wardPaintKey='';
function wardTurn(step){wardDir=((wardDir+step)%8+8)%8;drawWard(0);}
const wardGesture=bindImagePinch($('wardPinchStage'),$('wardPrev'),{max:()=>6,onSwipe:wardTurn});
function openWard(from){wardFrom=from;wardSel=ORDERED_COSTUMES().some(c=>c.id===save.costume)?save.costume:'basic';showOnly('scrWard');$('scrWard').scrollTop=0;
  // Points are shown inline with the selected costume, not in a separate row.
  const g=$('wardGrid');g.innerHTML='';loadImg(ATLAS.thumbs.file);
  ORDERED_COSTUMES().forEach(c=>{const shut=!c.special&&c!==BARE&&!cosOpen(c);const d=document.createElement('button');
    d.className='cos'+(c.id===wardSel?' on':'')+(c.special&&!c.secret2?' lock':'')+(shut?' locked':'');d.dataset.id=c.id;
    const cvs=document.createElement('canvas');cvs.width=ATLAS.thumbs.cw;cvs.height=ATLAS.thumbs.ch;/* v8.3.23: 345x366（3倍画面でも くっきり） */const f=thumbFrame(thumbId(c.id));
    {const paint=()=>{if(!cvs.isConnected)return;const x=cvs.getContext('2d');x.clearRect(0,0,cvs.width,cvs.height);x.imageSmoothingEnabled=true;x.imageSmoothingQuality='high';drawYasukoDetail(x,f,0,0,cvs.width,cvs.height);};if(imgOf(f.file))requestAnimationFrame(paint);loadImg(f.file).then(()=>requestAnimationFrame(paint));}
    d.appendChild(cvs);const s=document.createElement('div');s.className='cn';s.innerHTML=shut?'？？？':c.name.replace('\n','<br>');d.appendChild(s);
    const q=condText(c);if(q&&c.pts==null&&c.unlock!==0){const t=document.createElement('div');t.className='cq'+(c.pts!=null?' pt':'');t.textContent=(shut?'🔒 ':'')+q;d.appendChild(t);}
    d.onclick=()=>selectWard(c.id);g.appendChild(d);});
  sizeWardPrev();selectWard(wardSel);}
function wardLocked(id){const c=id==='base'?BARE:CMAP[id];return !!c&&c!==BARE&&!cosOpen(c)&&(!c.special||c.secret2);}
async function selectWard(id){if(!ORDERED_COSTUMES().some(c=>c.id===id))return;const seq=++wardSequence;wardSel=id;wardDir=0;wardPaintKey='';wardGesture.reset();document.querySelectorAll('#wardGrid .cos').forEach(b=>b.classList.toggle('on',b.dataset.id===id));
  const c=id==='base'?BARE:CMAP[id],shut=wardLocked(id),lock=(!!c.special&&!c.secret2)||shut,q=condText(c);
  const ptsInline=`<span class="wardPtsInline">${c.secret2?'第2のひみつ・必要ptなし':c.pts!=null?'必要ごほうび '+c.pts+'pt':'必要ごほうび 0pt'}</span>`;
  $('wardInfo').innerHTML=shut?`<div class="wardSummary"><b>🔒 まだ 着られない 衣装</b>${ptsInline}</div><div class="wq">入手：${q}${c.pts!=null?'（ステージ10クリア後）':''}</div>`
    :`<div class="wardSummary"><b>${c.name.replace('\n','')}${c===BARE?'（'+BASE_NAME[save.baseArt]+'）':''}</b>${ptsInline}</div>${c.star?`<span class="stars">${starStr(c.star)}</span>`:''}<div class="wa">${c.ab}${!c.special&&c!==BARE?'<br><span class="wk">'+atkText(c)+'</span>':''}${c.special?'<br><small>女神さまの姿で あそべます</small>':''}${c===BARE?'<br><small>（絵は せってい で えらべます）</small>':''}</div>${q?`<div class="wq">入手：${q}</div>`:''}`;
  $('btnWardOk').disabled=lock;$('btnWardOk').textContent=shut?'まだ 着られません':c.special&&!c.secret2?'へんしん専用です':c===BARE?'これに きめる（ハード）':'これに きめる';
  $('wardInfo').insertAdjacentHTML('beforeend','<div id="wardLoad" style="font-size:14px;color:#8a6a4a">よみこみ中…</div>');
  await loadImg(yInfo(id).file);if(seq!==wardSequence)return;const wl=$('wardLoad');if(wl)wl.remove();drawWard(0);}
/* the rotating preview: backing store follows CSS size x devicePixelRatio, figure cropped to the body */
let wardPx={w:460,h:488,s:1};
function sizeWardPrev(){const c=$('wardPrev');if(!c)return;const r=$('wardPinchStage').getBoundingClientRect(),dpr=Math.min(window.devicePixelRatio||1,3);
  const h=Math.max(830,Math.round((r.height||200)*dpr)),w=Math.round(h*(r.width||391)/(r.height||415));if(c.width!==w||c.height!==h){c.width=w;c.height=h;wardPaintKey='';}wardPx={w,h,s:dpr};}
function drawWard(dt){if($('scrWard').classList.contains('hidden')||!wardSel)return;
  const c=$('wardPrev'),x=c.getContext('2d'),W=c.width,H=c.height,fr=yFrame(wardSel,wardDir);
  const loaded=images[fr.file]?.img?.naturalWidth>0,key=[fr.file,wardDir,W,H,wardLocked(wardSel),loaded].join('|');
  if(wardPaintKey===key)return;wardPaintKey=key;x.clearRect(0,0,W,H);
  if(loaded){const crop=commonYasukoFrame(fr),k=Math.min(W/crop.sw,H/crop.sh)*0.98,w=crop.sw*k,h=crop.sh*k;
    x.imageSmoothingEnabled=true;x.imageSmoothingQuality='high';drawYasukoDetail(x,crop,(W-w)/2,(H-h)/2,w,h);
    if(wardLocked(wardSel)){x.globalCompositeOperation='source-atop';x.fillStyle='rgba(96,72,64,.92)';x.fillRect(0,0,W,H);x.globalCompositeOperation='source-over';}}
}
$('btnWardOk').onclick=async()=>{const c=wardSel==='base'?BARE:CMAP[wardSel];if(!c||!ORDERED_COSTUMES().includes(c)||(c!==BARE&&!cosOpen(c)))return;save.costume=wardSel;writeSave();iconCache.clear();await loadImg(yInfo(wardSel).file);
  if(wardFrom==='ready'){openReady(readyIdx);return;}
  if(wardFrom==='pause'){showOnly(null);state=pausedFrom||'play';
    if(P&&P.bare)banner('衣装を とりもどすと<small>この衣装に なります</small>',2.2);else if(P)burst(P.x,P.y-charPx*0.5,costume().trail,20,200);}
  else toTitle();};

// settings
const SETS=[['min','いちばん ゆっくりの速さ',30,160,5,'小さく指を動かしたときの速さ'],['max','いちばん はやい速さ',180,560,10,'大きく指を動かしたときの速さ'],
 ['drag','最高速になる 指のきょり',60,200,5,'小さいほど 少しの動きで はやくなります'],['curve','はやくなり方',0.6,2.6,0.1,'大きいほど ゆっくりの範囲が広くなります'],
 ['decel','指をはなして止まるまで（秒）',0.1,1.2,0.05,'大きいほど ふんわり長くすべります']];
function openSettings(from){overlayReturn=from;show('scrSettings');let h='';
  SETS.forEach(([k,l,a,b,st,n])=>{h+=`<div class="set">${l}<span class="v" id="v_${k}">${save.speed[k]}</span><input type="range" min="${a}" max="${b}" step="${st}" value="${save.speed[k]}" data-k="${k}"><small>${n}</small></div>`;});
  $('setList').innerHTML=h;$('setList').querySelectorAll('input').forEach(i=>i.oninput=()=>{save.speed[i.dataset.k]=+i.value;$('v_'+i.dataset.k).textContent=i.value;writeSave();});
  $('chkMeter').checked=save.meter;$('chkSleep').checked=save.sleepOn;$('chkAll').checked=save.allStages;$('chkStory').checked=!!save.storyAlways;
  document.querySelectorAll('#segBgm button').forEach(b=>b.classList.toggle('on',+b.dataset.v===save.bgmVol));document.querySelectorAll('#segSe button').forEach(b=>b.classList.toggle('on',+b.dataset.v===save.seVol));
  document.querySelectorAll('#segGuard button').forEach(b=>b.classList.toggle('on',b.dataset.g===save.guardMode));
  $('setBaseLbl').classList.remove('hidden');$('segBase').classList.remove('hidden');
  document.querySelectorAll('#segBase button').forEach(b=>{const selected=b.dataset.b===save.baseArt;b.classList.toggle('on',selected);b.style.display=secret2Open()||selected?'':'none';b.disabled=!secret2Open();});}
document.querySelectorAll('#segGuard button').forEach(b=>b.onclick=()=>{save.guardMode=b.dataset.g;writeSave();openSettings(overlayReturn);});
document.querySelectorAll('#segBase button').forEach(b=>b.onclick=async()=>{
  if(!secret2Open())return;
  save.baseArt=b.dataset.b;writeSave();await loadImg(yInfo('base').file);lastFace='';openSettings(overlayReturn);});
$('chkMeter').onchange=e=>{save.meter=e.target.checked;writeSave();$('speedMeter').classList.toggle('hidden',!save.meter);};
$('chkSleep').onchange=e=>{save.sleepOn=e.target.checked;writeSave();};
$('chkAll').onchange=e=>{save.allStages=e.target.checked;writeSave();$('btnJournal').classList.toggle('hidden',!(save.cleared[9]||save.allStages));};
$('chkStory').onchange=e=>{save.storyAlways=e.target.checked;writeSave();};
document.querySelectorAll('#segBgm button').forEach(b=>b.onclick=()=>{save.bgmVol=+b.dataset.v;writeSave();applyVol();document.querySelectorAll('#segBgm button').forEach(x=>x.classList.toggle('on',x===b));if(save.bgmVol&&SND.want)bgm(SND.want,true);});
document.querySelectorAll('#segSe button').forEach(b=>b.onclick=()=>{save.seVol=+b.dataset.v;writeSave();applyVol();document.querySelectorAll('#segSe button').forEach(x=>x.classList.toggle('on',x===b));setTimeout(()=>sfx('chest'),30);});

$('btnSetReset').onclick=()=>{save.speed={...DEFAULT_SPEED};writeSave();openSettings(overlayReturn);};
$('btnSetOk').onclick=()=>{hide('scrSettings');if(overlayReturn==='stages')openStages();};

$('btnHelpOk').onclick=()=>{hide('scrHelp');};$('btnHelpCloseTop').onclick=()=>{hide('scrHelp');};$('btnWardBackTop').onclick=()=>{if(wardFrom==='pause'){showOnly('scrPause');state='paused';}else if(wardFrom==='ready'){openReady(readyIdx);}else{toTitle();}};
let pausedFrom=null;
function pause(){if(state==='mini'||state==='story')return;if(state!=='play'&&state!=='perform')return;if(perform&&perform.video)return;pausedFrom=state;state='paused';input.on=false;$('btnPPhoto').classList.toggle('hidden',mode!=='walk');show('scrPause');}
$('btnPause').onclick=pause;$('btnHelp').onclick=()=>{pause();openManual();};
$('btnResume').onclick=()=>{hide('scrPause');state=pausedFrom||'play';};
$('btnPWard').onclick=()=>{hide('scrPause');openWard('pause');};
$('btnPScene').onclick=()=>{hide('scrPause');if(mode==='walk'){const L=sceneryList();if(L.length<2){state=pausedFrom;banner('ステージを クリアすると けしきが ふえるよ',2);return;}const i=(L.indexOf(world.tid)+1)%L.length;startWalk(L[i]);}else{state=pausedFrom;banner('けしきは おさんぽで かえられます',1.8);}};
$('btnPHelp').onclick=()=>openManual();$('btnPSet').onclick=()=>openSettings('pause');
$('btnQuit').onclick=()=>toTitle();
$('btnAdventure').onclick=openStages;$('btnStagesBack').onclick=toTitle;
$('btnWalk').onclick=()=>startWalk('meadow');
$('btnWardrobe').onclick=()=>openWard('title');$('btnSettingsT').onclick=()=>openSettings('title');$('btnHelpT').onclick=()=>openManual();
$('btnTutorial').onclick=()=>startTutorial();
function showClear(){show('scrClear');const last=stageIdx>=STAGES.length-1;
  $('clearTitle').textContent=last?'ぜんぶ クリア！':stage.bosses.length>=4?'大勝利！':'ステージクリア！';
  $('clearText').innerHTML=`ステージ${stageIdx+1}「${stage.name}」<br>タイム ${fmtT(clearTime)}${newBest?' <b style="color:#c0392b">ベスト更新！</b>':save.best[stageIdx]!=null&&save.best[stageIdx]<clearTime-0.05?`<br><small>ベスト ${fmtT(save.best[stageIdx])}</small>`:''}${first?'<br><small>初クリアで ごほうびポイント +1</small>':''}${newBest?`<br><small>ベスト更新で ごほうびポイント +2（いまの ごほうびポイント ${rewardPoints()}）</small>`:''}${stage.bosses.length===4?'<br>4人のライバルに 勝ちました！':''}${last?'<br>全ステージ クリア！ おめでとう！':''}`;
  $('btnNext').classList.toggle('hidden',last);
  const shownC=lastUnlock||giftNew[0]||null,nc=$('newCos');nc.classList.toggle('hidden',!shownC);
  if(shownC){nc.querySelector('.nt').textContent=lastUnlock?'新しい衣装を 手に入れた！':'ごほうび衣装を もらった！';}
  if(shownC){const c=shownC,f=thumbFrame(c.id),ti=imgOf(f.file),cv=$('newCosCv'),x=cv.getContext('2d');x.clearRect(0,0,230,244);if(ti)x.drawImage(ti,f.sx,f.sy,f.sw,f.sh,0,0,230,244);else loadImg(f.file).then(im=>{if(im&&cv.isConnected&&shownC===c){x.clearRect(0,0,230,244);x.drawImage(im,f.sx,f.sy,f.sw,f.sh,0,0,230,244);}});
    const more=[lastUnlock,...giftNew].filter(x=>x&&x!==c);$('newCosName').innerHTML=`<b>${c.name.replace('\n','')}</b> <span class="stars">${starStr(c.star)}</span><br><span style="font-size:15px">${c.ab}</span>${more.length?`<br><b style="color:var(--wine)">＋『${more.map(x=>x.name.replace('\n','')).join('』『')}』も もらった！</b>`:''}`;
    const b=$('btnNewCos');b.disabled=save.costume===c.id;b.textContent=save.costume===c.id?'着ています':'着てみる';
    b.onclick=async()=>{save.costume=c.id;writeSave();iconCache.clear();await loadImg(yInfo(c.id).file);b.disabled=true;b.textContent='着がえました！';};}
  const c=$('clearCat'),x=c.getContext('2d');x.clearRect(0,0,260,260);const img=imgOf(ribbonKey(ATLAS.catface.file));if(!catOn)drawNarrator(c,'goddess');else if(img){const i=ATLAS.catface.names.indexOf('smile'),cw=ATLAS.catface.cw;x.drawImage(img,(i%3)*cw,((i/3)|0)*cw,cw,cw,0,0,260,260);}}
$('btnNext').onclick=()=>openReady(stageIdx+1);$('btnRetryC').onclick=()=>openReady(stageIdx);$('btnSelC').onclick=openStages;
function showDefeat(){bgm(null);sfx('lose');show('scrDefeat');const lb=bosses.find(b=>b.st!=='dead')||bosses[0];const id=(lb&&lb.id)||stage.bosses[Math.min(bossesDown,stage.bosses.length-1)];
  const c=$('defeatImg'),x=c.getContext('2d');x.clearRect(0,0,460,488);
  if(id==='cat'){const cf=catFrame(0),ci=imgOf(cf.file);if(ci){x.drawImage(ci,cf.sx,cf.sy,cf.sw,cf.sh,80,90,300,300*cf.sh/cf.sw);x.globalCompositeOperation='source-atop';x.fillStyle='rgba(80,30,125,0.45)';x.fillRect(0,0,460,488);x.globalCompositeOperation='source-over';}
    $('defeatLine').innerHTML=`<span style="color:${BOSSES.cat.col}">${BOSSES.cat.name}</span>「${BOSSES.cat.win}」<br><small>女神さま「あきらめないで。光で 優しく 目覚めさせてあげましょう」</small>`;return;}
  const fr=bFrame(id,0),img=imgOf(fr.file);if(img)x.drawImage(img,fr.sx,fr.sy,fr.sw,fr.sh,-40,0,460,488);
  const pk=BOSSES[id].minion,pi=ATLAS.partner[pk],pf=partnerFrame(pk,7),pimg=imgOf(pf.file);if(pimg){const k=230*EKIND[pk].size/0.55/pi.charH;x.drawImage(pimg,pf.sx,pf.sy,pf.sw,pf.sh,330-pf.fx*k,482-pf.fy*k,pf.sw*k,pf.sh*k);}
  $('defeatLine').innerHTML=`<span style="color:${BOSSES[id].col}">${BOSSES[id].name}</span>「${BOSSES[id].win}」`;}
$('btnRetry').onclick=()=>openReady(stageIdx);$('btnRetryEasy').onclick=()=>{save.difficulty='easy';writeSave();openReady(stageIdx);};$('btnSelD').onclick=openStages;
$('btnErrOk').onclick=()=>{hide('scrError');};

/* ============ story ============ */
function drawGoddessIcon(x,w){const c=w/2;x.save();const g=x.createRadialGradient(c,c,2,c,c,c);g.addColorStop(0,'#fffdf0');g.addColorStop(0.55,'#fbe7a8');g.addColorStop(1,'#e9c46a');x.fillStyle=g;x.fillRect(0,0,w,w);
  softBlob(x,c,c,c*0.9,'#ffffff',0.6);
  for(const sd of[-1,1]){x.save();x.translate(c,c*1.05);x.scale(sd,1);for(let i=0;i<4;i++){x.fillStyle=`rgba(255,255,255,${0.95-i*0.12})`;x.strokeStyle='rgba(200,160,70,.55)';x.lineWidth=w*0.01;x.beginPath();x.ellipse(c*0.32+i*c*0.13,-c*0.08+i*c*0.07,c*0.3-i*c*0.04,c*0.11,-0.5+i*0.18,0,TAU);x.fill();x.stroke();}x.restore();}
  x.strokeStyle='#d9a93e';x.lineWidth=w*0.035;x.beginPath();x.ellipse(c,c*0.42,c*0.32,c*0.1,0,0,TAU);x.stroke();
  x.translate(c,c*1.02);x.fillStyle='#ffffff';starPath(x,4,c*0.42,c*0.1);x.fill();x.fillStyle='#f2c94c';starPath(x,4,c*0.26,c*0.07);x.fill();x.restore();}
function drawNarrator(cv,who){if(!cv)return;const x=cv.getContext('2d'),w=cv.width;x.clearRect(0,0,w,w);
  if(who==='goddess'){const gi=ATLAS.goddessface&&imgOf(ATLAS.goddessface.file);if(!gi){drawGoddessIcon(x,w);return;}
    const g=x.createRadialGradient(w/2,w*0.45,2,w/2,w/2,w*0.6);g.addColorStop(0,'#fffdf2');g.addColorStop(0.6,'#fbeec4');g.addColorStop(1,'#ecd08a');x.fillStyle=g;x.fillRect(0,0,w,w);x.drawImage(gi,0,0,w,w);return;}
  x.fillStyle='#fff6ea';x.fillRect(0,0,w,w);const img=imgOf(ribbonKey(ATLAS.catface.file));if(!img)return;const i=Math.max(0,ATLAS.catface.names.indexOf('smile')),cw=ATLAS.catface.cw;
  x.drawImage(img,(i%3)*cw+cw*0.06,((i/3)|0)*cw+cw*0.04,cw*0.88,cw*0.88,0,0,w,w);}
function playStory(lines,done,head){if(DEBUG&&window.__noStory){if(done)done();return;}state='story';document.body.classList.add('storying');try{updateHUD();}catch(e){}input.on=false;if(P){P.vx=0;P.vy=0;}clearBanners();
  story={lines,i:0,done,head,t:0};$('storyWin').classList.remove('hidden');$('storyDim').classList.remove('hidden');showStoryLine();}
function showStoryLine(){const[who,text]=story.lines[story.i];$('storyHead').textContent=story.head||'';$('storyName').textContent=NARR[who]||'';$('storyText').textContent=text;
  drawNarrator($('storyFace'),who);story.t=0;$('btnStoryNext').textContent=story.i<story.lines.length-1?'つぎへ ▶':'とじる ▶';}
function storyNext(){if(!story||story.t<0.4)return;story.i++;if(story.i>=story.lines.length){const d=story.done;story=null;$('storyWin').classList.add('hidden');$('storyDim').classList.add('hidden');document.body.classList.remove('storying');if(d)d();}else showStoryLine();}
$('btnStoryNext').addEventListener('click',e=>{e.stopPropagation();storyNext();});
$('storyDim').addEventListener('pointerdown',e=>{e.preventDefault();storyNext();});
$('storyWin').addEventListener('click',()=>storyNext());
function updateStory(dt){time+=dt;if(story)story.t+=dt;
  for(const p of parts){p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=p.g*dt;p.rot+=p.vr*dt;p.life-=dt;}parts=parts.filter(p=>p.life>0);
  for(const t of texts){t.y-=28*dt;t.life-=dt;}texts=texts.filter(t=>t.life>0);
  if(shake>0)shake=Math.max(0,shake-dt*20);
  if(scene)updateScene(dt);else updateCat(dt);
  if(P)updateCamera(dt);}
function afterPerform(first){bosses=[];ebul=[];traps=[];$('bossBar').classList.add('hidden');const i=stageIdx,st=STORY[i],toClear=()=>{state='result';showClear();};
  if(!st||!(first||save.storyAlways)||(DEBUG&&window.__noStory)){toClear();return;}const head=`ステージ${i+1}「${stage.name}」 おしまい`;
  if(i===4&&first&&catOn){curseScene(()=>playStory([st.e],toClear,head));return;}
  playStory([st.e],toClear,head);}
function curseScene(done){state='story';document.body.classList.add('storying');clearBanners();scene={t:0,curse:0,fade:1,done,said:0};if(!CAT){CAT=newCat();}catOn=true;CAT.pose=null;CAT.face=4;}
function updateScene(dt){const s=scene;s.t+=dt;const t=s.t;
  if(t<1.6){const a=R()*TAU,rad=Math.max(VW,VH)*0.6;if(R()<0.9)part(FX.glow(R()<0.5?'#8a64b8':'#b49ad8'),P.x+Math.cos(a)*rad,P.y-charPx*0.4+Math.sin(a)*rad*0.8,-Math.cos(a)*rad*0.55,-Math.sin(a)*rad*0.45,1.6,{s:rr(0.7,1.2),s2:0.8});
    if(t>0.5&&!s.said){s.said=1;banner('お城の 古い呪いの霧が！',1.6,{now:true});}}
  const tx=P.x+charPx*0.05,ty=P.y+28;if(t>0.9&&t<1.6){CAT.x+=(tx-CAT.x)*Math.min(1,dt*8);CAT.y+=(ty-CAT.y)*Math.min(1,dt*8);CAT.face=4;if(s.said===1){s.said=2;banner('黒猫が やっちゃんを かばった！',1.8);}}
  if(t>=1.6&&t<3.4){s.curse=Math.min(1,(t-1.6)/1.2);if(R()<0.5)part(FX.glow('#8a64b8'),CAT.x+rr(-30,30),CAT.y-rr(0,charPx*0.3),rr(-20,20),rr(-50,-20),0.9,{s:rr(0.3,0.5),s2:0.6});P.expr='surprised';P.exprT=1;}
  if(t>=3.4&&t<4.8){s.fade=Math.max(0,1-(t-3.4)/1.2);if(R()<0.5)part(FX.glow('#a07ad0'),CAT.x+rr(-30,30),CAT.y-rr(0,charPx*0.3),rr(-30,30),rr(-90,-40),1.0,{s:rr(0.3,0.5),s2:0.8});}
  if(t>=4.8){catOn=false;const d=s.done;scene=null;if(d)d();}}
/* ============ journal ============ */
let jIdx=0;
function openJournal(){jIdx=0;showOnly('scrJournal');renderJournal(0);}
function renderJournal(dir){const pg=$('jPage'),N=STORY.length+2;let h='';
  if(jIdx===0)h=`<div class="jno">― 表紙 ―</div><div class="jtitle">やっちゃんの旅日記</div><canvas class="jpic" id="jPic" width="640" height="360"></canvas>
    <p class="jsyn">ひだまり草原から 星のお城まで。やっちゃんと黒猫、そして女神さまと たどった ちいさな旅の おはなしです。</p><p class="jsyn" style="text-align:center">「つぎへ」で ページを めくってね</p>`;
  else if(jIdx<=STORY.length){const i=jIdx-1,st=STORY[i];
    h=`<div class="jno">第${i+1}話</div><div class="jtitle">${STAGE_NAMES[i]}</div><canvas class="jpic" id="jPic" width="640" height="360"></canvas><p class="jsyn">${SYNOPSIS[i]}</p>
    ${[['はじまり',st.s],['おしまい',st.e]].map(([lb,[w,t]])=>`<div class="jline"><canvas width="108" height="108" data-w="${w}"></canvas><div><div class="jw">${lb}・${NARR[w]}</div><div class="jt">「${t}」</div></div></div>`).join('')}`;}
  else h=`<div class="jno">― おしまい ―</div><div class="jtitle">また いっしょに 滑ろうね</div><canvas class="jpic" id="jPic" width="640" height="360"></canvas>
    <p class="jsyn">星の歌は もどり、黒猫は やっちゃんの となりに 帰ってきました。旅日記は ここで おしまい。でも、やっちゃんの冒険は まだまだ つづきます。</p>`;
  pg.innerHTML=h+`<div class="jpg">${jIdx+1} / ${N}</div>`;
  const pic=$('jPic');if(pic){const x=pic.getContext('2d');const bg=jIdx===0?'castle':jIdx<=STORY.length?STAGE_BG[jIdx-1]:'crystal';const bi=imgOf(ATLAS.bgs[bg].file);
    if(bi)x.drawImage(bi,0,0,640,360);x.fillStyle='rgba(255,250,235,.18)';x.fillRect(0,0,640,360);
    if(jIdx===0||jIdx>STORY.length){const fr=yFrame(jIdx===0?'basic':(save.costume||'basic'),0),yi=imgOf(fr.file);if(yi)x.drawImage(yi,fr.sx,fr.sy,fr.sw,fr.sh,180,40,fr.sw*310/fr.sh,310);
      const cf=catFrame(0),ci=imgOf(cf.file);if(ci)x.drawImage(ci,cf.sx,cf.sy,cf.sw,cf.sh,380,215,cf.sw*130/cf.sh,130);}}
  pg.querySelectorAll('canvas[data-w]').forEach(c=>drawNarrator(c,c.dataset.w));
  $('jPrev').disabled=jIdx===0;$('jNext').disabled=jIdx>=N-1;$('jNext').textContent=jIdx>=N-1?'おしまい':'つぎへ ▶';
  pg.classList.remove('flipN','flipP');void pg.offsetWidth;if(dir)pg.classList.add(dir>0?'flipN':'flipP');$('scrJournal').scrollTop=0;}
$('jPrev').onclick=()=>{if(jIdx>0){jIdx--;renderJournal(-1);}};
$('jNext').onclick=()=>{if(jIdx<STORY.length+1){jIdx++;renderJournal(1);}};
$('jBack').onclick=()=>toTitle();
$('btnJournal').onclick=async()=>{await Promise.all([...new Set(STAGE_BG)].map(k=>loadImg(ATLAS.bgs[k].file)).concat([loadImg(yInfo('basic').file),loadImg(yInfo(save.costume||'basic').file)]));openJournal();};

/* ---- field mini-games: number gates & level battle on the map ---- */
let fm=null,FONTF=null,fmStand=false;
const fmFrozen=()=>save.difficulty==='easy'||mode!=='play';const fontF=()=>FONTF||(FONTF=getComputedStyle(document.body).fontFamily);
const ARCHES=['arch_rose','arch_crystal','arch_wisteria','arch_wing','arch_stone'];
function gtGen(){const ez=save.difficulty==='easy';let v=2+((Math.random()*3)|0);const start=v,rounds=[];
  for(let i=0;i<3;i++){const ops=gtOps(v,i);rounds.push(ops);v=Math.max(...ops.map(o=>opApply(v,o)));}
  return{start,rounds,target:Math.max(start+4,Math.floor(v*(ez?0.6:0.8)))};}
function lbGen(){const ez=save.difficulty==='easy';let lv=3+((Math.random()*3)|0);const start=lv;
  const kinds=stage?[...new Set(stage.enemies.map(e=>e[0]))]:['pony','tiger','sheep','mouse'];const mons=[];
  for(let i=0;i<4;i++){const l=Math.max(1,Math.min(lv-1,Math.round(lv*(0.35+Math.random()*0.55))));mons.push({lv:l,k:pick(kinds),tier:i<2?0:1});lv+=l;}
  for(let i=mons.length-1;i>0;i--){const j=(Math.random()*(i+1))|0;[mons[i],mons[j]]=[mons[j],mons[i]];}
  mons.push({lv:lv-1-((Math.random()*2)|0),k:pick(kinds),tier:2,boss:true});
  return{start,mons,maxMiss:ez?5:3};}
function placeFoes(mons){const out=[],rx=Math.min(VW*0.4,200),ry=Math.min(VH*0.2,170),top=cam.y+150,bot=cam.y+VH-70;
  mons.forEach((m,i)=>{let best=null;
    const hh=charPx*TIER_H[m.tier],ymin=top+hh+(m.boss?44:30);
    for(let k=0;k<160&&!best;k++){const relax=k>=80,a=(i/mons.length)*TAU+rr(-0.5,0.5)+(k>40?R()*TAU:0),d=rr(0.7,1.05)*(relax?rr(1,1.5):1),x=P.x+Math.cos(a)*rx*d,y=P.y+40+Math.sin(a)*ry*d*(relax?1.3:1);
      if(y<ymin||y>bot)continue;
      if(x<world.b.l+30||x>world.b.r-30||y<world.b.t+60||y>world.b.b-20)continue;
      if(world.obst.some(o=>hyp(o.x-x,o.y+o.cy-y)<o.r+(relax?24:36)))continue;
      if(out.some(f=>hyp(f.x-x,f.y-y)<(relax?76:96)))continue;
      if(hyp(P.x-x,P.y-y)<125)continue;
      if(world.chests.some(c=>!c.open&&hyp(c.x-x,c.y-y)<70))continue;
      best={x,y};}
    if(!best){best=freeSpot(rr(150,240));best.y=Math.max(best.y,Math.min(ymin,world.b.b-20));}
    const h=hh*(KIND_MUL[m.k]||1);
    out.push({...m,x:best.x,y:best.y,h,bob:R()*TAU,shake:0,gone:false,die:0,block:false});});
  return out;}
function startField(c,type){shots=[];ebul=[];traps=[];P.idle=0;if(P.st!=='awake'){P.st='awake';P.expr='smile';}
  fm={type,c,res:null,endT:0,t:0,pop:0};
  if(type==='gates'){const g=gtGen();Object.assign(fm,{v:g.start,i:0,rounds:g.rounds,target:g.target,gates:null,wait:1.2,miss:0});
    banner(`数字ゲート！<small>上から ゲートが 2つ ながれてくるよ。くぐりたい ほうに ぶつかろう${fmFrozen()?'':'<br>敵の こうげきに 気をつけて！'}</small>`,3.6,{now:true});}
  else{const g=lbGen();Object.assign(fm,{lv:g.start,miss:0,maxMiss:g.maxMiss,foes:placeFoes(g.mons)});
    for(const f of fm.foes)burst(f.x,f.y-f.h*0.4,'#eadcff',10,120);
    banner(`レベル差バトル！<small>やっちゃんより Lvが ひくい 敵に ぶつかって たおそう${fmFrozen()?'':'<br>まわりの 敵の こうげきに 気をつけて！'}</small>`,3.6,{now:true});}
  $('bossBar').classList.add('hidden');$('goals').classList.add('hidden');$('fmPanel').classList.remove('hidden');fmPanel();}
function fmPanel(){const f=fm;if(!f)return;const pop=f.pop>0.4?'pop':'';
  if(f.type==='gates'){$('fmTitle').innerHTML='数字<br>ゲート';
    $('fmStats').innerHTML=`<div class="fs">やっちゃん<b class="${pop}">${f.v}</b></div><div class="fs">カギ<b>${f.target}</b></div><div class="fs">ゲート<b>${Math.min(f.i+(f.res==null?1:0),3)}/3</b></div>`;}
  else{const left=f.foes.filter(q=>!q.gone).length;$('fmTitle').innerHTML='レベル差<br>バトル';
    $('fmStats').innerHTML=`<div class="fs">やっちゃん<b class="${pop}">Lv ${f.lv}</b></div><div class="fs">のこり<b>${left}</b></div><div class="fs">ミスOK<b>${Math.max(0,f.maxMiss-f.miss)}</b></div>`;}}
$('fmQuit').addEventListener('click',e=>{e.stopPropagation();if(fm&&fm.res==null)fmEnd(null);});
function fmResult(ok,text){const f=fm;if(!f||f.res!=null)return;sfx(ok?'win':'miss');f.res=ok;f.endT=1.7;fmPanel();
  banner(`${text}<small>${ok?'大成功！ 宝箱が あくよ':'宝箱は まだ あかないよ'}</small>`,2.2,{now:true});
  if(ok){burst(P.x,P.y-charPx*0.6,'#fff3c2',30,260);P.expr='happy';P.exprT=1.8;}}
function fmEnd(ok){const c=fm.c;fm=null;$('fmPanel').classList.add('hidden');$('goals').classList.remove('hidden');if(bosses.length)$('bossBar').classList.remove('hidden');P.inv=Math.max(P.inv,1.5);
  if(!ok){c.cool=true;banner(ok===null?'宝箱は あとで あけられます':'おしい！<small>宝箱に もう一度 ふれると やりなおせるよ</small>',2.6,{now:true});return;}openChest(c,true);}
function updateField(dt){const f=fm;f.t+=dt;P.idle=0;if(f.pop>0)f.pop-=dt;
  if(f.type==='gates')fmGates(dt);else fmBattle(dt);
  if(fm&&f.res!=null){f.endT-=dt;if(f.endT<=0)fmEnd(f.res);}}
function spawnGates(){const f=fm,ops=f.rounds[f.i],arch=ARCHES[(f.i+((f.c.x|0)%5))%ARCHES.length],it=artRect(arch),h=it?Math.min(150,158*it[3]/it[2]):150,w=it?artW(arch,h):h*0.9,gap=Math.max(98,w*0.6);
  const cx=clamp(P.x,world.b.l+gap+20,world.b.r-gap-20);
  let gy=cam.y+175+h*0.42;if(P.y-charPx*0.4-gy<160)gy=P.y-charPx*0.4-160;
  f.gates={x:[cx-gap,cx+gap],y:gy,h,w,sp:save.difficulty==='easy'?66:88,ops,arch,t:0,hit:null,fade:0};}
function fmGates(dt){const f=fm;if(f.res!=null&&!f.gates)return;
  if(!f.gates){f.wait-=dt;if(f.wait<=0&&f.i<3)spawnGates();return;}
  const G=f.gates;G.t+=dt;G.y+=G.sp*dt*(G.hit==null?1:0.3);
  if(G.hit!=null){G.fade-=dt;if(G.fade<=0){f.gates=null;f.wait=0.5;if(f.i>=3&&f.res==null){const ok=f.v>=f.target;fmResult(ok,ok?`${f.v} ≧ ${f.target}　カギが あいた！`:`${f.v} ＜ ${f.target}　おしい！`);}}return;}
  const py=P.y-charPx*0.4;
  for(let k=0;k<2;k++){if(Math.abs(P.x-G.x[k])<G.w*0.36&&py>G.y-G.h*0.92&&py<G.y+charPx*0.15){passGate(k);return;}}
  if(G.y-G.h>P.y+charPx*0.3+40){f.gates=null;f.wait=0.6;f.miss++;banner('とおりすぎちゃった！<small>もう一度 ながれてくるよ</small>',1.8,{now:true});}}
function passGate(k){sfx('gate');const f=fm,G=f.gates,o=G.ops[k],before=f.v,good=o[0]==='+'||o[0]==='×';f.v=opApply(f.v,o);f.i++;G.hit=k;G.fade=0.8;f.pop=0.6;
  burst(G.x[k],G.y-G.h*0.5,good?'#fff3c2':'#cfe2ff',28,250);shake=3;P.expr=good?'happy':'surprised';P.exprT=1.1;
  banner(`${before} ${opLabel(o)} ＝ <b>${f.v}</b>${f.i<3?`<small>つぎの ゲートが くるよ（${f.i+1}/3）</small>`:''}`,1.6,{now:true});fmPanel();}
function fmBattle(dt){const f=fm;
  for(const e of f.foes){e.bob+=dt*3;if(e.shake>0)e.shake-=dt;if(e.gone){if(e.die>0)e.die-=dt;continue;}
    const d=hyp(P.x-e.x,P.y-e.y),md=charPx*0.24+e.h*0.24;
    if(e.block){if(d>md+45)e.block=false;else if(d<md){const dd=d||1;P.x=e.x+(P.x-e.x)/dd*md;P.y=e.y+(P.y-e.y)/dd*md;}continue;}
    if(f.res!=null||d>=md)continue;
    if(f.lv>e.lv){sfx('pop');e.gone=true;e.die=0.6;const before=f.lv;f.lv+=e.lv;f.pop=0.6;burst(e.x,e.y-e.h*0.5,'#fff3c2',26,230);shake=3;P.expr='happy';P.exprT=1.2;
      for(let i=0;i<6;i++)part(FX.star('#f2c94c'),e.x,e.y-e.h*0.5,rr(-90,90),rr(-200,-90),1,{g:260,s:0.6,s2:0.3});
      if(e.boss){fmPanel();fmResult(true,`宝箱の番人に かった！ Lv ${f.lv}`);return;}
      banner(`かった！ <b>Lv ${before} ＋ ${e.lv} ＝ Lv ${f.lv}</b>`,1.6,{now:true});fmPanel();}
    else{sfx('bump');f.miss++;e.shake=0.45;e.block=true;const dd=d||1;P.vx=(P.x-e.x)/dd*480;P.vy=(P.y-e.y)/dd*480;P.x=e.x+(P.x-e.x)/dd*(md+4);P.y=e.y+(P.y-e.y)/dd*(md+4);
      P.expr='surprised';P.exprT=1;burst(P.x,P.y-charPx*0.5,'#9ab4e0',12,170);fmPanel();
      if(f.miss>=f.maxMiss){fmResult(false,'はねかえされて しまった… おしい！');return;}
      banner(`まだ つよすぎる！<small>Lv ${f.lv} ≦ Lv ${e.lv}　あと ${f.maxMiss-f.miss}回 まちがえても だいじょうぶ</small>`,2,{now:true});}}}
function badge(x,y,text,o){o=o||{};const fs=o.fs||20;ctx.save();ctx.font=`bold ${fs}px ${fontF()}`;const w=ctx.measureText(text).width+fs*0.95,h=fs*1.5;
  if(o.alpha!=null)ctx.globalAlpha=o.alpha;if(o.sc){ctx.translate(x,y);ctx.scale(o.sc,o.sc);ctx.translate(-x,-y);}
  ctx.fillStyle=o.bg||'rgba(255,250,240,.96)';ctx.strokeStyle=o.col||'#c9a24a';ctx.lineWidth=3;ctx.beginPath();if(ctx.roundRect)ctx.roundRect(x-w/2,y-h,w,h,h/2);else ctx.rect(x-w/2,y-h,w,h);ctx.fill();ctx.stroke();
  ctx.fillStyle=o.tc||'#4a2a1c';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(text,x,y-h/2+1);ctx.restore();}
const lvIcon=(lv,boss)=>tcache('lvi'+lv+(boss?'b':''),()=>mk(36,36,x=>{if(boss)x.drawImage(FX.crown(),9,-2,18,18);x.fillStyle=boss?'#8a5a10':'#5a3a7a';x.textAlign='center';x.textBaseline='middle';x.font=`bold ${String(lv).length>2?13:16}px ${fontF()}`;x.fillText(String(lv),18,boss?24:19);}));
function drawFoe(f){const sc=f.h/ATLAS.enemy.charH,hop=Math.abs(Math.sin(f.bob))*3,a=f.gone?clamp(f.die/0.6,0,1):1,up=f.gone?(0.6-f.die)*90:0;
  if(f.boss&&!f.gone){ctx.save();ctx.globalCompositeOperation='lighter';drawFx(FX.glow('#ffe08a'),f.x,f.y-f.h*0.45,0,0.3+0.1*Math.sin(time*4),f.h*1.4/64);ctx.restore();}
  ctx.save();ctx.globalAlpha=0.55*a;ctx.strokeStyle=f.boss?'#c9a24a':'#a58bd0';ctx.lineWidth=3;ctx.beginPath();ctx.ellipse(f.x,f.y+2,f.h*0.36,f.h*0.12,0,0,TAU);ctx.stroke();ctx.restore();
  drawSprite(enemyFrame(f.k,f.tier),f.x+(f.shake>0?Math.sin(time*70)*5:0),f.y-hop-up,sc,{flip:P.x<f.x,alpha:a});
  if(f.boss&&!f.gone)ctx.drawImage(FX.crown(),f.x-16,f.y-hop-f.h-30,32,32);}
function drawFieldTop(){const f=fm;
  if(f.type==='gates'&&f.gates){const G=f.gates;
    for(let k=0;k<2;k++){let a=Math.min(1,G.t/0.6);if(G.hit!=null)a*=clamp(G.fade/0.8,0,1)*(k===G.hit?1:0.5);if(a<=0)continue;const x=G.x[k],y=G.y,h=G.h,o=G.ops[k],sc=G.hit===k?1+(0.8-G.fade)*0.35:1;
      ctx.save();ctx.globalAlpha=a*0.25;ctx.fillStyle='#3c2a40';ctx.beginPath();ctx.ellipse(x,y+4,G.w*0.42,10,0,0,TAU);ctx.fill();ctx.restore();
      if(!drawArt(G.arch,x,y,h,{alpha:a,sc})){ctx.save();ctx.globalAlpha=a;ctx.strokeStyle='#c9a24a';ctx.lineWidth=8;ctx.beginPath();ctx.moveTo(x-G.w*0.4,y);ctx.lineTo(x-G.w*0.4,y-h*0.6);ctx.arc(x,y-h*0.6,G.w*0.4,Math.PI,0);ctx.lineTo(x+G.w*0.4,y);ctx.stroke();ctx.restore();}
      const good=o[0]==='+'||o[0]==='×';badge(x,y-h*0.42,opLabel(o),{fs:30,alpha:a,sc,bg:good?'rgba(255,240,245,.95)':'rgba(236,243,255,.95)',col:good?'#d98aa5':'#8fa9d8',tc:good?'#b0365a':'#3b5b9a'});}}
  if(f.foes)for(const e of f.foes)if(!e.gone)badge(e.x,e.y-e.h-(e.boss?34:8)+(-Math.abs(Math.sin(e.bob))*3),`${e.boss?'番人 ':''}Lv ${e.lv}`,{fs:e.boss?19:18,col:e.boss?'#c9a24a':'#a58bd0'});
  const t=f.type==='gates'?String(f.v):'Lv '+f.lv;badge(P.x,P.y-P.lift-charPx*1.06,t,{fs:22,col:'#d2486a',tc:'#b0365a',sc:f.pop>0?1+f.pop*0.4:1});}
/* ---- star fragments (stages 1-4) & popped items ---- */
const STARS=[
 {name:'朝日の星',art:'star_p',col:'#ffc2d4',place:'hill',line:'にゃあ！ 宝箱から『朝日の星のかけら』が出たよ！ なんだかぽかぽか温かいね！'},
 {name:'木漏れ日の星',art:'star_y',col:'#ffe08a',place:'tree',line:'わあ、木の根元の宝箱に『木漏れ日の星のかけら』が入ってたよ！ キラキラしてるにゃ！'},
 {name:'さざ波の星',art:'star_b',col:'#a8d0ff',place:'rock',line:'やったね！ 砂浜の宝箱から『さざ波の星のかけら』を見つけたよ！ これで3つ目だ！'},
 {name:'月光の星',art:'star_rb',col:'#e8dcff',place:'center',line:'すごいにゃ！ 花園の宝箱から『月光の星のかけら』が出たよ！ 4つぜんぶそろったね！'}];
function placeStarChest(i){const S=STARS[i],W=world.W,H=world.H,b=world.b,rnd=mulberry(777+i*91);let x,y;
  if(S.place==='center'){x=W/2;y=H*0.55+150;}
  else{x=b.l+220+rnd()*(b.r-b.l-440);y=S.place==='hill'?b.b-200:S.place==='tree'?b.b-240:b.b-300;}
  const keepBig=o=>o.r>=70;
  world.obst=world.obst.filter(o=>keepBig(o)||hyp(o.x-x,o.y-y)>o.r+150);
  for(const c of world.chests)if(hyp(c.x-x,c.y-y)<260){c.x=c.x<W/2?Math.min(b.r-80,c.x+520):Math.max(b.l+80,c.x-520);}
  world.sdeco=world.sdeco.filter(d=>hyp(d.x-x,d.y-y)>60);
  const art=!!world.set,add=(k,ox,oy,hm)=>{if(!art||!OBJ[k])return;const o=artObj(k,x+ox,y+oy,0);if(hm){o.h*=hm;o.w*=hm;}world.obst.push(o);},
    deco=(k,ox,oy,h)=>{if(art)world.sdeco.push({k,x:x+ox,y:y+oy,h:h||SDECO_H[k]||28,f:ox<0});};
  world.mounds=world.mounds||[];
  if(S.place==='hill'){world.mounds.push({x,y:y-6,rx:150,ry:70,col:'#d9ecb0'});for(let a=0;a<12;a++){const t=Math.PI*0.15+a/11*Math.PI*1.7+Math.PI/2;deco(pick(['fl_daisy','fl_pink','fl_a71','fl_a73']),Math.cos(t)*115,Math.sin(t)*48-8,30);}add('bush_rose',-120,-30);add('bush_white',125,-25);}
  else if(S.place==='tree'){add('tree_g',0,-48,1.35);deco('shroom_r',-58,6,32);deco('shroom_r',62,10,28);deco('grass',-30,14,24);deco('grass2',36,16,22);}
  else if(S.place==='rock'){world.mounds.push({x,y:y+2,rx:80,ry:22,col:'rgba(90,80,70,.18)'});add('rock',-78,-14);add('rock_moss',74,-6);deco('fl_a71',-36,18,24);deco('rock_s',40,20,24);}
  else{add('bush_rose',-105,10);add('bush_hydr',105,10);deco('fl_pink',-55,26,28);deco('fl_lily',58,26,30);deco('fl_a72',0,40,24);}
  world.sdeco.sort((a,c)=>a.y-c.y);
  world.chests.push({x,y,open:false,t:0,type:'star',star:i});}
function openStarChest(c){sfx('star');const S=STARS[c.star],first=!save.stars[c.star];c.open=true;c.t=0;chestsOpen++;save.stars[c.star]=1;writeSave();
  P.expr='happy';P.exprT=2;burst(c.x,c.y-30,S.col,40,300);burst(c.x,c.y-30,'#fff3c2',24,220);shake=3;
  for(let i=0;i<16;i++)part(FX.star(pick(['#f2c94c',S.col,'#ffffff'])),c.x,c.y-30,rr(-140,140),rr(-260,-120),1.4,{g:260,vr:rr(-4,4),s:0.7,s2:0.4});
  popItem(S.art,c.x,c.y-46,{big:1});
  if(P.guard<P.maxGuard&&!P.bare){P.guard=Math.min(P.maxGuard,P.guard+curMods(false).heal);buildHearts();}
  if(P.godLeft>0)P.gauge=Math.min(1,P.gauge+0.35);
  const line=first?S.line:`『${S.name}のかけら』は もう 持っているよ。かわりに キラキラの宝石が 入ってたにゃ！`;
  banner(`<div class="bcard"><canvas width="96" height="96"></canvas><div><div class="bt">★ ${S.name}の かけら</div><div class="bl">「${line}」</div></div></div>`,4.2,{now:true,after:el=>drawNarrator(el.querySelector('canvas'),catOn?'cat':'goddess')});}
let pops=[];
function popItem(k,x,y,o){pops.push({k,x,y,t0:time,t:0,big:!!(o&&o.big)});}
function drawPops(){if(!pops.length)return;for(const q of pops){q.t=time-q.t0;const T=q.big?2.6:1.8,a=q.t<T-0.5?1:Math.max(0,(T-q.t)/0.5),up=Math.min(1,q.t/0.6),h=(q.big?54:40)*(0.6+0.4*up)*(1+0.06*Math.sin(q.t*8));
    const yy=q.y-up*(q.big?70:50);ctx.save();ctx.globalCompositeOperation='lighter';drawFx(FX.glow('#fff3c2'),q.x,yy-h*0.5,0,0.6*a,h/30);ctx.restore();drawArt(q.k,q.x,yy,h,{alpha:a});}
  pops=pops.filter(q=>q.t<(q.big?2.6:1.8));}
function starRow(){const el=$('starRow');if(!el)return;el.innerHTML='星のかけら '+STARS.map((S,i)=>`<canvas width="64" height="64" class="${save.stars[i]?'':'off'}" data-k="${S.art}"></canvas>`).join('');
  el.querySelectorAll('canvas').forEach(cv=>artToCanvas(cv,cv.dataset.k,2));}
const starIcon=i=>tcache('stI'+i,()=>mk(36,36,x=>{const it=artRect(STARS[i].art),img=objImg();if(it&&img)x.drawImage(img,it[0],it[1],it[2],it[3],3,3,30,30);}));
function artFeather(){if(!objImg()||!artRect('feather_a'))return null;return tcache('gfShot',()=>{const it=artRect('feather_a'),img=objImg(),h=34,w=Math.round(it[2]*h/it[3]);return mk(w+8,h+8,x=>{x.shadowColor='rgba(255,236,190,.95)';x.shadowBlur=5;x.drawImage(img,it[0],it[1],it[2],it[3],4,4,w,h);});});}
let gfi=0;function gFeather(){const ks=['feather_a','feather_b','feather_c','feather_d'],k=ks[(gfi++)%4];
  return tcache('gf_'+k,()=>{const it=artRect(k),img=objImg();const h=40,w=it?Math.round(it[2]*h/it[3]):20;return mk(w+8,h+8,x=>{if(it&&img){x.shadowColor='rgba(255,240,200,.9)';x.shadowBlur=6;x.drawImage(img,it[0],it[1],it[2],it[3],4,4,w,h);}else{x.fillStyle='#fff';x.beginPath();x.ellipse((w+8)/2,(h+8)/2,w/2,h/2,0,0,TAU);x.fill();}});});}
/* ---- reset (start over) ---- */
$('btnWipe').onclick=()=>showOnly('scrConfirm');
$('btnWipeNo').onclick=()=>showOnly('scrSettings');
$('btnWipeYes').onclick=()=>{Object.assign(save,{cleared:{},costume:'basic',storySeen:{},stars:{},tutDone:false,hintSeen:false,allStages:false,allCos:false,posterSeen:false,best:{},bestUp:0,stamps:[],ribbon:'red',ribbons:['red'],giftBonus:0,owned:['basic'],v83:1});writeSave();try{lastUnlock=null;}catch(e){}toTitle();};
/* ---- PR poster (first launch + manual) ---- */
let posterFrom=null;
function openPoster(from){if(!ATLAS.poster)return;posterFrom=from;const sc=$('scrPoster'),im=$('posterImg'),bx=$('posterBox');
  posterGesture.reset();$('posterGo').textContent=from==='boot'?'タイトルへ すすむ ▶':'とじる';
  im.classList.remove('on');im.onload=()=>im.classList.add('on');im.src=ASSETS[ATLAS.poster.file]||BASE+ATLAS.poster.file;if(im.complete&&im.naturalWidth)im.classList.add('on');
  sc.classList.remove('hidden');bx.scrollTop=0;bx.scrollLeft=0;}
function closePoster(){$('scrPoster').classList.add('hidden');if(posterFrom==='boot'){save.posterSeen=true;writeSave();setTimeout(stampCheck,300);}posterFrom=null;}
$('posterGo').onclick=closePoster;
const posterGesture=bindImagePinch($('posterBox'),$('posterImg'),{max:()=>6});
/* ---- before each stage: "衣装は えらんだ？" ---- */
let readyIdx=0,readyFrom=null;
function readyNarr(i){return i>=5&&i<=9&&!save.cleared[9]?'goddess':'cat';}
async function openReady(i){readyIdx=i;showOnly('scrReady');
  const st=STAGES[i],who=readyNarr(i),c=costume(),nm=c===BARE?'素体（ハードモード）':c.name.replace('\n','');
  const newest=COSTUMES.filter(x=>!x.special&&cosOpen(x)).sort((a,b)=>crank(b)-crank(a))[0];
  const tip=newest&&newest.id!==save.costume&&crank(newest)>0?`新しい『${newest.name.replace('\n','')}』も 着られる${who==='cat'?'よ':'わ'}！`:'';
  $('readyHead').textContent=`ステージ${i+1}「${st.name}」`;
  $('readyText').innerHTML=`<span class="rn">${NARR[who]}</span>`+(who==='cat'
    ?`にゃ！ しゅっぱつ前に、衣装は えらんだ？ いまは『${nm}』だよ。${tip?'<br>'+tip:''}`
    :`出発の前に、衣装は 選びましたか？ いまは『${nm}』ですね。${tip?'<br>'+tip.replace('着られるわ！','着られますよ。'):''}`)+(hardMode()?`<br><small>素体は 衣装の力が ないので むずかしいよ。</small>`:'');
  drawNarrator($('readyFace'),who);
  await loadImg(ATLAS.thumbs.file);const cv=$('readyCos'),x=cv.getContext('2d'),f=thumbFrame(thumbId(save.costume)),ti=imgOf(ATLAS.thumbs.file);x.clearRect(0,0,230,244);if(ti)x.drawImage(ti,f.sx,f.sy,f.sw,f.sh,0,0,230,244);
  $('readyCosName').innerHTML=`いまの 衣装<br>${nm}${c.star?` <span class="stars">${starStr(c.star)}</span>`:''}`;}
$('btnReadyGo').onclick=()=>{showOnly(null);startStage(readyIdx);};
$('btnReadyWard').onclick=()=>openWard('ready');
$('btnReadyBack').onclick=()=>openStages(Math.floor(readyIdx/10));
/* ============ sound (all synthesized here: original, no outside files) ============ */
const SND={ctx:null,master:null,bgmG:null,seG:null,song:null,want:null,next:0,step:0,timer:null,lastShot:0,lastPop:0};
const VOLS=[0,0.4,0.75,1.1];
const mtof=m=>440*Math.pow(2,(m-69)/12);
function audioInit(){if(SND.ctx)return true;const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return false;try{const c=new AC();SND.ctx=c;
  SND.master=c.createGain();SND.master.gain.value=0.9;SND.master.connect(c.destination);
  SND.bgmG=c.createGain();SND.seG=c.createGain();
  const d=c.createDelay(1);d.delayTime.value=0.27;const fb=c.createGain();fb.gain.value=0.3;const wet=c.createGain();wet.gain.value=0.25;d.connect(fb);fb.connect(d);d.connect(wet);wet.connect(SND.master);
  SND.bgmG.connect(SND.master);SND.seG.connect(SND.master);SND.bgmG.connect(d);SND.seG.connect(d);applyVol();
  SND.timer=setInterval(bgmTick,60);return true;}catch(e){return false;}}
function applyVol(){if(!SND.ctx)return;SND.bgmG.gain.value=VOLS[save.bgmVol|0]*0.24;SND.seG.gain.value=VOLS[save.seVol|0]*0.5;}
function audioUnlock(){if(!audioInit())return;const c=SND.ctx;if(c.state!=='running')c.resume();
  if(!SND.unlocked){SND.unlocked=true;try{const b=c.createBuffer(1,1,22050),src=c.createBufferSource();src.buffer=b;src.connect(c.destination);src.start(0);}catch(e){}if(SND.want!==SND.song)bgm(SND.want,true);}}
['pointerdown','touchend','keydown'].forEach(ev=>window.addEventListener(ev,audioUnlock,{capture:true,passive:true}));
document.addEventListener('visibilitychange',()=>{if(!SND.ctx)return;if(document.hidden)SND.ctx.suspend();else if(SND.unlocked)SND.ctx.resume();});
document.addEventListener('click',e=>{const b=e.target.closest&&e.target.closest('button');if(b&&!b.disabled)sfx('tap');},true);
function tone(f,t0,dur,o){o=o||{};const c=SND.ctx,g=c.createGain(),osc=c.createOscillator();osc.type=o.type||'sine';osc.frequency.setValueAtTime(f,t0);
  if(o.slide)osc.frequency.exponentialRampToValueAtTime(o.slide,t0+(o.st||dur));if(o.slide2)osc.frequency.exponentialRampToValueAtTime(o.slide2,t0+dur);
  const v=o.v||0.2,a=o.a||0.006;g.gain.setValueAtTime(0.0001,t0);g.gain.exponentialRampToValueAtTime(v,t0+a);g.gain.exponentialRampToValueAtTime(0.0001,t0+dur);
  osc.connect(g);g.connect(o.dest||SND.seG);osc.start(t0);osc.stop(t0+dur+0.05);}
function bell(f,t0,dur,v,dest){tone(f,t0,dur,{v,dest});tone(f*2,t0,dur*0.45,{v:v*0.3,dest});tone(f*3.01,t0,dur*0.22,{v:v*0.1,dest});}
function sfx(name){if(!SND.ctx||SND.ctx.state!=='running'||!save.seVol)return;const c=SND.ctx,t=c.currentTime+0.01;
  switch(name){
  case'shot':if(t-SND.lastShot<0.2)return;SND.lastShot=t;tone(1900,t,0.06,{v:0.045,type:'triangle',slide:2600});break;
  case'pop':if(t-SND.lastPop<0.06)return;SND.lastPop=t;bell(mtof(88),t,0.22,0.11);bell(mtof(95),t+0.05,0.3,0.09);break;
  case'tap':tone(1250,t,0.05,{v:0.04});break;
  case'chest':[84,88,91,96].forEach((m,i)=>bell(mtof(m),t+i*0.07,0.6,0.15));break;
  case'star':[79,84,88,91,96,100].forEach((m,i)=>bell(mtof(m),t+i*0.065,0.9,0.14));break;
  case'win':[72,76,79,84].forEach((m,i)=>bell(mtof(m),t+i*0.1,0.5,0.16));bell(mtof(88),t+0.42,1.1,0.16);break;
  case'miss':[76,72].forEach((m,i)=>tone(mtof(m),t+i*0.17,0.35,{v:0.1,type:'triangle'}));break;
  case'hurt':tone(330,t,0.22,{v:0.14,type:'triangle',slide:190});break;
  case'guard':[86,93].forEach((m,i)=>bell(mtof(m),t+i*0.05,0.5,0.13));break;
  case'goddess':[0,4,7,11,12,16,19,24].forEach((d,i)=>bell(mtof(84+d),t+i*0.055,1.2,0.09));break;
  case'boss':bell(mtof(64),t,1.3,0.18);bell(mtof(71),t+0.2,1.3,0.14);break;
  case'bossDown':[79,83,86,91].forEach((m,i)=>bell(mtof(m),t+i*0.08,0.8,0.15));break;
  case'clear':[72,76,79,84].forEach((m,i)=>bell(mtof(m),t+i*0.12,0.7,0.18));[84,88,91].forEach(m=>bell(mtof(m),t+0.56,1.9,0.11));break;
  case'lose':[76,74,72,67].forEach((m,i)=>tone(mtof(m),t+i*0.19,0.45,{v:0.09,type:'triangle'}));break;
  case'gate':bell(mtof(86),t,0.4,0.15);bell(mtof(91),t+0.06,0.5,0.11);break;
  case'bump':tone(230,t,0.16,{v:0.13,type:'triangle',slide:150});break;
  case'stamp':tone(190,t,0.14,{v:0.28,slide:95});bell(mtof(91),t+0.1,0.7,0.14);bell(mtof(96),t+0.18,0.8,0.1);break;
  case'meow':tone(560,t,0.42,{v:0.09,type:'triangle',slide:820,st:0.12,slide2:470});break;
  case'heal':[84,88,91,96].forEach((m,i)=>bell(mtof(m),t+i*0.06,0.6,0.11));break;
  case'shutter':tone(2400,t,0.03,{v:0.07,type:'square'});tone(1300,t+0.07,0.04,{v:0.05,type:'square'});bell(mtof(96),t+0.15,0.6,0.08);break;
  }}
const CH={F:[53,[65,69,72]],Dm:[50,[62,65,69]],Bb:[58,[62,65,70]],C:[48,[64,67,72]],C7:[48,[64,67,70]],Gm:[55,[62,67,70]],A:[57,[61,64,69]],Am:[57,[60,64,69]]};
const SONGS={
 title:{bpm:70,ch:['F','Am','Bb','C','F','Dm','Gm','C7'],mel:[[77,null,72],[76,null,72],[74,null,77],[76,null,79],[81,null,77],[74,null,77],[79,77,74],[72,null,null]],cv:0.035,bv:0.09},
 waltz:{bpm:100,ch:['F','F','Dm','Dm','Bb','Bb','C','C7','F','F','Dm','Dm','Bb','C','F','F'],
  mel:[[69,72,77],[76,74,72],[74,77,81],[79,77,76],[74,77,82],[81,79,77],[76,79,84],[82,81,79],[81,null,77],[72,77,81],[86,84,81],[77,null,74],[82,81,79],[79,76,72],[77,81,84],[89,null,null]],cv:0.045,bv:0.1},
 boss:{bpm:132,ch:['Dm','Dm','Bb','Bb','Gm','Gm','A','A'],mel:[[74,77,81],[79,77,76],[74,77,82],[81,79,77],[79,82,86],[84,82,79],[81,null,76],[73,76,81]],cv:0.05,bv:0.11}};
function bgm(name,force){SND.want=name;if(!SND.ctx||!SND.unlocked){return;}if(name===SND.song&&!force)return;SND.song=name;SND.step=0;SND.next=SND.ctx.currentTime+0.15;}
function bgmTick(){const c=SND.ctx;if(!c||c.state!=='running'||!SND.song||!save.bgmVol)return;const S=SONGS[SND.song];if(!S)return;const beat=60/S.bpm;
  while(SND.next<c.currentTime+0.3){const st=SND.step,bar=Math.floor(st/3)%S.ch.length,b=st%3,ch=CH[S.ch[bar]],t=SND.next,d=SND.bgmG;
    if(b===0)tone(mtof(ch[0]),t,beat*2.6,{v:S.bv,dest:d,type:'triangle'});else ch[1].forEach(m=>tone(mtof(m),t,beat*0.8,{v:S.cv,dest:d,type:'sine'}));
    const n=S.mel[bar%S.mel.length][b];if(n)bell(mtof(n),t,beat*1.7,0.1,d);
    SND.step++;SND.next+=beat;}}
/* ============ best time helpers ============ */
function fmtT(t){if(t==null)return'ー';const m=Math.floor(t/60),s=t-m*60;return (m?m+'分':'')+s.toFixed(1)+'秒';}
/* ============ shots: tear gem ============ */
FX.tear=(col)=>fx('tear'+col,30,(x,r)=>{glowCircle(x,r,'#eaf3ff',0.85);x.fillStyle=col;x.beginPath();x.moveTo(0,-r*0.78);x.bezierCurveTo(r*0.55,-r*0.08,r*0.52,r*0.62,0,r*0.64);x.bezierCurveTo(-r*0.52,r*0.62,-r*0.55,-r*0.08,0,-r*0.78);x.fill();
  x.strokeStyle='#ffffff';x.lineWidth=1.6;x.stroke();x.fillStyle='rgba(255,255,255,.9)';x.beginPath();x.ellipse(-r*0.14,r*0.12,r*0.1,r*0.22,0.3,0,TAU);x.fill();});
/* ============ cat ribbon colors (recolored here from the original art) ============ */
const RIBBONS=[['red','あか',null,'#c0392b'],['blue','あお',218,'#3d6fd0'],['pink','ピンク',322,'#e0569a'],['purple','むらさき',272,'#8a4fd0'],['green','みどり',140,'#3a9a5a'],['gold','きんいろ',44,'#d4a020']];
function ribbonKey(file){const r=save.ribbon||'red';if(r==='red')return file;const k=file+'#'+r;return imgOf(k)?k:file;}
function recolor(file,hue,cellH,key){const img=imgOf(file);if(!img)return Promise.resolve();const cv=document.createElement('canvas');cv.width=img.naturalWidth;cv.height=img.naturalHeight;const x=cv.getContext('2d');x.drawImage(img,0,0);
  const id=x.getImageData(0,0,cv.width,cv.height),d=id.data,W=cv.width;
  for(let i=0;i<d.length;i+=4){if(d[i+3]<26)continue;const r=d[i]/255,g=d[i+1]/255,b=d[i+2]/255,mx=Math.max(r,g,b),mn=Math.min(r,g,b),df=mx-mn;if(mx<0.28||df/mx<0.36)continue;
    let h;if(mx===r)h=((g-b)/df)%6;else if(mx===g)h=(b-r)/df+2;else h=(r-g)/df+4;h*=60;if(h<0)h+=360;if(!(h>=322||h<=6))continue;
    const y=((i/4)/W|0)%cellH;if(y/cellH<0.34)continue;
    const s=df/mx,v=mx,H=hue/60,C=v*s*(hue===44?0.85:1),X=C*(1-Math.abs(H%2-1)),m=v-C;let R1=0,G1=0,B1=0;const k=Math.floor(H)%6;
    if(k===0){R1=C;G1=X;}else if(k===1){R1=X;G1=C;}else if(k===2){G1=C;B1=X;}else if(k===3){G1=X;B1=C;}else if(k===4){R1=X;B1=C;}else{R1=C;B1=X;}
    d[i]=(R1+m)*255;d[i+1]=(G1+m)*255;d[i+2]=(B1+m)*255;}
  x.putImageData(id,0,0);const im=new Image();const p=new Promise(res=>{im.onload=()=>res(im);im.onerror=()=>res(null);});im.src=cv.toDataURL('image/png');images[key]={img:im,p};return p;}
async function prepRibbon(name){const R0=RIBBONS.find(r=>r[0]===name);if(!R0||!R0[2])return;const jobs=[[ATLAS.cat,ATLAS.cat.ch],[ATLAS.catpose,ATLAS.catpose.ch],[ATLAS.catface,ATLAS.catface.ch||ATLAS.catface.cw]];
  await Promise.all(jobs.map(([a,ch])=>loadImg(a.file).then(()=>images[a.file+'#'+name]?images[a.file+'#'+name].p:recolor(a.file,R0[2],ch,a.file+'#'+name))));}
async function setRibbon(name){if(!save.ribbons.includes(name))return;await prepRibbon(name);save.ribbon=name;writeSave();const ci=$('catIco');if(ci)delete ci.dataset.d;try{drawTitleChar();}catch(e){}}
/* ============ daily stamps ============ */
function todayKey(){const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
function stampCardHTML(n,fresh){const k=n%7===0&&n>0?7:n%7;return `<div class="stampCard">${Array.from({length:7},(_,i)=>`<div class="${i<k?'on':''}${fresh&&i===k-1?' new':''}">${i<k?'🐾':i+1}</div>`).join('')}</div>`;}
function stampCheck(){if(mode!=='title')return;if(DEBUG&&!/stamp/.test(location.search))return;if(!$('scrPoster').classList.contains('hidden'))return;
  const k=todayKey();if(save.stamps.includes(k))return;const giftBefore=GIFTS().filter(cosOpen).map(c=>c.id);
  save.stamps.push(k);const n=save.stamps.length;let rib=null;if(n%7===0){rib=RIBBONS.find(r=>!save.ribbons.includes(r[0]))||null;if(rib)save.ribbons.push(rib[0]);}
  syncOwned();writeSave();const gNew=GIFTS().filter(c=>cosOpen(c)&&!giftBefore.includes(c.id));
  show('scrStamp');drawNarrator($('stampCat'),'cat');$('stampTitle').textContent=n%7===0?'カードが いっぱい！':'きょうの スタンプ';
  $('stampMsg').innerHTML=n===1?'はじめまして にゃ！ あそびに きた日は スタンプを おすよ。':'きょうも きてくれて ありがとうにゃ！ スタンプ ポン！';
  $('stampCard').innerHTML=stampCardHTML(n,true);
  let info=`スタンプ 合計 <b>${n}</b>個`;if(n%7)info+=`　カードが いっぱいまで あと <b>${7-n%7}</b>個`;
  info+=`<br>ごほうびポイント <b>+1</b>（いまの ごほうびポイント <b>${rewardPoints()}</b>）`;
  if(rib)info+=`<br>ごほうび：<b style="color:${rib[3]}">黒猫の リボン（${rib[1]}）</b>！ きろく帳で つけかえられるよ。`;
  if(n%7===0&&!save.cleared[9]&&GIFTS().some(c=>!cosOpen(c)))info+=`<br><small>ごほうび衣装は ステージ10を クリアすると もらえるよ（とっておくね）。</small>`;
  if(gNew.length)info+=`<br><b style="color:var(--wine)">ごほうび衣装『${gNew.map(c=>c.name.replace('\n','')).join('』『')}』を もらった！</b>`;
  $('stampInfo').innerHTML=info;setTimeout(()=>sfx('stamp'),350);}
$('btnStampOk').onclick=()=>hide('scrStamp');
/* ============ record book ============ */
let recTab='stamp';
function openRecord(tab){recTab=tab||recTab;showOnly('scrRecord');
  $('recTabs').innerHTML=[['stamp','スタンプ'],['best','ベストタイム'],['album','アルバム']].map(([k,l])=>`<button data-t="${k}" class="${k===recTab?'on':''}">${l}</button>`).join('');
  $('recTabs').querySelectorAll('button').forEach(b=>b.onclick=()=>openRecord(b.dataset.t));
  const B=$('recBody');const n=stampCount();
  if(recTab==='stamp'){const gs=GIFTS(),got=gs.filter(cosOpen).length,all=COSTUMES.filter(c=>!c.special&&(!c.secret2||secret2Open())),gotAll=all.filter(cosOpen).length;
    B.innerHTML=`<div class="recPts">いまの ごほうびポイント <b>${rewardPoints()}</b></div>`+stampCardHTML(n,false)+`<p class="recInfo">スタンプ 合計 <b>${n}</b>個（あそんだ日に 1つ）。7つで カードが いっぱいに なり、黒猫の リボンの 色が ふえます。</p>
      <h3>黒猫の リボン</h3><div class="ribRow">${RIBBONS.map(r=>`<button data-r="${r[0]}" style="background:${r[3]}" class="${save.ribbon===r[0]?'on':''}" ${save.ribbons.includes(r[0])?'':'disabled'}>${save.ribbons.includes(r[0])?r[1]:'🔒'}</button>`).join('')}</div>
      <h3>ごほうびポイント</h3><p class="recInfo">ステージ初クリアで <b>1</b>ポイント、スタンプ 1個で <b>1</b>ポイント、ベストタイム 更新 1回で <b>2</b>ポイント たまります（スタンプ ${n}個・ベスト更新 ${save.bestUp||0}回）。<br>ごほうび衣装は ステージ10を クリアした あと、衣装ごとの 必要ポイントに とどくと もらえます（必要ポイントは「衣装」の画面で 見られます）。<br>${save.cleared[9]?`もらった ごほうび衣装 <b>${got}</b> / ${gs.length}着`:'まだ ステージ10を クリアしていません（ポイントは とっておけます）。'}・着られる衣装 <b>${gotAll}</b> / ${all.length}着</p>`;
    B.querySelectorAll('.ribRow button').forEach(b=>b.onclick=async()=>{await setRibbon(b.dataset.r);openRecord('stamp');});}
  else if(recTab==='best'){let h='',cnt=0;for(let i=0;i<STAGES.length;i++){if(!save.cleared[i])continue;cnt++;h+=`<div class="recRow"><span>${i+1}. ${STAGES[i].name}</span><b>${fmtT(save.best[i])}</b></div>`;}
    B.innerHTML=`<p class="recInfo">クリア <b>${cnt}</b>ステージ・ベスト更新 <b>${save.bestUp||0}</b>回</p>`+(h||'<p class="recInfo">まだ クリアした ステージが ありません。</p>');}
  else{const al=albumLoad();B.innerHTML=al.length?`<div class="album">${al.map((p,i)=>`<img src="${p.d}" data-i="${i}" alt="写真${i+1}">`).join('')}</div><p class="recInfo">タップすると 大きく 見られます（さいごの 8まい）。</p>`:'<p class="recInfo">まだ 写真が ありません。ステージを クリアしたら「📷 きねん写真」で とってみてね。</p>';
    B.querySelectorAll('.album img').forEach(im=>im.onclick=()=>openPhoto(al[+im.dataset.i].d,+im.dataset.i));}
  $('scrRecord').scrollTop=0;}
$('btnRecordT').onclick=()=>openRecord('stamp');
/* ---- secret commands: 10 title taps = existing rewards; 20 taps = 2nd secret ----
   20 taps unlock goddess, special outfits, and extra base choices. The 10-tap
   reward alone must not unlock these; persist both independently. */
let titleTaps=[],toastT=0,secretStage=0;
function toast(html,sec){const t=$('toast');t.innerHTML=html;t.classList.remove('hidden');clearTimeout(toastT);toastT=setTimeout(()=>t.classList.add('hidden'),(sec||3)*1000);}
$('titleCard').addEventListener('click',()=>{
  if($('scrTitle').classList.contains('hidden'))return;
  const now=Date.now();
  if(titleTaps.length && now-titleTaps[0]>16000){titleTaps=[];secretStage=0;}
  titleTaps.push(now);
  const count=titleTaps.length;
  if(count===10){
    secretStage=1;
    if(!save.allCos){save.allCos=true;writeSave();sfx('star');toast('✨ ひみつの じゅもん！<br>通常の 衣装が 着られるように なったよ',3.5);}
    else toast('✨ ひとつめの ひみつは もう 解放ずみ！',2.5);
    try{drawTitleChar();}catch(e){}
  } else if(count>=20){
    titleTaps=[];secretStage=0;
    if(!save.baseNUnlocked){save.baseNUnlocked=true;if(MOVED_BASE_IDS.includes(save.pendingBaseArt)){save.baseArt=save.pendingBaseArt;delete save.pendingBaseArt;}syncOwned();writeSave();sfx('star');toast('🌸 ふたつめの ひみつ！<br>29着の衣装と 素体（ハードモード／絵 8しゅるい）が つかえるよ',6.2);}
    else toast('🌸 ふたつめの ひみつは もう 解放ずみだよ',3);
  }
});$('btnRecOk').onclick=()=>toTitle();
/* ============ photos ============ */
const ALBUM_KEY=SAVE_KEY+'-album';
function albumLoad(){try{return JSON.parse(localStorage.getItem(ALBUM_KEY)||'[]');}catch(e){return [];}}
function albumSave(a){for(let k=0;k<4;k++){try{localStorage.setItem(ALBUM_KEY,JSON.stringify(a));return true;}catch(e){a.shift();if(!a.length)return false;}}return false;}
async function makePhoto(){const W=600,H=800,cv=document.createElement('canvas');cv.width=W;cv.height=H;const x=cv.getContext('2d');
  const tid=mode==='play'&&stage?stage.theme:(world&&world.tid)||'meadow';await loadImg(ATLAS.bgs[tid].file);const bg=imgOf(ATLAS.bgs[tid].file);
  if(bg){const s=Math.max(W/bg.naturalWidth,H/bg.naturalHeight);x.drawImage(bg,(W-bg.naturalWidth*s)/2,(H-bg.naturalHeight*s)*0.6,bg.naturalWidth*s,bg.naturalHeight*s);}else{x.fillStyle='#f6ead2';x.fillRect(0,0,W,H);}
  let g=x.createRadialGradient(W/2,H*0.56,40,W/2,H*0.56,W*0.85);g.addColorStop(0,'rgba(255,250,235,.38)');g.addColorStop(1,'rgba(70,40,50,.28)');x.fillStyle=g;x.fillRect(0,0,W,H);
  x.fillStyle='rgba(60,40,40,.22)';x.beginPath();x.ellipse(W*0.46,H*0.82,150,26,0,0,TAU);x.fill();
  const cid=hardMode()?'base':save.costume,co=costume();if(co.goddessAura){g=x.createRadialGradient(W*0.44,H*0.5,10,W*0.44,H*0.5,260);g.addColorStop(0,'rgba(255,255,255,.75)');g.addColorStop(0.5,co.goddessAura+'88');g.addColorStop(1,'rgba(255,255,255,0)');x.fillStyle=g;x.fillRect(0,0,W,H);}
  const fr=yFrame(cid,0);await loadImg(fr.file);const yi=imgOf(fr.file);const yh=520,ys=yh/fr.sh;if(yi)x.drawImage(yi,fr.sx,fr.sy,fr.sw,fr.sh,W*0.44-fr.sw*ys/2,H*0.84-yh,fr.sw*ys,yh);
  if(catOn){const cf=catFrame(0),ci=imgOf(cf.file);if(ci){const ch=200,cs=ch/cf.sh;x.drawImage(ci,cf.sx,cf.sy,cf.sw,cf.sh,W*0.76-cf.sw*cs/2,H*0.86-ch,cf.sw*cs,ch);}}
  for(let i=0;i<26;i++){const sx=Math.random()*W,sy=Math.random()*H*0.78,r=Math.random()*7+3;x.save();x.translate(sx,sy);x.fillStyle=`rgba(255,${230+Math.random()*25|0},${200+Math.random()*55|0},${0.5+Math.random()*0.4})`;starPath(x,4,r,r*0.25);x.fill();x.restore();}
  const oi=objImg();const art=(k,cx,cy,h,fl)=>{const it=artRect(k);if(!it||!oi)return;const w=it[2]*h/it[3];x.save();x.translate(cx,cy);if(fl)x.scale(-1,1);x.drawImage(oi,it[0],it[1],it[2],it[3],-w/2,-h,w,h);x.restore();};
  art('bush_rose',70,H-118,90);art('bush_rose',W-70,H-118,90,true);art('fl_pink',30,112,46);art('fl_daisy',W-34,110,44,true);
  x.lineWidth=12;x.strokeStyle='#d8b25c';x.strokeRect(12,12,W-24,H-24);x.lineWidth=3;x.strokeStyle='#fff7df';x.strokeRect(26,26,W-52,H-52);
  const TF=getComputedStyle(document.documentElement).getPropertyValue('--title')||'serif';
  x.fillStyle='rgba(255,250,240,.93)';x.strokeStyle='#d8b25c';x.lineWidth=3;x.beginPath();if(x.roundRect)x.roundRect(60,H-150,W-120,104,18);else x.rect(60,H-150,W-120,104);x.fill();x.stroke();
  x.textAlign='center';x.fillStyle='#8e2340';x.font=`bold 34px ${TF}`;
  const head=mode==='play'&&stage&&state==='result'?`ステージ${stageIdx+1} クリア！`:mode==='play'&&stage?`ステージ${stageIdx+1}`:'おさんぽの きねん';x.fillText(head,W/2,H-108);
  const d=new Date(),ds=`${d.getFullYear()}.${d.getMonth()+1}.${d.getDate()}`;x.font=`bold 21px ${fontF()}`;x.fillStyle='#5a3a2a';
  x.fillText(`${mode==='play'&&stage?stage.name:THEME_NAME[tid]}　${ds}${mode==='play'&&state==='result'?'　'+fmtT(clearTime):''}`,W/2,H-68);
  x.font=`bold 20px ${TF}`;x.fillStyle='rgba(142,35,64,.85)';x.fillText('やっちゃんの冒険',W/2,54);
  return cv.toDataURL('image/jpeg',0.86);}
let photoIdx=-1,photoData=null;
function openPhoto(data,idx){photoData=data;photoIdx=idx==null?-1:idx;$('photoImg').src=data;$('btnPhotoDel').classList.toggle('hidden',photoIdx<0);show('scrPhoto');}
async function takePhoto(){sfx('shutter');const data=await makePhoto();const a=albumLoad();a.push({d:data,t:Date.now()});while(a.length>8)a.shift();albumSave(a);openPhoto(data);
  const fl=document.createElement('div');fl.style.cssText='position:fixed;inset:0;background:#fff;z-index:20;opacity:.9;transition:opacity .5s;pointer-events:none';document.body.appendChild(fl);requestAnimationFrame(()=>{fl.style.opacity=0;});setTimeout(()=>fl.remove(),600);}
$('btnPhoto').onclick=()=>takePhoto();
$('btnPPhoto').onclick=()=>takePhoto();
$('btnPhotoOk').onclick=()=>{hide('scrPhoto');};
$('btnPhotoDel').onclick=()=>{const a=albumLoad();if(photoIdx>=0&&photoIdx<a.length){a.splice(photoIdx,1);albumSave(a);}hide('scrPhoto');openRecord('album');};
$('btnPhotoShare').onclick=async()=>{if(!photoData)return;try{const b=await (await fetch(photoData)).blob(),f=new File([b],`yacchan_${Date.now()}.jpg`,{type:'image/jpeg'});
    if(navigator.canShare&&navigator.canShare({files:[f]})){await navigator.share({files:[f],title:'やっちゃんの冒険'});return;}
    const u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download=f.name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),3000);}catch(e){}};
/* ============ the cat asks for something ============ */
let catReq=null,catReqT=40,catSay=null;
const reqIcon=k=>tcache('rq'+k,()=>mk(36,36,x=>{const it=artRect(k),img=objImg();if(it&&img){const s=Math.min(30/it[2],30/it[3]);x.drawImage(img,it[0],it[1],it[2],it[3],18-it[2]*s/2,18-it[3]*s/2,it[2]*s,it[3]*s);}}));
function updateCatReq(dt){if(catSay){catSay.t-=dt;if(catSay.t<=0)catSay=null;}
  if(!(mode==='play'||mode==='walk')||!catOn||!CAT||!P||P.dead||fm||scene)return;
  if(!catReq){catReqT-=dt;if(catReqT<=0){if(bosses.some(b=>b.st!=='dead')){catReqT=8;return;}
      const flower=R()<0.6,sp=freeSpot(rr(260,400));catReq={kind:flower?'flower':'gem',art:flower?pick(['fl_pink','fl_daisy','fl_lily','fl_a71']):'item_gem',x:sp.x,y:sp.y,t:30};
      catSay={text:flower?'お花が 見たいにゃ':'キラキラが ほしいにゃ',t:4,icon:catReq.art};sfx('meow');}return;}
  catReq.t-=dt;if(R()<dt*4)part(FX.spark('#fff3c2'),catReq.x+rr(-20,20),catReq.y-rr(10,40),0,-20,0.7,{s:0.6,s2:0.1});
  if(catReq.t<12&&!catSay)catSay={text:'',t:1.2,icon:catReq.art};
  if(hyp(P.x-catReq.x,P.y-catReq.y)<58){const k=catReq.kind;let healed=0;
    if(!P.bare&&P.guard<P.maxGuard){P.guard++;healed=1;}else if(P.bare&&P.bareHp<P.maxBare){P.bareHp++;healed=1;}else if(P.godLeft>0||mode==='walk')P.gauge=Math.min(1,P.gauge+0.3);
    buildHearts();burst(catReq.x,catReq.y-20,'#ffd6e6',22,200);for(let i=0;i<10;i++)part(FX.heart('#f19bb5'),CAT.x,CAT.y-charPx*0.3,rr(-90,90),rr(-170,-60),1.1,{g:140,s:0.7,s2:0.3});
    sfx('heal');setTimeout(()=>sfx('meow'),250);catSay={text:'ありがとうにゃ！',t:2,icon:null};
    banner(`<div class="bcard"><canvas width="96" height="96"></canvas><div><div class="bt">黒猫が よろこんでいる！</div><div class="bl">「${k==='flower'?'きれいな お花だにゃ！':'キラキラ だいすきにゃ！'}」${healed?' ハートが 1つ かいふく':' 女神ゲージが たまったよ'}</div></div></div>`,2.6,{now:true,after:el=>drawNarrator(el.querySelector('canvas'),'cat')});
    catReq=null;catReqT=mode==='walk'?rr(30,50):rr(45,75);return;}
  if(catReq.t<=0){catSay={text:'また こんど にゃ',t:2,icon:null};catReq=null;catReqT=rr(40,70);}}
function drawCatReq(){if(catReq){const q=catReq,bob=Math.sin(time*3)*4;ctx.save();ctx.globalCompositeOperation='lighter';drawFx(FX.glow('#ffe9a0'),q.x,q.y-22,0,0.45+0.2*Math.sin(time*5),1.6);ctx.restore();drawArt(q.art,q.x,q.y+bob,q.kind==='flower'?48:40);}
  if(catSay&&catOn&&CAT){const x0=CAT.x,y0=CAT.y-charPx*0.5,txt=catSay.text,ic=catSay.icon;ctx.save();ctx.globalAlpha=Math.min(1,catSay.t*3);ctx.font=`bold 15px ${fontF()}`;
    /* v8.3: explicit left alignment (the floating-text pass leaves textAlign='center' behind) and keep the bubble on screen */
    ctx.textAlign='left';ctx.textBaseline='middle';
    const tw=txt?ctx.measureText(txt).width:0,w=Math.ceil(tw+(ic?34:0)+20),h=34;let bx=CAT.x>=P.x?x0-18:x0-w+18;bx=clamp(bx,cam.x+6,cam.x+VW-w-6);const by=Math.max(y0-h,cam.y+156);
    const tx=clamp(x0,bx+14,bx+w-14);
    ctx.fillStyle='rgba(255,250,240,.96)';ctx.strokeStyle='#e0a2b6';ctx.lineWidth=2;ctx.beginPath();if(ctx.roundRect)ctx.roundRect(bx,by,w,h,14);else ctx.rect(bx,by,w,h);ctx.fill();ctx.stroke();
    ctx.beginPath();ctx.moveTo(tx-6,by+h-1);ctx.lineTo(tx,by+h+8);ctx.lineTo(tx+6,by+h-1);ctx.fill();
    if(ic)ctx.drawImage(reqIcon(ic),bx+6,by+2,30,30);if(txt){ctx.fillStyle='#8e2340';ctx.fillText(txt,bx+(ic?38:10),by+h/2+1);}ctx.restore();}}
/* ============ chest mini-games ============ */
let mini=null;
function startMini(c,type){state='mini';input.on=false;P.vx=0;P.vy=0;mini={type,c,g:null};
  show('scrMini');$('miniMsg').textContent='';$('miniTop').innerHTML='';$('miniBody').innerHTML='';
  $('miniBtns').innerHTML='<button class="btn sub small" id="miniQuit">やめる（宝箱は あとで）</button>';$('miniQuit').onclick=()=>endMini(null);
  if(type==='match3')m3Start();else if(type==='gates')gtStart();else lbStart();}
function miniResult(ok,text){if(!mini||mini.result!=null)return;sfx(ok?'win':'miss');mini.result=ok;$('miniMsg').innerHTML=text;
  $('miniBtns').innerHTML=ok?`<button class="btn" id="miniOpen">大成功！ 宝箱を あける</button>`:`<button class="btn sub" id="miniOpen">とじる（あとで もう一度）</button>`;$('miniOpen').onclick=()=>endMini(ok);}
function endMini(ok){if(!mini)return;const c=mini.c;mini=null;hide('scrMini');state='play';P.inv=Math.max(P.inv,1.5);lastFace='';
  if(!ok){c.cool=true;banner(ok===null?'宝箱は あとで あけられます':'おしい！<small>宝箱に もう一度 ふれると やりなおせるよ</small>',2.4);return;}openChest(c,true);}
const opLabel=o=>({'+':'＋','×':'×','−':'−','÷':'÷'}[o[0]])+o[1];
const opApply=(v,o)=>o[0]==='+'?v+o[1]:o[0]==='×'?v*o[1]:o[0]==='−'?Math.max(0,v-o[1]):Math.floor(v/o[1]);
/* ---- match 3 ---- */
const M3N=6,M3_COLORS=['#d2486a','#f2c94c','#f19bb5','#efe2c6','#8fb6ef'];
function m3Tile(t){return tcache('m3t'+t,()=>mk(56,56,x=>{x.translate(28,28);softBlob(x,1,3,25,'#5a3a2e',0.18);const col=M3_COLORS[t];
  if(t===0){x.fillStyle='#5f9a48';x.beginPath();x.ellipse(-12,12,9,4.5,-0.6,0,TAU);x.fill();x.beginPath();x.ellipse(12,12,9,4.5,0.6,0,TAU);x.fill();
    x.fillStyle=col;x.beginPath();x.arc(0,-1,18,0,TAU);x.fill();x.strokeStyle='rgba(255,225,232,.95)';x.lineWidth=2.4;for(let i=0;i<3;i++){x.beginPath();x.arc(0,-1,4+i*4.5,i*1.4,i*1.4+4.6);x.stroke();}}
  else if(t===1){x.fillStyle=col;starPath(x,5,23,10);x.fill();x.strokeStyle='#fff6c8';x.lineWidth=2.6;x.stroke();x.strokeStyle='rgba(160,110,20,.5)';x.lineWidth=1;x.stroke();}
  else if(t===2){x.fillStyle=col;heartPath(x,23);x.fill();x.strokeStyle='#fff';x.lineWidth=2.8;x.stroke();x.strokeStyle='rgba(180,60,90,.45)';x.lineWidth=1;x.stroke();}
  else if(t===3){const g=x.createRadialGradient(-6,-7,2,0,0,20);g.addColorStop(0,'#ffffff');g.addColorStop(1,'#d9c39a');x.fillStyle=g;x.beginPath();x.arc(0,0,19,0,TAU);x.fill();x.strokeStyle='rgba(150,120,70,.5)';x.lineWidth=1.4;x.stroke();}
  else{const g=x.createLinearGradient(-16,0,16,0);g.addColorStop(0,'#b7d0f7');g.addColorStop(0.5,'#f2f8ff');g.addColorStop(1,'#7f9fe0');x.fillStyle=g;x.beginPath();x.moveTo(0,-22);x.lineTo(17,-4);x.lineTo(0,22);x.lineTo(-17,-4);x.closePath();x.fill();x.strokeStyle='rgba(70,90,160,.6)';x.lineWidth=1.4;x.stroke();x.strokeStyle='rgba(255,255,255,.9)';x.beginPath();x.moveTo(-17,-4);x.lineTo(17,-4);x.stroke();}
  softBlob(x,-7,-9,6,'#ffffff',0.65);}));}
function m3Start(){const ez=save.difficulty==='easy',tm=mode==='tutorial';
  const g=mini.g={target:tm?6:ez?12:15,moves:tm?20:ez?16:13,cleared:0,phase:'fall',sel:null,t:0,idle:0,combo:0,board:[],hint:null,down:null};
  $('miniTitle').textContent='宝箱のマッチ3';$('miniRule').innerHTML='となりどうしを 入れかえて <b>同じもの 3つ</b>を ならべよう';
  $('miniBody').innerHTML='<canvas id="miniCv" width="360" height="360"></canvas>';const cv=$('miniCv');cv.width=Math.round(360*DPR);cv.height=Math.round(360*DPR);
  m3Fill(g);m3Stats();
  const cell=e=>{const b=cv.getBoundingClientRect(),cs=b.width/M3N;return{c:Math.floor((e.clientX-b.left)/cs),r:Math.floor((e.clientY-b.top)/cs),x:e.clientX,y:e.clientY,cs};};
  cv.addEventListener('pointerdown',e=>{e.preventDefault();const q=cell(e);if(q.r<0||q.r>=M3N||q.c<0||q.c>=M3N)return;g.down=q;try{cv.setPointerCapture(e.pointerId);}catch(_){}});
  cv.addEventListener('pointermove',e=>{if(!g.down)return;const dx=e.clientX-g.down.x,dy=e.clientY-g.down.y,cs=g.down.cs;if(Math.max(Math.abs(dx),Math.abs(dy))<cs*0.45)return;
    const a=[g.down.r,g.down.c],b=Math.abs(dx)>Math.abs(dy)?[a[0],a[1]+Math.sign(dx)]:[a[0]+Math.sign(dy),a[1]];g.down=null;if(b[0]>=0&&b[0]<M3N&&b[1]>=0&&b[1]<M3N)m3TrySwap(a,b);});
  cv.addEventListener('pointerup',e=>{if(!g.down)return;const q=g.down;g.down=null;const a=[q.r,q.c];
    if(g.sel&&Math.abs(g.sel[0]-a[0])+Math.abs(g.sel[1]-a[1])===1){m3TrySwap(g.sel,a);}else g.sel=(g.sel&&g.sel[0]===a[0]&&g.sel[1]===a[1])?null:a;});}
function m3Stats(){const g=mini.g;$('miniTop').innerHTML=`<div class="mstat">けした数<b>${Math.min(g.cleared,g.target)} / ${g.target}</b></div><div class="mstat">のこり手数<b>${g.moves}</b></div>`;}
function m3Rand(){return(Math.random()*5)|0;}
function m3Fill(g){do{g.board=[];for(let r=0;r<M3N;r++){g.board.push([]);for(let c=0;c<M3N;c++){let t;
      do{t=m3Rand();}while((c>=2&&g.board[r][c-1].t===t&&g.board[r][c-2].t===t)||(r>=2&&g.board[r-1][c].t===t&&g.board[r-2][c].t===t));
      g.board[r].push({t,x:c,y:r-M3N-1,s:1,die:0});}}}while(!m3HasMove(g));g.phase='fall';}
function m3Matches(g){const B=g.board,set=new Set();
  for(let r=0;r<M3N;r++){let run=1;for(let c=1;c<=M3N;c++){if(c<M3N&&B[r][c].t===B[r][c-1].t)run++;else{if(run>=3)for(let k=c-run;k<c;k++)set.add(r*M3N+k);run=1;}}}
  for(let c=0;c<M3N;c++){let run=1;for(let r=1;r<=M3N;r++){if(r<M3N&&B[r][c].t===B[r-1][c].t)run++;else{if(run>=3)for(let k=r-run;k<r;k++)set.add(k*M3N+c);run=1;}}}
  return set;}
function m3Swap(g,a,b){const B=g.board,t=B[a[0]][a[1]];B[a[0]][a[1]]=B[b[0]][b[1]];B[b[0]][b[1]]=t;}
function m3HasMove(g){for(let r=0;r<M3N;r++)for(let c=0;c<M3N;c++)for(const[dr,dc]of[[0,1],[1,0]]){const r2=r+dr,c2=c+dc;if(r2>=M3N||c2>=M3N)continue;
  m3Swap(g,[r,c],[r2,c2]);const ok=m3Matches(g).size>0;m3Swap(g,[r,c],[r2,c2]);if(ok)return[[r,c],[r2,c2]];}return null;}
function m3TrySwap(a,b){const g=mini&&mini.g;if(!g||g.phase!=='idle'||g.moves<=0||mini.result!=null)return;g.sel=null;g.idle=0;g.hint=null;m3Swap(g,a,b);g.last=[a,b];g.phase='swap';$('miniMsg').textContent='';}
function m3Clear(g,m){g.phase='clear';g.t=0.3;m.forEach(k=>{g.board[(k/M3N)|0][k%M3N].die=1;});g.cleared+=m.size;if(g.combo>0)$('miniMsg').textContent=`れんさ ${g.combo+1}！`;m3Stats();}
function m3Gravity(g){for(let c=0;c<M3N;c++){const col=[];for(let r=M3N-1;r>=0;r--){const o=g.board[r][c];if(!o.die)col.push(o);}
  const nn=M3N-col.length;for(let i=0;i<col.length;i++)g.board[M3N-1-i][c]=col[i];for(let r=0;r<nn;r++)g.board[r][c]={t:m3Rand(),x:c,y:r-nn-0.4,s:1,die:0};}}
function m3Update(dt){const g=mini.g;let moving=false;const sp=dt*(g.phase==='swap'||g.phase==='back'?7:12);
  for(let r=0;r<M3N;r++)for(let c=0;c<M3N;c++){const o=g.board[r][c],dx=c-o.x,dy=r-o.y;
    if(Math.abs(dx)>0.001){o.x+=Math.sign(dx)*Math.min(Math.abs(dx),sp);moving=true;}if(Math.abs(dy)>0.001){o.y+=Math.sign(dy)*Math.min(Math.abs(dy),sp);moving=true;}}
  if(g.phase==='swap'&&!moving){const m=m3Matches(g);if(m.size){g.moves--;g.combo=0;m3Clear(g,m);}else{m3Swap(g,g.last[0],g.last[1]);g.phase='back';}}
  else if(g.phase==='back'&&!moving){g.phase='idle';$('miniMsg').textContent='そろわないと もとに もどります';}
  else if(g.phase==='clear'){g.t-=dt;for(const row of g.board)for(const o of row)if(o.die)o.s=Math.max(0,g.t/0.3);if(g.t<=0){m3Gravity(g);g.phase='fall';}}
  else if(g.phase==='fall'&&!moving){const m=m3Matches(g);if(m.size){g.combo++;m3Clear(g,m);}else{g.phase='idle';g.idle=0;
      if(g.cleared>=g.target){g.phase='end';miniResult(true,'できた！ 大成功！');}
      else if(g.moves<=0){g.phase='end';miniResult(false,'手数が なくなりました');}
      else if(!m3HasMove(g)){for(const row of g.board)for(const o of row)o.t=m3Rand();if(m3Matches(g).size||!m3HasMove(g)){m3Fill(g);}$('miniMsg').textContent='シャッフル！';}}}
  if(g.phase==='idle'){g.idle+=dt;if(g.idle>6&&!g.hint)g.hint=m3HasMove(g);}
  m3Draw(g);}
function m3Draw(g){const cv=$('miniCv');if(!cv)return;const x=cv.getContext('2d'),S=360,cs=S/M3N;x.setTransform(cv.width/S,0,0,cv.width/S,0,0);x.clearRect(0,0,S,S);
  for(let r=0;r<M3N;r++)for(let c=0;c<M3N;c++){x.fillStyle=(r+c)%2?'#fbf1dc':'#f2e2c2';x.fillRect(c*cs+1,r*cs+1,cs-2,cs-2);}
  const glow=(q,col,a)=>{x.save();x.globalAlpha=a;x.strokeStyle=col;x.lineWidth=4;x.strokeRect(q[1]*cs+3,q[0]*cs+3,cs-6,cs-6);x.restore();};
  if(g.sel)glow(g.sel,'#c45a72',1);
  if(g.hint&&g.phase==='idle'){const a=0.45+0.45*Math.sin(time*6);glow(g.hint[0],'#e6b23a',a);glow(g.hint[1],'#e6b23a',a);}
  x.save();x.beginPath();x.rect(0,0,S,S);x.clip();
  for(let r=0;r<M3N;r++)for(let c=0;c<M3N;c++){const o=g.board[r][c],sel=g.sel&&g.sel[0]===r&&g.sel[1]===c,sz=cs*0.86*o.s*(sel?1.08+0.04*Math.sin(time*8):1);
    if(sz<=0.5)continue;x.globalAlpha=o.die?Math.max(0.2,o.s):1;x.drawImage(m3Tile(o.t),o.x*cs+cs/2-sz/2,o.y*cs+cs/2-sz/2,sz,sz);}
  x.restore();x.globalAlpha=1;}
/* ---- number gates ---- */
function gtOps(v,i){const pool=[['+',2+((Math.random()*7)|0)],['×',2],['+',1+((Math.random()*3)|0)],['−',1+((Math.random()*3)|0)]];if(i>=1)pool.push(['×',3]);if(v%2===0&&v>2)pool.push(['÷',2]);
  for(let k=0;k<40;k++){const a=pick(pool),b=pick(pool);if(a!==b&&opApply(v,a)!==opApply(v,b))return Math.random()<0.5?[a,b]:[b,a];}return[['+',3],['−',1]];}
function gtStart(){const ez=save.difficulty==='easy';let v=2+((Math.random()*3)|0);const start=v,rounds=[];
  for(let i=0;i<3;i++){const ops=gtOps(v,i);rounds.push(ops);v=Math.max(...ops.map(o=>opApply(v,o)));}
  const g=mini.g={v:start,i:0,rounds,target:Math.max(start+4,Math.floor(v*(ez?0.6:0.8))),busy:false};
  $('miniTitle').textContent='数字ゲート';$('miniRule').innerHTML='ゲートを くぐると 数字が かわります。<b>カギの数字</b> いじょうに しよう';gtRender();}
function gtRender(pop){const g=mini.g;$('miniTop').innerHTML=`<div class="mstat">やっちゃんの数字<b id="gtV" class="${pop?'pop':''}">${g.v}</b></div><div class="mstat">カギの数字<b>${g.target}</b></div>`;
  if(g.i>=3){$('miniBody').innerHTML='';return;}
  $('miniBody').innerHTML=`<div class="ground">ゲート ${g.i+1} / 3 ・ どちらを くぐる？</div><div class="gates">${g.rounds[g.i].map((o,k)=>`<button class="gate" data-k="${k}">${opLabel(o)}</button>`).join('')}</div>`;
  $('miniBody').querySelectorAll('.gate').forEach(b=>b.onclick=()=>gtPick(+b.dataset.k));}
function gtPick(k){const g=mini&&mini.g;if(!g||g.busy||mini.result!=null)return;g.busy=true;const o=g.rounds[g.i][k];
  $('miniBody').querySelectorAll('.gate').forEach((b,j)=>{b.disabled=true;if(j===k)b.style.background='linear-gradient(#fff6d8,#f2c94c)';});
  setTimeout(()=>{if(!mini)return;const before=g.v;g.v=opApply(g.v,o);g.i++;g.busy=false;gtRender(true);$('miniMsg').textContent=`${before} ${opLabel(o)} ＝ ${g.v}`;
    if(g.i>=3)setTimeout(()=>{if(!mini)return;if(g.v>=g.target)miniResult(true,`${g.v} ≧ ${g.target}　カギが あいた！ 大成功！`);else miniResult(false,`${g.v} ＜ ${g.target}　おしい！`);},500);},450);}
/* ---- level battle ---- */
function lbStart(){const ez=save.difficulty==='easy';let lv=3+((Math.random()*3)|0);const start=lv;
  const kinds=stage?[...new Set(stage.enemies.map(e=>e[0]))]:['pony','tiger','sheep','mouse'];const mons=[];
  for(let i=0;i<4;i++){const l=Math.max(1,Math.min(lv-1,Math.round(lv*(0.35+Math.random()*0.55))));mons.push({lv:l,k:pick(kinds),tier:i<2?0:1});lv+=l;}
  for(let i=mons.length-1;i>0;i--){const j=(Math.random()*(i+1))|0;[mons[i],mons[j]]=[mons[j],mons[i]];}
  mons.push({lv:lv-1-((Math.random()*2)|0),k:pick(kinds),tier:2,boss:true});
  mini.g={lv:start,mons,miss:0,maxMiss:ez?5:3};
  $('miniTitle').textContent='レベル差バトル';$('miniRule').innerHTML='やっちゃんより <b>レベルが ひくい</b>敵を タップして たおそう。たおすと その レベルが たされます';
  lbRender();}
function lbRender(){const g=mini.g;$('miniTop').innerHTML=`<div class="mstat">まちがえて いいのは<b>あと ${g.maxMiss-g.miss}回</b></div>`;
  $('miniBody').innerHTML=`<div class="mons"><div class="mon me"><canvas width="160" height="130" id="lbMe"></canvas>やっちゃん<br><span class="lv" id="lbLv">Lv ${g.lv}</span></div>${g.mons.map((m,i)=>`<button class="mon ${m.boss?'boss':''} ${m.gone?'gone':''}" data-i="${i}"><canvas width="160" height="130"></canvas>${m.boss?'宝箱の番人':EKIND[m.k].name}<br><span class="lv">Lv ${m.lv}</span></button>`).join('')}</div>`;
  const me=$('lbMe').getContext('2d'),fi=imgOf(ATLAS.faces.file);if(fi){const cw=ATLAS.faces.cw,k=cw/360;me.drawImage(fi,70*k,18*k,220*k,220*k,25,5,120,120);}
  $('miniBody').querySelectorAll('.mon[data-i]').forEach(b=>{const m=g.mons[+b.dataset.i],cv=b.querySelector('canvas');frameToCanvas(cv,enemyFrame(m.k,m.tier));
    if(m.boss){const x=cv.getContext('2d');x.drawImage(FX.crown(),cv.width/2-18,0,36,36);}b.onclick=()=>lbPick(+b.dataset.i,b);});}
function lbPick(i,el){const g=mini&&mini.g;if(!g||mini.result!=null)return;const m=g.mons[i];if(m.gone)return;
  if(g.lv>m.lv){m.gone=true;const before=g.lv;g.lv+=m.lv;lbRender();const lv=$('lbLv');lv.classList.add('pop');$('miniMsg').textContent=`かった！ Lv ${before} ＋ ${m.lv} ＝ Lv ${g.lv}`;
    if(m.boss)setTimeout(()=>miniResult(true,'宝箱の番人に かった！ 大成功！'),400);}
  else{g.miss++;el.classList.remove('no');void el.offsetWidth;el.classList.add('no');$('miniMsg').textContent=`まだ つよすぎる！（Lv ${g.lv} ≦ Lv ${m.lv}）`;
    $('miniTop').innerHTML=`<div class="mstat">まちがえて いいのは<b>あと ${Math.max(0,g.maxMiss-g.miss)}回</b></div>`;
    if(g.miss>=g.maxMiss)miniResult(false,'はねかえされて しまった… おしい！');}}

/* ============ tutorial ============ */
const TUT=[
 {k:'move',txt:'画面の どこでも 指で なぞってみよう。やっちゃんが その方向へ すべります。'},
 {k:'fast',txt:'指を 大きく うごかすと はやく すべります。いちばん はやく すべってみよう！'},
 {k:'stop',txt:'指を はなすと ふんわり 止まります。指を はなしてみよう。'},
 {k:'chest',txt:'光っている 宝箱に ふれてみよう（矢印の 方向）。宝箱では ミニゲームが はじまります。'},
 {k:'attack',txt:'敵に 近づくと やっちゃんが 自動で こうげきします。ネズミを 3匹 たおそう！'},
 {k:'guard',txt:'左上の ピンクのハートは 衣装の守り。なくなると 衣装の力を うばわれます。子羊に ぶつかってみよう（れんしゅうは 1回で とれます）。'},
 {k:'regain',txt:'子羊が 衣装を もっていった！ 頭の上に 衣装マークのある 子羊を たおすと 衣装が もどります。'},
 {k:'goddess',txt:'女神ゲージが いっぱい！ 右下の「女神へんしん」を おしてみよう。1ステージに 1回、12秒間 敵の こうげきを うけません。'},
 {k:'done',txt:'れんしゅう おしまい！ しばらく 止まっていると 居眠りします。右上の ≡ で 休けい・衣装がえ・せってい。'}];
async function startTutorial(){mode='tutorial';stage=null;tut={i:-1,t:0,wait:0};
  await ensureLoaded([...bgFiles('meadow'),yInfo(save.costume).file,yInfo('goddess').file,yInfo('base').file]);
  buildWorld('meadow',2024,0);beginRun();tutGo(0);banner('れんしゅう<small>やっちゃんを うごかしてみよう</small>',2);}
function freeSpot(r){for(let k=0;k<60;k++){const a=R()*TAU,x=P.x+Math.cos(a)*r,y=P.y+Math.sin(a)*r*0.8;
    if(x>world.b.l+40&&x<world.b.r-40&&y>world.b.t+60&&y<world.b.b-40&&!world.obst.some(o=>hyp(o.x-x,o.y+o.cy-y)<o.r+50))return{x,y};}
  return{x:clamp(P.x+r,world.b.l+40,world.b.r-40),y:P.y};}
function tutGo(i){tut.i=i;tut.t=0;tut.wait=0;tut.allowHit=false;tut.noFire=false;tut.target=null;const st=TUT[i];
  $('tutStep').textContent=st.k==='done'?'れんしゅう 完了':`れんしゅう ${i+1} / ${TUT.length-1}`;$('tutText').textContent=st.txt;$('tutBar').style.width=st.k==='done'?'100%':'0%';
  $('tutCard').classList.toggle('ok',st.k==='done');
  const bt=$('tutBtns');bt.innerHTML='';
  const mkb=(label,cls,fn)=>{const b=document.createElement('button');b.className='btn '+cls;b.textContent=label;b.onclick=fn;bt.appendChild(b);};
  if(st.k==='done'){mkb('ステージ1へ','',()=>startStage(0));mkb('タイトルへ','sub',()=>toTitle());}
  else mkb('れんしゅうを やめる','sub small',()=>toTitle());
  $('speedMeter').classList.toggle('hidden',!(st.k==='fast'||save.meter));
  if(st.k==='move')tut.dist=0;
  if(st.k==='fast')tut.fastT=0;
  if(st.k==='chest'){const q=freeSpot(300);const c={x:q.x,y:q.y,open:false,t:0};world.chests.push(c);tut.target=c;}
  if(st.k==='attack'){tut.k0=kills;for(let j=0;j<3;j++){const q=freeSpot(230+j*30);spawnEnemy('mouse',0,q.x,q.y);}}
  if(st.k==='guard'){P.guard=1;buildHearts();tut.allowHit=true;tut.noFire=true;const q=freeSpot(220);spawnEnemy('sheep',0,q.x,q.y);}
  if(st.k==='goddess')P.gauge=1;
  if(st.k==='done'){save.tutDone=true;save.hintSeen=true;writeSave();}}
function tutNext(){if(tut.wait>0)return;tut.wait=1.0;$('tutBar').style.width='100%';$('tutCard').classList.add('ok');$('tutStep').textContent='できた！';
  ftext(P.x,P.y-charPx*1.1,'できた！','#fff3c2');burst(P.x,P.y-charPx*0.6,'#f2c94c',14,180);}
function updateTutorial(dt){if(!tut||tut.i<0)return;tut.t+=dt;
  if(tut.wait>0){tut.wait-=dt;if(tut.wait<=0){tut.wait=0;tutGo(Math.min(tut.i+1,TUT.length-1));}return;}
  const k=TUT[tut.i].k,sp=hyp(P.vx,P.vy),maxs=save.speed.max*curMods(P.bare).speed;let prog=0;
  if(k==='move'){tut.dist+=sp*dt;prog=tut.dist/350;if(prog>=1)tutNext();}
  else if(k==='fast'){if(sp>maxs*0.8)tut.fastT+=dt;prog=tut.fastT/0.6;if(prog>=1)tutNext();}
  else if(k==='stop'){if(!input.on&&sp<4&&tut.t>0.5){prog=1;tutNext();}else prog=input.on?0.3:clamp(1-sp/maxs,0,0.95);}
  else if(k==='chest'){if(tut.target&&tut.target.open){prog=1;tutNext();}}
  else if(k==='attack'){prog=(kills-tut.k0)/3;if(prog>=1)tutNext();else if(!enemies.length){const q=freeSpot(240);spawnEnemy('mouse',0,q.x,q.y);}}
  else if(k==='guard'){if(P.bare){tutGo(tut.i+1);return;}if(!enemies.length){const q=freeSpot(220);spawnEnemy('sheep',0,q.x,q.y);}}
  else if(k==='regain'){if(!P.bare){prog=1;tutNext();}}
  else if(k==='goddess'){if(P.god>0){prog=1;tutNext();}}
  if(k!=='done'&&!tut.wait)$('tutBar').style.width=Math.round(clamp(prog,0,1)*100)+'%';}

/* ============ manual ============ */
const MAN_TABS=[['play','あそびかた'],['screen','画面'],['guard','衣装の守り'],['costume','衣装'],['chest','宝箱'],['foes','敵とボス'],['stage','ステージ'],['fun','おたのしみ'],['qa','Q&A'],['poster','ポスター']];
let manTab='play';const MANF={};let manSeq=0;
function manualCrop(fr,extra=10){
  // Crop only transparent margins. Extra padding preserves wispy lace and translucent veils.
  const b=frameBBox(fr);if(!b)return fr;
  const x0=Math.max(0,b.x-extra),y0=Math.max(0,b.y-extra),x1=Math.min(fr.sw,b.x+b.w+extra),y1=Math.min(fr.sh,b.y+b.h+extra);
  return {...fr,sx:fr.sx+x0,sy:fr.sy+y0,sw:x1-x0,sh:y1-y0};
}
function frameToCanvas(cv,fr){const paint=()=>{if(!cv.isConnected)return;const x=cv.getContext('2d');x.clearRect(0,0,cv.width,cv.height);
  const big=!!cv.closest('.manualCostumePic'),f=big?manualCrop(fr,10):fr;
  const s=Math.min((cv.width-(big?22:0))/f.sw,(cv.height-(big?18:0))/f.sh),w=f.sw*s,h=f.sh*s;
  x.imageSmoothingEnabled=true;x.imageSmoothingQuality='high';drawYasukoDetail(x,f,(cv.width-w)/2,cv.height-h-(big?9:0),w,h);
};if(imgOf(fr.file))requestAnimationFrame(paint);loadImg(fr.file).then(()=>requestAnimationFrame(paint));}
const titleSrc=id=>{const f=TITLE_FRONT[id];return f?(ASSETS[f]||BASE+f):null;};
/* 画面に近づいた絵だけ読みこむ（iPhone のメモリを使いすぎない） */
let manArtObs=null;
function hookManualTitleArt(root){
  if(manArtObs)manArtObs.disconnect();
  const imgs=[...root.querySelectorAll('img[data-title-art]')];
  const put=el=>{if(el.dataset.put)return;const u=titleSrc(el.dataset.titleArt);if(u){el.dataset.put='1';el.src=u;}};
  imgs.forEach(el=>{const stage=el.parentElement;stage.gesture=bindImagePinch(stage,el,{max:()=>8});});
  if(!('IntersectionObserver' in window)){imgs.forEach(put);return;}
  manArtObs=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){put(e.target);manArtObs.unobserve(e.target);}}),{root,rootMargin:'600px 0px'});
  imgs.forEach(im=>manArtObs.observe(im));
}
function manualArt(id,name){return `<div class="manualCostumePic"><img class="manualTitleArt" data-title-art="${id}" alt="${name}" draggable="false"></div>`;}
function mc(fr,w,h,style){const id='mc'+(manSeq++);MANF[id]=fr;return`<canvas data-mc="${id}" width="${w}" height="${h}"${style?` style="${style}"`:''}></canvas>`;}
const BOSS_DESC={hikaru:'まっすぐ 突進してくる（赤い線の 方向）。ときどき 白ポニー隊を よびます。',takumi:'星の弾を ぐるりと うちます。すばやい リーダー。',
  akira:'花びらの弾を うずまきのように うちます。ゆっくり 優雅。',tomo:'歯車の わなを しかけます。足もとの 光る輪から はなれよう。'};
const ENEMY_DESC={pony:['ポニー','あしが はやい'],tiger:['子虎','近くで とびかかる'],sheep:['子羊','おそいけど かたい'],mouse:['ネズミ','ジグザグに うごく'],cpony:['白ポニー','ひかるんの 部隊。精鋭は 空を とぶ']};
function manualHTML(t){const H=(full,cls)=>HEART_SVG(full,cls).replace('<svg','<svg style="width:22px;height:20px;vertical-align:middle"');
  if(t==='fun')return`<h3>きろく帳</h3><p>タイトルの「きろく帳」で、<b>スタンプ</b>・<b>ベストタイム</b>・<b>きねん写真</b>が 見られます。ステージをえらぶ 画面にも ベストタイムが 出ます。</p>
  <h3>スタンプ</h3><p>あそびに きた日に 1日 1つ、黒猫が スタンプを おしてくれます。7つ たまると カードが いっぱいになり、<b>黒猫の リボンの 色</b>が ふえます（きろく帳で えらべます）。スタンプ 1つで <b>ごほうびポイント</b>が 1 たまります。</p>
  <h3>ごほうび衣装</h3><p><b>ごほうびポイント</b>は、ステージ初クリアで 1、スタンプ 1つで 1、ベストタイムの 更新 1回で 2 たまります。ステージ10を クリアした あと、衣装ごとの <b>必要ポイント</b>に とどくと その衣装が もらえます。いまの ポイントは「衣装」の画面と「きろく帳」で 見られます。<b>女神シリーズ</b>は 必要ポイントが 高く、あとで もらう衣装ほど 強くなります。${COSTUMES.some(c=>c.permanentGoddess&&cosOpen(c))?'<b>「天衣の微笑み」だけ</b>は いつも 女神状態で 敵の こうげきを うけません。':''}</p>
  <h3>きねん写真</h3><p>クリアの 画面や、おさんぽの ≡ から「きねん写真」。やっちゃんと 黒猫の 写真が できます。写真を 長おし するか「保存・おくる」で 保存できます。さいごの 8まいは きろく帳の アルバムに のこります。</p>
  <h3>黒猫の おねだり</h3><p>ときどき 黒猫が「お花が 見たいにゃ」などと おねがいします。画面の はしの 矢印の ほうへ すべって、光っている お花や 宝石に ふれると、黒猫が よろこんで <b>ハートが 1つ かいふく</b>します（ハートが いっぱいの ときは 女神ゲージ）。</p>
  <h3>音</h3><p>やさしい 音楽と 効果音が なります。せっていで「なし・小・中・大」を えらべます。iPhoneは 横の スイッチが マナーモードだと 音が でません。</p>`;
  if(t==='poster')return ATLAS.poster?`<p>「やっちゃんの冒険」の ポスターです。絵を タップすると 画面いっぱいで 見られます。</p><img class="mposter" id="manPoster" src="${ASSETS[ATLAS.poster.file]||BASE+ATLAS.poster.file}" alt="ポスター"><button class="btn sub" id="manPosterBig">画面いっぱいで 見る</button>`:'<p>ポスターは ありません。</p>';
  if(t==='play')return`<h3>うごかしかた</h3><ul><li>画面の <b>どこでも</b> 指で なぞると、やっちゃんが その方向へ すべります。</li><li>指を <b>大きく</b> うごかすほど はやく、<b>小さく</b> うごかすと ゆっくり。</li><li>指を はなすと ふんわり 止まります。</li></ul>
  <h3>たたかいかた</h3><ul><li>こうげきは <b>自動</b>。敵に 近づくと やっちゃんが うちます。</li><li><b>黒猫</b>は 近くの 敵に <b>体当たり</b>（ねこアタック）して てつだいます。敵の 弾にも ぶつかって ふせぎます。</li><li>やっちゃんが こうげきを うけそうになると、黒猫が 前に とびだして <b>1回 まもって</b>くれます（ねこガード）。左上の 黒猫マークが 明るいときが じゅんびOK。つかうと しばらく お休みです。</li><li>ステージの はじめと クリアのあとに 画面の下に <b>おはなし</b>が 出ます。画面を タップするか「つぎへ」で すすみます。</li><li>宝箱に ふれると ミニゲームが はじまります。<b>成功すると</b> 宝箱が あきます。</li></ul>
  <h3>女神へんしん</h3><p>敵を たおすと 女神ゲージが たまります。いっぱいに なったら 右下の「女神へんしん」。<b>1ステージに 1回</b>（のんびりでは <b>ボスの数</b>だけ）つかえます。12秒間 敵の こうげきを うけず、羽根の こうげきが 3方向に とびます（体当たりでは 敵を たおせません）。</p>
  <h3>ひと休み・居眠り</h3><p>右上の ≡ で ひと休み（衣装がえ・せってい）。しばらく 動かさないと やっちゃんと黒猫が 居眠りします。なぞると 目を さまします。</p>
  <button class="btn" id="manTut">れんしゅうを はじめる</button>`;
  if(t==='screen')return`<div class="mrow"><div class="mi">${H('#e0526e')}${H('#e0526e')}${H(null)}</div><div class="mt"><b>ピンクのハート</b><br>衣装の守り。ダメージを うけると へります。</div></div>
  <div class="mrow"><div class="mi"><span class="hlabel">素体</span>${H('#ffffff','#e07a8e')}</div><div class="mt"><b>白いハート</b><br>素体のときの いのち。なくなると まけ。</div></div>
  <div class="mrow"><div class="mi"><div style="height:10px;border-radius:6px;border:1.5px solid var(--gold);background:linear-gradient(90deg,#f2c94c 60%,#fff 60%)"></div></div><div class="mt"><b>女神ゲージ</b><br>いっぱいで 女神へんしん。</div></div>
  <div class="mrow"><div class="mi"><div class="goal" style="font-size:15px;padding:2px 6px">敵<b>3/12</b></div></div><div class="mt"><b>クリア条件</b><br>敵・宝箱・ボスを ぜんぶ 達成すると クリア。</div></div>
  <div class="mrow"><div class="mi"><span class="roundBtn small" style="display:inline-flex;align-items:center;justify-content:center">≡</span></div><div class="mt"><b>ひと休み</b><br>衣装がえ・けしき・せってい・マニュアル。</div></div>
  <div class="mrow"><div class="mi"><span class="roundBtn small" style="display:inline-flex;align-items:center;justify-content:center">？</span></div><div class="mt"><b>マニュアル</b><br>この画面を いつでも ひらけます。</div></div>
  <div class="mrow"><div class="mi" style="font-size:30px;color:#c45a72">➤</div><div class="mt"><b>画面の はしの 矢印</b><br>衣装を もった敵や 宝箱（れんしゅう）の 方向を おしえます。</div></div>`;
  if(t==='guard'){const g=guardCount();return`<h3>衣装の守り</h3><p>やっちゃんは 衣装から 力を もらって 強くなります。ピンクのハートは 衣装の守りです。</p>
  <div class="pair">${mc(thumbFrame(thumbId(hardMode()?'basic':save.costume)),110,117)}<span class="arw">→</span>${mc(thumbFrame('base_'+save.baseArt),110,117)}</div>
  <ul><li>ダメージを <b>${g}回</b> うけると、衣装の力を うばわれて <b>素体</b>の すがたに なります。</li>
  <li>そのとき <b>最後に こうげきした敵</b>が 衣装を もっていきます。頭の上に まるい <b>衣装マーク</b>が つきます。</li>
  <li>その敵を たおすと 衣装が もどり、ハートも ぜんぶ もどります。にげていくので 追いかけよう。</li>
  <li>画面の外に にげたときは、画面の はしの 矢印が 場所を おしえます。</li>
  <li>素体のときは 衣装の とくべつな 力が つかえません。<b>白いハート</b>が なくなると まけです。</li>
  <li>素体のときに 宝箱を あけると、光のベールが 1回 まもってくれます。</li>
  <li>ボスが 衣装を もっていったときは、そのボスを たおすと もどります。女神へんしんも たすけになります。</li></ul>
  <p>回数（自動・3回・5回）${secret2Open()?'と 素体の絵':''}は「せってい」で かえられます。</p>`;}
  if(t==='costume')return`<p>衣装ごとに とくべつな 力と こうげきの しかたが あります。衣装は ≡ の「衣装をかえる」や タイトルの「衣装」で かえられます。</p>`+
    `<p>ステージ1〜10を クリアするたびに 1着ずつ ふえます。ステージ10の あとは <b>ごほうびポイント</b>（初クリア 1回で 1・スタンプ 1つで 1・ベスト更新 1回で 2）が 必要ポイントに とどくと もらえます。衣装ごとに こうげきの 強さが ちがいます。<br>いまの ごほうびポイント：<b>${rewardPoints()}</b></p>`+
    ORDERED_COSTUMES().map(c=>{const shut=!cosOpen(c),q=condText(c),name=c.name.replace('\n','');return `<div class="mrow manualCostume${shut?' locked':''}">${shut?'':c===BARE?Object.entries(BASE_NAME).map(([id,n])=>`<h3>${n}</h3>${manualArt('base_'+id,n)}`).join(''):manualArt(c.id,name)}<div class="mt">`+
      (shut?`<b>？？？</b><span class="mk">まだ 見えない 衣装</span>`:`<b>${name}</b>${c.star?` <span class="stars">${starStr(c.star)}</span>`:''}<br>${c.ab}${!c.special&&c!==BARE?`<span class="mk">${atkText(c)}</span>`:''}`)+
      (q?`<div class="mq">入手：${q}</div>`:'')+`</div></div>`;}).join('')+(!secret2Open()?`<div class="mrow manualCostume">${manualArt('base_'+save.baseArt,BASE_NAME[save.baseArt])}<div class="mt"><b>素体（${BASE_NAME[save.baseArt]}）</b><br>いまの すがた</div></div>`:'');
  if(t==='foes')return`<h3>ライバル（ボス）</h3>`+Object.keys(BOSSES).filter(id=>id!=='cat').map(id=>{const B=BOSSES[id];return`<div class="mrow">${mc(bFrame(id,0),70,80)}${mc(partnerFrame(B.minion,7),44,48,'width:44px')}<div class="mt"><b style="color:${B.col}">${B.name}</b><br>${BOSS_DESC[id]}</div></div>`;}).join('')+
    `<h3>いつもの敵</h3><p>左から 通常・強敵・精鋭。強いほど かざりが 豪華です。</p>`+ATLAS.enemy.kinds.map(k=>`<div class="mrow"><div class="tiers">${[0,1,2].map(i=>mc(enemyFrame(k,i),62,58)).join('')}</div><div class="mt"><b>${ENEMY_DESC[k][0]}</b><br>${ENEMY_DESC[k][1]}</div></div>`).join('');
  if(t==='chest')return`<p>宝箱に ふれると ミニゲームが はじまります。そのあいだ 敵は 止まって うすく なります。成功すると <b>大成功</b>（ハート回復・女神ゲージ 多め）。うまくいかなくても 宝箱は あきます。</p>
  <h3>① 宝箱のマッチ3（赤い宝箱）</h3><p>となりどうしを 入れかえて、同じもの 3つを ならべて けします。2つを じゅんばんに タップしても、指で すべらせても 入れかえられます。決められた 手数で 目標の数を けせば 成功。しばらく 迷っていると ヒントが 光ります。</p>
  <h3>② 数字ゲート（青い宝箱）</h3><p>画面の 上から ゲートが 2つ ならんで ながれてきます。くぐりたい ほうに やっちゃんを 動かして <b>ぶつかる</b>と、やっちゃんの 数字が かわります（＋ たす・× かける・− ひく・÷ わる）。3回 くぐって、カギの数字 いじょうに なれば 成功。とおりすぎたときは、もう一度 ながれてきます。</p>
  <h3>③ レベル差バトル（紫の宝箱）</h3><p>まわりに 頭の上に <b>Lv</b>の 数字を つけた敵が あらわれます。やっちゃんより レベルが <b>ひくい</b>敵に <b>ぶつかる</b>と 勝って、その レベルが やっちゃんに たされます。小さい敵から じゅんばんに たおして、さいごに 王冠の <b>宝箱の番人</b>を たおせば 成功。強すぎる敵に ぶつかると はねかえされます。画面の外の敵は、はしの 矢印が おしえます。</p>
  <p><b>宝箱の 色で ゲームが わかります</b>：赤＝マッチ3・青＝数字ゲート・紫＝レベル差バトル。</p><p>ミニゲームに <b>成功すると</b> 宝箱が あいて、回復のハート・キラキラの宝石・光のベールが 出てきます。しっぱいしても だいじょうぶ。宝箱から いったん はなれて、<b>もう一度 ふれると やりなおせます</b>。「やめる」で あとまわしにも できます。</p><p>「ふつう」では、数字ゲートと レベル差バトルの あいだも 敵が こうげきしてきます（ステージ1〜5は その場から 弾を うつ・ステージ6から あとは 動いて むかってくる）。「のんびり」では 敵は 止まっています。</p><h3>星のかけらの 宝箱（ステージ1〜4）</h3><p>羽根の ついた <b>金と紫の 特別な宝箱</b>が 1つずつ かくれています。ふれるだけで あいて、<b>星のかけら</b>が 手に入ります（ミニゲームは ありません）。ステージ1は 草原の奥の 花の丘、2は 森の奥の 大きな古木の 根元、3は 砂浜の 岩かげ、4は 花園の まんなか。画面の はしの 矢印も 教えてくれます。集めた かけらは「ステージをえらぶ」画面で 見られます。</p>`;
  if(t==='stage')return`<h3>クリア条件</h3><p>画面の上の 3つ（敵・宝箱・ボス）を ぜんぶ 達成すると クリア。クリアすると フィギュアスケートの ジャンプを 見られます（とばすことも できます）。</p><h3>ステージ</h3>`+
    STAGES.slice(0,10).map((st,i)=>`<div class="mrow"><div class="mi" style="font-size:26px;color:var(--wine);font-weight:bold">${i+1}</div><div class="mt"><b>${st.name}</b><br>ボス：${save.cleared[i]||save.allStages?st.bosses.map(b=>bossName(b)).join('・'):'？？？（クリアすると わかるよ）'}<br>ごほうび：${st.jump}ジャンプ${st.encore?'＋特別アンコール（アクセル）':''}</div></div>`).join('')+
    `<h3>おはなし</h3><p>ステージ1〜10には おはなしが あります。はじめて あそぶときと、はじめて クリアしたときに 画面の下に 出ます。語り手は、はじめは <b>黒猫</b>、とちゅうから <b>女神さま</b>に かわります。</p><p>ステージ10を クリアすると、タイトルに <b>「旅日記（おはなしをよむ）」</b>が あらわれ、いつでも 読みかえせます。</p>`+
    `<p>ステージ11からは、ライバルが 1〜4人 えらばれて あらわれます（ステージごとに きまっています）。ステージは 全部で ${MAX_STAGE}。10ステージごとに「1〜10」「11〜20」の ページで えらべます。</p>`+
    `<h3>むずかしさ</h3><ul><li><b>のんびり</b>：敵が ゆっくりで やわらかい。衣装の守り 5回・素体のハート 2つ。</li><li><b>ふつう</b>：衣装の守り 3回・素体のハート 1つ。</li></ul><p>負けたときは「のんびりモードで挑戦」も えらべます。</p>`;
  return`<h3>よくある質問</h3><ul><li><b>ホーム画面に おきたい</b><br>iPhone：Safari の 共有ボタン（□に↑）→「ホーム画面に追加」。Android：Chrome の ︙ →「ホーム画面に追加」。</li>
  <li><b>セーブは？</b><br>自動で この端末の ブラウザに 保存されます。べつの 端末には 引きつがれません。</li>
  <li><b>タイトルの絵を 大きく 見たい</b><br>絵の上で 2本指を ひろげると 大きく、つまむと 小さく なります。大きいときは 1本指で うごかせます。絵を 2回 タップすると もとの 大きさに もどります。</li>
  <li><b>マニュアルの 衣装の絵を 大きく 見たい</b><br>「衣装」の 絵を タップすると 大きく ひらきます。左右に スワイプ（または ◀ ▶）で 向きが かわり、2本指で 拡大・縮小、2回 タップで もとに もどります。</li>
  <li><b>すべる速さを かえたい</b><br>せってい の「すべる速さの 調整」。</li>
  <li><b>衣装が とれる回数を かえたい</b><br>せってい の「衣装が とれるまでの ダメージ」。</li>
  ${secret2Open()?'<li><b>素体の絵を かえたい</b><br>せってい の「素体の絵」。</li>':''}
  <li><b>先のステージや 衣装を 見たい</b><br>せってい の「全ステージ・全衣装・旅日記を選べる」。</li>
  <li><b>音が 出ない・うるさい</b><br>せっていの「音楽」「効果音」で えらべます。iPhoneは 横の スイッチ（マナーモード）を もどしてください。</li>
  <li><b>ポスターを もう一度 見たい</b><br>マニュアルの「ポスター」で いつでも 見られます。</li>
  ${secret2Open()?'<li><b>素体で あそびたい（ハードモード）</b><br>「衣装」で「素体」を えらびます。衣装の力が なにもなく、ハートが なくなると やりなおしです。</li>':''}
  <li><b>最初から やり直したい</b><br>せってい の いちばん下「最初から やり直す」。クリアの 記録・衣装・星のかけら・おはなしが 消えて、はじめから あそべます。</li>
  <li><b>画面の 上や下が きれる（iPhone）</b><br>Safari の 共有ボタン →「ホーム画面に追加」で アイコンを つくって、そこから ひらくと ブラウザの 帯が なくなり 全画面で あそべます。</li>
  <li><b>おはなしを もう一度 見たい</b><br>ステージ10を クリアすると タイトルの「旅日記」で 読めます。せってい の「ステージの おはなしを 毎回 表示する」でも 見られます。</li>
  <li><b>黒猫が いなくなった</b><br>ステージ6〜10は おはなしの 流れで 黒猫が いません。ステージ10で きっと もどってきます。ステージ11から あとは また いっしょです。</li>
  <li><b>画面が おかしい</b><br>ページを 読みこみなおしてください（セーブは 消えません）。</li></ul>
  <p style="font-size:14px;color:#8a6a4a;text-align:center;margin-top:14px">やっちゃんの冒険 ${VERSION}<br>本作品は非公式の二次創作ゲームです。</p>`;}
/* v8.3.29: shared, anchored pinch/pan for wardrobe, manual and poster. */
function bindImagePinch(stage,image,opts={}){
  const state={z:1,tx:0,ty:0},points=new Map();let pinch=null,pan=null,hadMulti=false,lastTap=null;
  const xy=(x,y)=>{const r=stage.getBoundingClientRect();return [x-r.left-r.width/2,y-r.top-r.height/2];};
  const max=()=>Math.max(1,opts.max?opts.max():6);
  function apply(){const mx=Math.max(0,(image.offsetWidth*state.z-stage.clientWidth)/2),my=Math.max(0,(image.offsetHeight*state.z-stage.clientHeight)/2);
    state.tx=clamp(state.tx,-mx,mx);state.ty=clamp(state.ty,-my,my);
    image.style.transform=state.z>1?`translate(${state.tx}px,${state.ty}px) scale(${state.z})`:'';}
  function reset(){state.z=1;state.tx=0;state.ty=0;points.clear();pinch=null;pan=null;hadMulti=false;lastTap=null;apply();}
  function pair(){const [a,b]=[...points.values()];return {d:Math.max(1,Math.hypot(a.x-b.x,a.y-b.y)),m:xy((a.x+b.x)/2,(a.y+b.y)/2)};}
  function beginPinch(){const {d,m}=pair();pinch={d:Math.max(12,d),z:state.z,u:(m[0]-state.tx)/state.z,v:(m[1]-state.ty)/state.z};pan=null;hadMulti=true;lastTap=null;}
  function zoom(z,m,u,v){state.z=clamp(z,1,max());state.tx=m[0]-u*state.z;state.ty=m[1]-v*state.z;if(state.z<=1){state.tx=0;state.ty=0;}apply();if(opts.onZoom)opts.onZoom();}
  stage.addEventListener('pointerdown',e=>{if(e.pointerType==='mouse'&&e.button!==0)return;if(!points.size){hadMulti=false;pinch=null;pan=null;}
    points.set(e.pointerId,{x:e.clientX,y:e.clientY,sx:e.clientX,sy:e.clientY,t:performance.now()});try{stage.setPointerCapture(e.pointerId);}catch(_){}
    if(points.size>=2)beginPinch();else if(state.z>1)pan={x:e.clientX,y:e.clientY,tx:state.tx,ty:state.ty};e.preventDefault();});
  stage.addEventListener('pointermove',e=>{const p=points.get(e.pointerId);if(!p)return;p.x=e.clientX;p.y=e.clientY;
    if(pinch&&points.size>=2){const {d,m}=pair();zoom(pinch.z*d/pinch.d,m,pinch.u,pinch.v);}
    else if(pan){state.tx=pan.tx+e.clientX-pan.x;state.ty=pan.ty+e.clientY-pan.y;apply();}
    else if(!hadMulti&&state.z<=1&&opts.onSwipe){const dx=e.clientX-(p.rx??p.sx),dy=e.clientY-p.sy;if(Math.abs(dx)>=36&&Math.abs(e.clientX-p.sx)>Math.abs(dy)*1.2){const n=Math.trunc(dx/36);p.rx=(p.rx??p.sx)+n*36;p.rotated=true;lastTap=null;opts.onSwipe(-n);}}e.preventDefault();});
  function end(e){const p=points.get(e.pointerId);if(!p)return;points.delete(e.pointerId);
    if(hadMulti){if(points.size>=2)beginPinch();else{pinch=null;pan=null;if(points.size===1&&state.z>1){const q=[...points.values()][0];pan={x:q.x,y:q.y,tx:state.tx,ty:state.ty};}if(!points.size){hadMulti=false;lastTap=null;}}return;}
    const wasPan=!!pan;pan=null;if(e.type!=='pointerup'){lastTap=null;return;}const dx=e.clientX-p.sx,dy=e.clientY-p.sy;
    if(p.rotated){lastTap=null;return;}
    if(performance.now()-p.t<320&&Math.hypot(dx,dy)<12){const now=performance.now();if(lastTap&&now-lastTap.t<380&&Math.hypot(e.clientX-lastTap.x,e.clientY-lastTap.y)<40){reset();}else lastTap={t:now,x:e.clientX,y:e.clientY};}}
  for(const ev of ['pointerup','pointercancel','lostpointercapture'])stage.addEventListener(ev,end);
  stage.addEventListener('dblclick',e=>{e.preventDefault();reset();});
  stage.addEventListener('wheel',e=>{if(!e.ctrlKey&&!e.metaKey)return;e.preventDefault();const m=xy(e.clientX,e.clientY);zoom(state.z*Math.exp(-e.deltaY*.01),m,(m[0]-state.tx)/state.z,(m[1]-state.ty)/state.z);},{passive:false});
  for(const ev of ['gesturestart','gesturechange','gestureend'])stage.addEventListener(ev,e=>e.preventDefault(),{passive:false});
  return {state,reset,apply};
}
async function openManual(tab){manTab=tab||manTab;show('scrHelp');
  await Promise.all([...Object.values(ATLAS.boss.list).map(b=>loadImg(b.file)),loadImg(ATLAS.thumbs.file),loadImg(ATLAS.enemy.file)]);
  $('manTabs').innerHTML=MAN_TABS.map(([k,l])=>`<button data-t="${k}" class="${k===manTab?'on':''}">${l}</button>`).join('');
  $('manTabs').querySelectorAll('button').forEach(b=>b.onclick=()=>openManual(b.dataset.t));
  manSeq=0;for(const k in MANF)delete MANF[k];
  $('manBody').innerHTML=manualHTML(manTab);
  $('manBody').querySelectorAll('canvas[data-mc]').forEach(c=>frameToCanvas(c,MANF[c.dataset.mc]));
  hookManualTitleArt($('manBody'));
  const tb=$('manTut');if(tb)tb.onclick=()=>{hide('scrHelp');hide('scrPause');startTutorial();};
  {const pb=$('manPosterBig'),pi=$('manPoster');if(pb)pb.onclick=()=>openPoster('manual');if(pi)pi.onclick=()=>openPoster('manual');}
  $('scrHelp').scrollTop=0;$('manBody').scrollTop=0;}

/* ============ loading ============ */
async function ensureLoaded(files){const need=files.filter(f=>!imgOf(f));if(!need.length)return;
  const wasHidden=$('scrLoad').classList.contains('hidden');show('scrLoad');$('loadMsg').textContent='絵を よみこんでいます…';let n=0;
  await Promise.all(need.map(f=>loadImg(f).then(()=>{n++;$('loadBar').firstChild.style.width=(n/need.length*100)+'%';})));
  if(wasHidden)hide('scrLoad');checkErrors();}
function checkErrors(){if(failed.length){$('errList').innerHTML=[...new Set(failed)].join('<br>');show('scrError');}}

/* ============ main loop ============ */
let last=performance.now();
function loop(t){const dt=Math.min(0.05,(t-last)/1000);last=t;
  try{if(state==='mini'){if(mini&&mini.type==='match3'&&mini.g)m3Update(dt);}else if(state==='story'){updateStory(dt);}else if(state!=='paused'&&state!=='menu')update(dt);
    drawWard(dt);render();}catch(err){console.error(err);showFatal(err);}
  requestAnimationFrame(loop);}
let fatalShown=false;
function showFatal(err){if(fatalShown)return;fatalShown=true;$('errList').textContent='プログラムのエラー: '+(err&&err.message||err);show('scrError');}
document.addEventListener('visibilitychange',()=>{if(document.hidden)pause();});
window.addEventListener('resize',()=>{resize();relayoutMenus();});
function relayoutMenus(){try{if(!$('scrTitle').classList.contains('hidden'))drawTitleChar();if(!$('scrWard').classList.contains('hidden'))sizeWardPrev();}catch(e){}}
if(window.visualViewport){let vt=0;const vr=()=>{clearTimeout(vt);vt=setTimeout(()=>{const h=Math.round(visualViewport.height);if(Math.abs(h-VH)>2||Math.abs(window.innerWidth-VW)>2)resize();else fitViewport();},60);};visualViewport.addEventListener('resize',vr);visualViewport.addEventListener('scroll',vr);}
window.addEventListener('orientationchange',()=>setTimeout(resize,300));

async function boot(){
  loadSave();resize();$('titleVer').textContent=VERSION;$('verTag').textContent=`やっちゃんの冒険 ${VERSION}`;
  const files=[ATLAS.thumbs.file,ATLAS.faces.file,ATLAS.cat.file,ATLAS.catpose.file,ATLAS.catface.file,ATLAS.poses.file,ATLAS.enemy.file,...(ATLAS.objects?[ATLAS.objects.file]:[]),...(ATLAS.goddessface?[ATLAS.goddessface.file]:[]),...Object.values(ATLAS.partner).map(p=>p.file),ATLAS.title,
    yInfo(save.costume).file,yInfo('base').file];
  $('loadMsg').textContent='もうすぐ はじまります';/* v8.3.21: ダウンロードは 0〜90%（ページ側）、絵の準備は 90〜100% */
  let n=0;await Promise.all(files.map(f=>loadImg(f).then(()=>{n++;$('loadBar').firstChild.style.width=(90+n/files.length*10)+'%';})));
  $('scrTitle').style.backgroundImage='none';$('scrTitle').style.setProperty('--title-bg',`url(${ASSETS[ATLAS.title]||BASE+ATLAS.title})`);
  if(save.ribbon&&save.ribbon!=='red')await prepRibbon(save.ribbon);
  toTitle();checkErrors();
  if(ATLAS.poster&&!save.posterSeen&&!(DEBUG&&!/poster/.test(location.search)))openPoster('boot');
  loadImg(yInfo('goddess').file);
  requestAnimationFrame(loop);
}
if(DEBUG){window.__costumeIds=()=>COSTUMES.filter(c=>!c.special).map(c=>c.id);window.__dbg={get P(){return P;},get state(){return state;},get enemies(){return enemies;},get bosses(){return bosses;},get world(){return world;},
  kills:n=>{kills=n;},chests:()=>{world.chests.forEach(c=>{if(!c.open){P.x=c.x;P.y=c.y+10;}});},openAll:()=>{world.chests.forEach(c=>{if(!c.open){c.open=true;chestsOpen++;}});},
  killBoss:()=>{bosses.forEach(b=>hitBoss(b,9999));},spawnBoss:()=>{if(bossQueue.length)spawnBoss(bossQueue.shift());},gauge:()=>{P.gauge=1;},hurt:()=>{P.inv=0;const o=enemies[0]||bosses[0]||null;damagePlayer(o,o);},get thief(){return thief;},get tut(){return tut;},startTutorial,openManual,killThief:()=>{if(thief&&thief.h)hitEnemy(thief,999,1,0);else if(thief)hitBoss(thief,9999);},tp:(x,y)=>{P.x=x;P.y=y;},
  input,startStage,startWalk,setState:s=>{state=s;},idle:s=>{P.idle=s;},
  get save(){return save;},spawnEnemy,get shots(){return shots;},get killCount(){return kills;},get catReq(){return catReq;},setCatSay:(t,i)=>{catSay={text:t,t:30,icon:i||null};},get catSay(){return catSay;},rewardPoints,cosOpen:id=>cosOpen(CMAP[id]),migrateV83,syncOwned,COSTUMES:()=>COSTUMES,fireTargets,strength,get story(){return story;},get scene(){return scene;},get catOn(){return catOn;},get CAT(){return CAT;},get stage(){return stage;},get stageIdx(){return stageIdx;},get fm(){return fm;},get pops(){return pops;},catGuard,openStarChest,startField:t=>{const c=world.chests.find(c=>!c.open);if(c){P.x=c.x;P.y=c.y+60;startField(c,t);}},passGate,STAGES,storyNext:()=>{if(story)story.t=1;storyNext();},openJournal,toTitle,writeSave};}
boot();
</script>
</body>
</html>
