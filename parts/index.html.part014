const ATK_TEXT={near:'いちばん近い敵を ねらう',strong:'いちばん強い敵を ねらう（ボス優先）',even:'近くの敵に 1発ずつ わけて ねらう',nway:'扇形に 広がる',front:'進む方向へ まっすぐ',scatter:'ばらまき',spiral:'うずまき',ring:'まわりに ぐるり'};
function atkOf(c){return (c&&ATK[c.id])||ATK.basic;}
function atkText(c){const a=atkOf(c),r=a.eff/ATK.basic.eff;
  return a.parts.map(([p,n])=>ATK_TEXT[p]+(n>1?`（${n}発）`:'')).join('＋')+(a.pr?`・敵を ${a.pr}体まで つらぬく`:'')+`・こうげき力 ${r<1.05?'ふつう':'基本の '+r.toFixed(1)+'倍'}`;}
function stampCount(){return (save.stamps||[]).length;}
/* more generous cumulative rewards: first clear of any stage +1, daily stamp +1, new personal-best +2, legacy bonus +7; old saves receive first-clear credit retroactively. */
function rewardPoints(){return stampCount()+2*(save.bestUp||0)+7*(save.giftBonus||0)+Object.keys(save.cleared||{}).filter(k=>save.cleared[k]).length;}
function legacyGifts(){return Math.floor((save.bestUp||0)/3)+Math.floor(stampCount()/7)+(save.giftBonus||0);}
function ruleOpen(c){if(c.secret2)return secret2Open();if(c.unlock===0)return true;if(c.pts!=null)return !!save.cleared[9]&&rewardPoints()>=c.pts;return !!save.cleared[c.unlock-1];}
function cosOpen(c){if(!c)return false;if(c.secret2)return secret2Open();if(c.special)return false;if(save.allStages||save.allCos||c.unlock===0)return true;
  if(Array.isArray(save.owned)&&save.owned.includes(c.id))return true;return ruleOpen(c);}
/* never lose a costume: anything open by the rules is recorded once and stays */
function syncOwned(){if(!Array.isArray(save.owned))save.owned=[];let ch=false;for(const c of COSTUMES){if(c.special||save.owned.includes(c.id))continue;if(ruleOpen(c)){save.owned.push(c.id);ch=true;}}return ch;}
/* v8.3 migration: costumes that the old rules (v8.2c/e/f) had opened are kept as owned */
function migrateV83(){if(save.v83)return;const g=legacyGifts(),done=!!save.cleared[9],own=new Set(Array.isArray(save.owned)?save.owned:[]);
  const OLD={chinaw:0,gsmile:1,gtear:2};for(let i=1;i<=16;i++)OLD['gset'+String(i).padStart(2,'0')]=i+2;
  for(const c of COSTUMES){if(c.special)continue;if(c.unlock!=null&&(c.unlock===0||save.cleared[c.unlock-1]))own.add(c.id);}
  if(done){for(const id in OLD)if(g>OLD[id])own.add(id);
    for(let i=10;i<=16;i++){if(g>i+2)own.add('gnew'+i);if(g>i+9)own.add('gnew'+i);}}
  if(save.costume&&save.costume!=='base'&&CMAP[save.costume]&&!CMAP[save.costume].special)own.add(save.costume);
  save.owned=[...own].filter(id=>CMAP[id]);save.v83=1;}
const crank=c=>Math.max(0,COSTUMES.indexOf(c));
const GIFTS=()=>COSTUMES.filter(c=>c.pts!=null&&!c.secret2);
const starStr=n=>'★'.repeat(n)+'☆'.repeat(5-n);
const CMAP={};COSTUMES.forEach(c=>CMAP[c.id]=c);
const BARE={id:'base',secret2:true,name:'素体',ab:'衣装の力が なにもない すがた。えらぶと <b>ハードモード</b>（ハートが なくなると やりなおし）。ゲーム中に 衣装の力を うばわれたときも この すがたに なります。',shot:'pearl',col:'#ffffff',trail:'#ffffff',mods:{}};
/* Normal clothing first, then goddess and base, then the second (20-tap) secret costumes. */
const secret2Open=()=>!!save.baseNUnlocked;
/* v8.3.16: 素体（ハードモード）と 素体の絵の選択は、すべて タイトル20回タップの「ふたつめの ひみつ」を解放してから。 */
const DISPLAY_COSTUME_IDS=["basic","sailor","polka","lace","chiffon","lolita","princess","gothic","maid","hakama","chinaw","chinab","gnew10","gnew14","gnew15","gnew16","gset01","gset02","gset03","gset04","gset05","ynew_beige","ynew_blossom","ynew_maid","gset09","ynew_lace","ynew_moon","ynew_tulle","gset10","gset11","gset12","gset13","gset14","gset15","gset16","ynew2_gold","ynew2_frill","ynew2_ribbon","ynew2_bob","crystal","ynew2_snow","v8331_ice_lace","v8331_jewel_ice","ynew4_icelace","ynew3_sport","gnew11","gnew13","ynew_tennis_white","ynew2_tennis","ynew2_marine","gnew12","ynew_longveil","ynew_veil","ynew3_lacebow","ynew2_rose","ynew3_pearl","ynew_sheer","gset06","gset07","gset08","ynew5_cape","ynew4_wrap","ynew5_cross","ynew5_pearl","v8331_flower_veil","v8331_star_veil","v8331_star_jewel_veil","v8331_star_snowflower_bob","v8331_star_snowflower_braids","v8331_star_short_veil","v8331_star_ribbon","v8331_star_open_sheer","v8331_star_sheer_sleeveless","v8331_star_smooth_onepiece","v8331_star_satin","v8331_star_halter","v8331_star_lace","v8331_star_embroidery","v8331_star_fine_lace","v8331_star_simple","gsmile","gtear","goddess"];
const ORDERED_COSTUMES=()=>[...DISPLAY_COSTUME_IDS.map(id=>CMAP[id]),...(secret2Open()?[BARE]:[])].filter(cosOpen);
const condText=c=>c===BARE||c.special||c.secret2?'':c.unlock===0?'さいしょから':c.unlock!=null?`ステージ${c.unlock}クリア`:`${c.pts}ポイント`;
