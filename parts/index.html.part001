<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#f6efe2">
<title>やっこの冒険 v0.3</title>
<style>
:root{--ink:#5a3a2e;--wine:#8e2f45;--wine2:#b44a62;--gold:#c9a24a;--paper:#fffaf0;--paper2:#f3e6cc;
--ui:"Hiragino Maru Gothic ProN","Hiragino Sans","Yu Gothic","Noto Sans JP",sans-serif;
--title:"Hiragino Mincho ProN","Yu Mincho","Noto Serif JP",serif;}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;height:100dvh;background:#2b2230;overflow:hidden;overscroll-behavior:none}
body{font-family:var(--ui);color:var(--ink);-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;-webkit-text-size-adjust:100%}
#game{position:fixed;left:0;right:0;top:0;height:100vh;height:100dvh;overflow:hidden;min-height:0}
body{position:fixed;left:0;right:0;top:0;height:100dvh;overflow:hidden}
#cv{position:absolute;inset:0;width:100%;height:100%;touch-action:none;display:block}
.hidden{display:none!important}
button{font-family:var(--ui);cursor:pointer;touch-action:manipulation}
/* ---------- HUD ---------- */
#hud{position:absolute;inset:0;pointer-events:none;padding:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left)}
#hudTop{display:flex;align-items:center;gap:8px;padding:8px 10px 0}
#portrait{width:62px;height:62px;border-radius:50%;border:3px solid var(--gold);background:#fff6ea;box-shadow:0 2px 6px rgba(60,30,20,.35);overflow:hidden;flex:none}
#portrait canvas{width:100%;height:100%;display:block}
#hudMid{flex:1;min-width:0}
#hearts{display:flex;gap:3px;flex-wrap:wrap;align-items:center}
#hearts svg{width:26px;height:24px;filter:drop-shadow(0 1px 1px rgba(80,30,30,.4))}
#gaugeWrap{margin-top:4px;display:flex;align-items:center;gap:6px;font-size:13px;font-weight:bold;color:#fff;text-shadow:0 1px 2px rgba(60,30,20,.8)}
#gaugeBar{flex:1;max-width:150px;height:10px;border-radius:6px;background:rgba(255,255,255,.55);border:1.5px solid var(--gold);overflow:hidden}
#gauge{height:100%;width:0;background:linear-gradient(90deg,#fff3c2,#f2c94c,#fff);transition:width .25s}
.roundBtn{pointer-events:auto;width:54px;height:54px;border-radius:50%;border:3px solid var(--gold);background:linear-gradient(#fffaf0,#f1e2c4);color:var(--wine);font-size:26px;font-weight:bold;box-shadow:0 2px 6px rgba(60,30,20,.35);flex:none;padding:0;line-height:1}
.roundBtn.small{width:46px;height:46px;font-size:22px}
#goals{display:flex;justify-content:center;gap:6px;margin:8px 8px 0;flex-wrap:wrap}
.goal{background:rgba(255,250,240,.93);border:2px solid var(--gold);border-radius:14px;padding:4px 10px;font-size:18px;font-weight:bold;color:var(--ink);box-shadow:0 2px 4px rgba(60,30,20,.25);white-space:nowrap}
.goal.done{background:linear-gradient(#fff4c4,#f3d77a);color:#7a4a10}
.goal b{color:var(--wine);margin-left:4px}
#goalRow{display:flex;align-items:stretch;justify-content:center;gap:6px;margin:8px 8px 0}
#goalRow #goals{margin:0}
#goalRow.withBoss #goals{flex-wrap:nowrap;gap:4px;flex:none}
#goalRow.withBoss .goal{font-size:15px;padding:3px 7px;border-radius:12px}
#goalRow.withBoss .goal b{margin-left:2px}
#goalRow.withBoss .goal.bare{display:none}
#goalRow #bossBar{margin:0;flex:1;min-width:84px;max-width:200px;width:auto;display:flex;flex-direction:column;justify-content:center;padding:2px 8px 4px;font-size:13px;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#goalRow #bossBar.hidden{display:none}
@media (max-width:359px){#goalRow.withBoss .goal{font-size:13px;padding:3px 5px}}
/* v8.3.22: クリア条件の箱は かならず 1行（iPhone SE などで ボスの箱が 下の行に 落ちて 画面を ふさがないように）。
   はばが 足りないときは JS（fitGoals）が 文字を 小さくして 1行に おさめる。 */
#goals,#goalRow.withBoss #goals{flex-wrap:nowrap}
#goals .goal{flex:none;white-space:nowrap}
#goalRow.gfit .goal{font-size:var(--gfs);padding:calc(var(--gfs)*.18) calc(var(--gfs)*.42);border-radius:calc(var(--gfs)*.7)}
#goalRow.gfit .goal b{margin-left:calc(var(--gfs)*.15)}
#goalRow.gfit #bossBar{min-width:72px}
#bossBar{margin:6px auto 0;width:min(86%,420px);background:rgba(255,250,240,.93);border:2px solid var(--wine);border-radius:12px;padding:3px 10px 5px;font-weight:bold;font-size:15px;color:var(--wine)}
#bossBar .bar{height:10px;border-radius:6px;background:#f0d9d9;overflow:hidden;margin-top:2px}
#bossHp{height:100%;width:100%;background:linear-gradient(90deg,#b44a62,#e07a8e);transition:width .15s}
#hudFlow{display:flex;flex-direction:column;align-items:stretch}
#banner{position:absolute;left:50%;bottom:calc(116px + env(safe-area-inset-bottom));width:max-content;max-width:calc(100% - 24px);background:rgba(255,250,240,.9);border:2px solid var(--gold);border-radius:14px;padding:5px 12px;text-align:center;font-family:var(--ui);font-weight:bold;font-size:16px;line-height:1.35;color:var(--wine);box-shadow:0 2px 8px rgba(60,30,20,.25);opacity:0;transform:translate(-50%,8px);transition:opacity .25s,transform .25s;pointer-events:none}
#banner.show{opacity:1;transform:translate(-50%,0)}
#banner small{display:block;font-size:13px;color:var(--ink);margin-top:1px;font-weight:bold}
.bcard{display:flex;align-items:center;gap:8px;text-align:left}
.bcard canvas{width:40px;height:40px;border-radius:50%;border:2px solid var(--gold);background:#fff6ea;flex:none}
.bcard .bt{font-size:15px}
.bcard .bl{font-size:13px;color:var(--ink);margin-top:1px;font-weight:bold;line-height:1.35}
#btnGoddess.used{background:rgba(255,255,255,.5)}
#btnGoddess.used span{background:#efe9df;color:#a99a86;font-size:13px}
#jumpOv{position:absolute;inset:0;z-index:4;background:#1c1420;overflow:hidden}
#jumpImg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .45s}
#jumpImg.on{opacity:1}
#jumpCap{position:absolute;left:0;right:0;top:calc(16px + env(safe-area-inset-top));text-align:center;color:#fff;font-family:var(--title);font-weight:bold;font-size:28px;line-height:1.3;text-shadow:0 2px 0 var(--wine),0 0 12px rgba(120,40,60,.9),0 2px 6px rgba(0,0,0,.5);padding:0 10px}
#jumpCap small{display:block;font-family:var(--ui);font-size:12px;margin-top:4px}
#btnJumpSkip{position:absolute;right:calc(14px + env(safe-area-inset-right));bottom:calc(24px + env(safe-area-inset-bottom));width:auto;padding:0 18px}
#newCos{margin:8px 0 2px;padding:8px;border:2px solid var(--gold);border-radius:14px;background:linear-gradient(#fffbe9,#fbeecb)}
#newCos canvas{width:110px;height:auto;display:block;margin:0 auto}
#newCos .nt{font-size:18px;font-weight:bold;color:var(--wine)}
.cos .lk{font-size:12px;color:#8a6a4a;font-weight:bold}
.wardMore{grid-column:1/-1;text-align:center;font-size:15px;color:#8a6a4a;background:#fbf3e2;border:2px dashed #e0c98e;border-radius:14px;padding:8px 6px;line-height:1.5}
.wardMore b{color:var(--wine);font-size:18px}
.cos.locked canvas{filter:grayscale(1) brightness(1.25);opacity:.45}
.stars{color:#d4a017;letter-spacing:1px}
#scrMini{z-index:5}
#miniCv{max-width:min(360px,calc(var(--app-h,100vh) - 270px))!important}
#scrConfirm{z-index:8}
#scrStamp,#scrPhoto{z-index:8}
#toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom));transform:translateX(-50%);z-index:30;background:rgba(255,250,240,.97);border:3px double var(--gold);border-radius:16px;padding:10px 16px;font-size:17px;font-weight:bold;color:var(--wine);text-align:center;box-shadow:0 4px 14px rgba(60,30,20,.35);width:min(90%,380px);line-height:1.5;transition:opacity .4s}
#toast.hidden{display:block;opacity:0;pointer-events:none}
#titleBtns .row4{gap:4px}
#titleBtns .row4 .btn{font-size:14px;padding:0 1px;letter-spacing:-.02em;white-space:nowrap;min-width:0}
.stampTop{display:flex;align-items:center;gap:10px;text-align:left}
#stampCat{width:76px;height:76px;border-radius:50%;border:3px solid var(--gold);background:#fff6ea;flex:none}
#stampMsg{font-size:17px;font-weight:bold;line-height:1.55;color:#3a2418}
.stampCard{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin:8px 0 4px;padding:8px 6px;background:linear-gradient(#fff8e8,#f8ecd0);border:2px dashed #d9b974;border-radius:14px}
.stampCard div{aspect-ratio:1;border-radius:50%;border:2px solid #e6d2a4;background:#fffdf6;display:flex;align-items:center;justify-content:center;font-size:20px}
.stampCard div.on{background:radial-gradient(#ffe1ea,#f7b9cb);border-color:#d9809a}
.stampCard div.new{animation:stampIn .6s cubic-bezier(.2,1.6,.4,1)}
@keyframes stampIn{0%{transform:scale(2.4) rotate(-25deg);opacity:0}100%{transform:none;opacity:1}}
#recTabs button{font-size:14px;white-space:nowrap;padding:0 2px;letter-spacing:-.02em}
#stampInfo,.recInfo{font-size:15px;line-height:1.6;color:#5a3a2a}
.ribRow{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;margin:6px 0}
.ribRow button{width:46px;height:46px;padding:0;border-radius:50%;border:3px solid #e6d2a4;font-size:11px;font-weight:bold;color:#fff;text-shadow:0 1px 2px rgba(0,0,0,.5)}
.ribRow button.on{border-color:var(--wine);box-shadow:0 0 0 3px #fff,0 0 0 5px var(--wine)}
.ribRow button:disabled{filter:grayscale(1);opacity:.35}
.recRow{display:flex;justify-content:space-between;gap:8px;padding:7px 4px;border-bottom:1px dashed #e6d2a4;font-size:16px}
.recRow b{color:var(--wine);white-space:nowrap}
.album{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
.album img{width:100%;border-radius:8px;border:2px solid #e0c98e;display:block}
#photoImg{display:block;margin:0 auto;max-width:100%;max-height:calc(var(--app-h,100vh) - 320px);border-radius:10px;border:2px solid #e0c98e}
.photoTip{font-size:14px;color:#8a6a4a;margin:4px 0 0}
#readyHead{font-family:var(--title);color:var(--wine);font-size:21px;text-align:center;line-height:1.3;margin-bottom:6px}
.readyRow{display:flex;gap:10px;align-items:flex-start;text-align:left}
#readyFace{width:72px;height:72px;border-radius:50%;border:3px solid var(--gold);background:#fff6ea;flex:none}
#readyText{font-size:18px;line-height:1.6;font-weight:bold;color:#2e1d14}
#readyText .rn{display:block;font-size:14px;color:var(--wine)}
.readyCos{display:flex;align-items:center;justify-content:center;gap:10px;margin:6px 0 2px;background:#fbf3e2;border:2px solid #e8d4a4;border-radius:14px;padding:4px 8px}
#readyCos{width:66px;height:70px}
#readyCosName{font-size:16px;font-weight:bold;color:#5a3a2a;text-align:left;line-height:1.4}
@media (max-height:640px){#readyHead{font-size:18px;margin-bottom:2px}#readyText{font-size:16px;line-height:1.5}#readyFace{width:60px;height:60px}#readyCos{width:52px;height:55px}}
#scrPoster{z-index:9;background:#2b1f24;justify-content:flex-start;gap:6px;padding:calc(6px + env(safe-area-inset-top)) 6px calc(8px + env(safe-area-inset-bottom))}
#posterBox{flex:1;min-height:0;width:100%;overflow:auto;display:flex;align-items:center;justify-content:center;-webkit-overflow-scrolling:touch;border-radius:10px}
#posterImg{max-width:100%;max-height:100%;object-fit:contain;border-radius:8px;box-shadow:0 4px 18px rgba(0,0,0,.5);opacity:0;transition:opacity .5s}
#posterImg.on{opacity:1}
#posterBox{overflow:hidden;touch-action:none;user-select:none;-webkit-user-select:none}
#posterImg{transform-origin:center;will-change:transform;-webkit-user-drag:none}
#posterBtns{display:flex;gap:8px;width:min(100%,440px);flex:none}
#posterBtns .btn{margin-top:0;min-height:54px}

.mposter{display:block;width:100%;border-radius:10px;border:2px solid #e0c98e;margin:4px 0 8px}
.stage canvas.lockbg{background:repeating-linear-gradient(45deg,#efe3c9,#efe3c9 8px,#e6d6b6 8px,#e6d6b6 16px)}
.btn.warn{background:linear-gradient(#fff4f2,#f6dcd6);color:#a3283f;border-color:#d98a8a;box-shadow:0 3px 0 #c98080}
#catIco{position:absolute;left:54px;top:44px;width:28px;height:28px;border-radius:50%;border:2px solid var(--gold);background:#fff6ea;box-shadow:0 1px 4px rgba(60,30,20,.35);transition:opacity .3s,filter .3s}
#catIco.cool{opacity:.45;filter:grayscale(.7)}
#hudTop{position:relative}
#starRow{display:flex;justify-content:center;align-items:center;gap:6px;margin:-4px 0 6px;font-size:15px;font-weight:bold;color:#8a6a4a}
#starRow canvas{width:30px;height:30px}
#starRow canvas.off{opacity:.22;filter:grayscale(1)}
@media (max-height:640px){
 .card{padding:10px 12px 12px}
 .card h2,h2{font-size:22px;margin:0 0 6px}
 .btn{min-height:50px;font-size:19px;margin-top:8px}
 .btn.small{min-height:44px;font-size:17px}
 .screen{padding-top:calc(8px + env(safe-area-inset-top));padding-bottom:calc(8px + env(safe-area-inset-bottom))}
 #miniRule{font-size:14px;line-height:1.35;margin-bottom:2px}
 #miniTop{margin:2px 0 4px}
 .mstat{font-size:12px;padding:2px}
 .mstat b{font-size:20px;line-height:1.15}
 #miniTitle{font-size:20px!important;margin:0 0 2px!important}
 #miniBtns .btn{min-height:44px;margin-top:6px;font-size:17px}
 #miniRule{font-size:13px!important}
 #miniMsg{font-size:16px;min-height:22px;margin-top:4px}
 #storyText{font-size:18px;line-height:1.6}
 #storyFace{width:64px;height:64px}
 #btnStoryNext{min-height:50px;margin-top:6px}
 }
body.storying #hint{display:none}
#fmPanel{pointer-events:auto;margin:6px auto 0;width:min(96%,470px);background:rgba(255,250,240,.96);border:3px double var(--gold);border-radius:16px;padding:5px 6px;display:flex;align-items:center;gap:5px;box-shadow:0 3px 8px rgba(60,30,20,.3)}
#fmTitle{font-weight:bold;color:var(--wine);font-size:14px;line-height:1.25;flex:none;width:4.4em;text-align:center}
#fmStats{display:flex;gap:4px;flex:1;justify-content:center}
.fs{background:#fff6e2;border:1.5px solid #e2c98a;border-radius:10px;padding:2px 5px;font-size:12px;color:#6a4a3a;text-align:center;line-height:1.15;min-width:52px}
.fs b{display:block;font-size:24px;color:var(--wine)}
.fs b.pop{animation:popn .45s}
#fmQuit{width:auto;min-height:42px;padding:0 9px;font-size:14px;flex:none;margin:0}
#storyDim{position:absolute;inset:0;z-index:6;background:rgba(30,18,30,.28)}
#storyWin{position:absolute;left:8px;right:8px;bottom:calc(10px + env(safe-area-inset-bottom));z-index:7;max-width:560px;margin:0 auto;background:#fffaf0;border:4px double var(--gold);border-radius:18px;padding:10px 12px 12px;box-shadow:0 6px 20px rgba(40,20,20,.45)}
#storyHead{font-size:14px;color:#8a6a4a;font-weight:bold;margin-bottom:6px}
#storyRow{display:flex;gap:10px;align-items:flex-start}
#storyFace{width:78px;height:78px;border-radius:50%;border:3px solid var(--gold);background:#fff6ea;flex:none}
#storyName{font-weight:bold;font-size:16px;color:var(--wine);margin-bottom:2px}
#storyText{font-size:20px;line-height:1.7;font-weight:bold;color:#2e1d14}
#btnStoryNext{margin-top:10px;min-height:56px}
#scrJournal{background:radial-gradient(ellipse at center,#5a4048,#2b1f24);z-index:5}
.jcard{background:linear-gradient(#fdf7e8,#f3e6c6);border:4px double #b8924a;box-shadow:0 8px 24px rgba(0,0,0,.5),inset 0 0 40px rgba(170,130,70,.18);perspective:900px}
#jPage{min-height:52vh;text-align:left}
#jPage.flipN{animation:flipN .45s ease}
#jPage.flipP{animation:flipP .45s ease}
@keyframes flipN{0%{transform:rotateY(-70deg);opacity:0}100%{transform:none;opacity:1}}
@keyframes flipP{0%{transform:rotateY(70deg);opacity:0}100%{transform:none;opacity:1}}
.jno{font-family:var(--title);color:#8a6a4a;font-size:16px;text-align:center}
.jtitle{font-family:var(--title);color:var(--wine);font-size:26px;text-align:center;margin:2px 0 8px;line-height:1.3}
.jpic{width:100%;height:auto;border-radius:12px;border:2px solid #d8bf86;display:block}
.jsyn{font-size:18px;line-height:1.75;margin:10px 2px;color:#3a2418}
.jline{display:flex;gap:8px;align-items:flex-start;margin:8px 0;padding:8px;background:rgba(255,255,255,.6);border-radius:12px;border:1px solid #e6d3a6}
.jline canvas{width:54px;height:54px;border-radius:50%;border:2px solid var(--gold);background:#fff6ea;flex:none}
.jline .jt{font-size:17px;line-height:1.65;font-weight:bold;color:#2e1d14}
.jline .jw{font-size:13px;color:var(--wine);font-weight:bold}
.jnav{position:sticky;bottom:0;margin:4px -6px -6px;padding:8px 6px 6px;background:linear-gradient(rgba(246,235,208,0),#f5e9cb 22%);border-radius:0 0 12px 12px}
.jnav .row{margin-top:0}
.jpg{text-align:center;color:#8a6a4a;font-family:var(--title);margin-top:6px}
#scrMini .card{padding:12px 12px 14px}
#miniRule{font-size:16px;line-height:1.5;margin-bottom:6px}
#miniTop{display:flex;gap:8px;margin:4px 0 8px}
.mstat{flex:1;background:#fff;border:2px solid #e0c98e;border-radius:12px;padding:4px 2px;font-size:15px;font-weight:bold;color:var(--ink)}
.mstat b{display:block;font-size:26px;color:var(--wine);font-family:var(--title);line-height:1.2}
#miniCv{width:100%;max-width:360px;height:auto;aspect-ratio:1/1;touch-action:none;display:block;margin:0 auto;border-radius:14px;background:#f4e6c8}
#miniMsg{min-height:30px;font-size:19px;font-weight:bold;color:var(--wine);margin-top:8px}
.gates{display:flex;gap:14px;justify-content:center;margin:8px 0 4px}
.gate{flex:1;max-width:160px;min-height:150px;border-radius:80px 80px 14px 14px;border:4px solid var(--gold);background:linear-gradient(#f4f9ff,#c9dcf7);font-size:44px;font-weight:bold;color:#2d3a6b;font-family:var(--title);box-shadow:0 4px 0 #b9a066}
.gate:active{transform:translateY(3px);box-shadow:0 1px 0 #b9a066}
.gate[disabled]{opacity:.55}
.ground{font-size:17px;font-weight:bold;color:#8a6a4a}
.pop{animation:popn .45s}
@keyframes popn{50%{transform:scale(1.3)}}
.mons{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:4px}
.mon{border:2px solid #e0c98e;border-radius:14px;background:#fffaf0;padding:4px 2px 6px;font-weight:bold;font-size:17px;color:var(--ink)}
.mon canvas{width:100%;height:auto;display:block}
.mon.me{background:linear-gradient(#fff,#fde9ef);border-color:#e07a8e}
.mon.boss{border-color:var(--wine);background:#fbe6ea}
.mon.gone{opacity:.25}
.mon.no{animation:shake .4s}
.mon .lv{font-size:20px;color:var(--wine)}
@keyframes shake{20%{transform:translateX(-7px)}60%{transform:translateX(7px)}}
#btnGoddess[data-n]:not([data-n=''])::after{content:attr(data-n);position:absolute;top:-6px;left:50%;transform:translateX(-50%);background:#b0365a;color:#fff;font-size:12px;font-weight:bold;border-radius:9px;padding:1px 7px;white-space:nowrap;box-shadow:0 1px 3px rgba(0,0,0,.3)}
#btnGoddess{pointer-events:auto;position:absolute;right:calc(14px + env(safe-area-inset-right));bottom:calc(18px + env(safe-area-inset-bottom));width:86px;height:86px;border-radius:50%;border:none;padding:5px;background:conic-gradient(#f2c94c var(--p,0%),rgba(255,255,255,.5) 0);box-shadow:0 3px 10px rgba(60,30,20,.4)}
#btnGoddess span{display:flex;align-items:center;justify-content:center;width:100%;height:100%;border-radius:50%;background:linear-gradient(#fffdf5,#f3e3c0);color:#b08a2e;font-weight:bold;font-size:15px;line-height:1.2;text-align:center}
#btnGoddess.ready span{background:radial-gradient(#fffbe6,#f7dd8a);color:var(--wine);animation:pulse 1s infinite}
#btnGoddess.active span{background:radial-gradient(#fff,#ffe9a6);color:#a0761c}
@keyframes pulse{50%{transform:scale(1.07)}}
#btnHelp{position:absolute;left:calc(12px + env(safe-area-inset-left));bottom:calc(18px + env(safe-area-inset-bottom))}
#verTag{position:absolute;left:calc(66px + env(safe-area-inset-left));bottom:calc(22px + env(safe-area-inset-bottom));font-size:12px;color:rgba(255,255,255,.9);text-shadow:0 1px 2px rgba(0,0,0,.6)}
#speedMeter{position:absolute;left:calc(66px + env(safe-area-inset-left));bottom:calc(40px + env(safe-area-inset-bottom));width:110px;height:10px;border-radius:6px;background:rgba(255,255,255,.6);border:1.5px solid var(--gold);overflow:hidden}
#speedMeter div{height:100%;width:0;background:linear-gradient(90deg,#9fd3c7,#f2c94c,#e07a8e)}
#hint{position:absolute;left:50%;top:58%;transform:translateX(-50%);width:min(88%,380px);background:rgba(255,250,240,.95);border:3px double var(--gold);border-radius:18px;padding:12px 14px;text-align:center;font-size:19px;line-height:1.5;font-weight:bold;box-shadow:0 4px 12px rgba(60,30,20,.35)}
#hint .finger{font-size:38px;display:inline-block;animation:swipe 1.6s ease-in-out infinite}
@keyframes swipe{0%{transform:translate(-40px,0)}50%{transform:translate(40px,-10px)}100%{transform:translate(-40px,0)}}
#caption{position:absolute;left:0;right:0;bottom:calc(120px + env(safe-area-inset-bottom));text-align:center;color:#fff;font-family:var(--title);font-weight:bold;font-size:30px;text-shadow:0 2px 0 var(--wine),0 0 14px rgba(120,40,60,.9);pointer-events:none}
#caption small{display:block;font-family:var(--ui);font-size:13px;margin-top:6px;text-shadow:0 1px 3px rgba(0,0,0,.7)}
#btnSkip{position:absolute;right:calc(14px + env(safe-area-inset-right));bottom:calc(30px + env(safe-area-inset-bottom));pointer-events:auto}
/* ---------- screens ---------- */
.screen{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:calc(14px + env(safe-area-inset-top)) 14px calc(14px + env(safe-area-inset-bottom));overflow-y:auto;-webkit-overflow-scrolling:touch}
.dim{background:rgba(50,30,40,.55)}
#scrWard,#scrSettings,#scrHelp{z-index:5}
#scrError{z-index:9}
.screen>.card{margin:auto 0;flex:none}
.card{width:min(100%,440px);background:linear-gradient(#fffaf0,#f6ead2);border:3px double var(--gold);border-radius:20px;padding:16px 16px 18px;box-shadow:0 6px 20px rgba(40,20,20,.45);text-align:center}
.card h2{font-family:var(--title);color:var(--wine);margin:2px 0 10px;font-size:26px}
.card p{font-size:18px;line-height:1.6;margin:6px 0}
.btn{display:block;width:100%;min-height:58px;margin:10px 0 0;border-radius:16px;border:2px solid var(--gold);background:linear-gradient(#c45a72,#8e2f45);color:#fff;font-size:21px;font-weight:bold;box-shadow:0 3px 0 #6b2234,0 4px 10px rgba(60,20,30,.3);letter-spacing:.04em}
.btn:active{transform:translateY(2px);box-shadow:0 1px 0 #6b2234}
.btn.sub{background:linear-gradient(#fffaf0,#f1e2c4);color:var(--wine);box-shadow:0 3px 0 #c9a24a}
.btn.small{min-height:48px;font-size:18px}
.btn[disabled]{opacity:.45}
#scrTitle{justify-content:flex-start;background:linear-gradient(180deg,#d9e5da 0%,#f3ead5 78%,#f7eee1 100%)}
#titleCard{margin-top:2px;background:rgba(255,250,240,.9);padding:3px 12px 4px!important;width:min(100%,400px)}
#titleCard .tline{display:flex;align-items:baseline;justify-content:center;gap:8px}
#titleCard h1{font-family:var(--title);color:var(--wine);font-size:32px;margin:0;letter-spacing:.06em;line-height:1.2;text-shadow:0 2px 0 #fff}
#titleCard .ver{font-size:14px;color:#7a5a3a;margin-top:0;font-weight:bold}
#titleCard .note{font-size:11px;color:#8a6a4a;margin-top:0;line-height:1.3}
#titleChar{flex:1 1 0;min-height:100px;width:100%;min-width:0;display:block;object-fit:contain;margin:4px 0 2px;filter:drop-shadow(0 6px 6px rgba(40,30,20,.35));animation:bob 2.6s ease-in-out infinite;touch-action:none;user-select:none;-webkit-user-select:none;cursor:grab}
#titleChar.dragging{cursor:grabbing}
/* Common title zoom, independent of costume and hidden command. */
#scrTitle{position:absolute;inset:0;isolation:isolate;overflow:hidden}
#scrTitle::before{content:'';position:absolute;inset:0;background-image:var(--title-bg);background-position:center 38%;background-size:cover;background-repeat:no-repeat;transform:translate3d(var(--title-pan-x,0px),var(--title-pan-y,0px),0) scale(var(--title-zoom,1));transform-origin:50% 44%;pointer-events:none;z-index:0;will-change:transform}
#titleCard,#titleChar,#titleBtns{position:relative;z-index:1}
/* v8.3.16: 拡大・縮小は 2本指のピンチ（スライダーは廃止）。タイトル画面では ブラウザ自体の拡大を止める。 */
#scrTitle{touch-action:none}

@keyframes bob{50%{transform:translateY(-6px)}}
#titleBtns{width:min(100%,440px);margin-top:0;flex:none}
#titleBtns .btn{margin-top:6px;min-height:52px}
#titleBtns .btn.small{min-height:44px}
#titleBtns .row{gap:6px}
#titleBtns #btnTutorial,#titleBtns #btnWalk{min-height:36px;height:36px;padding:0 4px;font-size:18px;line-height:1.15;border-radius:12px}
#scrTitle{padding-bottom:calc(10px + env(safe-area-inset-bottom));min-height:0;overflow:hidden}
#titleCard,#titleBtns{flex-shrink:0}
#titleBtns{max-width:100%}
@media (max-height:640px){
 #titleCard{padding:3px 8px!important}
 #titleCard h1{font-size:clamp(22px,6.5vw,30px)}
 #titleBtns .btn{min-height:42px;font-size:clamp(18px,5vw,23px);margin-top:4px}
 #titleBtns .btn.small{min-height:37px;font-size:clamp(14px,4vw,18px)}
 #titleBtns .row{gap:3px}
 #titleBtns #btnTutorial,#titleBtns #btnWalk{min-height:32px;height:32px;font-size:16px}
 #scrTitle{padding-top:calc(5px + env(safe-area-inset-top));padding-bottom:calc(5px + env(safe-area-inset-bottom))}
}
.seg{display:flex;gap:6px;margin:6px 0 4px}
.seg button{flex:1;min-height:52px;border-radius:14px;border:2px solid var(--gold);background:#fffaf0;color:var(--ink);font-size:19px;font-weight:bold}
.seg button.on{background:linear-gradient(#f7dd8a,#e6bf5a);color:#5a3a10}
.stage{display:flex;align-items:center;gap:10px;width:100%;min-height:60px;margin:7px 0 0;padding:8px 12px;border-radius:16px;border:2px solid var(--gold);background:linear-gradient(#fffaf0,#f3e5c8);color:var(--ink);text-align:left;font-size:19px;font-weight:bold;box-shadow:0 3px 0 #c9a24a}
.stage canvas{flex:none;width:84px;height:47px;border-radius:8px;border:1.5px solid #e0c98e;background:#efe3c8}
.stage .no{flex:none;width:40px;height:40px;border-radius:50%;background:var(--wine);color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px}
.stage .nm{flex:1}
.stage .nm small{display:block;font-size:14px;color:#8a6a4a;font-weight:normal}
.stage .st{flex:none;color:#d4a017;font-size:22px}
.stage[disabled]{opacity:.5}
#wardPrev{display:block;margin:0 auto;height:min(30vh,220px)}
#wardInfo{min-height:52px;font-size:17px;line-height:1.45}
#wardGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:8px}
.cos{border:2px solid #e0c98e;border-radius:14px;background:#fffaf0;padding:4px 2px 6px;font-size:13px;font-weight:bold;color:var(--ink);line-height:1.25}
.cos canvas{width:100%;height:auto;display:block}
.cos.on{border-color:var(--wine);background:#fbe6ea;box-shadow:0 0 0 2px var(--wine)}
.cos.lock{opacity:.75}
.row{display:flex;gap:8px}
.row .btn{flex:1}
.set{text-align:left;margin:10px 0 0;font-size:17px;font-weight:bold}
.set input[type=range]{width:100%;height:34px;accent-color:#8e2f45}
.set .v{float:right;color:var(--wine)}
.set small{display:block;font-weight:normal;color:#7a5a3a;font-size:14px}
.chk{display:flex;align-items:center;gap:10px;margin:12px 0 0;font-size:17px;font-weight:bold;text-align:left}
.chk input{width:28px;height:28px;accent-color:#8e2f45}
.help{text-align:left;font-size:18px;line-height:1.65;margin:0;padding-left:1.2em}
.help li{margin:6px 0}
#defeatImg{display:block;margin:0 auto;height:min(36vh,280px)}
.bubble{position:relative;background:#fff;border:2px solid var(--ink);border-radius:16px;padding:10px 12px;font-size:19px;line-height:1.5;font-weight:bold;margin:6px 0 4px;text-align:left}
.bubble:after{content:"";position:absolute;left:50%;top:-12px;margin-left:-10px;border:10px solid transparent;border-bottom-color:var(--ink);border-top:0}
#clearCat{width:96px;height:96px;display:block;margin:0 auto}
#loadBar{width:80%;height:14px;margin:10px auto 0;border:2px solid var(--gold);border-radius:8px;overflow:hidden;background:#fff}
#loadBar div{height:100%;width:0;background:linear-gradient(90deg,#f2c94c,#c45a72)}
#errList{font-size:14px;text-align:left;word-break:break-all;max-height:30vh;overflow:auto;background:#fff;border-radius:10px;padding:8px}
.hlabel{align-self:center;font-size:13px;font-weight:bold;color:#fff;background:#e07a8e;border-radius:8px;padding:1px 7px;margin-right:2px}
.hshield{align-self:center;color:#e9b93a;font-size:22px;line-height:1;text-shadow:0 0 6px #fff,0 0 2px #fff}
#portrait.bare{border-color:#fff;box-shadow:0 0 0 3px #f19bb5,0 2px 6px rgba(60,30,20,.35)}
.goal.bare{font-size:15px;white-space:normal;background:linear-gradient(#fff,#ffe3ea);border-color:var(--wine);color:var(--wine);animation:pulse 1.1s infinite}
#tutCard{position:relative;align-self:center;margin-top:6px;width:min(94%,430px);background:rgba(255,250,240,.94);border:2px solid var(--gold);border-radius:14px;padding:4px 10px 6px;box-shadow:0 4px 12px rgba(60,30,20,.35);pointer-events:auto;text-align:center}
#tutCard .tstep{font-size:12px;color:#8a6a4a;font-weight:bold;line-height:1.3}
#tutCard .ttext{font-size:16px;line-height:1.4;font-weight:bold;color:var(--ink);margin-top:1px}
#tutCard .tbar{height:6px;border-radius:4px;background:#f0e2c8;margin-top:4px;overflow:hidden}
#tutCard .tbar div{height:100%;width:0;background:linear-gradient(90deg,#f2c94c,#c45a72);transition:width .2s}
#tutCard .trow{display:flex;gap:6px;margin-top:4px}
#tutCard .trow .btn{margin-top:0;min-height:36px;font-size:15px;border-radius:12px}
#tutCard.ok{border-color:#e6bf5a;background:rgba(255,248,214,.97)}
.badge{display:inline-block;font-size:13px;background:#e07a8e;color:#fff;border-radius:9px;padding:1px 8px;margin-left:6px;vertical-align:middle}
.mtabs{display:flex;flex-wrap:wrap;gap:6px;margin:2px 0 8px}
.mtabs button{flex:1 1 28%;min-height:44px;border-radius:12px;border:2px solid var(--gold);background:#fffaf0;color:var(--ink);font-size:16px;font-weight:bold;padding:2px}
.mtabs button.on{background:linear-gradient(#f7dd8a,#e6bf5a);color:#5a3a10}
#manBody{text-align:left;font-size:18px;line-height:1.65}
#manBody h3{font-family:var(--title);color:var(--wine);font-size:20px;margin:14px 0 4px}
#manBody p{font-size:17px;margin:4px 0;line-height:1.6}
#manBody ul{margin:2px 0;padding-left:1.2em}
#manBody li{margin:5px 0;font-size:17px}
.mrow{display:flex;gap:10px;align-items:center;margin:8px 0;padding:6px 8px;background:rgba(255,255,255,.65);border-radius:12px;border:1px solid #eedcb6}
.mrow canvas{flex:none;width:70px;height:auto}
.mrow .mi{flex:none;min-width:70px;text-align:center}
.mrow .mt{flex:1;font-size:16px;line-height:1.5}
 .mrow .mt b{font-size:17px;color:var(--wine)}
/* Wardrobe manual: make character artwork readable on a phone. Keep other manual tabs compact. */
#manBody .mrow.manualCostume{display:flex;flex-direction:column;align-items:center;gap:3px;padding:12px 12px 14px}
#manBody .mrow.manualCostume .manualCostumePic{display:flex;align-items:center;justify-content:center;align-self:center;padding:0;margin:0;width:100%;max-width:none;background:transparent;border:0;border-radius:10px;cursor:zoom-in}
#manBody .mrow.manualCostume .manualCostumePic canvas{display:block;width:100%;height:auto;max-width:100%;flex:none;image-rendering:auto}
#manBody .mrow.manualCostume .manualCostumePic:focus-visible{outline:3px solid var(--wine);outline-offset:2px}
#manBody .mrow.manualCostume .mt{width:100%;text-align:left;font-size:17px;line-height:1.5}
#manBody .mrow.manualCostume .mt>b{font-size:20px}
/* v8.3.18: マニュアルの衣装の絵は、タイトルと同じ原寸の絵（劣化なし）。小さな一覧用サムネイルの引きのばしをやめた。 */
/* v8.3.20: iPhone の Safari で 右側が 切れないよう、絵は「わくの中に おさめる」背景画像で表示（ボタンは flex を使わない） */
#manBody .mrow.manualCostume .manualCostumePic .manualTitleArt{display:block;box-sizing:border-box;width:100%;max-width:100%;min-width:0;height:min(54vh,440px);background-repeat:no-repeat;background-position:50% 100%;background-size:contain}
#manBody .manualLookHint{text-align:center;font-size:12px;color:#8c6b55;line-height:1.2}
/* v8.3.30: マニュアルは正面の原画立ち絵のみ。 */

.pair{display:flex;justify-content:center;align-items:flex-end;gap:4px;margin:6px 0}
.pair canvas{width:96px;height:auto}
.pair .arw{font-size:30px;color:var(--wine);padding-bottom:40px;font-weight:bold}
.tiers{display:flex;gap:2px;flex:none}
.tiers canvas{width:52px;height:auto}
@keyframes dots{0%{content:''}25%{content:'.'}50%{content:'..'}75%{content:'...'}}
.ldots:after{content:'';animation:dots 1.2s steps(1) infinite}
</style>

<style id="v83">
.ptsBar{flex:0 0 auto;font-size:16px;font-weight:bold;color:#5a3a2a;background:linear-gradient(#fff8e2,#f8e8c0);border:2px solid #e3c47a;border-radius:12px;padding:2px 10px;margin:0 0 4px;text-align:center}
.ptsBar b{color:var(--wine);font-size:21px;margin-left:2px}
.cos .cn{font-size:13px;line-height:1.25}
.cos .cq{font-size:12px;color:#7a5a3a;margin-top:2px;line-height:1.2;font-weight:bold}
.cos .cq.pt{color:#a0405a}
.cos.locked canvas{filter:brightness(0) opacity(.22)!important}
.cos.locked .cn{color:#9a8a7a}
#wardInfo .wa{font-size:15px;line-height:1.35}
#wardInfo .wk{color:#6a3a50;font-size:14px}
#wardInfo .wq,.mrow .mq{margin-top:3px;font-size:14px;font-weight:bold;color:#7a4a20;background:#fbf0d8;border:1px solid #ead29a;border-radius:8px;padding:1px 7px;display:inline-block}
.mrow .mt .mk{display:block;font-size:14px;color:#6a3a50}
.mrow.locked canvas{filter:brightness(0) opacity(.22)}
.recPts{font-size:17px;font-weight:bold;text-align:center;margin:6px 0;padding:6px;border-radius:12px;background:linear-gradient(#fff8e2,#f8e8c0);border:2px solid #e3c47a;color:#5a3a2a}
.recPts b{font-size:26px;color:var(--wine)}
</style>

<style id="long-menu-fix">
#scrWard,#scrHelp{overflow:hidden!important;padding:calc(6px + env(safe-area-inset-top)) 8px calc(6px + env(safe-area-inset-bottom))!important;justify-content:center}
#scrWard>.card,#scrHelp>.card{display:flex;flex-direction:column;min-height:0;max-height:100%;overflow:hidden;margin:0!important;flex:0 1 auto;width:min(100%,480px)}
.wardHead{display:flex;align-items:center;justify-content:space-between;gap:8px;flex:0 0 auto}
.wardHead h2{margin:0 0 4px!important;font-size:22px!important}
.wardHead .btn{width:auto;min-height:42px;padding:5px 12px;margin:0 0 4px!important;flex-shrink:0;font-size:17px}
#scrWard .wardTop{display:flex;flex-direction:column;align-items:center;flex:0 0 auto;min-height:0}
#scrWard #wardPrev{height:clamp(150px,32dvh,360px)!important;max-height:none;width:auto;max-width:100%;flex:0 0 auto;margin:0 auto}
@media (max-height:700px){#scrWard .wardTop{flex-direction:row;align-items:center;gap:6px}
 #scrWard #wardPrev{height:clamp(120px,33dvh,230px)!important;max-width:46%;margin:0}
 #scrWard .wardTop #wardInfo{flex:1 1 auto;text-align:left;max-height:clamp(120px,33dvh,230px)!important;font-size:14px}}
#scrWard #wardInfo{flex:0 0 auto;max-height:98px;overflow-y:auto;line-height:1.3;font-size:15px}
#scrWard .wardSummary{display:flex;align-items:center;justify-content:space-between;gap:5px;flex-wrap:wrap;line-height:1.15;margin:0 0 2px}
#scrWard .wardPtsInline{margin-left:auto;border:1px solid #e3c47a;border-radius:10px;background:#fff6df;padding:1px 7px;font-size:12px;font-weight:700;white-space:nowrap;color:#8e2f45}
#scrWard #wardGrid{margin-top:4px}
#scrWard #wardPinchStage{height:clamp(160px,43dvh,520px);width:min(100%,490px);max-width:100%;flex:none;overflow:hidden;touch-action:none;user-select:none;-webkit-user-select:none}
#scrWard #wardPrev{width:100%!important;height:100%!important;max-width:none!important;margin:0!important;transform-origin:center;transform:none}
@media(max-height:700px){#scrWard #wardPinchStage{max-width:54%;height:clamp(160px,43dvh,320px)}}
.pinchHint{font-size:11px;line-height:1.2;text-align:center;flex:none;color:inherit;margin:1px 0}
#scrWard #wardGrid{flex:1 1 auto;min-height:55px;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
#scrWard #btnWardOk{flex:0 0 auto;min-height:52px;margin-top:6px}
#scrHelp #manTabs{flex:0 0 auto;max-height:100px;overflow-y:auto}
#scrHelp #manBody{flex:1 1 auto;min-height:55px;overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain}
#scrHelp #btnHelpOk{flex:0 0 auto;min-height:50px;margin-top:6px}
/* v8.3.30 direct native artwork, no rotation modal. */
#manBody .mrow.manualCostume .manualCostumePic{width:calc(100% - 20px);height:clamp(300px,65dvh,760px);overflow:hidden;touch-action:none;user-select:none;cursor:grab;display:flex;align-items:center;justify-content:center}
#manBody .mrow.manualCostume .manualCostumePic .manualTitleArt{display:block;width:100%;height:100%;object-fit:contain;transform-origin:center;pointer-events:none;max-width:none}
#manBody .mrow.manualCostume{padding:5px 7px 10px}
#segBase{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:3px}#segBase.hidden{display:none}#segBase button{white-space:normal;min-width:0}
</style>
<style id="v01-layout">
#titleCard{padding:2px 6px 3px!important;margin-top:0}
#titleCard .tline{gap:5px;flex-wrap:nowrap;white-space:nowrap}
#titleCard h1{font-size:clamp(19px,6.6vw,30px);letter-spacing:.015em;white-space:nowrap;line-height:1.12}
#titleCard .ver{white-space:nowrap;font-size:12px;flex:none}
#titleCard .note{font-size:10px;line-height:1.15}
#titleChar{margin:1px 0;min-height:90px}
#segBase button{white-space:nowrap;letter-spacing:0;font-size:clamp(12px,3.7vw,16px);padding:3px 2px}
#scrWard>.card{height:100%;padding:7px 8px}
#scrWard #wardGrid{gap:4px;min-height:70px;grid-template-columns:repeat(4,minmax(0,1fr))}
#scrWard #wardGrid .cos{min-width:0;padding:3px 1px}
#scrWard #wardInfo{width:100%;max-height:91px;min-height:45px}
#scrWard #wardPinchStage{height:clamp(150px,51dvh,630px)}
@media(max-height:700px) and (orientation:portrait){#scrWard .wardTop{flex-direction:column}#scrWard #wardPinchStage{max-width:100%;height:clamp(140px,44dvh,340px)}#scrWard .wardTop #wardInfo{max-height:80px!important;flex:0 0 auto}}
@media(orientation:landscape) and (max-height:550px){#scrWard #wardPinchStage{height:40dvh;min-height:100px}}
#manBody .mrow.manualCostume .manualCostumePic{width:100%;touch-action:pan-y;cursor:zoom-in}
#manBody .mrow.manualCostume .manualCostumePic:focus-visible{outline:3px solid var(--wine)}
#manBody .manualFoe{flex-direction:column;align-items:stretch}
#manBody .manualFoe .tiers{justify-content:center;flex-wrap:wrap}
#manBody canvas.manualZoomArt{display:block;width:min(100%,230px)!important;height:auto;margin:0 auto;cursor:zoom-in;touch-action:pan-y}
#manBody .tiers canvas.manualZoomArt{width:31%!important;max-width:145px;margin:0}
#artViewer{position:fixed;inset:0;z-index:9999;background:#f5e9d8;color:var(--ink);display:flex;flex-direction:column;padding:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);overflow:hidden;overscroll-behavior:none}
#artViewer.hidden{display:none!important}
#artViewerBar{display:flex;align-items:center;justify-content:space-between;gap:8px;flex:none;padding:0 4px}
#artViewerName{font-weight:bold;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:15px}
#artViewerClose{min-height:44px;min-width:86px;margin:0;width:auto}
#artViewerStage{position:relative;display:flex;align-items:center;justify-content:center;flex:1;min-height:0;width:100%;overflow:hidden;touch-action:none;user-select:none;-webkit-user-select:none;overscroll-behavior:none}
#artViewerImage{display:block;flex:none;max-width:none;max-height:none;object-fit:contain;transform-origin:center;pointer-events:none;-webkit-user-drag:none}
#artViewerStage[data-loading="1"] #artViewerImage{visibility:hidden}
#artViewerStatus{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none;font-size:14px;color:var(--ink)}
#artViewerStatus:empty{display:none}
#artViewerBar{min-height:44px}
#artViewerReset{width:auto;min-width:44px;min-height:44px;margin:0;padding:4px 7px;white-space:nowrap;font-size:12px}
#artViewerName{flex:1;min-width:0;white-space:normal;overflow-wrap:anywhere;line-height:1.25;font-size:clamp(12px,3.7vw,15px)}
#manBody .manualCostume .mt[data-art-tap]{cursor:zoom-in;touch-action:pan-y}
</style>

<style id="v01-integrated-layout">
#scrWard>.card,#scrHelp>.card{height:100%;flex:1 1 0;min-height:0;max-height:100%;padding:6px 8px;box-sizing:border-box}
#scrWard .wardTop{flex:1 1 0;min-height:0;width:100%;align-items:stretch;overflow:hidden}
#scrWard #wardPinchStage{flex:1 1 0;width:100%;max-width:100%;height:auto;min-height:0;position:relative}
#scrWard #wardPrev{position:absolute;inset:0}
#scrWard #wardInfo,#scrWard .wardTop #wardInfo{flex:0 0 auto;min-height:0;max-height:clamp(45px,11dvh,88px)!important;overflow:auto;margin:2px 0;width:100%;font-size:13px}
#scrWard #wardGrid{display:flex;flex:0 0 auto;align-items:stretch;gap:6px;min-height:0;width:100%;overflow-x:auto;overflow-y:hidden;padding:3px 3px 7px;scrollbar-width:thin;overscroll-behavior-x:contain;touch-action:pan-x}
#scrWard #wardGrid .cos{flex:0 0 clamp(70px,21vw,92px);min-width:0;padding:3px;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;box-sizing:border-box}
#scrWard #wardGrid .cos canvas{width:100%;height:auto;max-height:76px;object-fit:contain;flex:none}
#scrWard #wardGrid .cn{font-size:12px;line-height:1.15;overflow-wrap:anywhere}
#scrWard #wardGrid .cq{font-size:10px;line-height:1.1}
#scrWard #btnWardOk,#scrHelp #btnHelpOk{min-height:44px;margin-top:3px;padding:3px 8px}
#scrHelp #manTabs{flex:0 0 auto;flex-wrap:nowrap;overflow-x:auto;overflow-y:hidden;gap:4px;max-height:none;margin:2px 0 4px;padding-bottom:3px;scrollbar-width:thin;touch-action:pan-x}
#scrHelp #manTabs button{flex:0 0 auto;min-height:40px;padding:3px 9px;font-size:14px;white-space:nowrap}
#scrHelp #manBody{flex:1 1 0;min-height:0;overflow-y:auto;padding:0 1px}
#manBody .mrow.manualCostume .manualCostumePic{height:clamp(130px, var(--manual-art-h, 58vh), 760px);width:100%}
#manBody .mrow.manualCostume .manualTitleArt{object-fit:contain}
#manBody .manualFoe .tiers,#manBody .bossPair,#manBody .guardPair{display:flex;align-items:center;justify-content:flex-start;gap:6px;flex-wrap:nowrap;width:100%;overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:thin}
#manBody .bossPair canvas.manualZoomArt{width:calc(50% - 3px)!important;min-width:110px;max-width:none;flex:0 0 auto;margin:0}
#manBody .tiers canvas.manualZoomArt{width:calc((100% - 12px)/3)!important;min-width:85px;max-width:none;flex:0 0 auto;margin:0}
#manBody .guardPair .guardArt{width:calc((100% - 28px)/2);min-width:110px;flex:none;display:flex;flex-direction:column;align-items:center;gap:3px;text-align:center;font-size:13px}
#manBody .guardPair img{width:100%;height:clamp(120px,35dvh,320px);object-fit:contain;cursor:zoom-in}
#manBody .guardPair .arw{flex:none;padding:0;font-size:22px}
#artViewerNav{display:flex;flex:0 0 auto;align-items:center;gap:5px;padding:3px 6px;justify-content:center}
#artViewerNav .btn{min-height:42px;flex:1 1 auto;white-space:nowrap;font-size:13px;padding:3px 5px;margin:0;width:auto}
#artViewerNav.hidden{display:none!important}
#segBase button{white-space:nowrap;font-size:clamp(11px,3.4vw,16px);min-width:0;padding:2px 1px}
@media(max-height:550px){#scrWard,#scrHelp{padding:calc(2px + env(safe-area-inset-top)) 4px calc(2px + env(safe-area-inset-bottom))!important}#scrWard>.card,#scrHelp>.card{padding:3px 5px}.wardHead h2{font-size:18px!important}.wardHead .btn{min-height:40px;margin-bottom:0!important}#scrWard #wardInfo{font-size:12px}#scrHelp #btnHelpOk{display:none}#titleBtns .btn{min-height:42px;margin-top:3px}#titleChar{min-height:0}}
@media(orientation:landscape) and (max-height:550px){#scrWard>.card,#scrHelp>.card{width:min(100%,850px)}#scrWard .wardTop{flex-direction:row;align-items:stretch}#scrWard #wardPinchStage{flex:1 1 0;max-width:none}#scrWard .wardTop #wardInfo{flex:0 0 35%;max-height:100%!important;width:35%;text-align:left}#scrWard #wardGrid .cos{flex-basis:76px}#scrWard #wardGrid .cos canvas{max-height:55px}}
</style>
</head>
<body>
<div id="game">
<canvas id="cv"></canvas>

<div id="hud" class="hidden">
  <div id="hudFlow">
  <div id="hudTop">
    <div id="portrait"><canvas id="faceCv" width="128" height="128"></canvas></div><canvas id="catIco" width="64" height="64" class="hidden"></canvas>
    <div id="hudMid"><div id="hearts"></div>
      <div id="gaugeWrap"><div id="gaugeBar"><div id="gauge"></div></div><span>女神</span></div></div>
    <button id="btnPause" class="roundBtn" aria-label="メニュー">≡</button>
  </div>
  <div id="goalRow"><div id="goals"></div>
  <div id="bossBar" class="hidden"><span id="bossName"></span><div class="bar"><div id="bossHp"></div></div></div></div>
  <div id="fmPanel" class="hidden"><div id="fmTitle"></div><div id="fmStats"></div><button class="btn sub small" id="fmQuit">やめる</button></div>
  <div id="tutCard" class="hidden"><div class="tstep" id="tutStep"></div><div class="ttext" id="tutText"></div><div class="tbar"><div id="tutBar"></div></div>
    <div class="trow" id="tutBtns"></div></div>
  <div id="banner"></div>
  </div>
  <div id="hint" class="hidden"><div class="finger">👆</div>画面を指で なぞってみてね<br><span style="font-size:16px;font-weight:normal">大きく動かすと はやく、小さく動かすと ゆっくり</span></div>
  <button id="btnGoddess" class="hidden"><span>女神<br>へんしん</span></button>
  <button id="btnHelp" class="roundBtn small">？</button>
  <div id="speedMeter" class="hidden"><div></div></div>
  <div id="verTag"></div>
  <div id="caption" class="hidden"></div>
  <button id="btnSkip" class="btn sub small hidden" style="width:auto;padding:0 18px">とばす ▶</button>
</div>

<div id="jumpOv" class="hidden"><img id="jumpImg" alt=""><div id="jumpCap"></div><button id="btnJumpSkip" class="btn sub small">とばす ▶</button></div>
<!-- loading -->
<div id="scrLoad" class="screen" style="background:#f6efe2">
  <div class="card"><h2>やっこの冒険</h2><p><span id="loadMsg">絵を よみこんでいます</span><span class="ldots"></span></p><div id="loadBar"><div></div></div>
  <p style="font-size:14px;color:#8a6a4a">はじめては 少し 時間が かかります</p></div>
</div>
<!-- error -->
<div id="scrError" class="screen dim hidden"><div class="card"><h2>読み込みエラー</h2>
  <p>絵の データを よみこめませんでした。<br>index.html が 最後まで 保存（アップロード）されているか 確認してください。</p>
  <div id="errList"></div><button class="btn" id="btnErrOk">このまま つづける</button></div></div>
<!-- title -->
<div id="scrTitle" class="screen hidden">
  <div class="card" id="titleCard"><div class="tline"><h1>やっこの冒険</h1><div class="ver" id="titleVer"></div></div>
    <div class="note">本作品は非公式の二次創作ゲームです。</div></div>
  <canvas id="titleChar" width="520" height="520" aria-label="2本指のピンチで拡大・縮小、1本指で上下左右に動かせます"></canvas>
  <div id="titleBtns">
    <button class="btn" id="btnAdventure">冒険にでる</button>
    <div class="row"><button class="btn sub" id="btnTutorial">れんしゅう</button><button class="btn sub" id="btnWalk">おさんぽ</button></div>
    <button class="btn sub hidden" id="btnJournal">📖 旅日記（おはなしをよむ）</button>
    <div class="row row4"><button class="btn sub small" id="btnWardrobe">衣装</button><button class="btn sub small" id="btnRecordT">きろく帳</button><button class="btn sub small" id="btnSettingsT">せってい</button><button class="btn sub small" id="btnHelpT">マニュアル</button></div>
  </div>
</div>
<!-- stage select -->
<div id="scrStages" class="screen dim hidden"><div class="card"><h2>ステージをえらぶ</h2><div id="starRow"></div>
  <div style="font-weight:bold;font-size:17px;text-align:left">むずかしさ</div>
  <div class="seg"><button data-d="easy">のんびり</button><button data-d="normal">ふつう</button></div>
  <div class="mtabs" id="chapTabs"></div>
  <div id="stageList"></div>
  <button class="btn sub small" id="btnStagesBack">もどる</button></div></div>
<!-- wardrobe -->
<div id="scrWard" class="screen dim hidden"><div class="card"><div class="wardHead"><h2>衣装をえらぶ</h2><button class="btn sub small" id="btnWardBackTop">もどる</button></div>
  <div class="wardTop"><div id="wardPinchStage"><canvas id="wardPrev" width="782" height="830" aria-label="左右にドラッグで回転、2本指で拡大・縮小、拡大中は移動"></canvas></div>
  <div id="wardInfo"></div></div>
  <div id="wardGrid"></div>
  <button class="btn" id="btnWardOk">これに きめる</button></div></div>
<!-- settings -->
<div id="scrSettings" class="screen dim hidden"><div class="card"><h2>せってい</h2>
  <div class="set">衣装が とれるまでの ダメージ<small>自動 ＝ ふつう 3回・のんびり 5回（つぎに はじめるときから）</small></div>
  <div class="seg" id="segGuard"><button data-g="auto">自動</button><button data-g="3">3回</button><button data-g="5">5回</button></div>
  <div class="set hidden" id="setBaseLbl">素体の絵<small>衣装の力を うばわれたときの すがた</small></div>
  <div class="seg hidden" id="segBase"><button data-b="B">シンプル</button><button data-b="A">リボン</button><button data-b="W">水彩</button><button data-b="N">淡彩</button><button data-b="P">ピンク</button><button data-b="ynew5_satin">白絹のスケート</button><button data-b="ynew5_braid">桜色の三つ編み</button><button data-b="ynew5_long">桜の長三つ編み</button></div>
  <div class="set">音楽（BGM）</div>
  <div class="seg" id="segBgm"><button data-v="0">なし</button><button data-v="1">小</button><button data-v="2">中</button><button data-v="3">大</button></div>
  <div class="set">効果音</div>
  <div class="seg" id="segSe"><button data-v="0">なし</button><button data-v="1">小</button><button data-v="2">中</button><button data-v="3">大</button></div>
  <div class="set" style="margin-top:14px">すべる速さの 調整</div>
  <div id="setList"></div>
  <label class="chk"><input type="checkbox" id="chkMeter">速度メーターを表示（調整用）</label>
  <label class="chk"><input type="checkbox" id="chkSleep">止まっていると居眠りする</label>
  <label class="chk"><input type="checkbox" id="chkStory">ステージの おはなしを 毎回 表示する</label>
  <label class="chk"><input type="checkbox" id="chkAll">全ステージ・全衣装・旅日記を選べる（確認用）</label>
  <div class="row"><button class="btn sub small" id="btnSetReset">速さを 初期値にもどす</button></div>
  <button class="btn warn small" id="btnWipe">最初から やり直す（記録を けす）</button>
  <button class="btn" id="btnSetOk">とじる</button></div></div>
<div id="scrConfirm" class="screen dim hidden"><div class="card"><h2>最初から やり直しますか？</h2>
  <p style="font-size:17px;line-height:1.6;margin:4px 0">クリアした ステージ・ベストタイム・手に入れた 衣装・星のかけら・スタンプ・おはなしの 記録が ぜんぶ 消えて、ステージ1から はじまります。<br><small>（きねん写真と、すべる速さ・音 などの せっていは そのままです）</small></p>
  <button class="btn" id="btnWipeYes">やり直す</button><button class="btn sub" id="btnWipeNo">やめる</button></div></div>
<!-- manual -->
<div id="scrHelp" class="screen dim hidden"><div class="card"><div class="wardHead"><h2>マニュアル</h2><button class="btn sub small" id="btnHelpCloseTop">とじる</button></div>
  <div class="mtabs" id="manTabs"></div>
  <div id="manBody"></div>
  <button class="btn" id="btnHelpOk">とじる</button></div></div>
<!-- pause -->
<div id="scrPause" class="screen dim hidden"><div class="card"><h2>ひと休み</h2>
  <button class="btn" id="btnResume">つづける</button>
  <button class="btn sub" id="btnPWard">衣装をかえる</button>
  <button class="btn sub" id="btnPScene">けしきをかえる</button>
  <button class="btn sub hidden" id="btnPPhoto">📷 きねん写真を とる</button>
  <div class="row"><button class="btn sub small" id="btnPHelp">マニュアル</button><button class="btn sub small" id="btnPSet">せってい</button></div>
  <button class="btn sub small" id="btnQuit">タイトルへもどる</button></div></div>
<div id="storyDim" class="hidden"></div>
<div id="storyWin" class="hidden"><div id="storyHead"></div><div id="storyRow"><canvas id="storyFace" width="160" height="160"></canvas><div><div id="storyName"></div><div id="storyText"></div></div></div>
  <button class="btn" id="btnStoryNext">つぎへ ▶</button></div>
<div id="scrPoster" class="screen hidden"><div id="posterBox"><img id="posterImg" alt="やっこの冒険 ポスター"></div>
  <div id="posterBtns"><button class="btn" id="posterGo">タイトルへ すすむ ▶</button></div></div>
<div id="scrReady" class="screen dim hidden"><div class="card"><div id="readyHead"></div>
  <div class="readyRow"><canvas id="readyFace" width="160" height="160"></canvas><div id="readyText"></div></div>
  <div class="readyCos"><canvas id="readyCos" width="230" height="244"></canvas><div id="readyCosName"></div></div>
  <button class="btn" id="btnReadyGo">このまま しゅっぱつ ▶</button>
  <button class="btn sub" id="btnReadyWard">衣装を えらぶ</button>
  <button class="btn sub small" id="btnReadyBack">もどる</button></div></div>
<div id="toast" class="hidden"></div>
<div id="scrRecord" class="screen dim hidden"><div class="card"><h2>きろく帳</h2>
  <div class="mtabs" id="recTabs"></div><div id="recBody"></div>
  <button class="btn" id="btnRecOk">とじる</button></div></div>
<div id="scrStamp" class="screen dim hidden"><div class="card"><h2 id="stampTitle">きょうの スタンプ</h2>
  <div class="stampTop"><canvas id="stampCat" width="160" height="160"></canvas><div id="stampMsg"></div></div>
  <div id="stampCard"></div><div id="stampInfo"></div>
  <button class="btn" id="btnStampOk">やったー！</button></div></div>
<div id="scrPhoto" class="screen dim hidden"><div class="card"><h2>きねん写真</h2><img id="photoImg" alt="きねん写真">
  <p class="photoTip">長おしで 写真に 保存できます</p>
  <div class="row"><button class="btn" id="btnPhotoShare">保存・おくる</button><button class="btn sub hidden" id="btnPhotoDel">けす</button></div>
  <button class="btn sub small" id="btnPhotoOk">とじる</button></div></div>
<!-- journal -->
<div id="scrJournal" class="screen hidden"><div class="card jcard"><div id="jPage"></div>
  <div class="jnav"><div class="row"><button class="btn sub" id="jPrev">◀ まえへ</button><button class="btn" id="jNext">つぎへ ▶</button></div>
  <button class="btn sub small" id="jBack">もどる</button></div></div></div>
<!-- mini game -->
<div id="scrMini" class="screen dim hidden"><div class="card"><h2 id="miniTitle"></h2>
  <div id="miniRule"></div><div id="miniTop"></div><div id="miniBody"></div><div id="miniMsg"></div><div id="miniBtns"></div></div></div>
<!-- clear -->
<div id="scrClear" class="screen dim hidden"><div class="card"><h2 id="clearTitle">ステージクリア！</h2>
  <canvas id="clearCat" width="260" height="260"></canvas>
  <p id="clearText"></p>
  <div id="newCos" class="hidden"><div class="nt">新しい衣装を 手に入れた！</div><canvas id="newCosCv" width="230" height="244"></canvas><div id="newCosName"></div><button class="btn small" id="btnNewCos">着てみる</button></div>
  <button class="btn" id="btnNext">つぎのステージへ</button>
  <button class="btn sub" id="btnRetryC">もう一度あそぶ</button>
  <div class="row"><button class="btn sub small" id="btnPhoto" style="flex:0 0 36%;white-space:nowrap">📷 写真</button><button class="btn sub small" id="btnSelC" style="white-space:nowrap">ステージをえらぶ</button></div></div></div>
<!-- defeat -->
<div id="scrDefeat" class="screen dim hidden"><div class="card"><h2>ざんねん…！</h2>
  <canvas id="defeatImg" width="460" height="488"></canvas>
  <div class="bubble" id="defeatLine"></div>
  <button class="btn" id="btnRetry">もう一度挑戦</button>
  <button class="btn sub" id="btnRetryEasy">のんびりモードで挑戦</button>
  <button class="btn sub small" id="btnSelD">ステージ選択</button></div></div>
</div>

<div id="artViewer" class="hidden" role="dialog" aria-modal="true" aria-labelledby="artViewerName"><div id="artViewerBar"><span id="artViewerName"></span><button class="btn sub small" id="artViewerReset" aria-label="元の倍率に戻す">100%</button><button class="btn sub small" id="artViewerClose">とじる</button></div><div id="artViewerStage" data-loading="1"><img id="artViewerImage" alt="" draggable="false"><span id="artViewerStatus" role="status"></span></div><div id="artViewerNav" class="hidden"><button class="btn sub small" id="artViewerPrev">◀ 前</button><button class="btn small" id="artViewerWear">この衣装にする</button><button class="btn sub small" id="artViewerNext">次 ▶</button></div></div>
<script>window.__ASSETS={};window.__ld=function(i){try{var p=Math.round(i/90*100),b=document.getElementById("loadBar"),m=document.getElementById("loadMsg");if(b&&b.firstChild)b.firstChild.style.width=Math.round(p*0.9)+"%";if(m)m.textContent="絵を よみこんでいます "+p+"%";}catch(e){}};</script>
<script>Object.assign(window.__ASSETS,{"yg_10.webp":"data:image/webp;base64,"});__ld(1)</script>
<script>Object.assign(window.__ASSETS,{"yg_11.webp":"data:image/webp;base64,"});__ld(2)</script>
<script>Object.assign(window.__ASSETS,{"yg_12.webp":"data:image/webp;base64,"});__ld(3)</script>
<script>Object.assign(window.__ASSETS,{"yg_13.webp":"data:image/webp;base64,","yg_14.webp":"data:image/webp;base64,"});__ld(4)</script>
<script>Object.assign(window.__ASSETS,{"yg_15.webp":"data:image/webp;base64,","yg_16.webp":"data:image/webp;base64,"});__ld(5)</script>
<script>Object.assign(window.__ASSETS,{"yg_09.webp":"data:image/webp;base64,